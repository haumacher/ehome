<?xml version="1.0" encoding="utf-8" ?>

<config:template-call
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
	template="com.top_logic.element/treegrid.template.xml"
>
	<arguments
		defaultColumns="name,sections,products,extId"
		type="ehome.catalog:Catalog"
	>
		<name key="dynamic.ab7e8626-cd2b-43fe-88b1-9ef33c9aec65">
			<en>Catalogs</en>
			<de>Kataloge</de>
		</name>
		<modelBuilder class="com.top_logic.model.search.providers.TreeModelByExpression"
			nodePredicate="true"
			parents="node->$node.container()"
			rootNode="`ehome.catalog#ROOT`"
		>
			<children><![CDATA[node->switch {
    $node.instanceOf(`ehome.catalog:Manufacturer`):
        $node.get(`ehome.catalog:Manufacturer#catalogs`);
    $node.instanceOf(`ehome.catalog:Catalog`):
        $node.get(`ehome.catalog:Catalog#sections`)
        .union($node.get(`ehome.catalog:Catalog#products`));
    $node.instanceOf(`ehome.catalog:ManufacturerRoot`):
        $node.get(`ehome.catalog:ManufacturerRoot#manufacturers`)
        .filter(m -> !$m.get(`ehome.catalog:Manufacturer#catalogs`).isEmpty());
}]]></children>
		</modelBuilder>
		<buttons>
			<button id="exportExcelGrid"
				class="com.top_logic.layout.table.export.StreamingExcelExportHandler"
			/>
			<button id="createNewRow"
				class="com.top_logic.model.search.providers.GridCreateHandlerByExpression"
				createContext="model -> $model"
				target="selection(self())"
			>
				<checkScopeProvider/>
				<initOperation><![CDATA[createContext -> newObject -> target -> node-> switch {
    $createContext.instanceOf(`ehome.catalog:ManufacturerRoot`):
        $createContext.add(`ehome.catalog:ManufacturerRoot#manufacturers`, $newObject);
    $createContext.instanceOf(`ehome.catalog:Manufacturer`):
        $createContext.add(`ehome.catalog:Manufacturer#catalogs`, $newObject);
    $createContext.instanceOf(`ehome.catalog:Catalog`): 
        switch {
            $newObject.instanceOf(`ehome.catalog:Catalog`):
                $createContext.add(`ehome.catalog:Catalog#sections`, $newObject);
            $newObject.instanceOf(`ehome.catalog:Product`):
                $createContext.add(`ehome.catalog:Catalog#products`, $newObject);
        };
}]]></initOperation>
				<type-options class="com.top_logic.model.search.providers.CreateTypeOptionsByExpression"
					include-subtypes="true"
				>
					<possible-types><![CDATA[node->switch {
    $node.instanceOf(`ehome.catalog:Manufacturer`):
        `ehome.catalog:Manufacturer#catalogs`
        .get(`tl.model:TLStructuredTypePart#type`);
    $node.instanceOf(`ehome.catalog:Catalog`): [
        `ehome.catalog:Catalog#sections`
        .get(`tl.model:TLStructuredTypePart#type`),
        `ehome.catalog:Catalog#products`
        .get(`tl.model:TLStructuredTypePart#type`)
        ];
    $node.instanceOf(`ehome.catalog:ManufacturerRoot`):
        `ehome.catalog:ManufacturerRoot#manufacturers`
        .get(`tl.model:TLStructuredTypePart#type`);
}]]></possible-types>
				</type-options>
			</button>
		</buttons>
	</arguments>
</config:template-call>