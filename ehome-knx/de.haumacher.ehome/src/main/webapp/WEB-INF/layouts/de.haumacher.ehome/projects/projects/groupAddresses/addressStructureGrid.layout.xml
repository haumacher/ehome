<?xml version="1.0" encoding="utf-8" ?>

<config:template-call
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
	template="com.top_logic.element/treegrid.template.xml"
>
	<arguments
		defaultColumns="name,extId"
		model="selection(de.haumacher.ehome/projects/projectsContextTable.layout.xml#Table)"
		type="ehome.logical:GroupRange"
	>
		<name key="dynamic.f1db18b5-2308-459c-972d-6b5d07d82d8a">
			<en>Address structure</en>
			<de>Addressstruktur</de>
		</name>
		<modelBuilder class="com.top_logic.model.search.providers.TreeModelByExpression"
			parents="node->$node.container()"
			rootNode="model -> $model"
		>
			<children><![CDATA[node->switch {
    $node.instanceOf(`ehome.project:Project`):
        $node.get(`ehome.project:Project#groupAddresses`);
    $node.instanceOf(`ehome.logical:GroupRange`):
        $node.get(`ehome.logical:GroupRange#parts`);
    $node.instanceOf(`ehome.logical:GroupAddress`):
        $node.referers(`ehome.physical:Connection#target`)
            .referers(`ehome.physical:Connector#connections`)
            .referers(`ehome.physical:Device#connectors`);
}]]></children>
			<nodePredicate><![CDATA[node->$node.instanceOf(`ehome.project:Project`)
    || $node.instanceOf(`ehome.logical:GroupRange`)
    || $node.instanceOf(`ehome.logical:GroupAddress`)]]></nodePredicate>
		</modelBuilder>
		<buttons>
			<button id="exportExcelGrid"
				class="com.top_logic.layout.table.export.StreamingExcelExportHandler"
			>
				<downloadNameProvider class="com.top_logic.layout.table.export.ComponentDownloadName"/>
			</button>
			<button id="createNewRow"
				class="com.top_logic.model.search.providers.GridCreateHandlerByExpression"
				createContext="model -> $model"
				initOperation="createContext -> newObject -> target -> $createContext.add(`ehome.logical:GroupRange#parts`, $newObject)"
				target="selection(self())"
			>
				<checkScopeProvider/>
				<type-options class="com.top_logic.element.layout.create.AttributeBasedCreateTypeOptions"
					attribute="ehome.logical:GroupRange#parts"
					owner="ehome.logical:GroupRange"
				/>
			</button>
		</buttons>
	</arguments>
</config:template-call>