<?xml version="1.0" encoding="utf-8" ?>

<grid name="Grid"
	elementTypes="ehome.building:BuildingDefinition"
	model="selection(ehome/project/projectsView.layout.xml#Table)"
>
	<tabInfo>
		<label>
			<de>Gebäude</de>
		</label>
	</tabInfo>

	<titleKey>
		<de>Gebäude</de>
	</titleKey>

	<modelBuilder class="com.top_logic.element.layout.grid.TreeGridBuilder">
		<builder class="de.haumacher.ehome.common.builder.ConfiguredTreeBuilder"
			supports="x -> $x.instanceOf(`ehome.project:Project`)"
			supports-node="m -> x -> $x.instanceOf(`ehome.building:BuildingDefinition`)"
		>
			<children>
				<switch
					expr="p -> $p.get(`ehome.project:Project#buildings`)"
					type="ehome.project:Project"
				/>
				<switch
					expr="b -> $b.get(`ehome.building:BuildingDefinition#parts`)"
					type="ehome.building:BuildingDefinition"
				/>
			</children>
			<parent>
				<switch
					expr="m -> b -> union($b.referers(`ehome.building:BuildingDefinition#parts`), $b.referers(`ehome.project:Project#buildings`))"
					type="ehome.building:BuildingDefinition"
				/>
			</parent>
		</builder>
	</modelBuilder>

	<tables>
		<table
			defaultColumns="name"
			fixedColumns="1"
		>
			<columns>
				<column name="name">
					<cellRenderer class="com.top_logic.layout.tree.renderer.TreeCellRenderer"
						resourceProvider="com.top_logic.element.layout.grid.TreeGridTypeProvider"
					/>
				</column>
			</columns>
		</table>
	</tables>
</grid>
