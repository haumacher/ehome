<?xml version="1.0" encoding="utf-8" ?>

<grid name="Grid"
	elementTypes="ehome.logical:GroupAddressDefinition"
	model="selection(ehome/project/projectsView.layout.xml#Table)"
>
	<titleKey>
		<de>Gruppenadressen</de>
	</titleKey>

	<modelBuilder class="com.top_logic.element.layout.grid.TreeGridBuilder">
		<builder class="de.haumacher.ehome.common.builder.ConfiguredTreeBuilder"
			supports="x -> $x.instanceOf(`ehome.project:Project`)"
			supports-node="m -> x -> $x.instanceOf(`ehome.logical:GroupAddressDefinition`)"
		>
			<children>
				<switch
					expr="a -> $a.get(`ehome.project:Project#groupAddresses`)"
					type="ehome.project:Project"
				/>
				<switch
					expr="a -> $a.get(`ehome.logical:GroupRange#parts`)"
					type="ehome.logical:GroupRange"
				/>
				<switch
					expr="a -> $a.referers(`ehome.physical:Connection#target`).referers(`ehome.physical:Connector#connections`).referers(`ehome.physical:Device#connectors`)"
					type="ehome.logical:GroupAddress"
				/>
			</children>
			<parent>
				<switch
					expr="m -> d -> union($d.referers(`ehome.project:Project#groupAddresses`), $d.referers(`ehome.logical:GroupRange#parts`))"
					type="ehome.logical:GroupAddressDefinition"
				/>
				<switch
					expr="m -> d -> $d.get(`ehome.physical:Device#connectors`).get(`ehome.physical:Connector#connections`).get(`ehome.physical:Connection#target`)"
					type="ehome.physical:Device"
				/>
			</parent>
		</builder>
	</modelBuilder>

	<tables>
		<table
			defaultColumns="name"
			fixedColumns="1"
		>
			<columns>
				<column name="name">
					<cellRenderer class="com.top_logic.layout.tree.renderer.TreeCellRenderer"
						resourceProvider="com.top_logic.element.layout.grid.TreeGridTypeProvider"
					/>
				</column>
			</columns>
		</table>
	</tables>
</grid>
