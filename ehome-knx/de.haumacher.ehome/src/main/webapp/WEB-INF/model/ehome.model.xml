<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.core">
		<annotations>
		</annotations>
		<interface name="Externalized">
			<attributes>
				<property name="extId" 
					type="tl.core:String" />
			</attributes>
		</interface>
	</module>
		
	<module name="ehome.catalog">
		<annotations>
			<singletons>
				<singleton name="ROOT" type="ManufacturerRoot"/>
			</singletons>
		</annotations>
		
		<class name="ManufacturerRoot">
			<attributes>
				<reference name="manufacturers" 
					type="ehome.catalog:Manufacturer" multiple="true" composite="true" />
			</attributes>
		</class>
		
		<class name="Manufacturer">
			<annotations>
				<table name="EHManufacturer" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<property name="id" 
					type="tl.core:Integer" />
				<reference name="catalogs" 
					type="ehome.catalog:Catalog" multiple="true" composite="true" />
				<reference name="programs" 
					type="ehome.operational:Program" multiple="true" composite="true" />
			</attributes>
		</class>

		<class name="Catalog">
			<annotations>
				<table name="EHCatalog" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<reference name="sections" 
					type="ehome.catalog:Catalog" multiple="true" composite="true" />
				<reference name="products" 
					type="ehome.catalog:Product" multiple="true" composite="true" />
			</attributes>
		</class>
		
		<class name="Product">
			<annotations>
				<table name="EHProduct" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<property name="serialNumber" 
					type="tl.core:String" />
				<property name="versionNumber" 
					type="tl.core:String" />
				<reference name="variants"
					type="ehome.catalog:Variant" multiple="true" composite="true"/>
				<reference name="programs"
					type="ehome.catalog:ProgramAssignment" multiple="true" kind="backwards" inverse-reference="product"/>
			</attributes>
		</class>

		<class name="ProgramAssignment">
			<annotations>
				<table name="EHProgramAssignment" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<reference name="product"
					type="ehome.catalog:Product"/>
				<reference name="program"
					type="ehome.operational:Program"/>
			</attributes>
		</class>
		
		<class name="Variant">
			<annotations>
				<table name="EHProduct" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<property name="orderNumber" 
					type="tl.core:String" />
				<reference name="product"
					type="ehome.catalog:Product" multiple="false" aggregate="true" 
					kind="backwards" inverse-reference="variants"/>
			</attributes>
		</class>
	</module>
	
	<module name="ehome.project">
		<annotations>
		</annotations>
		<class name="Project">
			<annotations>
				<table name="EHProject" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<reference name="areas" 
					type="ehome.physical:Area" multiple="true" composite="true" />
				<reference name="buildings" 
					type="ehome.building:BuildingDefinition" multiple="true" composite="true" />
				<reference name="groupAddresses" 
					type="ehome.logical:GroupAddressDefinition" multiple="true" composite="true" />
			</attributes>
		</class>
	</module>
	
	<module name="ehome.logical">
		<interface name="GroupAddressDefinition">
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" type="tl.core:String" />
			</attributes>
		</interface>
		
		<class name="GroupRange">
			<annotations>
				<table name="EHGroupAddress" />
			</annotations>
			<generalizations>
				<generalization type="ehome.logical:GroupAddressDefinition" />
			</generalizations>
			<attributes>
				<reference name="parts" 
					type="ehome.logical:GroupAddressDefinition" multiple="true" composite="true" />
			</attributes>
		</class>
		
		<class name="GroupAddress">
			<annotations>
					<table name="EHGroupAddress" />
			</annotations>
			<generalizations>
				<generalization type="ehome.logical:GroupAddressDefinition" />
			</generalizations>
			<attributes>
				<property name="address" type="tl.core:Integer" />
			</attributes>
		</class>
	</module>
	
	<module name="ehome.operational">
		<annotations>
			<package-binding
				interface-package="de.haumacher.ehome.model.operational"
				implementation-package="de.haumacher.ehome.model.operational.internal"
			/>
		</annotations>
		<class name="Program">
			<annotations>
				<table name="EHProgram" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" type="tl.core:String" />
				<reference name="manufacturer" 
					type="ehome.catalog:Manufacturer" multiple="false" 
					aggregate="true" kind="backwards" inverse-reference="programs"/>
				<reference name="originalManufacturer" 
					type="ehome.catalog:Manufacturer" />
				<reference name="parameterTypes" 
					type="ehome.operational:ParameterType" multiple="true" composite="true" />
				<reference name="parameters" 
					type="ehome.operational:Parameter" multiple="true" composite="true" />
				<reference name="ports" 
					type="ehome.operational:Port" multiple="true" composite="true" />
				<reference name="segments" 
					type="ehome.operational:CodeSegment" multiple="true" composite="true" />
				<reference name="fragments" 
					type="ehome.operational:ConfigFragment" multiple="true" composite="true" ordered="true"/>
			</attributes>
		</class>
		
		<class name="CodeSegment">
			<annotations>
				<table name="EHCodeSegment" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="address" type="tl.core:Integer"/>
				<property name="size" type="tl.core:Integer"/>
				<reference name="pointers" type="ehome.operational:Pointer" multiple="true" composite="true" kind="backwards" inverse-reference="segment"/>
			</attributes>
		</class>
		
		<class name="Pointer">
			<annotations>
				<table name="EHPointer" />
			</annotations>
			<generalizations>
			</generalizations>
			<attributes>
				<reference name="segment" type="ehome.operational:CodeSegment" mandatory="true" aggregate="true"/>
				<property name="byteOffset" type="tl.core:Integer" mandatory="true"/>
				<property name="bitOffset" type="tl.core:Integer" mandatory="true"/>
				<property name="bits" type="tl.core:Integer"/>
				<reference name="usage" type="ehome.operational:Parameter" multiple="true" kind="backwards" inverse-reference="address"/>
			</attributes>
		</class>
		
		<interface name="ParameterType">
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" type="tl.core:String" />
			</attributes>
		</interface>
		
		<class name="VoidType">
			<annotations>
				<table name="EHParameterType" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ParameterType" />
			</generalizations>
		</class>
		
		<class name="TextType">
			<annotations>
				<table name="EHParameterType" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ParameterType" />
			</generalizations>
			<attributes>
				<property name="bits" type="tl.core:Integer" mandatory="true"/>
			</attributes>
		</class>
		
		<enum name="NumberKind">
			<classifier name="unsignedInt"/>
			<classifier name="signedInt"/>
		</enum>

		<class name="NumericType">
			<annotations>
				<table name="EHParameterType" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ParameterType" />
			</generalizations>
			
			<attributes>
				<property name="min" type="tl.core:Long" mandatory="true"/>
				<property name="max" type="tl.core:Long" mandatory="true"/>
				<property name="bits" type="tl.core:Integer" mandatory="true"/>
				<reference name="kind" type="ehome.operational:NumberKind" mandatory="true"/>
			</attributes>
		</class>
		
		<class name="FloatingPointType">
			<annotations>
				<table name="EHParameterType" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ParameterType" />
			</generalizations>
		</class>
		
		<class name="EnumerationType">
			<annotations>
				<table name="EHParameterType" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ParameterType" />
			</generalizations>
			<attributes>
				<property name="bits" type="tl.core:Integer" mandatory="true"/>
				<reference name="kind" type="ehome.operational:ValueKind" mandatory="true" ordered="true"/>
				<reference name="values" type="ehome.operational:EnumerationValue" multiple="true" composite="true" mandatory="true" ordered="true"/>
			</attributes>
		</class>
		
		<enum name="ValueKind">
			<classifier name="Value"/>
			<classifier name="BinaryValue"/>
		</enum>

		<class name="EnumerationValue">
			<annotations>
				<table name="EHEnumerationValue" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" type="tl.core:String" />
				<property name="index" type="tl.core:Integer"/>
				<property name="value" type="tl.core:Integer" mandatory="true"/>
				<property name="binary" type="tl.core:Binary" />
			</attributes>
		</class>
		
		<class name="TimeType">
			<annotations>
				<table name="EHParameterType" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ParameterType" />
			</generalizations>
		</class>
		
		<class name="DateType">
			<annotations>
				<table name="EHParameterType" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ParameterType" />
			</generalizations>
		</class>
		
		<class name="IPAddressType">
			<annotations>
				<table name="EHParameterType" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ParameterType" />
			</generalizations>
		</class>
		
		<enum name="AccessKind">
			<classifier name="None"/>
			<classifier name="Read"/>
			<classifier name="Write"/>
			<classifier name="ReadWrite"/>
		</enum>
		
		<class name="Parameter">
			<annotations>
				<table name="EHParameter" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" type="tl.core:String" />
				<property name="description" type="tl.core:String" />
				<reference name="type" type="ehome.operational:ParameterType" mandatory="true" />

				<reference name="access" type="ehome.operational:AccessKind" mandatory="true"/>
				<property name="value" type="tl.core:Integer" />
					
				<reference name="address" type="ehome.operational:Pointer" />
				<reference name="views" 
					type="ehome.operational:ParameterView" multiple="true" composite="true"/>
			</attributes>
		</class>
		
		<class name="ParameterView">
			<annotations>
				<table name="EHParameterView" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:Option" />
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<reference name="parameter" type="ehome.operational:Parameter" kind="backwards" aggregate="true" multiple="false" inverse-reference="views"/>
				
				<property name="name" type="tl.core:String" />
				<property name="description" type="tl.core:String" />

				<reference name="access" type="ehome.operational:AccessKind" />
				<property name="value" type="tl.core:Integer" />
				
				<property name="order" type="tl.core:Integer" />
				<property name="tag" type="tl.core:Integer" />
			</attributes>
		</class>
		
		<class name="Port">
			<!-- Corresponds to a ComObject in ETS format. -->
			<annotations>
				<table name="EHPort" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<property name="function" 
					type="tl.core:String" />
				<property name="text" 
					type="tl.core:String" />
				<property name="description" 
					type="tl.core:String" />
				<property name="index" 
					type="tl.core:Integer" mandatory="true"/>
				<!-- Size in bits -->
				<property name="size" mandatory="true"
					type="tl.core:Integer" />

				<reference name="priority"
					type="ehome.physical:Priority" mandatory="true"/>
				<reference name="canRead"
					type="ehome.common:Enablement" mandatory="true"/>
				<reference name="canWrite"
					type="ehome.common:Enablement" mandatory="true"/>
				<reference name="communication"
					type="ehome.common:Enablement" mandatory="true"/>
				<reference name="transmission"
					type="ehome.common:Enablement" mandatory="true"/>
				<reference name="update"
					type="ehome.common:Enablement" mandatory="true"/>
				<reference name="readOnInit"
					type="ehome.common:Enablement" mandatory="true"/>

				<reference name="interfaces" 
					type="ehome.operational:Interface" multiple="true" composite="true"/>
			</attributes>
		</class>
		
		<class name="Interface">
			<!-- Corresponds to a ComObjectRef in ETS format. -->
			<annotations>
				<table name="EHInterface" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:Option" />
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<property name="function" 
					type="tl.core:String" />
				<reference name="port" 
					type="ehome.operational:Port" multiple="false" aggregate="true" 
					kind="backwards" inverse-reference="interfaces"/>
				<property name="dpt" 
					type="tl.core:String" />
				<property name="tag" 
					type="tl.core:Integer" />
			</attributes>
		</class>
		
		<interface name="Option">
		</interface>
		
		<interface name="ConfigFragment">
			<attributes>
				<reference name="contents" 
					type="ehome.operational:Option" multiple="true" ordered="true"/>
			</attributes>
		</interface>
		
		<class name="ChannelIndependent">
			<annotations>
				<table name="EHConfigFragment" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ConfigFragment" />
				<generalization type="ehome.core:Externalized" />
			</generalizations>
		</class>
		
		<class name="Channel">
			<annotations>
				<table name="EHConfigFragment" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ConfigFragment" />
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<property name="description" 
					type="tl.core:String" />
				<property name="number" 
					type="tl.core:Integer" />
			</attributes>
		</class>
		
		<class name="ParameterGroup">
			<annotations>
				<table name="EHConfigFragment" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ConfigFragment" />
				<generalization type="ehome.operational:Option" />
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" type="tl.core:String" />
				<property name="description" type="tl.core:String" />
				<reference name="access" type="ehome.operational:AccessKind"/>
				<reference name="input" type="ehome.operational:ParameterView"/>
			</attributes>
		</class>
		
		<class name="Switch">
			<annotations>
				<table name="EHSwitch" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:Option" />
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<reference name="input" type="ehome.operational:ParameterView"/>
				<reference name="alternatives" type="ehome.operational:Case" multiple="true"/>
			</attributes>
		</class>
		
		<class name="Case">
			<annotations>
				<table name="EHConfigFragment" />
			</annotations>
			<generalizations>
				<generalization type="ehome.operational:ConfigFragment" />
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="pattern" 
					type="tl.core:String" />
			</attributes>
		</class>
	</module>
	
	<module name="ehome.common">
		<enum name="Enablement">
			<classifier name="Disabled"/>
			<classifier name="Enabled"/>
		</enum>
	</module>
	
	<module name="ehome.physical">
		<enum name="Priority">
			<classifier name="Low"/>
			<classifier name="High"/>
			<classifier name="Alert"/>
		</enum>
	
		<class name="Area">
			<annotations>
				<table name="EHLine" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<property name="address" 
					type="tl.core:Integer" />
				<reference name="lines" 
					type="ehome.physical:Line" multiple="true" composite="true" />
			</attributes>
		</class>
		
		<class name="Line">
			<annotations>
				<table name="EHLine" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<property name="address" 
					type="tl.core:Integer" />
				<reference name="devices" 
					type="ehome.physical:Device" multiple="true" composite="true" />
			</attributes>
		</class>
		
		<class name="Device">
			<annotations>
				<table name="EHDevice" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<property name="address" 
					type="tl.core:Integer" />
				<reference name="type" 
					type="ehome.catalog:Variant" multiple="false" mandatory="true" />
				<reference name="program" 
					type="ehome.catalog:ProgramAssignment" multiple="false" mandatory="true" />
				<reference name="location" 
					type="ehome.building:BuildingDefinition" multiple="false" mandatory="false" />
				<reference name="connectors" 
					type="ehome.physical:Connector" multiple="true" composite="true" />
			</attributes>
		</class>
		
		<class name="Connector">
			<annotations>
				<table name="EHConnector" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<reference name="port" 
					type="ehome.operational:Interface" multiple="false" mandatory="true"/>
				<property name="description" 
					type="tl.core:String" />
				<property name="function" 
					type="tl.core:String" />
					
				<reference name="priority"
					type="ehome.physical:Priority" />
				<reference name="canRead"
					type="ehome.common:Enablement" />
				<reference name="canWrite"
					type="ehome.common:Enablement" />
				<reference name="communication"
					type="ehome.common:Enablement" />
				<reference name="transmission"
					type="ehome.common:Enablement" />
				<reference name="update"
					type="ehome.common:Enablement" />
				<reference name="readOnInit"
					type="ehome.common:Enablement" />
					
				<reference name="connections" 
					type="ehome.physical:Connection" multiple="true" composite="true"/>
			</attributes>
		</class>
		
		<class name="Connection">
			<annotations>
				<table name="EHConnection" />
			</annotations>
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query expr="x -> concat($x.get(`ehome.physical:Connection#target`).get(`ehome.logical:GroupAddress#name`), ' (', $x.get(`ehome.physical:Connection#kind`), ')')"/>
						</storage-algorithm>
					</annotations>
				</property>
				<reference name="kind" 
					type="ehome.physical:ConnectionType" multiple="false" mandatory="true"/>
				<reference name="target" 
					type="ehome.logical:GroupAddress" multiple="false" mandatory="true"/>
				<property name="acknowledge" 
					type="tl.core:Boolean" />
			</attributes>
		</class>
		
		<enum name="ConnectionType">
			<classifier name="send"/>
			<classifier name="receive"/>
		</enum>
	</module>
	
	<module name="ehome.building">
		<interface name="BuildingDefinition">
			<generalizations>
				<generalization type="ehome.core:Externalized" />
			</generalizations>
			<attributes>
				<property name="name" 
					type="tl.core:String" />
				<reference name="parts" 
					type="ehome.building:BuildingDefinition" multiple="true" composite="true" />
			</attributes>
		</interface>

		<class name="Building">
			<annotations>
				<table name="EHBuilding" />
			</annotations>
			<generalizations>
				<generalization type="ehome.building:BuildingDefinition" />
			</generalizations>
			<attributes>
			</attributes>
		</class>
		
		<class name="Floor">
			<annotations>
				<table name="EHBuilding" />
			</annotations>
			<generalizations>
				<generalization type="ehome.building:BuildingDefinition" />
			</generalizations>
			<attributes>
			</attributes>
		</class>

		<class name="Stairway">
			<annotations>
				<table name="EHBuilding" />
			</annotations>
			<generalizations>
				<generalization type="ehome.building:BuildingDefinition" />
			</generalizations>
			<attributes>
			</attributes>
		</class>
		
		<class name="Room">
			<annotations>
				<table name="EHBuilding" />
			</annotations>
			<generalizations>
				<generalization type="ehome.building:BuildingDefinition" />
			</generalizations>
			<attributes>
			</attributes>
		</class>

