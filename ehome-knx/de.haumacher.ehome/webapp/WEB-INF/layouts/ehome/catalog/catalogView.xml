<?xml version="1.0" encoding="utf-8" ?>

<template xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<params>
		<param name="namePrefix"
			value="catalogView"
		/>
		<param name="structure"
			value="TODO: UnusedNonsense"
		/>
	</params>

	<grid name="${namePrefix}Grid"
		elementTypes="ehome.catalog:Manufacturer,ehome.catalog:Catalog,ehome.catalog:Product"
	>
		<model config:interface="com.top_logic.layout.ModelSpec$Provider">
			<impl class="com.top_logic.element.layout.structured.WholeStructureModelProvider"
				structure="ehome.catalog"
			/>
		</model>

		<modelBuilder class="com.top_logic.element.layout.grid.TreeGridBuilder">
			<builder class="de.haumacher.ehome.common.builder.ConfiguredTreeBuilder"
				supports="true"
				supports-node="m -> x -> $x.instanceOf(`ehome.catalog:Manufacturer`) or $x.instanceOf(`ehome.catalog:Catalog`) or $x.instanceOf(`ehome.catalog:Product`)"
			>
				<children>
					<switch
						expr="m -> $m.get(`ehome.catalog:Manufacturer#catalogs`)"
						type="ehome.catalog:Manufacturer"
					/>
					<switch
						expr="c -> union($c.get(`ehome.catalog:Catalog#sections`), $c.get(`ehome.catalog:Catalog#products`))"
						type="ehome.catalog:Catalog"
					/>
					<switch
						expr="p -> none()"
						type="ehome.catalog:Product"
					/>
					<switch
						expr="r -> $r.get(`ehome.catalog:ManufacturerRoot#manufacturers`).filter(m -> !$m.get(`ehome.catalog:Manufacturer#catalogs`).isEmpty())"
						type="ehome.catalog:ManufacturerRoot"
					/>
				</children>
				<parent>
					<switch
						expr="m -> d -> $d.referers(`ehome.physical:Device#connectors`)"
						type="ehome.physical:Connector"
					/>
					<switch
						expr="m -> d -> $d.referers(`ehome.physical:Line#devices`)"
						type="ehome.physical:Device"
					/>
					<switch
						expr="m -> d -> $d.referers(`ehome.physical:Area#lines`)"
						type="ehome.physical:Line"
					/>
					<switch
						expr="m -> d -> $d.referers(`ehome.project:Project#areas`)"
						type="ehome.physical:Area"
					/>
				</parent>
			</builder>
		</modelBuilder>

		<tables>
			<table
				defaultColumns="name"
				fixedColumns="1"
			>
				<columns>
					<column name="name">
						<cellRenderer class="com.top_logic.layout.tree.renderer.TreeCellRenderer"
							resourceProvider="com.top_logic.element.layout.grid.TreeGridTypeProvider"
						/>
					</column>
				</columns>
			</table>
		</tables>
	</grid>
</template>