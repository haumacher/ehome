<?xml version="1.0" encoding="utf-8" ?>

<template>
	<params>
		<param name="namePrefix"
			value="projectView"
		/>
		<param name="structure"
			value="TODO: UnusedNonsense"
		/>
	</params>

	<tableView name="${namePrefix}Table"
		objectType="ehome.project:Project"
	>
		<modelBuilder class="com.top_logic.element.layout.MEInstanceTableModelBuilder"
			metaElement="ehome.project:Project"
		/>

		<dialogs>
			<layout name="${namePrefix}ImportWizard">
				<dialogInfo/>

				<wizard buttonComponent="${namePrefix}ImportWizardButtons">
					<steps>
						<step name="upload">
							<form>
								<modelBuilder class="com.top_logic.layout.form.declarative.DefaultDeclarativeFormBuilder"
									create="true"
									formType="de.haumacher.ehome.etsImport.UploadForm"
								/>
							</form>

							<nextCommand id="import"
								class="de.haumacher.ehome.etsImport.ImportFromEts"
							/>
							<prevCommand id="TODO"
								class="de.haumacher.ehome.etsImport.ImportFromEts"
							/>
						</step>
						<step name="analyze">
							<form>
								<modelBuilder class="com.top_logic.layout.form.declarative.DefaultDeclarativeFormBuilder"
									create="true"
									formType="de.haumacher.ehome.etsImport.AnalyzeForm"
								/>
							</form>

							<nextCommand id="import"
								class="de.haumacher.ehome.etsImport.ImportFromEts"
							/>
							<prevCommand id="TODO"
								class="de.haumacher.ehome.etsImport.ImportFromEts"
							/>
						</step>
					</steps>

					<buttons>
						<button id="prev"
							backwards="true"
							class="com.top_logic.layout.component.assistent.WizardComponent$Navigate"
							clique="backward"
						/>
						<button id="next"
							class="com.top_logic.layout.component.assistent.WizardComponent$Navigate"
							clique="forward"
						/>
					</buttons>
				</wizard>
				<buttonbar name="${namePrefix}ImportWizardButtons"/>
			</layout>
		</dialogs>
	</tableView>
</template>