<?xml version="1.0" encoding="utf-8" ?>

<!--
	Download of a trace of the virtual device (virtual/virtual-device.view.xml) as text file. "file"
	carries the result of virtualTraceFile (de.haumacher.ehome.virtual.tooling.VirtualFunctions): the trace in
	the format of de.haumacher.ehome.virtual.tooling.trace.TraceFormat, offered by a read-only binary input as a
	download link.
-->
<view>
	<channels>
		<channel name="file"/>
	</channels>
	<window width="600px">
		<title>
			<en>Export the trace</en>
			<de>Aufzeichnung exportieren</de>
		</title>
		<inset>
			<stack gap="loose">
				<text>
					<label>
						<en>The trace as text file: a header, then one line per service with its time, direction, sender, receiver, parameters and data.</en>
						<de>Die Aufzeichnung als Textdatei: ein Kopf, dann eine Zeile je Dienst mit Zeit, Richtung, Absender, Empfänger, Parametern und Daten.</de>
					</label>
				</text>
				<fields>
					<value-input
						readonly="true"
						type="tl.core:Binary"
						value="file"
					>
						<label>
							<en>File</en>
							<de>Datei</de>
						</label>
					</value-input>
				</fields>
			</stack>
		</inset>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
