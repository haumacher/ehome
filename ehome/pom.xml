<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.top-logic</groupId>
    <artifactId>tl-parent-app</artifactId>
    <version>8.0.0-alpha12.820</version>
    <relativePath/>
  </parent>
  <artifactId>de.haumacher.ehome</artifactId>
  <version>1.4.0</version>
  <properties>
    <!-- The context path of the app: in development mode (exec:java) and the name of the deployable war (target/ehome.war). -->
    <tl.contextPath>ehome</tl.contextPath>
  </properties>
  <repositories>
    <repository>
      <id>tl-releases</id>
      <url>https://dev.top-logic.com/nexus/repository/toplogic/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <repository>
      <id>tl-snapshots</id>
      <url>https://dev.top-logic.com/nexus/repository/toplogic-snapshots/</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>
  <dependencies>

		<dependency>
			<groupId>com.github.calimero</groupId>
			<artifactId>calimero-core</artifactId>
			<version>2.6</version>
		</dependency>

		<!--
			The KNXnet/IP server side of Calimero (with calimero-device, which it brings along), same version
			and license (GPL 2.0 with Classpath Exception) as calimero-core: the virtual installation the
			rules simulation runs on (package de.haumacher.ehome.virtual, haumacher/ehome #58), and the
			programmable virtual device of the development tooling (module ehome-virtual, #27, #28).
		-->
		<dependency>
			<groupId>com.github.calimero</groupId>
			<artifactId>calimero-server</artifactId>
			<version>2.6</version>
			<exclusions>
				<!-- TopLogic logs through log4j (log4j-slf4j2-impl is on the classpath). -->
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-simple</artifactId>
				</exclusion>
				<!-- Calimero logs through slf4j; this binding would redirect the JDK's platform logging of the whole application. -->
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-jdk-platform-logging</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!--
			Reading the password-protected project part of an ETS 5/6 project file (P-xxxx.zip, AES or
			traditional ZIP encryption, which the JDK cannot read; haumacher/ehome #32). License: Apache 2.0.
		-->
		<dependency>
			<groupId>net.lingala.zip4j</groupId>
			<artifactId>zip4j</artifactId>
			<version>2.11.5</version>
		</dependency>

		<!--
			Evaluating the JavaScript parameter calculations of application programs (ETS 6:
			ParameterCalculation, haumacher/ehome #123) in a sandbox without Java access. 1.9.1: the newest
			release older than a few weeks (1.9.2 came out on 2026-10-27). License: MPL 2.0.
		-->
		<dependency>
			<groupId>org.mozilla</groupId>
			<artifactId>rhino</artifactId>
			<version>1.9.1</version>
		</dependency>

		<!--
			Formatting the help texts of application programs (ETS: ContextHelpFile, Markdown,
			haumacher/ehome #157) as HTML, raw HTML escaped. The version the engine uses (tl-basic depends
			on it, the TopLogic BOM manages it). License: BSD 2-Clause.
		-->
		<dependency>
			<groupId>org.commonmark</groupId>
			<artifactId>commonmark</artifactId>
		</dependency>

    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-contact</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-scripting-template</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-formeditor</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-graph-diagramjs-server</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-monitoring</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-themes-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-model-search</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-xio</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-view</artifactId>
    </dependency>
    <!--
      Agent access to a running session (doc/agent-access.md): the endpoint /agent-api and the access
      tokens a user issues from the development menu (Agent access) to let an agent drive the session
      with the user's permissions.
    -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-view-agent</artifactId>
    </dependency>
    <!--
      The contacts of the accounts in the views (haumacher/ehome #163): the administration's page
      "Personen" (Administration, Zugriffskontrolle) creates and edits a person with its mail address and
      optional login, and the settings get the tab "Profil", in which a user edits the own contact. The
      members of a project are added by that address (de.haumacher.ehome.project.ProjectMembers).
    -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-view-contact</artifactId>
    </dependency>
    <!--
      Passkeys (haumacher/ehome #86): passwordless sign-in with a discoverable passkey (usage "login",
      the module's default), managed in the settings (Security) and the account administration. The
      relying party is the public address of the installation, tl_host (doc/debian.md, "Passkeys").
    -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-security-passkey</artifactId>
    </dependency>
    <!--
      The assistant (haumacher/ehome #126, #129, doc/ai.md): the agent framework with its providers, tools
      and security layers (tl-ai-core), the chat in the shell (tl-chat, <chat-dock> in app.view.xml), and
      the MCP endpoint /ehome/mcp for external agents with a personal access token (tl-ai-mcp-server,
      WEB-INF/autoconf/ehome.mcp.config.xml). Not the whole tl-starter-ai: no agents rewriting views
      (tl-ai-views), no A2A.
    -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-ai-core</artifactId>
      <exclusions>
        <!--
          The browsers of Playwright (200 MB), for the agent's browser tools (group egress), which
          E-Home grants nobody; without them a browser tool fails when called, the app is unaffected.
          doc/tl-todo.md, "AI modules".
        -->
        <exclusion>
          <groupId>com.microsoft.playwright</groupId>
          <artifactId>driver-bundle</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-chat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-ai-mcp-server</artifactId>
    </dependency>
	
    <!--
      The controllers' WebSocket (haumacher/ehome #54, ControllerSocket): the Jakarta WebSocket API,
      provided by the container the war runs in (the version is the engine's). The implementation in
      the tests and the development start is Jetty's, which the engine brings (tl-ide-jetty).
    -->
    <dependency>
      <groupId>jakarta.websocket</groupId>
      <artifactId>jakarta.websocket-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.websocket</groupId>
      <artifactId>jakarta.websocket-client-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-basic</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <!-- The scripted provider of the assistant's tests (ai/testing-agents): recorded answers, no model, no key. -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-ai-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <!-- The access coverage test (TestSecurityCoverage, ehome-testSettings.config.xml). -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-element</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>${project.basedir}/../checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.top-logic</groupId>
        <artifactId>tl-maven-plugin</artifactId>
        <!--
          generate-java is not bound to the lifecycle: run "../mvnw tl:generate-java" in this module when
          the model changes. The header is fixed, so a run does not rewrite the year of every generated file.
        -->
        <configuration>
          <modules>ehome.core,ehome.operational</modules>
          <languages>en,de</languages>
          <copyrightHeader>Copyright (c) 2018 Bernhard Haumacher</copyrightHeader>
        </configuration>
        <executions>
          <execution>
            <id>build-app</id>
            <configuration>
              <warName>${tl.contextPath}.war</warName>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <arguments combine.self="override">
            <argument>-port</argument>
            <argument>${tl.port}</argument>
            <argument>-contextPath</argument>
            <argument>${tl.contextPath}</argument>
          </arguments>
          <systemProperties>
            <systemProperty>
              <key>tl_operation_mode</key>
              <value>development</value>
            </systemProperty>
          </systemProperties>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The development start includes the development tooling (module ehome-virtual, haumacher/ehome #28):
      its classes and, through them, its web fragment (src/main/webapp of the module) are put on the
      classpath of exec:java. The tooling depends on the app, so the app cannot depend on it; the
      classpath of the start is the only place the app names it. Build it first (./mvnw install in the
      repository root). Active unless another profile of this POM is chosen.
    -->
    <profile>
      <id>development</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <additionalClasspathElements>
                <additionalClasspathElement>${project.basedir}/../ehome-virtual/target/classes</additionalClasspathElement>
              </additionalClasspathElements>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- The app without the development tooling. -->
      <id>production</id>
    </profile>
    <!--
      The war of the Debian package (bin/build-deb.sh, doc/debian.md): with the H2 driver and its
      connection pool (deploy aspect deploy/debian) instead of the container's JNDI data source of the
      engine's default war (tl.app.metaConfAddons.db), and without the debug settings of deploy/local.
      The location of the data and the database password come from /etc/ehome/ehome.env
      (tl_storage_path, h2_name, h2_passwd). Build: ./mvnw install -Pproduction,debian
    -->
    <profile>
      <id>debian</id>
      <properties>
        <deployAspects>debian</deployAspects>
        <tl.app.metaConfAddons.db></tl.app.metaConfAddons.db>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.h2database</groupId>
          <artifactId>h2</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
