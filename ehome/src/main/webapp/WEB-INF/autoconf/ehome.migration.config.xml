<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
  xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
  <services>
    <!--
      The data migrations of E-Home: WEB-INF/kbase/migration/ehome/. The module came with its first
      migration (TL #29806), so a database of an earlier E-Home has no version of it: minimum-modules
      makes the migration service start such a database at the module's initial version and run
      its migrations, instead of skipping the module as one the database did not have.
    -->
    <config service-class="com.top_logic.knowledge.service.migration.MigrationService">
      <instance minimum-modules="ehome">
        <modules>
          <module name="ehome"/>
        </modules>
      </instance>
    </config>
  </services>
</application>
