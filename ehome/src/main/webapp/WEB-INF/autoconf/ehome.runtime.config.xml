<?xml version="1.0" encoding="utf-8"?>

<!--
	Deployment of runtime images to HomeControl controllers (haumacher/ehome #39, package
	de.haumacher.ehome.runtime): the model of the controllers, deployments and functions, and the
	TL-Script functions of the views controllers.view.xml, projects/deployment.view.xml,
	projects/functions.view.xml, projects/rules.view.xml, projects/pages.view.xml and of the runtime settings and the
	rules in the model.
-->
<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<!-- A renamed id rewrites the expressions naming it (haumacher/ehome #111, de.haumacher.ehome.runtime.IdRenames). -->
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance class="com.top_logic.basic.module.ModuleSystem">
				<modules>
					<module key="de.haumacher.ehome.runtime.IdRenames$Module"
						value="true"
					/>
				</modules>
			</instance>
		</config>
		<config service-class="de.haumacher.ehome.runtime.IdRenames">
			<instance class="de.haumacher.ehome.runtime.IdRenames"/>
		</config>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance class="com.top_logic.util.resource.analyzer.IDEResources">
				<bundles>
					<bundle name="model.ehome.runtime.messages"/>
				</bundles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/ehome.runtime.model.xml"/>
				</declarations>
			</instance>
		</config>
		<config service-class="com.top_logic.model.search.expr.config.SearchBuilder">
			<instance>
				<methods>
					<!-- The controllers and the runtime image (de.haumacher.ehome.runtime.RuntimeFunctions): one builder, the function by its name. -->
					<method name="controllerTokenHint" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="controllerAddress" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="deploymentVeto" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="nextImageRevision" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<!-- What differs from the image the controller stores, what it runs (haumacher/ehome #47). -->
					<method name="deploymentConfirmation" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="unloadConfirmation" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<!-- The E-Home connection of the controllers (haumacher/ehome #54, de.haumacher.ehome.connection.ConnectionFunctions). -->
					<method name="controllerConnection" class="de.haumacher.ehome.connection.ConnectionFunctions$Builder"/>
					<method name="controllerOnline" class="de.haumacher.ehome.connection.ConnectionFunctions$Builder"/>
					<method name="enrollmentCodeState" class="de.haumacher.ehome.connection.ConnectionFunctions$Builder"/>
					<method name="forgetConfirmation" class="de.haumacher.ehome.connection.ConnectionFunctions$Builder"/>
					<!-- The installation key of a project and the keys the controllers hold (homecontrol issue #35, de.haumacher.ehome.connection.InstallationKeys). -->
					<method name="installationKeyState" class="de.haumacher.ehome.connection.ConnectionFunctions$Builder"/>
					<method name="controllerKeyState" class="de.haumacher.ehome.connection.ConnectionFunctions$Builder"/>
					<method name="installationKeyCreateVeto" class="de.haumacher.ehome.connection.ConnectionFunctions$Builder"/>
					<method name="installationKeyRenewVeto" class="de.haumacher.ehome.connection.ConnectionFunctions$Builder"/>
					<!-- Functions and runtime settings (haumacher/ehome #43, #45). -->
					<method name="runtimeGroupAddresses" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<!-- The options of a function's roles: group addresses and application datapoints (haumacher/ehome #61). -->
					<method name="runtimeDatapoints" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="runtimeBuildingParts" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<!-- A button repeating the command of another function (haumacher/ehome #92). -->
					<method name="functionRedundancy" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<!-- The question before a delete, naming what refers to the object (haumacher/ehome #94). -->
					<method name="deleteConfirmation" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<!-- The virtual devices (haumacher/ehome #75). -->
					<method name="blockTypeOptions" class="de.haumacher.ehome.runtime.BlockFunctions$Builder"/>
					<method name="blockTypeLabel" class="de.haumacher.ehome.runtime.BlockFunctions$Builder"/>
					<method name="blockCreate" class="de.haumacher.ehome.runtime.BlockFunctions$Builder"/>
					<method name="blockBind" class="de.haumacher.ehome.runtime.BlockFunctions$Builder"/>
					<method name="blockBindingOptions" class="de.haumacher.ehome.runtime.BlockFunctions$Builder"/>
					<method name="blockLabel" class="de.haumacher.ehome.runtime.BlockFunctions$Builder"/>
