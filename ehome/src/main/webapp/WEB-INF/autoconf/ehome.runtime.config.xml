					<method name="pageInsert" class="de.haumacher.ehome.runtime.PageFunctions$Builder"/>
					<method name="pageMoveVeto" class="de.haumacher.ehome.runtime.PageFunctions$Builder"/>
					<method name="pageMove" class="de.haumacher.ehome.runtime.PageFunctions$Builder"/>
				</methods>
			</instance>
		</config>
	</services>
</application>
