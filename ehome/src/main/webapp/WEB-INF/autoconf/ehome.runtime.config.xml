					<method name="runtimeHistoryEffective" class="de.haumacher.ehome.runtime.HistoryFunctions$Builder"/>
					<method name="runtimeHistoryManual" class="de.haumacher.ehome.runtime.HistoryFunctions$Builder"/>
					<method name="runtimeHistoryUsage" class="de.haumacher.ehome.runtime.HistoryFunctions$Builder"/>
