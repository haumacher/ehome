					<method name="datapointUnit" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="datapointFlagsSource" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<!-- Rules and schedules (haumacher/ehome #57, de.haumacher.ehome.runtime.RuleFunctions). -->
					<method name="ruleSummary" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="ruleList" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="ruleCreate" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="ruleMove" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="ruleMoveVeto" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="ruleDatapoints" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<!-- The datapoints offered while typing a reference in a text of the rule language (TL #29887). -->
					<method name="ruleSuggestions" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<!-- The import of rules from a runtime image (haumacher/ehome #60). -->
					<method name="ruleImportImage" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<!-- The options of the references of rules and schedule entries (haumacher/ehome #90). -->
					<method name="ruleOptions" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="ruleOptionLabel" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<!-- The create dialogs of rules, schedule entries, application datapoints and pages (haumacher/ehome #91). -->
					<method name="ruleDraft" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="rulePageDraft" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="ruleDraftField" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="ruleDraftTitle" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
					<method name="ruleAdd" class="de.haumacher.ehome.runtime.RuleFunctions$Builder"/>
