<?xml version="1.0" encoding="utf-8"?>

<!--
	The catalog of known Zigbee devices (haumacher/ehome #64, de.haumacher.ehome.zigbee.ZigbeeCatalog):
	the model of the shared master data, and the service loading the device types E-Home ships
	(WEB-INF/zigbee-catalog/*.json) once per database (ZigbeeCatalogSeed). The TL-Script functions of
	the catalog are registered with the other Zigbee functions in ehome.zigbee.config.xml.
-->
<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance class="com.top_logic.basic.module.ModuleSystem">
				<modules>
					<module key="de.haumacher.ehome.zigbee.ZigbeeCatalogSeed$Module" value="true"/>
				</modules>
			</instance>
		</config>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance class="com.top_logic.util.resource.analyzer.IDEResources">
				<bundles>
					<bundle name="model.ehome.zigbee.catalog.messages"/>
				</bundles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/ehome.zigbee.catalog.model.xml"/>
				</declarations>
			</instance>
		</config>
	</services>
</application>
