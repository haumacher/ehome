<?xml version="1.0" encoding="utf-8"?>

<!--
	Zigbee devices of a project (haumacher/ehome #40, package de.haumacher.ehome.zigbee): the model of
	the devices, their endpoints and functions as a HomeControl controller exports them, and the
	TL-Script functions of the view projects/zigbee.view.xml and of the binding of an application
	datapoint.
-->
<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance class="com.top_logic.util.resource.analyzer.IDEResources">
				<bundles>
					<bundle name="model.ehome.zigbee.messages"/>
				</bundles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/ehome.zigbee.model.xml"/>
				</declarations>
			</instance>
		</config>
		<config service-class="com.top_logic.model.search.expr.config.SearchBuilder">
			<instance>
				<methods>
					<!-- The import and the bindings (de.haumacher.ehome.zigbee.ZigbeeFunctions): one builder, the function by its name. -->
					<method name="zigbeeImport" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeCreateDatapoint" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeBind" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeUnbind" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeBindVeto" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeUnbindVeto" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeCandidates" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeFunctionOptions" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<!-- The live state of the devices and the network, the names of the functions, the cleanup (haumacher/ehome #64). -->
					<method name="zigbeeFunctionLabel" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeDeviceState" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeNetworkState" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeReadState" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeLiveProblem" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeRemoveAbsent" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
					<method name="zigbeeRemoveAbsentVeto" class="de.haumacher.ehome.zigbee.ZigbeeFunctions$Builder"/>
				</methods>
			</instance>
		</config>
	</services>
</application>
