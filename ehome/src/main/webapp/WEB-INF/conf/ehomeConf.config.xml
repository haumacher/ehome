		<!--
			Group addresses (model type ehome.logical:GA) are written in the notation they carry; a device
			is named with its individual address (also in the options of a device choice).
		-->
		<config service-class="com.top_logic.layout.provider.LabelProviderService">
			<instance>
				<label-providers>
					<provider kind="CODE" type="de.haumacher.ehome.knx.GA" implementation="de.haumacher.ehome.knx.GALabelProvider"/>
				</label-providers>
				<resource-providers>
					<provider kind="MODEL" type="ehome.physical:Device" implementation="de.haumacher.ehome.programming.DeviceResourceProvider"/>
				</resource-providers>
			</instance>
		</config>

		<!-- The app's styles of the React UI: markers of changes and untyped addresses, device entries. -->
		<config service-class="com.top_logic.layout.react.resource.ClientResources">
			<instance class="com.top_logic.layout.react.resource.ClientResources">
				<resources>
					<stylesheet name="ehome-css"
						requires="tl-design-system-components"
						resource="/style/ehome.css"
					/>
				</resources>
			</instance>
		</config>

		<!--
			Where an object is shown when it is followed as a link (haumacher/ehome #102): a group address
			in the group addresses of its project, selected in the tree. The drill-down starts at the list
			of projects, so that the target is reached from any place of the app; the frame of the
			project is labelled as the list labels it (projects.view.xml).
		-->
		<config service-class="com.top_logic.layout.view.navigation.DisplayTargetService">
			<instance>
				<targets>
					<target type="ehome.logical:GroupAddress">
						<show view="projects/overview.view.xml">
							<bind
								channel="project"
								expr="recursion($object, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
							/>
						</show>
						<show frame="project"
							label-expr="recursion($object, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement().get(`ehome.project:Project#name`)"
						>
							<bind
								channel="project"
								expr="recursion($object, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
							/>
						</show>
						<show view="projects/addresses.view.xml">
							<bind channel="selected"/>
						</show>
					</target>
				</targets>
			</instance>
		</config>

		<!-- The create commands of the structure trees, one per node type, folded into a menu. -->
		<config service-class="com.top_logic.layout.view.command.CommandCliqueService">
			<instance>
				<cliques>
					<clique name="new"
						config:position="before"
						config:reference="create"
						display="menu"
						icon="css:bi bi-plus-lg"
					>
						<label>
							<en>New</en>
							<de>Neu</de>
						</label>
					</clique>
				</cliques>
			</instance>
		</config>
