<?xml version="1.0" encoding="utf-8" ?>

<!--
	haumacher/ehome #166: the derived attribute ObjectOverlay#untypedConnected is gone (it read the
	connectors of every project). Its query called the TL-Script function placementUntypedConnected,
	which went with it; the automatic model upgrade would load the stored attribute to delete it and
	log an error for the unknown function. This migration deletes the attribute from the stored model
	before, so the upgrade has nothing to do for it. A derived attribute has no stored values.
-->
<migration config:interface="com.top_logic.knowledge.service.migration.MigrationConfig"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<version name="Issue_166_Drop_untyped_connected"
		module="ehome"
	/>
	<dependencies>
		<dependency name="Ticket_30357_Drop_cookie_pool"
			module="ehome"
		/>
		<dependency name="Ticket_29492_enlarge_layout_key"
			module="tl"
		/>
		<dependency name="Ticket_30183_account_lock"
			module="tl-element"
		/>
		<dependency name="Ticket_29741_hide_anonymous_in_options"
			module="tl-contact"
		/>
		<dependency name="Ticket_28710_Added_TLSearch"
			module="tl-model-search"
		/>
		<dependency name="Ticket_27736_Upgrade_layout"
			module="tl-monitoring"
		/>
		<dependency name="Ticket_30183_account_lock"
			module="tl-layout-formeditor"
		/>
	</dependencies>
	<processors>
		<delete-property name="ehome.template:ObjectOverlay#untypedConnected"/>
	</processors>
	<post-processors/>
</migration>
