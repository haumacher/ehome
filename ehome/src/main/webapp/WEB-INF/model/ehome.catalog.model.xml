<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.catalog">
		<annotations>
			<singletons>
				<singleton type="ManufacturerRoot"/>
			</singletons>
		</annotations>
		<!--
			A file inside an archive of a manufacturer's baggage (haumacher/ehome #156, #157): a picture of an
			icon archive (ETS: ApplicationProgram@IconFile) or a text of a help archive (ETS:
			ApplicationProgram@ContextHelpFile), unpacked by the import from the archive an application program
			names, so that the parameter editor shows it. Owned by its archive; a newer version of the archive
			replaces its entries.
		-->
		<class name="ArchiveEntry">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-file-earmark-zip"/>
			</annotations>
			<attributes>
				<!-- The name of the file in the archive, with its folders separated by "/". -->
				<property name="name"
					type="tl.core:String"
				/>
				<!-- The file itself. -->
				<property name="content"
					type="tl.core:Binary"
				/>
			</attributes>
		</class>
		<!--
			A file a manufacturer ships with its product data (ETS: Baggage, haumacher/ehome #154): a picture
			of the parameter dialog, an archive of icons or help texts, a document, a plug-in installer. It is
			kept as it is, whatever its kind; E-Home never runs it. The import reuses it by its ID and replaces
			its content by that of a newer time only.
		-->
		<class name="Baggage">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-file-earmark"/>
			</annotations>
			<attributes>
				<!-- The file name (ETS: Name). -->
				<property name="name"
					type="tl.core:String"
				/>
				<!-- The folder of the file below the manufacturer's baggage, with "/" between its parts; empty for none (ETS: TargetPath). -->
				<property name="path"
					type="tl.core:String"
				/>
				<!-- The time of the file's version (ETS: FileInfo@TimeInfo); a newer one replaces the content. -->
				<property name="time"
					type="tl.core:DateTime"
				/>
				<!-- The number of bytes of the content; empty without content. -->
				<property name="size"
					type="tl.core:Long"
				/>
				<!-- The file itself; empty if the product file did not hold it or it was above the size limit. -->
				<property name="content"
					type="tl.core:Binary"
				/>
				<!--
					The files of the archive, if the file is an archive an application program takes its icons or
					help texts from (haumacher/ehome #156, #157), see unpacked.
				-->
				<reference name="entries"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ArchiveEntry"
				/>
				<!--
					Whether the import unpacked the archive into its entries (an archive that is no ZIP archive has
					none). A newer version of the file unpacks it again.
				-->
				<property name="unpacked"
					type="tl.core:Boolean"
				/>
				<reference name="manufacturer"
					aggregate="true"
					inverse-reference="baggage"
					kind="backwards"
					type="Manufacturer"
				/>
			</attributes>
		</class>
		<class name="Catalog">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHCatalog"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.model.i18n:I18NString"
				/>
				<reference name="sections"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Catalog"
				/>
				<reference name="variants"
					kind="forwards"
					multiple="true"
					navigate="true"
					ordered="true"
					type="Variant"
				/>
			</attributes>
		</class>
		<class name="Manufacturer">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHManufacturer"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="id"
					type="tl.core:Integer"
				>
					<annotations>
						<!-- The KNX manufacturer ID; the external ID of a manufacturer created in the app is formed from it. -->
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> if($value != null
        and !$obj.container().get(`ehome.catalog:ManufacturerRoot#manufacturers`)
            .filter(m -> $m != $obj and $m.get(`ehome.catalog:Manufacturer#id`) == $value)
            .isEmpty(),
    #("Another manufacturer has the KNX ID {0}."@en, "Ein anderer Hersteller hat die KNX-ID {0}."@de).fill($value),
    null)]]></check>
							</constraint-by-expression>
						</constraints>
					</annotations>
				</property>
				<reference name="catalogs"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Catalog"
				/>
				<reference name="programs"
					composite="true"
					inverse-reference="manufacturer"
					kind="forwards"
					multiple="true"
					type="ehome.operational:Program"
				/>
				<reference name="products"
					composite="true"
					kind="forwards"
					multiple="true"
					navigate="true"
					type="Product"
				/>
				<!-- The files the manufacturer ships with its product data (ETS: Baggages, haumacher/ehome #154). -->
				<reference name="baggage"
					composite="true"
					inverse-reference="manufacturer"
					kind="forwards"
					multiple="true"
					type="Baggage"
				/>
			</attributes>
		</class>
		<class name="ManufacturerRoot">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<attributes>
				<reference name="manufacturers"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Manufacturer"
				/>
			</attributes>
		</class>
		<class name="Product">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHProduct"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="serialNumber"
					type="tl.core:String"
				/>
				<property name="versionNumber"
					type="tl.core:String"
				/>
				<reference name="variants"
					composite="true"
					inverse-reference="product"
					kind="forwards"
					multiple="true"
					type="Variant"
				/>
				<!-- The application programs the product runs (ETS: Hardware2Program); owned by the product. -->
				<reference name="programs"
					composite="true"
					inverse-reference="product"
					kind="forwards"
					multiple="true"
					type="ProgramAssignment"
				/>
			</attributes>
		</class>
		<class name="ProgramAssignment">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHProgramAssignment"/>
			</annotations>
			<attributes>
				<reference name="product"
					aggregate="true"
					inverse-reference="programs"
					kind="backwards"
					type="Product"
				/>
				<reference name="program"
					kind="forwards"
					type="ehome.operational:Program"
				>
					<annotations>
						<!-- Only the programs of the manufacturer of the product (in a create dialog: of the variant the assignment is created for). -->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> {
    context = $self.container();
    product = $self.get(`ehome.catalog:ProgramAssignment#product`)
        || if($context.instanceOf(`ehome.catalog:Variant`), $context.get(`ehome.catalog:Variant#product`), null);
    $product.container().get(`ehome.catalog:Manufacturer#programs`)
}]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<property name="name"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[a -> $a.get(`ehome.catalog:ProgramAssignment#program`).get(`ehome.operational:Program#name`).localize()]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="Variant">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHProduct"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.model.i18n:I18NString"
				/>
				<property name="orderNumber"
					type="tl.core:String"
				/>
				<!-- The files of the manufacturer's baggage the product names (ETS: Product/Baggages, a driver installer for instance). -->
				<reference name="baggage"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="Baggage"
				/>
				<reference name="product"
					aggregate="true"
					inverse-reference="variants"
					kind="backwards"
					type="Product"
				/>
			</attributes>
		</class>
	</module>
</model>