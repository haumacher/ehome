<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.physical">
		<enum name="ConnectionType">
			<classifier name="send"/>
			<classifier name="receive"/>
		</enum>
		<!-- The parts of a device configuration ETS downloads into the device. -->
		<enum name="DownloadPart">
			<classifier name="IndividualAddress"/>
			<classifier name="ApplicationProgram"/>
			<classifier name="Parameters"/>
			<classifier name="GroupAddresses"/>
			<classifier name="MediumConfig"/>
		</enum>
		<!--
			What the configuration of a device is compared with: the defaults of its program, or what the
			device holds since its last download.
		-->
		<enum name="ChangeReference">
			<classifier name="default"/>
			<classifier name="device"/>
		</enum>
		<enum name="Priority">
			<classifier name="Low"/>
			<classifier name="High"/>
			<classifier name="Alert"/>
		</enum>
		<class name="Area">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHLine"/>
				<instance-presentation icon="css:fa-solid fa-lock"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="address"
					type="tl.core:Integer"
				/>
				<reference name="lines"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Line"
				/>
			</attributes>
		</class>
		<class name="Connection">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHConnection"/>
				<instance-presentation icon="css:fa-solid fa-link"/>
				<id-column value="name"/>
			</annotations>
			<attributes>
				<!-- The label: the group address as the app displays it, and whether the object sends to it or receives from it. -->
				<property name="name"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[x -> "{0} ({1})".fill(
    $x.get(`ehome.physical:Connection#target`).get(`ehome.logical:GroupAddress#displayName`),
    $x.get(`ehome.physical:Connection#kind`).label())]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<reference name="kind"
					kind="forwards"
					mandatory="true"
					type="ConnectionType"
				/>
				<reference name="target"
					kind="forwards"
					mandatory="true"
					type="ehome.logical:GroupAddress"
				/>
				<property name="acknowledge"
					type="tl.core:Boolean"
				/>
			</attributes>
		</class>
		<class name="Connector">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHConnector"/>
				<instance-presentation icon="css:fa-solid fa-plug"/>
				<id-column value="displayName"/>
			</annotations>
			<attributes>
				<!--
					The label (haumacher/ehome #62): the number of the communication object, its text and function in
					this device (else the program's), and the description entered in the project, as ETS lists the
					objects of a device: "7 Kanal A: Status (KanalAStatus)".
					A placeholder {{0}} in the program's text is filled with the device's value of the text
					parameter of the object (haumacher/ehome #119): "Kanal B: {{0}}" with the value "WZ" is
					"Kanal B: WZ"; with an empty value (or without a text parameter) the placeholder is left
					out, {{0:default}} gives its default.
				-->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> {
    placed = connectorPort($c);
    port = $placed.get(`ehome.operational:Interface#port`);
    textParameter = $placed.get(`ehome.operational:Interface#textParameter`);
    text = $c.get(`ehome.physical:Connector#text`)
        || fillTextParameter($placed.get(`ehome.operational:Interface#displayName`),
            if($textParameter == null, null, deviceValue($c.container(), $textParameter)));
    function = $c.get(`ehome.physical:Connector#function`)
        || $placed.get(`ehome.operational:Interface#function`).localize()
        || $port.get(`ehome.operational:Port#function`).localize();
    description = $c.get(`ehome.physical:Connector#description`);
    label = if($placed == null,
        #("{0}: communication object the import did not find in the application program (e.g. of a dynamic module)"@en,
          "{0}: Kommunikationsobjekt, das der Import im Applikationsprogramm nicht gefunden hat (z.B. eines dynamischen Moduls)"@de)
            .fill($c.container()).localize(),
        if($function == null, "{0} {1}".fill($port.get(`ehome.operational:Port#index`), $text),
            "{0} {1}: {2}".fill($port.get(`ehome.operational:Port#index`), $text, $function)));
    if($description == null, $label, "{0} ({1})".fill($label, $description))
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<reference name="port"
					kind="forwards"
					mandatory="true"
					type="ehome.operational:Interface"
				/>
				<!--
					Of an object of a dynamic module (haumacher/ehome #119): the module instance of the device
					whose object it is; port names the reference of the module definition (the template).
				-->
				<reference name="instance"
					kind="forwards"
					type="ModuleInstance"
				/>
				<!-- The text of the communication object in this device, if it differs from the program's (ETS: Text). -->
				<property name="text"
					type="tl.core:String"
				/>
				<!-- A description entered in the project (ETS: Description). -->
				<property name="description"
					type="tl.core:String"
				/>
				<property name="function"
					type="tl.core:String"
				/>
				<!-- Whether the communication object is in use under the current parameter values. -->
				<property name="active"
					type="tl.core:Boolean"
				/>
				<reference name="datapointTypes"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.datapoint:DatapointType"
				/>
				<!--
					The datapoint type the template of the device's program gives the object, else the
					manufacturer's (the placement's, else the program object's): what the object has unless a
					type is entered in the project (haumacher/ehome #103, ehome.template). Computed by
					de.haumacher.ehome.template.ObjectTypes, the one place of the chain.
				-->
				<reference name="inheritedDatapointTypes"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.datapoint:DatapointType"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> placementInheritedTypes(connectorPort($c))]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
				<!--
					The datapoint type of the object in this device: the one entered in the project
					(datapointTypes, read from and written to the project file), else the inherited one. The
					field edits the project's type and shows the inherited one greyed while it is empty; the
					choice offers the types of the object's size.
				-->
				<reference name="effectiveDatapointTypes"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.datapoint:DatapointType"
				>
					<annotations>
						<storage-algorithm>
							<fallback-storage
								fallback-attribute="inheritedDatapointTypes"
								storage-attribute="datapointTypes"
							/>
						</storage-algorithm>
						<options>
							<options-by-expression>
								<function><![CDATA[self -> placementTypeChoices(connectorPort($self))]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!--
					The datapoint type the values of this communication object have: the first of
					effectiveDatapointTypes (de.haumacher.ehome.template.ObjectTypes#effective).
				-->
				<reference name="effectiveDatapointType"
					kind="forwards"
					type="ehome.datapoint:DatapointType"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> connectorDatapointType($c)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
				<reference name="priority"
					kind="forwards"
					type="Priority"
				/>
				<reference name="canRead"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="canWrite"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="communication"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="transmission"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="update"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="readOnInit"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="connections"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Connection"
				/>
			</attributes>
		</class>
		<class name="Device">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHDevice"/>
				<instance-presentation icon="css:fa-solid fa-mobile-screen-button"/>
				<!-- A device that needs a download is marked like ETS does. -->
				<dynamic-icon>
					<icon-by-expression>
						<icon><![CDATA[d -> if($d.get(`ehome.physical:Device#downloadPending`),
    "css:fa-solid fa-mobile-screen-button ehomeDownloadPending",
    null)]]></icon>
					</icon-by-expression>
				</dynamic-icon>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[d -> $d.get(`ehome.physical:Device#title`) || "{0} ({1})".fill(
    $d.get(`ehome.physical:Device#type`).label(),
    $d.get(`ehome.physical:Device#address`).label()
)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- The name the user gave the device; without one, the device is named by type and address. -->
				<property name="title"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.core:Text"
				/>
				<property name="installationHints"
					type="tl.core:Text"
				/>
				<!-- The serial number of the real device, as read from the bus. -->
				<property name="serialNumber"
					type="tl.core:String"
				/>
				<!--
					The serial number as KNX writes it, manufacturer and number in hex ("000A:2A4A2711"); the
					stored serialNumber is in the form of ETS's project (Base64, haumacher/ehome #120).
				-->
				<property name="serialText"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[d -> serialNumberText($d.get(`ehome.physical:Device#serialNumber`))]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<property name="lastModified"
					type="tl.core:DateTime"
				/>
				<property name="lastDownload"
					type="tl.core:DateTime"
				/>
				<!--
					The revision of the project data the last full download was computed from: the device's
					state in it is what the real device holds (de.haumacher.ehome.programming.DeviceChanges).
				-->
				<property name="downloadRevision"
					type="tl.core:Long"
				/>
				<!-- The parts of the configuration that are in the real device. -->
				<reference name="loaded"
					kind="forwards"
					multiple="true"
					type="DownloadPart"
				/>
				<!-- Whether the real device needs a download: a part is missing or the configuration changed since. -->
				<property name="downloadPending"
					type="tl.core:Boolean"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[d -> {
    modified = $d.get(`ehome.physical:Device#lastModified`);
    download = $d.get(`ehome.physical:Device#lastDownload`);
    $d.get(`ehome.physical:Device#loaded`).size() < 5
        or $download == null
        or ($modified != null and $modified > $download)
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<property name="address"
					type="tl.core:Integer"
				/>
				<reference name="type"
					kind="forwards"
					mandatory="true"
					type="ehome.catalog:Variant"
				/>
				<reference name="program"
					kind="forwards"
					mandatory="true"
					type="ehome.catalog:ProgramAssignment"
				>
					<annotations>
						<!--
							Only the programs of the device's product (its hardware): a program of another product does not
							run on the device (haumacher/ehome #121).
						-->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> $self.get(`ehome.physical:Device#type`).container()
    .get(`ehome.catalog:Product#programs`)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<reference name="location"
					kind="forwards"
					type="ehome.building:BuildingDefinition"
				/>
				<!-- The parameter values set in the project; all others have their default. -->
				<reference name="settings"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ParameterSetting"
				/>
				<reference name="connectors"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Connector"
				/>
				<!--
					The instances of the dynamic modules of the device's program (haumacher/ehome #119), as
					E-Home computes them from the program and the device's values (in effect: active), and
					those a change of a value removed (inactive), which keep their settings and connectors
					until they are in effect again.
				-->
				<reference name="moduleInstances"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ModuleInstance"
				/>
				<!--
					What the project says per channel of the device's program (ETS 6: ChannelInstances,
					haumacher/ehome #122): the description the user gave a channel and whether it is active.
				-->
				<reference name="channelInstances"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ChannelInstance"
				/>
			</attributes>
		</class>
		<!--
			A channel of the program in a device (ETS 6: ChannelInstance, haumacher/ehome #122): the description
			the user entered and whether the channel is active. The parameter editor shows the description beside
			the channel's title (de.haumacher.ehome.programming.DeviceTexts).
		-->
		<class name="ChannelInstance">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-diagram-3"/>
			</annotations>
			<attributes>
				<!--
					The ETS ID of the channel in the device (ETS: RefId, relative to the program: CH-4, of a
					module instance's channel MD-1_M-1_MI-1_CH-1). An ID, not a reference: a channel of a module
					instance exists only in the instance E-Home computes from the device's values.
				-->
				<property name="channel"
					mandatory="true"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.core:String"
				/>
				<property name="active"
					type="tl.core:Boolean"
				/>
			</attributes>
		</class>
		<class name="Line">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHLine"/>
				<instance-presentation icon="colored:tl-icon network-small"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="address"
					type="tl.core:Integer"
				/>
				<reference name="devices"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Device"
				/>
			</attributes>
		</class>
		<!--
			An instance of a dynamic module in a device (haumacher/ehome #119, ETS: ModuleInstance): E-Home
			computes it from the device's program and values (de.haumacher.ehome.modules.ModuleInstances)
			for each placement in effect, in the order of the structure, and stores the placement, the
			repeat index and the argument values. The settings and connectors of the module's parameters
			and objects name it.
		-->
		<class name="ModuleInstance">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-box"/>
				<id-column value="displayName"/>
			</annotations>
			<attributes>
				<!-- The ID ETS gives the instance, relative to the program: MD-1_M-1_MI-1, MD-1_M-1_MI-1_SM-1_M-1_MI-2 for a sub-module. -->
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				/>
				<reference name="placement"
					kind="forwards"
					mandatory="true"
					type="ehome.operational:ModulePlacement"
				/>
				<!-- The instance of the enclosing module of a sub-module's instance. -->
				<reference name="parent"
					kind="forwards"
					type="ModuleInstance"
				/>
				<!-- Per enclosing Repeat: its position in the program's document and the iteration, as in "37x2 41x1" (ETS: RepeatIndex). -->
				<property name="repeatIndex"
					type="tl.core:String"
				/>
				<!-- Whether the instance is in effect under the device's current values. -->
				<property name="active"
					type="tl.core:Boolean"
				/>
				<reference name="arguments"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="InstanceArgument"
				/>
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[i -> "{0} ({1})".fill(
    $i.get(`ehome.physical:ModuleInstance#placement`).get(`ehome.operational:ModulePlacement#displayName`),
    $i.get(`ehome.physical:ModuleInstance#name`))]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<!--
			The value of an argument in a module instance of a device, as E-Home computes it. Where the
			project file an import read gave another value (the device's memory was written with that
			layout), the difference is recorded in deviceValue until a full download the user confirms
			writes E-Home's layout (haumacher/ehome #119).
		-->
		<class name="InstanceArgument">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<attributes>
				<reference name="argument"
					kind="forwards"
					mandatory="true"
					type="ehome.operational:ModuleArgument"
				/>
				<property name="value"
					type="tl.core:String"
				/>
				<!-- The value of the imported project file where it differs from value; empty without a difference. -->
				<property name="deviceValue"
					type="tl.core:String"
				/>
			</attributes>
		</class>
		<!--
			A parameter value of a device that differs from the default of its application program. The
			value is typed like every parameter value (ehome.operational:ParameterValue).
		-->
		<class name="ParameterSetting">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
				<generalization type="ehome.operational:ParameterValue"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-sliders"/>
			</annotations>
			<attributes>
				<reference name="parameter"
					kind="forwards"
					mandatory="true"
					type="ehome.operational:ParameterView"
				/>
				<!--
					Of a parameter of a dynamic module (haumacher/ehome #119): the module instance of the
					device whose parameter it sets; parameter names the reference of the module definition
					(the template).
				-->
				<reference name="instance"
					kind="forwards"
					type="ModuleInstance"
				/>
				<property name="name"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[s -> {
    parameter = settingParameter($s);
    if($parameter == null,
        #("{0}: setting of a parameter the import did not find in the application program (e.g. of a dynamic module)"@en,
          "{0}: Einstellung eines Parameters, den der Import im Applikationsprogramm nicht gefunden hat (z.B. eines dynamischen Moduls)"@de)
            .fill($s.container()).localize(),
        $parameter.get(`ehome.operational:ParameterView#title`))
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- The default in effect where the program places the parameter. -->
				<property name="displayDefault"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[s -> settingParameter($s).get(`ehome.operational:ParameterView#displayDefault`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
	</module>
</model>