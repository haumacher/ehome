<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.project">
		<class name="Project">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHProject"/>
				<instance-presentation icon="colored:tl-icon structure"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<reference name="areas"
					composite="true"
					kind="forwards"
					multiple="true"
					type="ehome.physical:Area"
				/>
				<!-- Devices of the project not placed in a line yet. -->
				<reference name="unassignedDevices"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.physical:Device"
				/>
				<!-- The Zigbee devices of the project, imported from the export of a controller (haumacher/ehome #40). -->
				<reference name="zigbeeDevices"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.zigbee:ZigbeeDevice"
				/>
				<!-- The buildings in their order: the order of the ETS project, then as the user arranges them (haumacher/ehome #71). -->
				<reference name="buildings"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.building:BuildingDefinition"
				/>
				<reference name="groupAddresses"
					composite="true"
					kind="forwards"
					multiple="true"
					type="ehome.logical:GroupAddressDefinition"
				/>
				<!-- The notation of the project's group addresses, as chosen in ETS. -->
				<reference name="groupAddressStyle"
					type="ehome.logical:GroupAddressStyle"
				/>
				<!--
					The KNXnet/IP gateway the devices of the project are programmed and read through: an
					address, optionally with the port (192.168.178.81 or 192.168.178.81:3671).
				-->
				<property name="gateway"
					type="tl.core:String"
				/>
				<!-- The recordings of the group monitor (haumacher/ehome #10). -->
				<reference name="recordings"
					composite="true"
					kind="forwards"
					multiple="true"
					type="ehome.monitor:Recording"
				/>
				<!--
					Devices a scan of the installation found that the catalog could not identify (their
					program or manufacturer is missing); matched again after an import of product data.
				-->
				<reference name="unidentifiedDevices"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="UnidentifiedDevice"
				/>
				<!--
					The HomeControl controller the runtime image of the project is deployed to (haumacher/ehome #39):
					one of the project's own controllers or a controller on the LAN (one no project holds,
					haumacher/ehome #69), never an enrollment of another project.
				-->
				<reference name="controller"
					kind="forwards"
					type="ehome.runtime:Controller"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[p -> $p.get(`ehome.project:Project#controllers`)
    .union(all(`ehome.runtime:Controller`).filter(c -> $c.container() == null))]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!--
					The controllers enrolled for the project with an enrollment code (haumacher/ehome #54); they
					connect to E-Home by themselves. Forgetting one deletes it.
				-->
				<reference name="controllers"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.runtime:Controller"
				/>
				<!--
					The open enrollment code of the project (ABCD-EFGH, one use, de.haumacher.ehome.connection.Enrollment):
					a controller presenting it before it expires is enrolled for the project. Readable only by
					installers (ehome.security.config.xml).
				-->
				<property name="enrollmentCode"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<!-- When the open enrollment code expires. -->
				<property name="enrollmentExpires"
					type="tl.core:DateTime"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<!-- Who created the open enrollment code. -->
				<reference name="enrollmentCreatedBy"
					kind="forwards"
					type="tl.accounts:Person"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</reference>
				<!--
					The installation key of the project (homecontrol issue #35, de.haumacher.ehome.connection.InstallationKeys):
					the private key of its Ed25519 key pair, as the 32-byte seed in 64 hex digits, generated by
					E-Home at the enrollment of the project's first controller or on demand. Every runtime image
					deployed or exported is signed with it; it never leaves E-Home and is read by nobody but an
					administrator (ehome.security.config.xml). Empty: the project deploys unsigned.
				-->
				<property name="installationKey"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<!-- The public key of the installation key (64 hex digits), sent to the controllers at the enrollment. -->
				<property name="installationPublicKey"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<!--
					The new installation key of a rotation (its seed, 64 hex digits): offered to the controllers,
					it replaces the installation key once no controller of the project holds the old one any more;
					until then images are signed with the key each controller holds. Read by nobody but an
					administrator.
				-->
				<property name="newInstallationKey"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<!-- The public key of the new installation key of a rotation. -->
				<property name="newInstallationPublicKey"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<!-- The revision of the runtime image last loaded by a controller; the next deployment carries the next one. -->
				<property name="imageRevision"
					type="tl.core:Long"
				>
					<annotations>
						<format>
							<decimal pattern="0" result-type="long"/>
						</format>
					</annotations>
				</property>
				<!-- What the inhabitant operates: the functions of the runtime image (haumacher/ehome #43). -->
				<reference name="functions"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.runtime:Function"
				/>
				<!-- The control pages of the controller's user interface (haumacher/ehome #72), in the order of its navigation; none: the controller's generated room overview. -->
				<reference name="pages"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.runtime:Page"
				/>
				<!-- The rules of the runtime image (haumacher/ehome #57), ordered by their attribute order. -->
				<reference name="rules"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.runtime:Rule"
				/>
				<!-- The entries of the schedule of the runtime image (haumacher/ehome #57), in the image order. -->
				<reference name="schedules"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.runtime:ScheduleEntry"
				/>
				<!--
					The datapoints of the runtime image owned by no technology (haumacher/ehome #59): values
					of the application and the outputs of schedule entries, after the group addresses' ones.
				-->
				<reference name="applicationDatapoints"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.runtime:ApplicationDatapoint"
				/>
				<!-- In the simulation: which object of a device follows which (haumacher/ehome #62). -->
				<reference name="simulationFollowers"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.runtime:ObjectFollower"
				/>
				<!-- The proposed functions the user deleted, which the proposal does not bring back (haumacher/ehome #49). -->
				<reference name="dismissedProposals"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.runtime:DismissedProposal"
				/>
				<!--
					The time zone of the controller as POSIX TZ string, e.g. CET-1CEST,M3.5.0,M10.5.0/3 for
					Central Europe; empty: the controller keeps its own.
				-->
				<property name="timeZone"
					type="tl.core:String"
				>
					<annotations>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> runtimeTimeZoneProblem($value)]]></check>
							</constraint-by-expression>
						</constraints>
					</annotations>
				</property>
				<!-- The latitude of the installation in degrees (north positive), for the sun times of astronomical schedules. -->
				<property name="latitude"
					type="tl.core:Double"
				>
					<annotations>
						<!-- Up to six decimals (about 0.1 m): the default format would round to two. -->
						<format>
							<decimal pattern="0.0#####" result-type="double"/>
						</format>
						<value-range
							max="90.0"
							min="-90.0"
						/>
					</annotations>
				</property>
				<!-- The longitude of the installation in degrees (east positive), for the sun times of astronomical schedules. -->
				<property name="longitude"
					type="tl.core:Double"
				>
					<annotations>
						<!-- Up to six decimals (about 0.1 m): the default format would round to two. -->
						<format>
							<decimal pattern="0.0#####" result-type="double"/>
						</format>
						<value-range
							max="180.0"
							min="-180.0"
						/>
					</annotations>
				</property>
				<!-- The elevation of the installation in metres. -->
				<property name="elevation"
					type="tl.core:Integer"
				>
					<annotations>
						<value-range
							max="9000"
							min="-500"
						/>
					</annotations>
				</property>
				<!-- The host name of the NTP server the controller synchronizes its clock with; empty: the controller keeps its own. -->
				<property name="ntpServer"
					type="tl.core:String"
				>
					<annotations>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> runtimeHostNameProblem($value)]]></check>
							</constraint-by-expression>
						</constraints>
					</annotations>
				</property>
				<!-- The group address the controller sends the time of day on as KNX time master (DPT 10.001). -->
				<reference name="timeMasterTime"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> runtimeTimeMasterProblem($value, $obj, 'timeMasterTime')]]></check>
							</constraint-by-expression>
						</constraints>
						<options>
							<options-by-expression>
								<function><![CDATA[p -> runtimeGroupAddresses($p)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!-- The group address the controller sends the date on as KNX time master (DPT 11.001). -->
				<reference name="timeMasterDate"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> runtimeTimeMasterProblem($value, $obj, 'timeMasterDate')]]></check>
							</constraint-by-expression>
						</constraints>
						<options>
							<options-by-expression>
								<function><![CDATA[p -> runtimeGroupAddresses($p)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!-- The group address the controller sends date and time on as KNX time master (DPT 19.001). -->
				<reference name="timeMasterDateTime"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> runtimeTimeMasterProblem($value, $obj, 'timeMasterDateTime')]]></check>
							</constraint-by-expression>
						</constraints>
						<options>
							<options-by-expression>
								<function><![CDATA[p -> runtimeGroupAddresses($p)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!-- The period of the time master's broadcasts in seconds (60 to 86400); empty: 600. -->
				<property name="timeMasterInterval"
					type="tl.core:Integer"
				>
					<annotations>
						<format>
							<decimal pattern="0" result-type="long"/>
						</format>
						<value-range
							max="86400"
							min="60"
						/>
					</annotations>
				</property>
				<!-- Whether the time master also sends right after local midnight; empty: yes. -->
				<property name="timeMasterAtMidnight"
					type="tl.core:Tristate"
				/>
				<!-- Whether the time master also sends when the controller's clock becomes synchronized; empty: yes. -->
				<property name="timeMasterOnSynchronized"
					type="tl.core:Tristate"
				/>
				<!-- The memory in bytes the histories of the datapoints (raw rings and archives) may use on the controller (at most 65536); empty: what they need. -->
				<property name="historyBudget"
					type="tl.core:Integer"
				>
					<annotations>
						<format>
							<decimal pattern="0" result-type="long"/>
						</format>
						<value-range
							max="65536"
							min="0"
						/>
					</annotations>
				</property>
				<!-- The bytes the histories of the datapoints take against the budget and the device's cap (haumacher/ehome #73). -->
				<property name="historyUsage"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[p -> runtimeHistoryUsage($p)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- The deployments of the runtime image, newest first. -->
				<reference name="deployments"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.runtime:Deployment"
				/>
			</attributes>
		</class>
		<!--
			A device found on the bus by a scan of the installation (de.haumacher.ehome.scan) that no
			application program of the catalog matches: what it told about itself.
		-->
		<class name="UnidentifiedDevice">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-question-circle"/>
			</annotations>
			<attributes>
				<!-- The individual address as text (1.3.5). -->
				<property name="name"
					type="tl.core:String"
				/>
				<!-- The individual address: area, line and device number in 4, 4 and 8 bits. -->
				<property name="address"
					type="tl.core:Integer"
				/>
				<!-- The device descriptor (mask version) as hex digits. -->
				<property name="descriptor"
					type="tl.core:String"
				/>
				<property name="manufacturerId"
					type="tl.core:Integer"
				/>
				<!-- The serial number as hex digits. -->
				<property name="serialNumber"
					type="tl.core:String"
				/>
				<!-- Manufacturer, application number and version (5 bytes) as hex digits. -->
				<property name="programVersion"
					type="tl.core:String"
				/>
				<!-- The hardware type (device object, property 78) as hex digits. -->
				<property name="hardwareType"
					type="tl.core:String"
				/>
				<property name="orderInfo"
					type="tl.core:String"
				/>
				<!-- Why the catalog does not identify the device. -->
				<property name="reason"
					type="tl.core:String"
				/>
				<property name="lastSeen"
					type="tl.core:DateTime"
				/>
			</attributes>
		</class>
	</module>
</model>