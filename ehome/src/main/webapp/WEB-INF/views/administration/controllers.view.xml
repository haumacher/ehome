<?xml version="1.0" encoding="utf-8" ?>

<!--
	The HomeControl controllers without a project, for the E-Home administrators (haumacher/ehome #151,
	#165): an item of the group "E-Home administration" of the sidebar (app.view.xml), withheld from
	everybody else. Every controller is a part of exactly one project and is created, changed and
	forgotten in the project's tab "Controllers" (projects/controllers.view.xml); only a controller
	without a project needs an E-Home administrator.

	Such a controller is left only by the migration of existing data
	(de.haumacher.ehome.connection.ControllerOwnershipMigration: one no project deployed to). Its access
	parent is the group of the E-Home administrators (ehome.security.config.xml): they read it, nobody
	else does. "Assign to project" makes it one of a project's controllers
	(controllers/assign-controller.view.xml, controllerAssign), "Delete" forgets it (ForgetControllerAction).

	The list is one query of the database (controllersWithoutProject, haumacher/ehome #167): the
	controllers no project holds in its composition "controllers"; it loads only those, no project
	and no controller of a project. It runs only while an E-Home administrator shows the page;
	a list of the controllers of all projects is not offered: the controllers of a project are the
	project's business, shown in its tab.
-->
<view>
	<channels>
		<channel name="controller"/>
	</channels>
	<panel>
		<title>
			<en>HomeControl controllers without a project</en>
			<de>HomeControl-Controller ohne Projekt</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-box-arrow-in-right"
				inputs="controller"
				placement="TOOLBAR"
			>
				<label>
					<en>Assign to project</en>
					<de>Einem Projekt zuordnen</de>
				</label>
				<tooltip>
					<en>Makes the controller, which belongs to no project, one of the controllers of the project chosen.</en>
					<de>Macht den Controller, der zu keinem Projekt gehört, zu einem Controller des gewählten Projekts.</de>
				</tooltip>
				<access>
					<operation name="EHomeAdministration"/>
					<operation name="Read"
						object="$controller"
						type="ehome.runtime:Controller"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<!-- A controller of a project is managed in the project's tab Controllers. -->
					<disabled-if expr="if($controller.container() == null, null, #('The controller belongs to the project {0}; it is managed in the tab Controllers of the project.'@en, 'Der Controller gehört zum Projekt {0}; er wird im Reiter „Controller“ des Projekts verwaltet.'@de).fill($controller.container().get(`ehome.project:Project#name`)))"/>
				</executability>
				<open-dialog
					bind-input-to="controller"
					dialog-view="controllers/assign-controller.view.xml"
				/>
			</generic-command>
			<generic-command
				image="css:bi bi-trash"
				inputs="controller"
				placement="TOOLBAR"
			>
				<label>
					<en>Delete</en>
					<de>Löschen</de>
				</label>
				<access>
					<operation name="EHomeAdministration"/>
					<operation name="Read"
						object="$controller"
						type="ehome.runtime:Controller"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<!-- A controller of a project is managed in the project's tab Controllers. -->
					<disabled-if expr="if($controller.container() == null, null, #('The controller belongs to the project {0}; it is managed in the tab Controllers of the project.'@en, 'Der Controller gehört zum Projekt {0}; er wird im Reiter „Controller“ des Projekts verwaltet.'@de).fill($controller.container().get(`ehome.project:Project#name`)))"/>
				</executability>
				<confirm expr="forgetConfirmation($controller)"/>
				<forget-controller>
					<with-result>
						<notify
							expr="$result"
							kind="info"
						/>
					</with-result>
				</forget-controller>
			</generic-command>
		</commands>
		<table
			observed-types="ehome.runtime:Controller"
			selection="controller"
			types="ehome.runtime:Controller"
		>
			<columns>
				<column attribute="name"/>
				<column attribute="host"/>
				<column attribute="port"/>
				<computed-column name="connection"
					type="tl.core:String"
				>
					<label>
						<en>Connection</en>
						<de>Verbindung</de>
					</label>
					<value>controllerConnection($row)</value>
				</computed-column>
				<column attribute="lastContact"/>
				<column attribute="firmwareVersion"/>
				<computed-column name="token"
					type="tl.core:String"
				>
					<label>
						<en>Token</en>
						<de>Token</de>
					</label>
					<value>controllerTokenHint($row)</value>
				</computed-column>
			</columns>
			<rows>controllersWithoutProject()</rows>
		</table>
	</panel>
</view>
