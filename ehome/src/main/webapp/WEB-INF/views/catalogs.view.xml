<?xml version="1.0" encoding="utf-8" ?>

<!--
	The product catalogs: manufacturers, their catalogs with sections, and the product variants listed
	in a catalog, and below a variant the application programs of its product. The application
	programs of a manufacturer are also listed below the manufacturer; an application program is shown
	with its structure, parameters, communication objects and types (catalogs/program.view.xml). A
	variant is referenced by its catalog, not contained in it, so the tree finds the catalog of a
	variant through that reference.

	The ETS import creates every manufacturer of the KNX master data. Only those with catalogs,
	products or application programs are shown; a manufacturer just created is shown in the details
	until it has one of them.

	The catalog is filled by importing the product file of a manufacturer (.knxprod, the format of
	the ETS catalog import; ImportProductDataAction) or an ETS project (projects/overview.view.xml).
	The product import always shows its report (projects/import-report.view.xml), naming the
	manufacturer, products and application programs imported or already known, and selects the
	manufacturer of the file.

	Everything the tree shows is created here: a manufacturer, a catalog, a section, an application
	program, a product with its first variant (in a catalog), a further variant of a product, and the
	assignment of an application program to the product of a variant. Every object gets an external
	ID in the manner of ETS when it is created (de.haumacher.ehome.knx.ExtIds).

	The detail pane shows the selected node in a form matching its type.
-->
<view>
	<channels>
		<channel name="selected"/>
		<derived-channel name="root"
			expr="`ehome.catalog#ROOT`"
			inputs="selected"
		/>
		<derived-channel name="selectedManufacturer"
			expr="if($selected.instanceOf(`ehome.catalog:Manufacturer`), $selected, null)"
			inputs="selected"
		/>
		<derived-channel name="selectedProgram"
			expr="switch {
    $selected.instanceOf(`ehome.operational:Program`): $selected;
    $selected.instanceOf(`ehome.catalog:ProgramAssignment`): $selected.get(`ehome.catalog:ProgramAssignment#program`);
    default: null;
}"
			inputs="selected"
		/>
		<derived-channel name="selectedCatalog"
			expr="if($selected.instanceOf(`ehome.catalog:Catalog`), $selected, null)"
			inputs="selected"
		/>
		<derived-channel name="selectedVariant"
			expr="if($selected.instanceOf(`ehome.catalog:Variant`), $selected, null)"
			inputs="selected"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="240"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Catalogs</en>
						<de>Kataloge</de>
					</title>
					<commands>
						<upload-command
							accept=".knxprod"
							image="css:fa-solid fa-upload"
							inputs="root"
							placement="TOOLBAR"
						>
							<label>
								<en>Import product data</en>
								<de>Produktdaten importieren</de>
							</label>
							<access>
								<!--
									An import adds manufacturers, catalogs and programs: a write of the
									manufacturers. (A type-level check of the creation of a product, a
									composition part, is no check at all: see doc/tl-todo.md.)
								-->
								<operation name="Write"
									object="$root"
									type="ehome.catalog:ManufacturerRoot"
								/>
							</access>
							<import-product-data>
								<with-result as="report">
									<open-dialog
										bind-input-to="report"
										dialog-view="projects/import-report.view.xml"
									/>
									<execute-script function='$report["manufacturer"]'>
										<with-result>
											<write-channel name="selected"/>
										</with-result>
									</execute-script>
								</with-result>
							</import-product-data>
						</upload-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-industry"
							inputs="root"
							placement="TOOLBAR"
						>
							<label>
								<en>Manufacturer</en>
								<de>Hersteller</de>
							</label>
							<access>
								<operation name="Write"
									object="$root"
									type="ehome.catalog:ManufacturerRoot"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.catalog:Manufacturer">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="root"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-journal-plus"
							inputs="selectedManufacturer"
							placement="TOOLBAR"
						>
							<label>
								<en>Catalog</en>
								<de>Katalog</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedManufacturer"
									type="ehome.catalog:Manufacturer"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.catalog:Catalog">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="selectedManufacturer"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-journal-text"
							inputs="selectedCatalog"
							placement="TOOLBAR"
						>
							<label>
								<en>Section</en>
								<de>Abschnitt</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedCatalog"
									type="ehome.catalog:Catalog"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.catalog:Catalog">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="selectedCatalog"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-cpu"
							inputs="selectedManufacturer"
							placement="TOOLBAR"
						>
							<label>
								<en>Application program</en>
								<de>Applikationsprogramm</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedManufacturer"
									type="ehome.catalog:Manufacturer"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.operational:Program">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="selectedManufacturer"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-box-seam"
							inputs="selectedCatalog"
							placement="TOOLBAR"
						>
							<label>
								<en>Product</en>
								<de>Produkt</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedCatalog"
									type="ehome.catalog:Catalog"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient
								container="selectedCatalog"
								type="ehome.catalog:Variant">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="catalogs/create-variant.view.xml"
									>
										<bind
											channel="container"
											to="selectedCatalog"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-boxes"
							inputs="selectedVariant"
							placement="TOOLBAR"
						>
							<label>
								<en>Variant</en>
								<de>Variante</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedVariant"
									type="ehome.catalog:Variant"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient
								container="selectedVariant"
								type="ehome.catalog:Variant">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="catalogs/create-variant.view.xml"
									>
										<bind
											channel="container"
											to="selectedVariant"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-link-45deg"
							inputs="selectedVariant"
							placement="TOOLBAR"
						>
							<label>
								<en>Program assignment</en>
								<de>Programmzuweisung</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedVariant"
									type="ehome.catalog:Variant"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient
								container="selectedVariant"
								type="ehome.catalog:ProgramAssignment">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="selectedVariant"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="selected"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Delete {0}?'@en, '{0} löschen?'@de).fill($selected.label())"/>
							<delete-object/>
							<write-channel name="selected" clear="true"/>
						</generic-command>
					</commands>
					<!-- The catalogs with the columns of the classic tree grid (exported to Excel as an outline). -->
					<tree-table
						observed-types="ehome.catalog:Manufacturer,ehome.catalog:Catalog,ehome.catalog:Product,ehome.catalog:Variant,ehome.catalog:ProgramAssignment,ehome.operational:Program"
						selection="selected"
					>
						<root>`ehome.catalog#ROOT`</root>
						<children><![CDATA[switch {
    $node.instanceOf(`ehome.catalog:ManufacturerRoot`):
        $node.get(`ehome.catalog:ManufacturerRoot#manufacturers`)
            .filter(m -> !$m.get(`ehome.catalog:Manufacturer#catalogs`).isEmpty()
                or !$m.get(`ehome.catalog:Manufacturer#products`).isEmpty()
                or !$m.get(`ehome.catalog:Manufacturer#programs`).isEmpty());
    $node.instanceOf(`ehome.catalog:Manufacturer`):
        concat(
            $node.get(`ehome.catalog:Manufacturer#catalogs`),
            $node.get(`ehome.catalog:Manufacturer#programs`));
    $node.instanceOf(`ehome.catalog:Catalog`):
        $node.get(`ehome.catalog:Catalog#sections`)
            .union($node.get(`ehome.catalog:Catalog#variants`));
    $node.instanceOf(`ehome.catalog:Variant`):
        $node.get(`ehome.catalog:Variant#product`).get(`ehome.catalog:Product#programs`);
    default: [];
}]]></children>
						<parents><![CDATA[switch {
    $node.instanceOf(`ehome.catalog:Variant`):
        $node.referers(`ehome.catalog:Catalog#variants`);
    $node.instanceOf(`ehome.catalog:ProgramAssignment`):
        $node.get(`ehome.catalog:ProgramAssignment#product`).get(`ehome.catalog:Product#variants`);
    default: $node.container();
}]]></parents>
						<export download-name="#('Catalogs'@en, 'Kataloge'@de)">
							<sheet-name>
								<en>Catalogs</en>
								<de>Kataloge</de>
							</sheet-name>
						</export>
						<columns>
							<computed-column name="name"
								width="300"
							>
								<label>
									<en>Name</en>
									<de>Name</de>
								</label>
								<value>$row</value>
								<display class="com.top_logic.layout.view.element.ResourceDisplayByExpression"/>
							</computed-column>
							<!-- The number of sections and of variants of a catalog. -->
							<computed-column name="sections"
								type="tl.core:Integer"
								width="100"
							>
								<label>
									<en>Sections</en>
									<de>Abschnitte</de>
								</label>
								<value>if($row.instanceOf(`ehome.catalog:Catalog`), $row.get(`ehome.catalog:Catalog#sections`).size(), null)</value>
							</computed-column>
							<computed-column name="variants"
								type="tl.core:Integer"
								width="100"
							>
								<label>
									<en>Variants</en>
									<de>Varianten</de>
								</label>
								<value>if($row.instanceOf(`ehome.catalog:Catalog`), $row.get(`ehome.catalog:Catalog#variants`).size(), null)</value>
							</computed-column>
							<computed-column name="extId"
								type="tl.core:String"
								width="200"
							>
								<label>
									<en>External ID</en>
									<de>Externe ID</de>
								</label>
								<value>if($row.instanceOf(`ehome.core:Externalized`), $row.get(`ehome.core:Externalized#extId`), null)</value>
							</computed-column>
						</columns>
					</tree-table>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<panel>
					<title>
						<en>Details</en>
						<de>Details</de>
					</title>
					<switch input="selected">
						<case test="$selected.instanceOf(`ehome.catalog:Manufacturer`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="id"/>
								<field attribute="extId"/>
							</form>
						</case>
						<case test="$selected.instanceOf(`ehome.catalog:Catalog`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="extId"/>
							</form>
						</case>
						<case test="$selected.instanceOf(`ehome.catalog:Variant`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="orderNumber"/>
								<field attribute="product"/>
								<field attribute="extId"/>
							</form>
						</case>
						<!-- An application program, also when reached as the program of a product. -->
						<case test="$selected.instanceOf(`ehome.operational:Program`) or $selected.instanceOf(`ehome.catalog:ProgramAssignment`)">
							<!--
								The assignment itself: which program the product runs, and its ID; the program
								is shown below it without an edit command of its own (one "Edit" per detail),
								it is edited where it is selected itself.
							-->
							<visible-if
								expr="$selected.instanceOf(`ehome.catalog:ProgramAssignment`)"
								input="selected"
							>
								<form
									input="selected"
									with-inset="true"
								>
									<field attribute="product"/>
									<field attribute="program"/>
									<field attribute="extId"/>
								</form>
								<form
									input="selectedProgram"
									with-inset="true"
									withEditMode="false"
								>
									<field attribute="name"/>
									<field attribute="extId"/>
								</form>
							</visible-if>
							<visible-if
								expr="$selected.instanceOf(`ehome.operational:Program`)"
								input="selected"
							>
								<form
									input="selectedProgram"
									with-inset="true"
								>
									<field attribute="name"/>
									<field attribute="extId"/>
								</form>
							</visible-if>
							<view-ref view="catalogs/program.view.xml">
								<bind
									channel="program"
									to="selectedProgram"
								/>
							</view-ref>
						</case>
					</switch>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
