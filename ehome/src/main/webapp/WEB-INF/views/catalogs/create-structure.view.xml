<?xml version="1.0" encoding="utf-8" ?>

<!--
	Create dialog for an element of the configuration structure of an application program: a
	channel, the channel independent part, a parameter block, a switch, a case, or a parameter or
	communication object placed in the structure.

	"model" carries the transient object of the type the opening command chose, created in the context
	of "anchor", the element selected in the structure tree (the program if nothing is selected). The
	new element goes into the anchor (at its end) if the anchor can contain an element of its kind,
	otherwise after it into the anchor's container (structureInsert without a position); from there,
	drag and drop in the structure tree (catalogs/program.view.xml) moves it to any other place. The
	created element is written to "selection", so that the tree selects it.

	The element is persisted without container and inserted in the same transaction, so that it is
	part of the structure when it is committed and gets its external ID from there.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="anchor"/>
		<channel name="selection"/>
	</channels>
	<window width="500px">
		<title>
			<en>New structure element</en>
			<de>Neues Strukturelement</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<visible-if
				expr="n -> $n.instanceOf(`ehome.operational:Channel`)"
				input="model"
			>
				<field attribute="number"/>
			</visible-if>
			<visible-if
				expr="n -> $n.instanceOf(`ehome.operational:Channel`) or $n.instanceOf(`ehome.operational:ParameterGroup`)"
				input="model"
			>
				<field attribute="name"/>
				<field attribute="description"/>
			</visible-if>
			<visible-if
				expr="n -> $n.instanceOf(`ehome.operational:ParameterGroup`) or $n.instanceOf(`ehome.operational:Switch`)"
				input="model"
			>
				<field attribute="input"/>
			</visible-if>
			<visible-if
				expr="n -> $n.instanceOf(`ehome.operational:Case`)"
				input="model"
			>
				<field attribute="pattern"/>
				<field attribute="isDefault"/>
			</visible-if>
			<visible-if
				expr="n -> $n.instanceOf(`ehome.operational:ParameterView`)"
				input="model"
			>
				<field attribute="parameter"/>
				<field attribute="description"/>
				<field attribute="access"/>
			</visible-if>
			<visible-if
				expr="n -> $n.instanceOf(`ehome.operational:Interface`)"
				input="model"
			>
				<field attribute="port"/>
				<field attribute="name"/>
				<field attribute="function"/>
			</visible-if>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					input="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Erstellen</de>
					</label>
					<store-form-state/>
					<with-transaction>
						<persist-transient/>
						<execute-script function="anchor -> node -> structureInsert($node, $anchor, null)">
							<inputs>
								<input channel="anchor"/>
							</inputs>
						</execute-script>
					</with-transaction>
					<write-channel name="selection"/>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
