<?xml version="1.0" encoding="utf-8" ?>

<!--
	An E-Home administrator assigns a controller without a project to a project (haumacher/ehome #151,
	#165, the list administration/controllers.view.xml): "controller" carries it, "project" the project
	chosen. The project is found by its name (projectsNamed, a query of the database reading no other
	project, haumacher/ehome #167): the administrator enters the name, the projects of exactly that
	name are offered. controllerAssign (de.haumacher.ehome.connection.ProjectControllers#assign) makes
	the controller one of the project's controllers, its deployment target if the project has none, and
	refuses a controller that belongs to a project already.

	The administrator need not edit the project: assigning repairs what the migration left, as the
	E-Home administrator repairs the members of a project; the command checks the E-Home
	administration, the read of the controller and of the project.
-->
<view>
	<channels>
		<channel name="controller"/>
		<channel name="name"/>
		<channel name="project"/>
	</channels>
	<window width="500px">
		<title>
			<en>Assign to project</en>
			<de>Einem Projekt zuordnen</de>
		</title>
		<inset>
			<stack gap="default">
				<text>
					<label>
						<en>The controller becomes one of the controllers of the project chosen; the project deploys to it if it has no controller yet.</en>
						<de>Der Controller wird einer der Controller des gewählten Projekts; das Projekt stellt auf ihm bereit, wenn es noch keinen Controller hat.</de>
					</label>
				</text>
				<fields>
					<value-input
						type="tl.core:String"
						value="name"
					>
						<label>
							<en>Name of the project</en>
							<de>Name des Projekts</de>
						</label>
						<placeholder>
							<en>The exact name, as the list of projects shows it</en>
							<de>Der genaue Name, wie ihn die Liste der Projekte zeigt</de>
						</placeholder>
					</value-input>
					<value-input
						inputs="name"
						mandatory="true"
						options="projectsNamed($name)"
						type="ehome.project:Project"
						value="project"
					>
						<label>
							<en>Project</en>
							<de>Projekt</de>
						</label>
					</value-input>
				</fields>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-check-lg"
					inputs="controller, project"
				>
					<label>
						<en>Assign</en>
						<de>Zuordnen</de>
					</label>
					<access>
						<operation name="EHomeAdministration"/>
						<operation name="Read"
							object="$controller"
							type="ehome.runtime:Controller"
						/>
						<operation name="Read"
							object="$project"
							type="ehome.project:Project"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<with-transaction>
						<execute-script function="controllerAssign($controller, $project)"/>
					</with-transaction>
					<close-dialog/>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
