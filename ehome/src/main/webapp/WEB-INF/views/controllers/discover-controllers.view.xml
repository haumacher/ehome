<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog searching the local networks for HomeControl controllers (haumacher/ehome #42): the controllers
	announcing the DNS-SD service _homecontrol._tcp over multicast DNS (<discover-controllers>,
	de.haumacher.ehome.runtime.DiscoverControllersAction), with the version of their announcement.
	"Create" makes a controller (ehome.runtime:Controller) of the selected row - its name, address and
	port - in the project in "project" (haumacher/ehome #151, controllerCreate) and writes it to
	"selection"; the token is set afterwards with "Set token". A controller of the project with the same
	address and port is not created again; "Known as" names it. Without a network interface the search
	runs on all interfaces that are up and support multicast, except the loopback interface.

	Unless the installation reaches local networks (configuration variable tl_ehome_local_network,
	haumacher/ehome #150, TL-Script localNetworkVeto()), the dialog offers no search and says why; the
	command opening it (projects/controllers.view.xml) is not offered then either, and controllerCreate
	refuses.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="selection"/>
		<channel name="found"/>
		<channel name="selected"/>
		<channel name="networkInterface"/>
		<!-- Why this installation does not reach local networks, null if it does (haumacher/ehome #150). -->
		<derived-channel name="localNetworkVeto"
			expr="localNetworkVeto()"
		/>
		<derived-channel name="localNetworkReason"
			expr="if($localNetworkVeto == null, null, $localNetworkVeto.localize())"
			inputs="localNetworkVeto"
		/>
	</channels>
	<window width="900px">
		<title>
			<en>Search controllers</en>
			<de>Controller suchen</de>
		</title>
		<inset>
			<stack gap="default">
				<switch input="localNetworkVeto">
					<case test="$localNetworkVeto == null">
						<stack gap="default">
							<text tone="secondary">
								<label>
									<en>Controllers in the local networks announce themselves over mDNS (_homecontrol._tcp). Choose one and create it; then set its token.</en>
									<de>Controller in den lokalen Netzen kündigen sich über mDNS an (_homecontrol._tcp). Einen wählen und anlegen; danach sein Token setzen.</de>
								</label>
							</text>
							<fields>
								<value-input
									options="knxNetworkInterfaces()"
									value="networkInterface"
								>
									<label>
										<en>Network interface (empty: all)</en>
										<de>Netzwerkschnittstelle (leer: alle)</de>
									</label>
								</value-input>
							</fields>
							<button>
								<action class="com.top_logic.layout.view.command.GenericViewCommand"
									image="css:bi bi-broadcast"
									inputs="project"
								>
									<label>
										<en>Search</en>
										<de>Suchen</de>
									</label>
									<access>
										<!--
											The search only lists what answers on the network, for the project the dialog creates
											a controller in: whoever may change the project (haumacher/ehome #65, #152).
										-->
										<operation name="Write"
											object="$project"
											type="ehome.project:Project"
										/>
									</access>
									<execute-script function="{'interface': $networkInterface}">
										<inputs>
											<input channel="networkInterface"/>
										</inputs>
										<with-result>
											<discover-controllers>
												<with-result as="rows">
													<write-channel name="found"/>
													<notify expr="if($rows.isEmpty(), #('No controller answered.'@en, 'Kein Controller hat geantwortet.'@de))"
														kind="warning"
													/>
												</with-result>
											</discover-controllers>
										</with-result>
									</execute-script>
								</action>
							</button>
							<table selection="selected">
								<inputs>
									<input channel="found"/>
								</inputs>
								<columns>
									<computed-column name="name"
										type="tl.core:String"
									>
										<label>
											<en>Name</en>
											<de>Name</de>
										</label>
										<value>$row["name"]</value>
									</computed-column>
									<computed-column name="host"
										type="tl.core:String"
									>
										<label>
											<en>Address</en>
											<de>Adresse</de>
										</label>
										<value>$row["host"]</value>
									</computed-column>
									<computed-column name="port"
										type="tl.core:String"
									>
										<label>
											<en>Port</en>
											<de>Port</de>
										</label>
										<value>$row["portText"]</value>
									</computed-column>
									<computed-column name="version"
										type="tl.core:String"
									>
										<label>
											<en>Version</en>
											<de>Version</de>
										</label>
										<value>$row["version"]</value>
									</computed-column>
									<computed-column name="build"
										type="tl.core:String"
									>
										<label>
											<en>Build</en>
											<de>Build</de>
										</label>
										<value>$row["build"]</value>
									</computed-column>
									<computed-column name="known"
										inputs="project"
										type="tl.core:String"
									>
										<label>
											<en>Known as</en>
											<de>Bekannt als</de>
										</label>
										<value>$project.get(`ehome.project:Project#controllers`).filter(c -> $c.get(`ehome.runtime:Controller#host`) == $row["host"] and $c.get(`ehome.runtime:Controller#port`) == $row["port"]).map(c -> $c.get(`ehome.runtime:Controller#name`)).firstElement()</value>
									</computed-column>
								</columns>
								<rows>if($found == null, [], $found)</rows>
							</table>
						</stack>
					</case>
					<default>
						<text
							input="localNetworkReason"
							tone="secondary"
						/>
					</default>
				</switch>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-plus-lg"
					inputs="project, selected"
				>
					<label>
						<en>Create</en>
						<de>Anlegen</de>
					</label>
					<access>
						<create
							in="$project"
							reference="ehome.project:Project#controllers"
						/>
					</access>
					<executability>
						<visible-if expr="localNetworkVeto() == null"/>
					</executability>
					<with-transaction>
						<execute-script>
							<function><![CDATA[if($selected == null,
    throw(#("Choose a controller the search found."@en, "Bitte einen gefundenen Controller wählen."@de)),
    controllerCreate($project, $selected["name"], $selected["host"], $selected["port"], null))]]></function>
						</execute-script>
						<with-result>
							<write-channel name="selection"/>
							<close-dialog/>
						</with-result>
					</with-transaction>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
