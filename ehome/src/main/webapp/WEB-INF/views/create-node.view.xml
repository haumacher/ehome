<?xml version="1.0" encoding="utf-8" ?>

<!--
	Create dialog for a node of one of the structure trees (building parts, group addresses, areas
	and lines, catalog entries, application programs, the assignment of a program to a product).

	"model" carries the transient object of the type the opening command chose; "container" is the
	object the new node is added to. The reference it is added to depends on the container and the
	type of the new node. The created node is written to "selection", so that the tree selects it.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="container"/>
		<channel name="selection"/>
		<!-- The product of a variant the new node is created for (a program assignment). -->
		<derived-channel name="product"
			expr="if($container.instanceOf(`ehome.catalog:Variant`), $container.get(`ehome.catalog:Variant#product`), null)"
			inputs="container"
		/>
	</channels>
	<window width="500px">
		<title>
			<en>New element</en>
			<de>Neues Element</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<!-- The name of a program assignment is that of its program. -->
			<visible-if
				expr="!$model.instanceOf(`ehome.catalog:ProgramAssignment`)"
				input="model"
			>
				<field attribute="name"/>
			</visible-if>
			<visible-if
				expr="$model.instanceOf(`ehome.logical:GroupAddress`) or $model.instanceOf(`ehome.physical:Area`) or $model.instanceOf(`ehome.physical:Line`)"
				input="model"
			>
				<field attribute="address"/>
			</visible-if>
			<visible-if
				expr="$model.instanceOf(`ehome.catalog:Manufacturer`)"
				input="model"
			>
				<field attribute="id"/>
			</visible-if>
			<visible-if
				expr="$model.instanceOf(`ehome.catalog:ProgramAssignment`)"
				input="model"
			>
				<field attribute="program"/>
			</visible-if>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					inputs="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Erstellen</de>
					</label>
					<store-form-state/>
					<switch value="switch {
    $container.instanceOf(`ehome.project:Project`) and $model.instanceOf(`ehome.building:BuildingDefinition`): 'buildings';
    $container.instanceOf(`ehome.project:Project`) and $model.instanceOf(`ehome.logical:GroupAddressDefinition`): 'groupAddresses';
    $container.instanceOf(`ehome.project:Project`) and $model.instanceOf(`ehome.physical:Area`): 'areas';
    $container.instanceOf(`ehome.physical:Area`): 'lines';
    $container.instanceOf(`ehome.catalog:ManufacturerRoot`): 'manufacturers';
    $container.instanceOf(`ehome.catalog:Manufacturer`) and $model.instanceOf(`ehome.operational:Program`): 'programs';
    $container.instanceOf(`ehome.catalog:Manufacturer`): 'catalogs';
    $container.instanceOf(`ehome.catalog:Catalog`): 'sections';
    $container.instanceOf(`ehome.catalog:Variant`): 'assignment';
    default: 'parts';
}">
						<inputs>
							<input channel="container"/>
						</inputs>
						<case match="'buildings'">
							<persist-transient
								container="container"
								reference="buildings"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</case>
						<case match="'groupAddresses'">
							<persist-transient
								container="container"
								reference="groupAddresses"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</case>
						<case match="'areas'">
							<persist-transient
								container="container"
								reference="areas"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</case>
						<case match="'lines'">
							<persist-transient
								container="container"
								reference="lines"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</case>
						<case match="'manufacturers'">
							<persist-transient
								container="container"
								reference="manufacturers"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</case>
						<case match="'programs'">
							<persist-transient
								container="container"
								reference="programs"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</case>
						<case match="'catalogs'">
							<persist-transient
								container="container"
								reference="catalogs"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</case>
						<case match="'sections'">
							<persist-transient
								container="container"
								reference="sections"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</case>
						<!-- The assignment of a program to the product of the selected variant, owned by the product. -->
						<case match="'assignment'">
							<persist-transient
								container="product"
								reference="programs"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</case>
						<default>
							<persist-transient
								container="container"
								reference="parts"
							>
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</persist-transient>
						</default>
					</switch>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
