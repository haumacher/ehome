<?xml version="1.0" encoding="utf-8" ?>

<!--
	The KNX datapoint types: all subtypes, grouped by their main type, and the selected one in a
	form, with its named values where the master data name them. They come from the master data of
	the imported ETS projects.
-->
<view>
	<channels>
		<channel name="selected"/>
		<!-- The name of this page for the assistant (app.view.xml, <page-selection> below). -->
		<derived-channel name="assistantPage"
			expr="'Datapoint types'"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="320"
				size="60"
				unit="%"
			>
				<!-- What the assistant is told about this page: its name and its selection (app.view.xml). -->
				<page-selection to="pageView">
					<inputs>
						<input channel="assistantPage"/>
					</inputs>
				</page-selection>
				<page-selection to="pageSelection">
					<inputs>
						<input channel="selected"/>
					</inputs>
				</page-selection>
				<panel>
					<title>
						<en>Datapoint types</en>
						<de>Datenpunkttypen</de>
					</title>
					<table
						group-by="mainType"
						observed-types="ehome.datapoint:DatapointType"
						selection="selected"
						types="ehome.datapoint:DatapointSubtype"
					>
						<columns>
							<column attribute="code"/>
							<column attribute="name"/>
							<column attribute="description"/>
							<column attribute="sizeInBit"/>
							<column attribute="mainType"/>
						</columns>
						<rows><![CDATA[`ehome.datapoint#ROOT`
    .get(`ehome.datapoint:DatapointTypes#types`)
    .get(`ehome.datapoint:DatapointMainType#subtypes`)]]></rows>
					</table>
				</panel>
			</pane>
			<pane
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Details</en>
						<de>Details</de>
					</title>
					<form
						input="selected"
						with-inset="true"
					>
						<field attribute="code"/>
						<field attribute="name"/>
						<field attribute="description"/>
						<field attribute="sizeInBit"/>
						<field attribute="mainType"/>
						<field attribute="extId"/>
						<!-- The named values of an enumerated subtype (master data of ETS 5.5 and later). -->
						<field attribute="values"/>
					</form>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
