<?xml version="1.0" encoding="utf-8" ?>

<!--
	Drill-down through the KNX projects: the list of projects, and the structures of one project.
-->
<view>
	<channels>
		<channel name="navPath"/>
		<!-- The name of this page for the assistant (app.view.xml, <page-selection> below). -->
		<derived-channel name="assistantPage"
			expr="'Projects'"
		/>
	</channels>

	<stack>
		<!-- What the assistant is told about this page: its name and its selection (app.view.xml). -->
		<page-selection to="pageView">
			<inputs>
				<input channel="assistantPage"/>
			</inputs>
		</page-selection>
		<slot-content to="appbar-content">
			<tile-breadcrumb path="navPath">
				<home-label>
					<en>Projects</en>
					<de>Projekte</de>
				</home-label>
			</tile-breadcrumb>
		</slot-content>

		<tile-stack
			initial="projects/overview.view.xml"
			path="navPath"
		>
			<!-- A project, opened from the list of projects (projects/overview.view.xml) or shown from another one. -->
			<frame id="project"
				view="projects/project.view.xml"
			>
				<param name="project"/>
				<label class="com.top_logic.layout.view.tiles.ScriptedTileLabel"
					expr="$project.get(`ehome.project:Project#name`)"
					inputs="project"
				/>
			</frame>
		</tile-stack>
	</stack>
</view>
