<?xml version="1.0" encoding="utf-8" ?>

<!--
	The group addresses of a project: the ranges and their addresses, and below each address its
	connections (ehome.physical:Connection), one node per communication object connected to it,
	labelled with the device, the object and the direction (connectionLabel), the sending ones first.
	The selected node is shown beside the tree: a range or an address with its connections, the
	datapoint types that do not fit together and the number of senders, or a connection with its
	device. A connection, a node of the tree or a row of the table of an address, opens its device in
	the device view by row activation (double-click, Enter or the button of the row).

	An address without a datapoint type in effect (GroupAddressTypes: neither the address nor an
	object names one, and the size of the objects does not decide it) is left out of the runtime
	image. The tree marks it (ehomeUntyped), the switch above the tree narrows the tree to such
	addresses and the ranges holding them, the details say why, and "Set the datapoint type" chooses
	a type for the address (projects/set-datapoint-type.view.xml).

	The details of an address include the settings of its datapoint in the runtime image (#45):
	writable and read on start (derived from the connected objects unless set), readable, persistence,
	history and unit. The history (#73) is derived from the charts of the control pages unless it is
	set by hand: the form shows the history in the image and the derived one; "Set history by hand"
	starts from the derived one and shows the raw ring and the archives for editing, "Derive history"
	returns to the derived one.

	Objects are connected to the selected address and connections removed with the operations of
	the device view (deviceConnect, deviceDisconnect), so the rules of a connection hold on both
	sides. The connections are computed by Java functions (GroupAddressConnections), hence the tree,
	the table and the channels reading them observe connections and connectors: a connection made in
	the device view appears here, and the other way round, without reloading.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="selected"/>
		<!-- Whether the form of the selected address is being edited. -->
		<channel name="addressEditMode"/>
		<!-- Whether the tree shows only the addresses without a datapoint type and the ranges holding them. -->
		<channel name="untypedOnly"/>
		<derived-channel name="selectedDefinition"
			expr="if($selected.instanceOf(`ehome.logical:GroupAddressDefinition`), $selected, null)"
			inputs="selected"
		/>
		<derived-channel name="container"
			expr="if($selected.instanceOf(`ehome.logical:GroupRange`), $selected, if($selected.instanceOf(`ehome.logical:GroupAddress`), $selected.container(), $project))"
			inputs="project, selected"
		/>
		<!-- The selected address, or the address of the selected connection: where an object is connected to. -->
		<derived-channel name="address"
			expr="if($selected.instanceOf(`ehome.logical:GroupAddress`), $selected, if($selected.instanceOf(`ehome.physical:Connection`), $selected.get(`ehome.physical:Connection#target`), null))"
			inputs="selected"
		/>
		<!-- The connection selected in the table of the selected address. -->
		<channel name="selectedRow"/>
		<!-- The selected connection: the node selected in the tree, or the row selected in the table of the selected address. -->
		<derived-channel name="connection"
			inputs="selected, selectedRow"
			observed-types="ehome.physical:Connection"
		>
			<expr><![CDATA[switch {
    $selected.instanceOf(`ehome.physical:Connection`): $selected;
    $selectedRow != null and $selected.instanceOf(`ehome.logical:GroupAddress`) and groupAddressConnections($selected).containsElement($selectedRow): $selectedRow;
    default: null;
}]]></expr>
		</derived-channel>
		<!-- The device of the selected connection. -->
		<derived-channel name="connectionDevice"
			expr="connectionDevice($connection)"
			inputs="connection"
		/>
		<derived-channel name="connectionText"
			expr="connectionLabel($connection)"
			inputs="connection"
		/>
		<!-- What does not fit together at the selected address; nothing if all fits. -->
		<derived-channel name="problems"
			expr="groupAddressProblems($address)"
			inputs="address"
			observed-types="ehome.physical:Connection,ehome.physical:Connector"
		/>
		<!-- Why the selected address has no datapoint type; nothing for an address that has one. -->
		<derived-channel name="typeHint"
			inputs="address"
			observed-types="ehome.logical:GroupAddress,ehome.physical:Connection,ehome.physical:Connector"
		>
			<expr><![CDATA[if($address == null or groupAddressHasType($address), null,
    #("{0} has no datapoint type: neither the address nor its objects name one, and the size of the objects does not decide it. The runtime image leaves the address out until a type is set (“Set the datapoint type”)."@en,
      "{0} hat keinen Datenpunkttyp: Weder die Adresse noch ihre Objekte nennen einen, und die Größe der Objekte legt ihn nicht fest. Das Laufzeitabbild lässt die Adresse weg, bis ein Typ gesetzt ist („Datenpunkttyp setzen“)."@de)
        .fill($address.get(`ehome.logical:GroupAddress#displayName`)).localize())]]></expr>
		</derived-channel>
		<derived-channel name="senders"
			expr="if($address == null, null, #('Sending objects: {0}'@en, 'Sendende Objekte: {0}'@de).fill(groupAddressSenders($address)).localize())"
			inputs="address"
			observed-types="ehome.physical:Connection,ehome.physical:Connector"
		/>
		<!-- The name of this page for the assistant (app.view.xml, <page-selection> below). -->
		<derived-channel name="assistantPage"
			expr="'Project, tab Group addresses'"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="240"
				size="40"
				unit="%"
			>
				<!-- What the assistant is told about this page: its name and its selection (app.view.xml). -->
				<page-selection to="pageView">
					<inputs>
						<input channel="assistantPage"/>
					</inputs>
				</page-selection>
				<page-selection to="pageSelection">
					<inputs>
						<input channel="selectedRow"/>
						<input channel="selected"/>
						<input channel="project"/>
					</inputs>
				</page-selection>
				<panel>
					<title>
						<en>Group addresses</en>
						<de>Gruppenadressen</de>
					</title>
					<commands>
						<generic-command
							clique="new"
							image="css:bi bi-folder-plus"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Group range</en>
								<de>Gruppenbereich</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.logical:GroupRange">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-wifi"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Group address</en>
								<de>Gruppenadresse</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.logical:GroupAddress">
								<with-result>
									<!-- The next free address of the range is proposed. -->
									<execute-script function="{ $result.set(`ehome.logical:GroupAddress#address`, groupAddressNextFree($container)); $result }">
										<inputs>
											<input channel="container"/>
										</inputs>
										<with-result>
											<open-dialog
												bind-input-to="model"
												dialog-view="create-node.view.xml"
											>
												<bind
													channel="container"
													to="container"
												/>
												<bind
													channel="selection"
													to="selected"
												/>
											</open-dialog>
										</with-result>
									</execute-script>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="selectedDefinition"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="deleteConfirmation($selectedDefinition)"/>
							<delete-object/>
							<write-channel name="selected" clear="true"/>
						</generic-command>
						<generic-command
							image="css:bi bi-link-45deg"
							inputs="address"
							placement="TOOLBAR"
						>
							<label>
								<en>Connect an object</en>
								<de>Objekt verbinden</de>
							</label>
							<access>
								<operation name="Write"
									object="$address"
									type="ehome.logical:GroupAddress"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="address"
								dialog-view="projects/connect-object.view.xml"
							>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-123"
							inputs="address"
							placement="TOOLBAR"
						>
							<label>
								<en>Set the datapoint type</en>
								<de>Datenpunkttyp setzen</de>
							</label>
							<tooltip>
								<en>Gives the address a datapoint type of its own, chosen from the types its objects suggest by their size. An address without a datapoint type is left out of the runtime image of the controller.</en>
								<de>Gibt der Adresse einen eigenen Datenpunkttyp, gewählt aus den Typen, die ihre Objekte nach ihrer Größe nahelegen. Eine Adresse ohne Datenpunkttyp fehlt im Laufzeitabbild des Controllers.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$address"
									type="ehome.logical:GroupAddress"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="address"
								dialog-view="projects/set-datapoint-type.view.xml"
							>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-x-lg"
							inputs="connection"
							placement="TOOLBAR"
						>
							<label>
								<en>Remove the connection</en>
								<de>Verbindung entfernen</de>
							</label>
							<access>
								<operation name="Write"
									object="$connection"
									type="ehome.physical:Connection"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Remove the connection {0}?'@en, 'Verbindung {0} entfernen?'@de).fill(connectionLabel($connection))"/>
							<!-- A removed connection selected in the tree hands the selection to its address. -->
							<with-transaction>
								<execute-script function="deviceDisconnect($connection)"/>
							</with-transaction>
						</generic-command>
					</commands>
					<stack>
						<inset>
							<fields>
								<value-input
									type="tl.core:Boolean"
									value="untypedOnly"
								>
									<label>
										<en>Only addresses without datapoint type</en>
										<de>Nur Adressen ohne Datenpunkttyp</de>
									</label>
									<input-control class="com.top_logic.layout.view.form.BooleanControlProvider"
										display="switch"
									/>
								</value-input>
							</fields>
						</inset>
						<!--
							The ranges and addresses with the columns of the classic tree grid (exported to Excel
							as an outline), below an address its connections.
						-->
						<tree-table
							observed-types="ehome.logical:GroupAddressDefinition,ehome.physical:Connection"
							selection="selected"
						>
							<inputs>
								<input channel="project"/>
								<input channel="untypedOnly"/>
							</inputs>
							<root>$project</root>
							<children><![CDATA[switch {
    $node.instanceOf(`ehome.project:Project`) or $node.instanceOf(`ehome.logical:GroupRange`):
        if($untypedOnly, groupAddressUntypedParts($node), groupAddressParts($node));
    $node.instanceOf(`ehome.logical:GroupAddress`):
        groupAddressConnections($node);
    default: [];
}]]></children>
							<parents>if($node.instanceOf(`ehome.physical:Connection`), $node.get(`ehome.physical:Connection#target`), $node.container())</parents>
							<export download-name="#('Group addresses of {0}'@en, 'Gruppenadressen von {0}'@de).fill($project.get(`ehome.project:Project#name`))">
								<sheet-name>
									<en>Group addresses</en>
									<de>Gruppenadressen</de>
								</sheet-name>
							</export>
							<columns>
								<!--
									A range or an address by its name (the address has a column of its own), a
									connection by its device, object and direction; an address without a datapoint
									type carries a mark after its label.
								-->
								<computed-column name="name"
									width="300"
								>
									<label>
										<en>Name</en>
										<de>Name</de>
									</label>
									<value>$row</value>
									<display class="com.top_logic.layout.view.element.ResourceDisplayByExpression"
										css-class="if($value.instanceOf(`ehome.logical:GroupAddress`) and !groupAddressHasType($value), 'ehomeUntyped', null)"
									>
										<label><![CDATA[switch {
    $value.instanceOf(`ehome.physical:Connection`): connectionLabel($value);
    $value.instanceOf(`ehome.logical:GroupAddressDefinition`) and !$value.get(`ehome.logical:GroupAddressDefinition#name`).isEmpty():
        $value.get(`ehome.logical:GroupAddressDefinition#name`);
    default: null;
}]]></label>
									</display>
								</computed-column>
								<!-- The address in the notation of the project; of a range, the prefix its addresses share. -->
								<computed-column name="address"
									width="110"
								>
									<label>
										<en>Address</en>
										<de>Adresse</de>
									</label>
									<value><![CDATA[switch {
    $row.instanceOf(`ehome.logical:GroupAddress`): $row.get(`ehome.logical:GroupAddress#address`);
    $row.instanceOf(`ehome.logical:GroupRange`): groupRangePrefix($row.get(`ehome.logical:GroupRange#rangeStart`), $row.get(`ehome.logical:GroupRange#rangeEnd`));
    default: null;
}]]></value>
								</computed-column>
								<computed-column name="extId"
									type="tl.core:String"
									width="160"
								>
									<label>
										<en>External ID</en>
										<de>Externe ID</de>
									</label>
									<value>if($row.instanceOf(`ehome.core:Externalized`), $row.get(`ehome.core:Externalized#extId`), null)</value>
								</computed-column>
							</columns>
							<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
								image="css:bi bi-box-arrow-up-right"
							>
								<label>
									<en>Go to the device</en>
									<de>Zum Gerät</de>
								</label>
								<executability>
									<!-- Of the nodes, only a connection opens its device. -->
									<visible-if expr="$row.instanceOf(`ehome.physical:Connection`)"/>
								</executability>
								<show-views>
									<show frame="project"
										label-expr="recursion(connectionDevice($row), x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement().get(`ehome.project:Project#name`)"
									>
										<bind
											channel="project"
											expr="recursion(connectionDevice($row), x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
										/>
									</show>
									<show view="projects/devices.view.xml">
										<bind
											channel="selected"
											expr="connectionDevice($row)"
										/>
									</show>
								</show-views>
							</on-activate>
						</tree-table>
					</stack>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<!--
					The selected node: a range, an address with its connections and what does not fit
					together at it, or a connection with its device.
				-->
				<panel>
					<title>
						<en>Details</en>
						<de>Details</de>
					</title>
					<switch input="selected">
						<case test="$selected.instanceOf(`ehome.logical:GroupRange`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="rangeStart"/>
								<field attribute="rangeEnd"/>
								<field attribute="unfiltered"/>
								<field attribute="description"/>
								<field attribute="extId"/>
							</form>
						</case>
						<case test="$selected.instanceOf(`ehome.logical:GroupAddress`)">
							<split-panel
								orientation="vertical"
								resizable="true"
							>
								<panes>
									<pane
										size="50"
										unit="%"
									>
										<stack>
											<visible-if
												expr="$typeHint != null"
												input="typeHint"
											>
												<inset>
													<text
														input="typeHint"
														tone="warning"
													/>
												</inset>
											</visible-if>
											<form
												editMode="addressEditMode"
												input="selected"
												with-inset="true"
											>
												<commands>
													<!-- The history set by hand (haumacher/ehome #73): starting from the derived one; back to the derived one. -->
													<generic-command
														image="css:bi bi-pencil-square"
														inputs="selected, addressEditMode as editing"
														placement="TOOLBAR"
													>
														<label>
															<en>Set history by hand</en>
															<de>Verlauf von Hand einstellen</de>
														</label>
														<tooltip>
															<en>Makes the history the controller keeps of the datapoint for the charts of the control pages (raw ring and archives) editable, starting from the derived one. It then no longer follows changes of the charts.</en>
															<de>Macht den Verlauf, den der Controller für die Diagramme der Bedienseiten vom Datenpunkt führt (Rohdaten und Archive), von Hand einstellbar, ausgehend vom abgeleiteten. Er folgt dann Änderungen der Diagramme nicht mehr.</de>
														</tooltip>
														<access>
															<operation name="Write"
																object="$selected"
																type="ehome.logical:GroupAddress"
															/>
														</access>
														<executability>
															<visible-if expr="$editing != true and $selected.instanceOf(`ehome.logical:GroupAddress`) and !runtimeHistoryManual($selected)"/>
														</executability>
														<with-transaction>
															<execute-script function="runtimeHistorySetManual($selected)"/>
														</with-transaction>
													</generic-command>
													<generic-command
														image="css:bi bi-arrow-counterclockwise"
														inputs="selected, addressEditMode as editing"
														placement="TOOLBAR"
													>
														<label>
															<en>Derive history</en>
															<de>Verlauf ableiten</de>
														</label>
														<tooltip>
															<en>Discards the history set by hand: the controller keeps again the history the charts of the control pages need.</en>
															<de>Verwirft den von Hand eingestellten Verlauf: Der Controller führt wieder den Verlauf, den die Diagramme der Bedienseiten brauchen.</de>
														</tooltip>
														<access>
															<operation name="Write"
																object="$selected"
																type="ehome.logical:GroupAddress"
															/>
														</access>
														<executability>
															<visible-if expr="$editing != true and $selected.instanceOf(`ehome.logical:GroupAddress`) and runtimeHistoryManual($selected)"/>
														</executability>
														<with-transaction>
															<execute-script function="runtimeHistoryReset($selected)"/>
														</with-transaction>
													</generic-command>
												</commands>
												<field attribute="name"/>
												<field attribute="address"/>
												<field attribute="effectiveDatapointType"/>
												<field attribute="datapointTypes"/>
												<field attribute="central"/>
												<field attribute="unfiltered"/>
												<field attribute="description"/>
												<field attribute="extId"/>
												<!--
													The settings of the address's datapoint in the runtime image (#45): the
													effective flags beside the settings that override their derivation.
												-->
												<group>
													<label>
														<en>Runtime (HomeControl)</en>
														<de>Laufzeit (HomeControl)</de>
													</label>
													<field attribute="runtimeFlagsSource"/>
													<field attribute="runtimeWritable"/>
													<field attribute="effectiveWritable"/>
													<field attribute="runtimeReadOnStart"/>
													<field attribute="effectiveReadOnStart"/>
													<field attribute="runtimeReadable"/>
													<field attribute="runtimePersist"/>
													<field attribute="historyEffective"/>
													<field attribute="historyDerived"/>
													<field attribute="historyManual"/>
													<field attribute="historyRetention"/>
													<field attribute="historySpacing"/>
													<composition-table attribute="historyArchives">
														<columns>
															<column attribute="resolution"/>
															<column attribute="retention"/>
														</columns>
													</composition-table>
													<field attribute="runtimeUnit"/>
													<field attribute="effectiveUnit"/>
												</group>
											</form>
										</stack>
									</pane>
									<pane
										size="50"
										unit="%"
									>
										<panel>
											<title>
												<en>Connected objects</en>
												<de>Verbundene Objekte</de>
											</title>
											<stack>
												<inset>
													<stack gap="compact">
														<visible-if
															expr="$problems != null"
															input="problems"
														>
															<text
																input="problems"
																tone="warning"
															/>
														</visible-if>
														<text
															input="senders"
															tone="secondary"
														/>
													</stack>
												</inset>
												<table
													observed-types="ehome.physical:Connection,ehome.physical:Connector"
													selection="selectedRow"
													types="ehome.physical:Connection"
												>
													<inputs>
														<input channel="address"/>
													</inputs>
													<columns>
														<computed-column name="device"
															type="tl.core:String"
															width="200"
														>
															<label>
																<en>Device</en>
																<de>Gerät</de>
															</label>
															<value>deviceLabel(connectionDevice($row))</value>
														</computed-column>
														<computed-column name="number"
															type="tl.core:Integer"
															width="90"
														>
															<label>
																<en>No.</en>
																<de>Nr.</de>
															</label>
															<value>connectionObject($row).get(`ehome.operational:Interface#port`).get(`ehome.operational:Port#index`)</value>
														</computed-column>
														<computed-column name="object"
															type="tl.core:String"
															width="170"
														>
															<label>
																<en>Object</en>
																<de>Objekt</de>
															</label>
															<value>connectionObjectText($row)</value>
														</computed-column>
														<computed-column name="function"
															type="tl.core:String"
															width="130"
														>
															<label>
																<en>Function</en>
																<de>Funktion</de>
															</label>
															<value>connectionFunction($row)</value>
														</computed-column>
														<column attribute="kind"
															width="130"
														>
															<label>
																<en>Direction</en>
																<de>Richtung</de>
															</label>
														</column>
														<computed-column name="datapointType"
															type="ehome.datapoint:DatapointType"
															width="200"
														>
															<label>
																<en>Datapoint type of the object</en>
																<de>Datenpunkttyp des Objekts</de>
															</label>
															<value>connectionDatapointType($row)</value>
														</computed-column>
													</columns>
													<rows>if($address == null, [], groupAddressConnections($address))</rows>
													<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
														image="css:bi bi-box-arrow-up-right"
													>
														<label>
															<en>Go to the device</en>
															<de>Zum Gerät</de>
														</label>
														<show-views>
															<show frame="project"
																label-expr="recursion(connectionDevice($row), x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement().get(`ehome.project:Project#name`)"
															>
																<bind
																	channel="project"
																	expr="recursion(connectionDevice($row), x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
																/>
															</show>
															<show view="projects/devices.view.xml">
																<bind
																	channel="selected"
																	expr="connectionDevice($row)"
																/>
															</show>
														</show-views>
													</on-activate>
												</table>
											</stack>
										</panel>
									</pane>
								</panes>
							</split-panel>
						</case>
						<case test="$selected.instanceOf(`ehome.physical:Connection`)">
							<!--
								A connection: which object of which device, the direction, and the device; the
								device is configured in the device view, which the node opens by row activation.
							-->
							<stack>
								<inset>
									<text
										input="connectionText"
										variant="title"
									/>
								</inset>
								<form
									input="selected"
									with-inset="true"
									withEditMode="false"
								>
									<field attribute="target"/>
									<field attribute="kind"/>
								</form>
								<form
									input="connectionDevice"
									with-inset="true"
									withEditMode="false"
								>
									<group>
										<label>
											<en>Device</en>
											<de>Gerät</de>
										</label>
										<field attribute="name"/>
										<field attribute="type"/>
										<field attribute="location"/>
										<field attribute="description"/>
									</group>
								</form>
							</stack>
						</case>
					</switch>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
