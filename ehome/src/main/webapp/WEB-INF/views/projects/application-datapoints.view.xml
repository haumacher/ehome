<?xml version="1.0" encoding="utf-8" ?>

<!--
	The application datapoints of a project (haumacher/ehome #59, homecontrol spec/runtime-image.md
	3.3): datapoints of the runtime image that no technology owns, values of the application that rules
	and the user interface command (a holiday mode, a counter) and the outputs of schedule entries
	(spec/schedules.md 5). They are part of the image after the datapoints of the group addresses and
	are listed with them in the rules' "Datapoints" table. One bound to a function of a Zigbee device
	(zigbeeFunction, haumacher/ehome #40; created and bound in projects/zigbee.view.xml) is the
	datapoint of that function instead. Shown in the project's tab-bar after "Group addresses"
	(project.view.xml, haumacher/ehome #115): the values of the whole project, not of one rule. The history of a datapoint (haumacher/ehome #221) is the setting
	"Recording", from which its stores follow, with the flag "Meter reading" (a counter computed by a
	rule).
	The initial value (haumacher/ehome #217) is entered as a literal of the rule language of the datapoint's
	type; while it is empty, the field shows the type's neutral value, which then applies.
	"New" opens the create dialog projects/create-part.view.xml (haumacher/ehome #91): id, label and
	type; nothing is stored before "Create".
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="datapoint"/>
		<!-- Whether the form of the selected datapoint is being edited. -->
		<channel name="datapointEditMode"/>
		<!-- The name of this page for the assistant (app.view.xml, <page-selection> below). -->
		<derived-channel name="assistantPage"
			expr="'Project, tab Application datapoints'"
		/>
	</channels>
	<panel>
		<!-- What the assistant is told about this page: its name and its selection (app.view.xml). -->
		<page-selection to="pageView">
			<inputs>
				<input channel="assistantPage"/>
			</inputs>
		</page-selection>
		<page-selection to="pageSelection">
			<inputs>
				<input channel="datapoint"/>
				<input channel="project"/>
			</inputs>
		</page-selection>
		<title>
			<en>Application datapoints</en>
			<de>Anwendungsdatenpunkte</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-plus-lg"
				inputs="project"
				placement="TOOLBAR"
			>
				<label>
					<en>New datapoint</en>
					<de>Neuer Datenpunkt</de>
				</label>
				<access>
					<operation name="Write"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<execute-script function="ruleDraft($project, 'applicationDatapoints', `ehome.runtime:ApplicationDatapoint`)">
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="projects/create-part.view.xml"
						>
							<bind
								channel="selection"
								to="datapoint"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				image="css:bi bi-trash"
				inputs="datapoint"
				placement="TOOLBAR"
			>
				<label>
					<en>Delete</en>
					<de>Löschen</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<confirm expr="deleteConfirmation($datapoint)"/>
				<delete-object/>
				<write-channel name="datapoint" clear="true"/>
			</generic-command>
			<generic-command
				clique="edit"
				image="css:bi bi-arrow-up"
				inputs="datapoint"
				placement="TOOLBAR"
			>
				<label>
					<en>Move up</en>
					<de>Nach oben</de>
				</label>
				<access>
					<operation name="Write"
						object="$datapoint"
						type="ehome.runtime:ApplicationDatapoint"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="ruleMoveVeto($datapoint, -1)"/>
				</executability>
				<with-transaction>
					<execute-script function="ruleMove($datapoint, -1)"/>
				</with-transaction>
			</generic-command>
			<generic-command
				clique="edit"
				image="css:bi bi-arrow-down"
				inputs="datapoint"
				placement="TOOLBAR"
			>
				<label>
					<en>Move down</en>
					<de>Nach unten</de>
				</label>
				<access>
					<operation name="Write"
						object="$datapoint"
						type="ehome.runtime:ApplicationDatapoint"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="ruleMoveVeto($datapoint, 1)"/>
				</executability>
				<with-transaction>
					<execute-script function="ruleMove($datapoint, 1)"/>
				</with-transaction>
			</generic-command>
		</commands>
		<split-panel
			orientation="vertical"
			resizable="true"
		>
			<panes>
				<pane
					size="45"
					unit="%"
				>
					<table
						observed-types="ehome.runtime:ApplicationDatapoint,ehome.project:Project,ehome.zigbee:ZigbeeFunction"
						selection="datapoint"
						types="ehome.runtime:ApplicationDatapoint"
					>
						<inputs>
							<input channel="project"/>
						</inputs>
						<columns>
							<column attribute="identifier"/>
							<column attribute="label"/>
							<column attribute="type"/>
							<column attribute="writable"/>
							<column attribute="persist"/>
							<column attribute="zigbeeFunction"/>
						</columns>
						<rows>if($project == null, [], $project.get(`ehome.project:Project#applicationDatapoints`))</rows>
					</table>
				</pane>
				<pane
					size="55"
					unit="%"
				>
					<form
						editMode="datapointEditMode"
						input="datapoint"
						with-inset="true"
					>
						<field attribute="identifier"/>
						<field attribute="label"/>
						<field attribute="type"/>
						<field attribute="writable"/>
						<field attribute="persist"/>
						<field attribute="initial"/>
						<field attribute="unit"/>
						<field attribute="recording"/>
						<field attribute="meter"/>
						<field attribute="historyEffective"/>
						<field attribute="zigbeeFunction"/>
					</form>
				</pane>
			</panes>
		</split-panel>
	</panel>
</view>
