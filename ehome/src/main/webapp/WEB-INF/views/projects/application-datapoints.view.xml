<?xml version="1.0" encoding="utf-8" ?>

<!--
	The application datapoints of a project (haumacher/ehome #59, homecontrol spec/runtime-image.md
	3.3): datapoints of the runtime image that no technology owns, values of the application that rules
	and the user interface command (a holiday mode, a counter) and the outputs of schedule entries
	(spec/schedules.md 5). They are part of the image after the datapoints of the group addresses and
	are listed with them in the rules' "Datapoints" table. One bound to a function of a Zigbee device
	(zigbeeFunction, haumacher/ehome #40; created and bound in projects/zigbee.view.xml) is the
	datapoint of that function instead. Shown in the rules' tab-bar
	(rules.view.xml), where they are used. The history of a datapoint (haumacher/ehome #73) is derived
	from the charts of the control pages unless it is set by hand ("Set history by hand", "Derive
	history").
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="datapoint"/>
		<!-- Whether the form of the selected datapoint is being edited. -->
		<channel name="datapointEditMode"/>
	</channels>
	<panel>
		<title>
			<en>Application datapoints</en>
			<de>Anwendungsdatenpunkte</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-plus-lg"
				inputs="project"
				placement="TOOLBAR"
			>
				<label>
					<en>New datapoint</en>
					<de>Neuer Datenpunkt</de>
				</label>
				<access>
					<operation name="Write"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<with-transaction>
					<execute-script function="ruleCreate($project, 'applicationDatapoints', `ehome.runtime:ApplicationDatapoint`)"/>
					<with-result>
						<write-channel name="datapoint"/>
					</with-result>
				</with-transaction>
			</generic-command>
			<generic-command
				image="css:bi bi-trash"
				inputs="datapoint"
				placement="TOOLBAR"
			>
				<label>
					<en>Delete</en>
					<de>Löschen</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<confirm expr="#('Delete the datapoint? Rules and schedule entries naming it are then refused.'@en, 'Den Datenpunkt löschen? Regeln und Zeitplaneinträge, die ihn nennen, werden dann abgelehnt.'@de)"/>
				<delete-object/>
				<write-channel name="datapoint" clear="true"/>
			</generic-command>
			<generic-command
				clique="edit"
				image="css:bi bi-arrow-up"
				inputs="datapoint"
				placement="TOOLBAR"
			>
				<label>
					<en>Move up</en>
					<de>Nach oben</de>
				</label>
				<access>
					<operation name="Write"
						object="$datapoint"
						type="ehome.runtime:ApplicationDatapoint"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="ruleMoveVeto($datapoint, -1)"/>
				</executability>
				<with-transaction>
					<execute-script function="ruleMove($datapoint, -1)"/>
				</with-transaction>
			</generic-command>
			<generic-command
				clique="edit"
				image="css:bi bi-arrow-down"
				inputs="datapoint"
				placement="TOOLBAR"
			>
				<label>
					<en>Move down</en>
					<de>Nach unten</de>
				</label>
				<access>
					<operation name="Write"
						object="$datapoint"
						type="ehome.runtime:ApplicationDatapoint"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="ruleMoveVeto($datapoint, 1)"/>
				</executability>
				<with-transaction>
					<execute-script function="ruleMove($datapoint, 1)"/>
				</with-transaction>
			</generic-command>
		</commands>
		<split-panel
			orientation="vertical"
			resizable="true"
		>
			<panes>
				<pane
					size="45"
					unit="%"
				>
					<table
						observed-types="ehome.runtime:ApplicationDatapoint,ehome.project:Project,ehome.zigbee:ZigbeeFunction"
						selection="datapoint"
						types="ehome.runtime:ApplicationDatapoint"
					>
						<inputs>
							<input channel="project"/>
						</inputs>
						<columns>
							<column attribute="identifier"/>
							<column attribute="label"/>
							<column attribute="type"/>
							<column attribute="writable"/>
							<column attribute="persist"/>
							<column attribute="zigbeeFunction"/>
						</columns>
						<rows>if($project == null, [], $project.get(`ehome.project:Project#applicationDatapoints`))</rows>
					</table>
				</pane>
				<pane
					size="55"
					unit="%"
				>
					<form
						editMode="datapointEditMode"
						input="datapoint"
						with-inset="true"
					>
						<commands>
							<!-- The history set by hand (haumacher/ehome #73): starting from the derived one; back to the derived one. -->
							<generic-command
								image="css:bi bi-pencil-square"
								inputs="datapoint, datapointEditMode as editing"
								placement="TOOLBAR"
							>
								<label>
									<en>Set history by hand</en>
									<de>Verlauf von Hand einstellen</de>
								</label>
								<access>
									<operation name="Write"
										object="$datapoint"
										type="ehome.runtime:ApplicationDatapoint"
									/>
								</access>
								<executability>
									<visible-if expr="$editing != true and $datapoint.instanceOf(`ehome.runtime:ApplicationDatapoint`) and !runtimeHistoryManual($datapoint)"/>
								</executability>
								<with-transaction>
									<execute-script function="runtimeHistorySetManual($datapoint)"/>
								</with-transaction>
							</generic-command>
							<generic-command
								image="css:bi bi-arrow-counterclockwise"
								inputs="datapoint, datapointEditMode as editing"
								placement="TOOLBAR"
							>
								<label>
									<en>Derive history</en>
									<de>Verlauf ableiten</de>
								</label>
								<access>
									<operation name="Write"
										object="$datapoint"
										type="ehome.runtime:ApplicationDatapoint"
									/>
								</access>
								<executability>
									<visible-if expr="$editing != true and $datapoint.instanceOf(`ehome.runtime:ApplicationDatapoint`) and runtimeHistoryManual($datapoint)"/>
								</executability>
								<with-transaction>
									<execute-script function="runtimeHistoryReset($datapoint)"/>
								</with-transaction>
							</generic-command>
						</commands>
						<field attribute="identifier"/>
						<field attribute="label"/>
						<field attribute="type"/>
						<field attribute="writable"/>
						<field attribute="persist"/>
						<field attribute="unit"/>
						<field attribute="historyEffective"/>
						<field attribute="historyDerived"/>
						<field attribute="historyManual"/>
						<field attribute="historyRetention"/>
						<field attribute="historySpacing"/>
						<composition-table attribute="historyArchives">
							<columns>
								<column attribute="resolution"/>
								<column attribute="retention"/>
							</columns>
						</composition-table>
						<field attribute="zigbeeFunction"/>
					</form>
				</pane>
			</panes>
		</split-panel>
	</panel>
</view>
