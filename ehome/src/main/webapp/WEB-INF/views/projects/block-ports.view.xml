<?xml version="1.0" encoding="utf-8" ?>

<!--
	The inputs or the outputs of a virtual device (projects/blocks.view.xml, haumacher/ehome #75):
	"inputs" says which. Each port with its label, type, unit, whether it is required, how many
	datapoints it binds and which aggregations it allows, the ids of its bound datapoints (a deleted
	one marked) and the aggregation in effect. The selected port by its label, with its bindings in
	their order: "Bind datapoints" adds datapoints of the project of a type and unit the port reads
	(an input) or commands (an output, block-bind.view.xml); "Remove binding" removes the selected
	one. What the port does is its help text (haumacher/ehome #101, blockHelp): the tooltip of its name
	in the table and, in full, below the selected port's text. An input that binds several datapoints
	combines them with the aggregation chosen from those the port allows (haumacher/ehome #78);
	choosing the port's default removes the choice.
-->
<view>
	<channels>
		<channel name="block"/>
		<channel name="port"/>
		<channel name="binding"/>
		<channel name="inputs"/>
		<!-- The aggregation the input of the selected port shows: the one in effect, again after each selection and change. -->
		<channel name="aggregationValue"
			init="if($port == null, null, blockAggregationValue($port))"
			inputs="port"
			observed-types="ehome.runtime:BlockPort"
		/>
		<derived-channel name="aggregated"
			expr="$port != null and blockAggregated($port) and canWrite($port)"
			inputs="port"
		/>
		<derived-channel name="portText"
			expr="if($port == null, null, blockLabel($port) + ' · ' + blockPortInfo($port))"
			inputs="port"
		/>
		<!-- What the selected port does (haumacher/ehome #101). -->
		<derived-channel name="portHelp"
			expr="if($port == null, null, blockHelp($port))"
			inputs="port"
		/>
	</channels>
	<split-panel
		orientation="vertical"
		resizable="true"
	>
		<panes>
			<pane
				size="55"
				unit="%"
			>
				<table
					observed-types="ehome.runtime:BlockPort,ehome.runtime:BlockBinding"
					selection="port"
					types="ehome.runtime:BlockPort"
				>
					<inputs>
						<input channel="block"/>
						<input channel="inputs"/>
					</inputs>
					<columns>
						<computed-column name="label"
							type="tl.core:String"
							width="220"
						>
							<label>
								<en>Port</en>
								<de>Anschluss</de>
							</label>
							<value>blockLabel($row)</value>
							<tooltip>blockHelp($row)</tooltip>
						</computed-column>
						<computed-column name="info"
							type="tl.core:String"
							width="300"
						>
							<label>
								<en>Kind</en>
								<de>Art</de>
							</label>
							<value>blockPortInfo($row)</value>
						</computed-column>
						<computed-column name="bound"
							type="tl.core:String"
							width="240"
						>
							<label>
								<en>Bound to</en>
								<de>Gebunden an</de>
							</label>
							<value>blockPortBindings($row)</value>
						</computed-column>
						<computed-column name="aggregation"
							type="tl.core:String"
							width="160"
						>
							<label>
								<en>Aggregation</en>
								<de>Zusammenfassung</de>
							</label>
							<value>blockAggregationValue($row)</value>
						</computed-column>
					</columns>
					<rows>if($block == null, [], if($inputs, blockInputPorts($block), blockOutputPorts($block)))</rows>
				</table>
			</pane>
			<pane
				size="45"
				unit="%"
			>
				<panel>
					<title>
						<en>Bindings</en>
						<de>Bindungen</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-link-45deg"
							inputs="port"
							placement="TOOLBAR"
						>
							<label>
								<en>Bind datapoints</en>
								<de>Datenpunkte binden</de>
							</label>
							<tooltip>
								<en>Binds datapoints of the project of a type and unit the port reads (an input) or commands (an output); an input combines several by its aggregation.</en>
								<de>Bindet Datenpunkte des Projekts, deren Typ und Einheit der Port liest (ein Eingang) oder ansteuert (ein Ausgang); ein Eingang fasst mehrere mit seiner Aggregation zusammen.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$port"
									type="ehome.runtime:BlockPort"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog dialog-view="projects/block-bind.view.xml">
								<bind
									channel="port"
									to="port"
								/>
								<bind
									channel="selection"
									to="binding"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-x-circle"
							inputs="binding"
							placement="TOOLBAR"
						>
							<label>
								<en>Remove binding</en>
								<de>Bindung entfernen</de>
							</label>
							<access>
								<operation name="Write"
									object="$binding"
									type="ehome.runtime:BlockBinding"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<delete-object/>
							<write-channel name="binding" clear="true"/>
						</generic-command>
					</commands>
					<stack gap="default">
						<text input="portText"/>
						<text input="portHelp"/>
						<visible-if
							expr="$aggregated"
							input="aggregated"
						>
							<fields max-columns="1">
								<value-input
									inputs="port"
									options="blockAggregationOptions($port)"
									type="tl.core:String"
									value="aggregationValue"
								>
									<label>
										<en>Aggregation</en>
										<de>Zusammenfassung</de>
									</label>
									<on-submit inputs="port">
										<access>
											<operation name="Write"
												object="$port"
												type="ehome.runtime:BlockPort"
											/>
										</access>
										<with-transaction>
											<execute-script function="blockApplyAggregation($port, $value)"/>
											<with-result>
												<notify
													expr="$result"
													kind="error"
												/>
											</with-result>
										</with-transaction>
									</on-submit>
								</value-input>
							</fields>
						</visible-if>
						<table
							observed-types="ehome.runtime:BlockBinding,ehome.runtime:BlockPort"
							selection="binding"
							types="ehome.runtime:BlockBinding"
						>
							<inputs>
								<input channel="port"/>
							</inputs>
							<columns>
								<column attribute="datapoint"/>
								<column attribute="boundId"/>
							</columns>
							<rows>if($port == null, [], $port.get(`ehome.runtime:BlockPort#bindings`))</rows>
						</table>
					</stack>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
