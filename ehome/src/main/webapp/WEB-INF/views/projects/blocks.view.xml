<?xml version="1.0" encoding="utf-8" ?>

<!--
	The virtual devices of a project (haumacher/ehome #75, homecontrol spec/blocks.md): instances of
	the block types the controller runs (the room controller), each in a room, with its parameter
	values and the bindings of its ports to datapoints of the project. They are part of the runtime
	image (member blocks, schema 1.3); each instance, its adjustable parameters, its outputs and its
	inputs bound to several datapoints are datapoints block/<id>/<x> of the image, which functions,
	rules, pages and other virtual devices name like any other.

	"New virtual device" asks for the type and the room (block-create.view.xml); the identifier is
	derived from the name once and never changes. The form of the selected instance shows what the
	image refuses of it (the controller's reason with its path). Below it the parameters of the type
	with their value, the value of the image (set or default), the type's default and the bounds or
	choices, each as people read it (haumacher/ehome #78, BlockValues): a choice by its label, a
	duration in the unit of the manifest (stored in ms), a time of day as a time, a truth value as
	yes or no. The selected parameter is entered by its kind - a choice from its labels, a duration or
	a number in its unit, a time of day in a time input, a truth value as a checkbox - and the value a
	user finishes is applied at once (blockApplyValue): the default or an emptied input removes the
	value. The inputs and the outputs with their bindings: "Bind datapoints" offers the datapoints of
	the project of a type and unit the port reads or commands (block-bind.view.xml), an input binds up
	to its number of datapoints and an aggregation chosen from the port's combines them. A binding
	keeps the id of its datapoint, so a group address a re-import of the ETS project removes leaves a
	binding the validation names.

	"Diagnostics" reads on demand what the controller of the project tells of the deployed instance
	(GET /api/blocks, BlockDiagnosticsAction): its status and fault, its calls with the last one and
	the last error, its outputs and inputs with their values, the timers, the parameters the
	inhabitant changed and the state record; a project without controller, an unreachable controller
	and an instance that is not deployed are said as such.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="block"/>
		<channel name="parameter"/>
		<channel name="input"/>
		<channel name="output"/>
		<channel name="binding"/>
		<!-- The value the input of the selected parameter shows: the value of the image, again after each selection and change. -->
		<channel name="parameterValue"
			init="blockEditValue($parameter)"
			inputs="parameter"
			observed-types="ehome.runtime:BlockParameter"
		/>
		<!-- How the selected parameter is entered; "readonly" where the user may not change it. -->
		<derived-channel name="parameterKind"
			expr="if($parameter == null, null, if(!canWrite($parameter), 'readonly', blockParameterKind($parameter)))"
			inputs="parameter"
		/>
		<derived-channel name="parameterUnit"
			expr="if($parameter == null, null, blockUnit($parameter))"
			inputs="parameter"
		/>
		<derived-channel name="parameterEffective"
			expr="if($parameter == null, null, blockEffective($parameter))"
			inputs="parameter"
			observed-types="ehome.runtime:BlockParameter"
		/>
		<derived-channel name="parameterLabel"
			expr="if($parameter == null, null, blockLabel($parameter))"
			inputs="parameter"
		/>
		<derived-channel name="parameterHint"
			inputs="parameter"
			observed-types="ehome.runtime:BlockParameter"
		>
			<expr><![CDATA[if($parameter == null, null, {
    range = blockRange($parameter);
    #("Default: {0}. Range: {1}. An empty input or the default leaves the parameter at the type's default."@en,
      "Vorgabe: {0}. Bereich: {1}. Eine leere Eingabe oder die Vorgabe lässt den Parameter bei der Vorgabe des Typs."@de)
        .fill(blockDefault($parameter), if($range == null or $range == '', '–', $range)).localize()
})]]></expr>
		</derived-channel>
		<!-- What the last "Read diagnostics" told, with the virtual device it was read for. -->
		<channel name="diagnostics"/>
		<derived-channel name="diagnosticsText"
			inputs="block, diagnostics"
		>
			<expr><![CDATA[if($block == null, null,
    if($diagnostics != null and $diagnostics["block"] == $block, $diagnostics["text"],
        #("Not read yet: \"Read diagnostics\" asks the controller what the virtual device does."@en,
          "Noch nicht gelesen: „Diagnose lesen“ fragt den Controller, was das virtuelle Gerät tut."@de).localize()))]]></expr>
		</derived-channel>
		<derived-channel name="inputsFlag"
			expr="true"
			inputs="block"
		/>
		<derived-channel name="outputsFlag"
			expr="false"
			inputs="block"
		/>
		<derived-channel name="problem"
			inputs="block"
			observed-types="ehome.runtime:BlockInstance,ehome.runtime:BlockPort,ehome.runtime:BlockBinding,ehome.runtime:BlockParameter"
		>
			<expr><![CDATA[if($block == null, null, {
    problem = blockProblem($block);
    if($problem == null,
        #("The image accepts the virtual device."@en, "Das Abbild nimmt das virtuelle Gerät an."@de).localize(),
        #("The image refuses the virtual device:"@en, "Das Abbild lehnt das virtuelle Gerät ab:"@de).localize() + "\n" + $problem)
})]]></expr>
		</derived-channel>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="300"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Virtual devices</en>
						<de>Virtuelle Geräte</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-plus-lg"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>New virtual device</en>
								<de>Neues virtuelles Gerät</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog dialog-view="projects/block-create.view.xml">
								<bind
									channel="project"
									to="project"
								/>
								<bind
									channel="selection"
									to="block"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="block"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<access>
								<operation name="Delete"
									object="$block"
									type="ehome.runtime:BlockInstance"
								/>
								<operation name="Write"
									object="$block"
									type="ehome.runtime:BlockInstance"
								/>
							</access>
							<executability>
								<delete-veto-disabled/>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Delete the virtual device {0}? Its state and overrides on the controller go with the next image.'@en, 'Das virtuelle Gerät {0} löschen? Sein Zustand und seine Überschreibungen auf dem Controller gehen mit dem nächsten Abbild.'@de).fill($block.get(`ehome.runtime:BlockInstance#name`))"/>
							<delete-object/>
							<write-channel name="block" clear="true"/>
						</generic-command>
					</commands>
					<table
						observed-types="ehome.runtime:BlockInstance"
						selection="block"
						types="ehome.runtime:BlockInstance"
					>
						<inputs>
							<input channel="project"/>
						</inputs>
						<columns>
							<column attribute="name"/>
							<column attribute="room"/>
							<column attribute="identifier"/>
							<computed-column name="type"
								type="tl.core:String"
							>
								<label>
									<en>Type</en>
									<de>Typ</de>
								</label>
								<value>blockTypeLabel($row.get(`ehome.runtime:BlockInstance#blockType`) + " " + $row.get(`ehome.runtime:BlockInstance#version`))</value>
							</computed-column>
							<column attribute="enabled"/>
						</columns>
						<rows>if($project == null, [], $project.get(`ehome.project:Project#blocks`))</rows>
					</table>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="40"
							unit="%"
						>
							<panel>
								<title>
									<en>Virtual device</en>
									<de>Virtuelles Gerät</de>
								</title>
								<stack gap="default">
									<form
										input="block"
										with-inset="true"
									>
										<field attribute="name"/>
										<field attribute="room"/>
										<field attribute="enabled"/>
										<field attribute="enabledAdjustable"/>
										<field attribute="description"/>
										<field attribute="identifier"
											readonly="true"
										/>
										<field attribute="blockType"
											readonly="true"
										/>
										<field attribute="version"
											readonly="true"
										/>
									</form>
									<text
										input="problem"
										tone="secondary"
									/>
								</stack>
							</panel>
						</pane>
						<pane
							size="60"
							unit="%"
						>
							<tab-bar active-tab="parameters">
								<tabs>
									<tab id="parameters"
										icon="css:bi bi-sliders"
									>
										<label>
											<en>Parameters</en>
											<de>Parameter</de>
										</label>
										<split-panel
											orientation="vertical"
											resizable="true"
										>
											<panes>
												<pane
													size="70"
													unit="%"
												>
													<table
														observed-types="ehome.runtime:BlockParameter"
														selection="parameter"
														types="ehome.runtime:BlockParameter"
													>
														<inputs>
															<input channel="block"/>
														</inputs>
														<columns>
															<computed-column name="label"
																type="tl.core:String"
																width="220"
															>
																<label>
																	<en>Parameter</en>
																	<de>Parameter</de>
																</label>
																<value>blockLabel($row)</value>
															</computed-column>
															<computed-column name="value"
																type="tl.core:String"
																width="180"
															>
																<label>
																	<en>Value</en>
																	<de>Wert</de>
																</label>
																<value>blockValue($row)</value>
															</computed-column>
															<computed-column name="effective"
																type="tl.core:String"
																width="180"
															>
																<label>
																	<en>In the image</en>
																	<de>Im Abbild</de>
																</label>
																<value>blockEffective($row)</value>
															</computed-column>
															<computed-column name="default"
																type="tl.core:String"
																width="160"
															>
																<label>
																	<en>Default</en>
																	<de>Vorgabe</de>
																</label>
																<value>blockDefault($row)</value>
															</computed-column>
															<computed-column name="range"
																type="tl.core:String"
																width="260"
															>
																<label>
																	<en>Range</en>
																	<de>Bereich</de>
																</label>
																<value>blockRange($row)</value>
															</computed-column>
															<computed-column name="adjustable"
																type="tl.core:Boolean"
																width="100"
															>
																<label>
																	<en>Adjustable</en>
																	<de>Einstellbar</de>
																</label>
																<value>blockAdjustable($row)</value>
															</computed-column>
														</columns>
														<rows>if($block == null, [], $block.get(`ehome.runtime:BlockInstance#parameters`))</rows>
													</table>
												</pane>
												<pane
													size="30"
													unit="%"
												>
													<panel>
														<title>
															<en>Parameter</en>
															<de>Parameter</de>
														</title>
														<inset>
															<stack gap="default">
																<text input="parameterLabel"/>
																<switch input="parameterKind">
																	<case test="$parameterKind == 'boolean'">
																		<fields max-columns="1">
																			<value-input
																				type="tl.core:Boolean"
																				value="parameterValue"
																			>
																				<label>
																					<en>Value</en>
																					<de>Wert</de>
																				</label>
																				<on-submit inputs="parameter">
																					<access>
																						<operation name="Write"
																							object="$parameter"
																							type="ehome.runtime:BlockParameter"
																						/>
																					</access>
																					<with-transaction>
																						<execute-script function="blockApplyValue($parameter, $value)"/>
																						<with-result>
																							<notify
																								expr="$result"
																								kind="error"
																							/>
																						</with-result>
																					</with-transaction>
																				</on-submit>
																			</value-input>
																		</fields>
																	</case>
																	<case test="$parameterKind == 'choice'">
																		<fields max-columns="1">
																			<value-input
																				inputs="parameter"
																				options="blockChoiceOptions($parameter)"
																				type="tl.core:String"
																				value="parameterValue"
																			>
																				<label>
																					<en>Value</en>
																					<de>Wert</de>
																				</label>
																				<on-submit inputs="parameter">
																					<access>
																						<operation name="Write"
																							object="$parameter"
																							type="ehome.runtime:BlockParameter"
																						/>
																					</access>
																					<with-transaction>
																						<execute-script function="blockApplyValue($parameter, $value)"/>
																						<with-result>
																							<notify
																								expr="$result"
																								kind="error"
																							/>
																						</with-result>
																					</with-transaction>
																				</on-submit>
																			</value-input>
																		</fields>
																	</case>
																	<case test="$parameterKind == 'duration' or $parameterKind == 'number'">
																		<fields max-columns="1">
																			<value-input
																				submit-on="change"
																				type="tl.core:Double"
																				value="parameterValue"
																			>
																				<label>
																					<en>Value</en>
																					<de>Wert</de>
																				</label>
																				<!-- The number in the unit of the manifest, with as many decimals as it has (up to three). -->
																				<input-control class="com.top_logic.layout.view.form.NumberInputControlProvider"
																					inputs="parameterUnit as unit"
																					unit="$unit"
																				>
																					<format>
																						<decimal pattern="0.###"/>
																					</format>
																				</input-control>
																				<on-submit inputs="parameter">
																					<access>
																						<operation name="Write"
																							object="$parameter"
																							type="ehome.runtime:BlockParameter"
																						/>
																					</access>
																					<with-transaction>
																						<execute-script function="blockApplyValue($parameter, $value)"/>
																						<with-result>
																							<notify
																								expr="$result"
																								kind="error"
																							/>
																						</with-result>
																					</with-transaction>
																				</on-submit>
																			</value-input>
																		</fields>
																	</case>
																	<case test="$parameterKind == 'time'">
																		<fields max-columns="1">
																			<value-input
																				type="tl.core:Time"
																				value="parameterValue"
																			>
																				<label>
																					<en>Value</en>
																					<de>Wert</de>
																				</label>
																				<on-submit inputs="parameter">
																					<access>
																						<operation name="Write"
																							object="$parameter"
																							type="ehome.runtime:BlockParameter"
																						/>
																					</access>
																					<with-transaction>
																						<execute-script function="blockApplyValue($parameter, $value)"/>
																						<with-result>
																							<notify
																								expr="$result"
																								kind="error"
																							/>
																						</with-result>
																					</with-transaction>
																				</on-submit>
																			</value-input>
																		</fields>
																	</case>
																	<case test="$parameterKind == 'readonly'">
																		<text input="parameterEffective"/>
																	</case>
																</switch>
																<text
																	input="parameterHint"
																	tone="secondary"
																/>
															</stack>
														</inset>
													</panel>
												</pane>
											</panes>
										</split-panel>
									</tab>
									<tab id="inputs"
										icon="css:bi bi-box-arrow-in-right"
									>
										<label>
											<en>Inputs</en>
											<de>Eingänge</de>
										</label>
										<view-ref view="projects/block-ports.view.xml">
											<bind
												channel="block"
												to="block"
											/>
											<bind
												channel="port"
												to="input"
											/>
											<bind
												channel="binding"
												to="binding"
											/>
											<bind
												channel="inputs"
												to="inputsFlag"
											/>
										</view-ref>
									</tab>
									<tab id="outputs"
										icon="css:bi bi-box-arrow-right"
									>
										<label>
											<en>Outputs</en>
											<de>Ausgänge</de>
										</label>
										<view-ref view="projects/block-ports.view.xml">
											<bind
												channel="block"
												to="block"
											/>
											<bind
												channel="port"
												to="output"
											/>
											<bind
												channel="binding"
												to="binding"
											/>
											<bind
												channel="inputs"
												to="outputsFlag"
											/>
										</view-ref>
									</tab>
									<tab id="diagnostics"
										icon="css:bi bi-activity"
									>
										<label>
											<en>Diagnostics</en>
											<de>Diagnose</de>
										</label>
										<panel>
											<title>
												<en>On the controller</en>
												<de>Auf dem Controller</de>
											</title>
											<commands>
												<generic-command
													image="css:bi bi-arrow-clockwise"
													inputs="block"
													placement="TOOLBAR"
												>
													<label>
														<en>Read diagnostics</en>
														<de>Diagnose lesen</de>
													</label>
													<tooltip>
														<en>Asks the project's controller what the deployed virtual device does: status and fault, calls, the values of its inputs and outputs, timers and state; nothing is changed.</en>
														<de>Fragt den Controller des Projekts, was das bereitgestellte virtuelle Gerät tut: Status und Fehler, Aufrufe, die Werte seiner Ein- und Ausgänge, Timer und Zustand; es wird nichts geändert.</de>
													</tooltip>
													<access>
														<!-- Only asks the controller of the project (GET /api/blocks, with the stored token, in Java). -->
														<operation name="Read"
															object="$block"
															type="ehome.runtime:BlockInstance"
														/>
													</access>
													<executability>
														<null-input-disabled/>
													</executability>
													<block-diagnostics>
														<with-result>
															<write-channel name="diagnostics"/>
														</with-result>
													</block-diagnostics>
												</generic-command>
											</commands>
											<inset>
												<text input="diagnosticsText"/>
											</inset>
										</panel>
									</tab>
								</tabs>
							</tab-bar>
						</pane>
					</panes>
				</split-panel>
			</pane>
		</panes>
	</split-panel>
</view>
