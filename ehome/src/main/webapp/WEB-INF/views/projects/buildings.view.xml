<?xml version="1.0" encoding="utf-8" ?>

<!--
	The building structure of a project: buildings and their nested parts (floors, rooms, ...), parts
	only (haumacher/ehome #87). The selected part is shown beside the tree. Below, the tabs "In this
	building part" list what lies in the selected part and in all its sub-parts, each row with the
	part it is placed in ("Placed in"): the devices (ehome.physical:Device#location), the Zigbee
	devices (ehome.zigbee:ZigbeeDevice#location, haumacher/ehome #64), the virtual devices
	(ehome.runtime:BlockInstance#room, haumacher/ehome #75) and the group addresses in use: the
	connections of the devices placed in the part and in its sub-parts (BuildingDevices#connections),
	derived and stored nowhere, since ETS links group addresses to devices, not to building parts.
	A row opens its object in the object's own view by row activation (double-click, Enter or the
	button of the row): a device in the device view, a Zigbee device in the Zigbee tab, a virtual
	device in the tab "Virtual devices", a connection at its group address in the group-address view.

	The parts are ordered (haumacher/ehome #71): the import takes the order of the ETS project, and a
	part is moved by dragging it in the tree, to another place among its siblings or into another part.
	The runtime image of a controller lists the locations in this order.

	A device is placed in the selected part with the dialog projects/place-device.view.xml and
	removed from its part with "Remove the placement" (the device selected in the tab "Devices"); the
	device view chooses the location from the other side (projects/choose-location.view.xml). Zigbee
	devices are placed in the Zigbee tab, virtual devices in the tab "Virtual devices". The lists of
	a part are computed by Java functions (BuildingFunctions, BlockFunctions), hence the tables
	reading them observe the listed types and the building parts: a device placed in a sub-part
	appears in the tabs of its containers without reloading.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="selected"/>
		<!-- The selected part: the tree shows parts only. -->
		<derived-channel name="part"
			expr="if($selected.instanceOf(`ehome.building:BuildingDefinition`), $selected, null)"
			inputs="selected"
		/>
		<derived-channel name="partPath"
			expr="buildingPath($part)"
			inputs="part"
			observed-types="ehome.building:BuildingDefinition"
		/>
		<derived-channel name="container"
			expr="if($part != null, $part, $project)"
			inputs="project, part"
		/>
		<!-- The device selected in the table of the devices of the part. -->
		<channel name="selectedRow"/>
		<!-- The selected device: the row selected in the table of the devices of the part and its sub-parts. -->
		<derived-channel name="device"
			inputs="part, selectedRow"
			observed-types="ehome.physical:Device,ehome.building:BuildingDefinition"
		>
			<expr><![CDATA[if($selectedRow != null and $part != null and buildingAllDevices($part).containsElement($selectedRow), $selectedRow, null)]]></expr>
		</derived-channel>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="240"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Buildings</en>
						<de>Gebäude</de>
					</title>
					<commands>
						<generic-command
							clique="new"
							image="css:fa-solid fa-building"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Building</en>
								<de>Gebäude</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Building`)"/>
							</executability>
							<create-transient type="ehome.building:Building">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-building-circle-arrow-right"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Building part</en>
								<de>Gebäudeteil</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:BuildingPart`)"/>
							</executability>
							<create-transient type="ehome.building:BuildingPart">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-layer-group"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Floor</en>
								<de>Etage</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Floor`)"/>
							</executability>
							<create-transient type="ehome.building:Floor">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-door-open"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Room</en>
								<de>Raum</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Room`)"/>
							</executability>
							<create-transient type="ehome.building:Room">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-arrows-left-right"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Corridor</en>
								<de>Flur</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Corridor`)"/>
							</executability>
							<create-transient type="ehome.building:Corridor">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-stairs"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Stairway</en>
								<de>Treppenhaus</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Stairway`)"/>
							</executability>
							<create-transient type="ehome.building:Stairway">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-plug"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Distribution board</en>
								<de>Verteiler</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:DistributionBoard`)"/>
							</executability>
							<create-transient type="ehome.building:DistributionBoard">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-location-dot"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Location</en>
								<de>Ort</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Location`)"/>
							</executability>
							<create-transient type="ehome.building:Location">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="part"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Delete {0}?'@en, '{0} löschen?'@de).fill($part.label())"/>
							<delete-object/>
							<write-channel name="selected" clear="true"/>
						</generic-command>
						<generic-command
							image="css:bi bi-box-arrow-in-down-right"
							inputs="part"
							placement="TOOLBAR"
						>
							<label>
								<en>Place a device</en>
								<de>Gerät zuordnen</de>
							</label>
							<access>
								<operation name="Write"
									object="$part"
									type="ehome.building:BuildingDefinition"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="part"
								dialog-view="projects/place-device.view.xml"
							>
								<!-- The placed device is selected in the tab "Devices". -->
								<bind
									channel="selection"
									to="selectedRow"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-box-arrow-up-left"
							inputs="device"
							placement="TOOLBAR"
						>
							<label>
								<en>Remove the placement</en>
								<de>Zuordnung entfernen</de>
							</label>
							<access>
								<operation name="Write"
									object="$device"
									type="ehome.physical:Device"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Remove {0} from {1}?'@en, '{0} aus {1} entfernen?'@de).fill(deviceLabel($device), buildingPath($device.get(`ehome.physical:Device#location`)))"/>
							<with-transaction>
								<!-- The selected part stays selected. -->
								<execute-script>
									<function><![CDATA[{
    buildingPlace($device, null);
    $part
}]]></function>
									<inputs>
										<input channel="part"/>
									</inputs>
								</execute-script>
								<with-result>
									<write-channel name="selected"/>
								</with-result>
							</with-transaction>
						</generic-command>
					</commands>
					<!-- The structure with the columns of the classic tree grid (exported to Excel as an outline). -->
					<tree-table
						observed-types="ehome.building:BuildingDefinition"
						selection="selected"
					>
						<inputs>
							<input channel="project"/>
						</inputs>
						<root>$project</root>
						<children><![CDATA[switch {
    $node.instanceOf(`ehome.project:Project`):
        $node.get(`ehome.project:Project#buildings`);
    $node.instanceOf(`ehome.building:BuildingDefinition`):
        $node.get(`ehome.building:BuildingDefinition#parts`);
    default: [];
}]]></children>
						<parents>$node.container()</parents>
						<!--
							The parts of the buildings are ordered (haumacher/ehome #71): a part is dragged to its
							place, between two parts or onto a part as its first sub-part, also into another part
							of the project. BuildingDevices#moveVeto refuses (with its reason) a place that cannot
							hold a part of its type and a place inside the dragged part.
						-->
						<drag kind="buildingPart"/>
						<drop
							accept="buildingPart"
							input="project"
							refuse-if="buildingMoveVeto($objects, $parent, $before)"
							target="ordered"
						>
							<executability>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</executability>
							<with-transaction>
								<execute-script function="buildingMove($objects, $parent, $before)"/>
							</with-transaction>
						</drop>
						<export download-name="#('Buildings of {0}'@en, 'Gebäude von {0}'@de).fill($project.get(`ehome.project:Project#name`))">
							<sheet-name>
								<en>Buildings</en>
								<de>Gebäude</de>
							</sheet-name>
						</export>
						<columns>
							<computed-column name="name"
								width="280"
							>
								<label>
									<en>Name</en>
									<de>Name</de>
								</label>
								<value>$row</value>
							</computed-column>
							<computed-column name="type"
								width="140"
							>
								<label>
									<en>Type</en>
									<de>Typ</de>
								</label>
								<value>$row.type()</value>
							</computed-column>
							<computed-column name="extId"
								type="tl.core:String"
								width="160"
							>
								<label>
									<en>External ID</en>
									<de>Externe ID</de>
								</label>
								<value>if($row.instanceOf(`ehome.core:Externalized`), $row.get(`ehome.core:Externalized#extId`), null)</value>
							</computed-column>
						</columns>
					</tree-table>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<!--
					Above, the selected part; below, what lies in it and in its sub-parts.
				-->
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="40"
							unit="%"
						>
							<panel>
								<title>
									<en>Details</en>
									<de>Details</de>
								</title>
								<visible-if
									expr="$part != null"
									input="part"
								>
									<stack>
										<inset>
											<text
												input="partPath"
												variant="title"
											/>
										</inset>
										<form
											input="part"
											with-inset="true"
										>
											<field attribute="name"/>
											<field attribute="extId"/>
										</form>
									</stack>
								</visible-if>
							</panel>
						</pane>
						<pane
							size="60"
							unit="%"
						>
							<panel>
								<title>
									<en>In this building part</en>
									<de>In diesem Gebäudeteil</de>
								</title>
								<tab-bar active-tab="devices">
									<tabs>
										<tab id="devices"
											icon="css:fa-solid fa-mobile-screen-button"
										>
											<label>
												<en>Devices</en>
												<de>Geräte</de>
											</label>
											<!-- The devices placed in the part and in its sub-parts, by individual address. -->
											<table
												observed-types="ehome.physical:Device,ehome.building:BuildingDefinition"
												selection="selectedRow"
												types="ehome.physical:Device"
											>
												<inputs>
													<input channel="part"/>
												</inputs>
												<columns>
													<computed-column name="device"
														type="tl.core:String"
														width="240"
													>
														<label>
															<en>Device</en>
															<de>Gerät</de>
														</label>
														<value>deviceLabel($row)</value>
													</computed-column>
													<column attribute="type"
														width="260"
													/>
													<column attribute="description"
														width="200"
													/>
													<computed-column name="location"
														type="tl.core:String"
														width="200"
													>
														<label>
															<en>Placed in</en>
															<de>Platziert in</de>
														</label>
														<value>buildingPath($row.get(`ehome.physical:Device#location`))</value>
													</computed-column>
												</columns>
												<rows>if($part == null, [], buildingAllDevices($part))</rows>
												<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
													image="css:bi bi-box-arrow-up-right"
												>
													<label>
														<en>Go to the device</en>
														<de>Zum Gerät</de>
													</label>
													<show-views>
														<show frame="project"
															label-expr="recursion($row, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement().get(`ehome.project:Project#name`)"
														>
															<bind
																channel="project"
																expr="recursion($row, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
															/>
														</show>
														<show view="projects/devices.view.xml">
															<bind channel="selected"/>
														</show>
													</show-views>
												</on-activate>
											</table>
										</tab>
										<tab id="zigbeeDevices"
											icon="css:bi bi-broadcast-pin"
										>
											<label>
												<en>Zigbee devices</en>
												<de>Zigbee-Geräte</de>
											</label>
											<!-- The Zigbee devices placed in the part and in its sub-parts, by name. -->
											<table
												observed-types="ehome.zigbee:ZigbeeDevice,ehome.building:BuildingDefinition"
												types="ehome.zigbee:ZigbeeDevice"
											>
												<inputs>
													<input channel="part"/>
												</inputs>
												<columns>
													<column attribute="name"
														width="240"
													/>
													<column attribute="manufacturer"
														width="160"
													/>
													<column attribute="model"
														width="160"
													/>
													<column attribute="ieee"
														width="160"
													/>
													<computed-column name="location"
														type="tl.core:String"
														width="200"
													>
														<label>
															<en>Placed in</en>
															<de>Platziert in</de>
														</label>
														<value>buildingPath($row.get(`ehome.zigbee:ZigbeeDevice#location`))</value>
													</computed-column>
												</columns>
												<rows>if($part == null, [], buildingAllZigbeeDevices($part))</rows>
												<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
													image="css:bi bi-box-arrow-up-right"
												>
													<label>
														<en>Go to the Zigbee device</en>
														<de>Zum Zigbee-Gerät</de>
													</label>
													<show-views>
														<show frame="project"
															label-expr="recursion($row, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement().get(`ehome.project:Project#name`)"
														>
															<bind
																channel="project"
																expr="recursion($row, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
															/>
														</show>
														<show view="projects/zigbee.view.xml">
															<bind channel="device"/>
														</show>
													</show-views>
												</on-activate>
											</table>
										</tab>
										<tab id="blocks"
											icon="css:bi bi-cpu"
										>
											<label>
												<en>Virtual devices</en>
												<de>Virtuelle Geräte</de>
											</label>
											<!-- The virtual devices of the part and of its sub-parts (haumacher/ehome #75), edited in the project's tab "Virtual devices". -->
											<table
												observed-types="ehome.runtime:BlockInstance,ehome.building:BuildingDefinition"
												types="ehome.runtime:BlockInstance"
											>
												<inputs>
													<input channel="part"/>
												</inputs>
												<columns>
													<column attribute="name"
														width="240"
													/>
													<column attribute="identifier"
														width="160"
													/>
													<computed-column name="type"
														type="tl.core:String"
														width="200"
													>
														<label>
															<en>Type</en>
															<de>Typ</de>
														</label>
														<value>blockTypeLabel($row.get(`ehome.runtime:BlockInstance#blockType`) + " " + $row.get(`ehome.runtime:BlockInstance#version`))</value>
													</computed-column>
													<column attribute="enabled"
														width="100"
													/>
													<computed-column name="location"
														type="tl.core:String"
														width="200"
													>
														<label>
															<en>Placed in</en>
															<de>Platziert in</de>
														</label>
														<value>buildingPath($row.get(`ehome.runtime:BlockInstance#room`))</value>
													</computed-column>
												</columns>
												<rows>if($part == null, [], blockAllRoomInstances($part))</rows>
												<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
													image="css:bi bi-box-arrow-up-right"
												>
													<label>
														<en>Go to the virtual device</en>
														<de>Zum virtuellen Gerät</de>
													</label>
													<show-views>
														<show frame="project"
															label-expr="recursion($row, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement().get(`ehome.project:Project#name`)"
														>
															<bind
																channel="project"
																expr="recursion($row, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
															/>
														</show>
														<show view="projects/blocks.view.xml">
															<bind channel="block"/>
														</show>
													</show-views>
												</on-activate>
											</table>
										</tab>
										<tab id="addresses"
											icon="css:fa-solid fa-wifi"
										>
											<label>
												<en>Group addresses in use</en>
												<de>Verwendete Gruppenadressen</de>
											</label>
											<!--
												The group addresses the devices placed in the part and in its sub-parts are
												connected to, one row per connection; a row opens its group address.
											-->
											<table
												observed-types="ehome.physical:Connection,ehome.physical:Connector,ehome.physical:Device,ehome.building:BuildingDefinition"
												types="ehome.physical:Connection"
											>
												<inputs>
													<input channel="part"/>
												</inputs>
												<columns>
													<column attribute="target"
														width="200"
													>
														<label>
															<en>Group address</en>
															<de>Gruppenadresse</de>
														</label>
													</column>
													<computed-column name="device"
														type="tl.core:String"
														width="200"
													>
														<label>
															<en>Device</en>
															<de>Gerät</de>
														</label>
														<value>deviceLabel(connectionDevice($row))</value>
													</computed-column>
													<computed-column name="number"
														type="tl.core:Integer"
														width="90"
													>
														<label>
															<en>No.</en>
															<de>Nr.</de>
														</label>
														<value>connectionObject($row).get(`ehome.operational:Interface#port`).get(`ehome.operational:Port#index`)</value>
													</computed-column>
													<computed-column name="object"
														type="tl.core:String"
														width="170"
													>
														<label>
															<en>Object</en>
															<de>Objekt</de>
														</label>
														<value>connectionObjectText($row)</value>
													</computed-column>
													<column attribute="kind"
														width="130"
													>
														<label>
															<en>Direction</en>
															<de>Richtung</de>
														</label>
													</column>
													<computed-column name="location"
														type="tl.core:String"
														width="200"
													>
														<label>
															<en>Placed in</en>
															<de>Platziert in</de>
														</label>
														<value>buildingPath(connectionDevice($row).get(`ehome.physical:Device#location`))</value>
													</computed-column>
												</columns>
												<rows>if($part == null, [], buildingConnections($part))</rows>
												<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
													image="css:bi bi-box-arrow-up-right"
												>
													<label>
														<en>Go to the group address</en>
														<de>Zur Gruppenadresse</de>
													</label>
													<show-views>
														<show frame="project"
															label-expr="recursion($row, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement().get(`ehome.project:Project#name`)"
														>
															<bind
																channel="project"
																expr="recursion($row, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
															/>
														</show>
														<show view="projects/addresses.view.xml">
															<bind
																channel="selected"
																expr="$row.get(`ehome.physical:Connection#target`)"
															/>
														</show>
													</show-views>
												</on-activate>
											</table>
										</tab>
									</tabs>
								</tab-bar>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</pane>
		</panes>
	</split-panel>
</view>
