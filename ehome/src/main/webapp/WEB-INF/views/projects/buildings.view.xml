<?xml version="1.0" encoding="utf-8" ?>

<!--
	The building structure of a project: buildings and their nested parts (floors, rooms, ...), and
	under each part the devices placed in it (ehome.physical:Device#location, labelled with name and
	individual address by deviceLabel), after its sub-parts. The selected node is shown beside the
	tree: a part, or a placed device with the way to it in the device view ("Go to the device").
	Below, for the selected part (or the part of the selected device), the devices placed in it and
	the group addresses in use in it: the connections of the devices placed in the part and in its
	sub-parts (BuildingDevices#connections), derived and stored nowhere, since ETS links group
	addresses to devices, not to building parts.

	A device is placed in the selected part with the dialog projects/place-device.view.xml and
	removed from it with "Remove the placement"; the device view chooses the location from the other
	side (projects/choose-location.view.xml). The devices of a part are computed by Java functions
	(BuildingFunctions), hence the tree, the tables and the channels reading them observe the
	devices: a device placed in the device view appears here, and the other way round, without
	reloading.

	The Zigbee devices placed in a part (ehome.zigbee:ZigbeeDevice#location, haumacher/ehome #64) appear
	the same way, after the KNX devices: in the tree under the part, in the tab "Zigbee devices" of the
	part (the backwards reference BuildingDefinition#zigbeeDevices) and, selected, with a form of their
	own and the way to them in the Zigbee tab ("Go to the Zigbee device"). They are placed in the
	Zigbee tab.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="selected"/>
		<derived-channel name="selectedPart"
			expr="if($selected.instanceOf(`ehome.building:BuildingDefinition`), $selected, null)"
			inputs="selected"
		/>
		<!-- The selected part, or the part the selected (KNX or Zigbee) device is placed in. -->
		<derived-channel name="part"
			inputs="selected"
			observed-types="ehome.physical:Device,ehome.zigbee:ZigbeeDevice"
		>
			<expr><![CDATA[switch {
    $selected.instanceOf(`ehome.physical:Device`): $selected.get(`ehome.physical:Device#location`);
    $selected.instanceOf(`ehome.zigbee:ZigbeeDevice`): $selected.get(`ehome.zigbee:ZigbeeDevice#location`);
    $selected.instanceOf(`ehome.building:BuildingDefinition`): $selected;
    default: null;
}]]></expr>
		</derived-channel>
		<!-- The selected Zigbee device node. -->
		<derived-channel name="zigbeeDevice"
			expr="if($selected.instanceOf(`ehome.zigbee:ZigbeeDevice`), $selected, null)"
			inputs="selected"
		/>
		<!-- Where the selected Zigbee device node is placed, as the path of its building part. -->
		<derived-channel name="zigbeeLocationPath"
			expr="if($selected.instanceOf(`ehome.zigbee:ZigbeeDevice`), buildingPath($selected.get(`ehome.zigbee:ZigbeeDevice#location`)), null)"
			inputs="selected"
			observed-types="ehome.zigbee:ZigbeeDevice,ehome.building:BuildingDefinition"
		/>
		<derived-channel name="partPath"
			expr="buildingPath($part)"
			inputs="part"
			observed-types="ehome.building:BuildingDefinition"
		/>
		<derived-channel name="container"
			expr="if($part != null, $part, $project)"
			inputs="project, part"
		/>
		<!-- The device selected in the table of the devices of the part. -->
		<channel name="selectedRow"/>
		<!-- The selected device: the node selected in the tree, or the row selected in the table of the devices of the part. -->
		<derived-channel name="device"
			inputs="selected, part, selectedRow"
			observed-types="ehome.physical:Device"
		>
			<expr><![CDATA[switch {
    $selected.instanceOf(`ehome.physical:Device`): $selected;
    $selectedRow != null and $part != null and buildingDevices($part).containsElement($selectedRow): $selectedRow;
    default: null;
}]]></expr>
		</derived-channel>
		<!-- Where the selected device node is placed, as the path of its building part. -->
		<derived-channel name="locationPath"
			expr="if($selected.instanceOf(`ehome.physical:Device`), buildingPath($selected.get(`ehome.physical:Device#location`)), null)"
			inputs="selected"
			observed-types="ehome.physical:Device,ehome.building:BuildingDefinition"
		/>
		<derived-channel name="deviceText"
			expr="deviceLabel($device)"
			inputs="device"
			observed-types="ehome.physical:Device"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="240"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Buildings</en>
						<de>Gebäude</de>
					</title>
					<commands>
						<generic-command
							clique="new"
							image="css:fa-solid fa-building"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Building</en>
								<de>Gebäude</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Building`)"/>
							</executability>
							<create-transient type="ehome.building:Building">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-building-circle-arrow-right"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Building part</en>
								<de>Gebäudeteil</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:BuildingPart`)"/>
							</executability>
							<create-transient type="ehome.building:BuildingPart">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-layer-group"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Floor</en>
								<de>Etage</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Floor`)"/>
							</executability>
							<create-transient type="ehome.building:Floor">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-door-open"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Room</en>
								<de>Raum</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Room`)"/>
							</executability>
							<create-transient type="ehome.building:Room">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-arrows-left-right"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Corridor</en>
								<de>Flur</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Corridor`)"/>
							</executability>
							<create-transient type="ehome.building:Corridor">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-stairs"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Stairway</en>
								<de>Treppenhaus</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Stairway`)"/>
							</executability>
							<create-transient type="ehome.building:Stairway">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-plug"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Distribution board</en>
								<de>Verteiler</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:DistributionBoard`)"/>
							</executability>
							<create-transient type="ehome.building:DistributionBoard">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-location-dot"
							inputs="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Location</en>
								<de>Ort</de>
							</label>
							<access>
								<operation name="Write"
									object="$container"
									type="ehome.core:Externalized"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="buildingInsertVeto($container, `ehome.building:Location`)"/>
							</executability>
							<create-transient type="ehome.building:Location">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="container"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="selectedPart"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Delete {0}?'@en, '{0} löschen?'@de).fill($selectedPart.label())"/>
							<delete-object/>
							<write-channel name="selected" clear="true"/>
						</generic-command>
						<generic-command
							image="css:bi bi-box-arrow-in-down-right"
							inputs="part"
							placement="TOOLBAR"
						>
							<label>
								<en>Place a device</en>
								<de>Gerät zuordnen</de>
							</label>
							<access>
								<operation name="Write"
									object="$part"
									type="ehome.building:BuildingDefinition"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="part"
								dialog-view="projects/place-device.view.xml"
							>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-box-arrow-up-left"
							inputs="device"
							placement="TOOLBAR"
						>
							<label>
								<en>Remove the placement</en>
								<de>Zuordnung entfernen</de>
							</label>
							<access>
								<operation name="Write"
									object="$device"
									type="ehome.physical:Device"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Remove {0} from {1}?'@en, '{0} aus {1} entfernen?'@de).fill(deviceLabel($device), buildingPath($device.get(`ehome.physical:Device#location`)))"/>
							<with-transaction>
								<!-- The part the device was placed in is selected afterwards. -->
								<execute-script>
									<function><![CDATA[{
    buildingPlace($device, null);
    $part
}]]></function>
									<inputs>
										<input channel="part"/>
									</inputs>
								</execute-script>
								<with-result>
									<write-channel name="selected"/>
								</with-result>
							</with-transaction>
						</generic-command>
						<generic-command
							image="css:bi bi-box-arrow-up-right"
							inputs="device"
							placement="TOOLBAR"
						>
							<label>
								<en>Go to the device</en>
								<de>Zum Gerät</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<show-views>
								<show frame="project"
									label-expr="recursion($device, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement().get(`ehome.project:Project#name`)"
								>
									<bind
										channel="project"
										expr="recursion($device, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
									/>
								</show>
								<show view="projects/devices.view.xml">
									<bind channel="selected"/>
								</show>
							</show-views>
						</generic-command>
						<generic-command
							image="css:bi bi-box-arrow-up-right"
							inputs="zigbeeDevice"
							placement="TOOLBAR"
						>
							<label>
								<en>Go to the Zigbee device</en>
								<de>Zum Zigbee-Gerät</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<show-views>
								<show frame="project"
									label-expr="$zigbeeDevice.container().get(`ehome.project:Project#name`)"
								>
									<bind
										channel="project"
										expr="$zigbeeDevice.container()"
									/>
								</show>
								<show view="projects/zigbee.view.xml">
									<bind channel="device"/>
								</show>
							</show-views>
						</generic-command>
					</commands>
					<!--
						The structure with the columns of the classic tree grid (exported to Excel as an outline);
						a placed device is labelled with its individual address. A device placed in a part from
						elsewhere (the device view, the Zigbee tab) is placed in the tree through "parents".
					-->
					<tree-table
						observed-types="ehome.building:BuildingDefinition,ehome.physical:Device,ehome.zigbee:ZigbeeDevice"
						selection="selected"
					>
						<inputs>
							<input channel="project"/>
						</inputs>
						<root>$project</root>
						<children><![CDATA[switch {
    $node.instanceOf(`ehome.project:Project`):
        $node.get(`ehome.project:Project#buildings`);
    $node.instanceOf(`ehome.building:BuildingDefinition`):
        concat(
            $node.get(`ehome.building:BuildingDefinition#parts`),
            buildingDevices($node),
            $node.get(`ehome.building:BuildingDefinition#zigbeeDevices`).sort(a -> b -> compare($a.get(`ehome.zigbee:ZigbeeDevice#name`), $b.get(`ehome.zigbee:ZigbeeDevice#name`))));
    default: [];
}]]></children>
						<parents><![CDATA[switch {
    $node.instanceOf(`ehome.physical:Device`): $node.get(`ehome.physical:Device#location`);
    $node.instanceOf(`ehome.zigbee:ZigbeeDevice`): $node.get(`ehome.zigbee:ZigbeeDevice#location`);
    default: $node.container();
}]]></parents>
						<export download-name="#('Buildings of {0}'@en, 'Gebäude von {0}'@de).fill($project.get(`ehome.project:Project#name`))">
							<sheet-name>
								<en>Buildings</en>
								<de>Gebäude</de>
							</sheet-name>
						</export>
						<columns>
							<computed-column name="name"
								width="280"
							>
								<label>
									<en>Name</en>
									<de>Name</de>
								</label>
								<value>$row</value>
								<display class="com.top_logic.layout.view.element.ResourceDisplayByExpression"
									label="if($value.instanceOf(`ehome.physical:Device`), deviceLabel($value), null)"
								/>
							</computed-column>
							<computed-column name="type"
								width="140"
							>
								<label>
									<en>Type</en>
									<de>Typ</de>
								</label>
								<value>$row.type()</value>
							</computed-column>
							<computed-column name="extId"
								type="tl.core:String"
								width="160"
							>
								<label>
									<en>External ID</en>
									<de>Externe ID</de>
								</label>
								<value>if($row.instanceOf(`ehome.core:Externalized`), $row.get(`ehome.core:Externalized#extId`), null)</value>
							</computed-column>
						</columns>
					</tree-table>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<!--
					Above, the selected node; below, the devices of the selected part (or of the part of
					the selected device) and the group addresses in use in it, for the part of a selected
					device as well as for a selected part.
				-->
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="40"
							unit="%"
						>
							<panel>
								<title>
									<en>Details</en>
									<de>Details</de>
								</title>
								<switch input="selected">
									<case test="$selected.instanceOf(`ehome.building:BuildingDefinition`)">
										<stack>
											<inset>
												<text
													input="partPath"
													variant="title"
												/>
											</inset>
											<form
												input="selectedPart"
												with-inset="true"
											>
												<field attribute="name"/>
												<field attribute="extId"/>
											</form>
										</stack>
									</case>
									<case test="$selected.instanceOf(`ehome.physical:Device`)">
										<!-- A placed device; it is configured in the device view ("Go to the device"). -->
										<stack>
											<inset>
												<text
													input="deviceText"
													variant="title"
												/>
											</inset>
											<form
												input="selected"
												with-inset="true"
												withEditMode="false"
											>
												<field attribute="name"/>
												<field attribute="type"/>
												<value-input
													readonly="true"
													type="tl.core:String"
													value="locationPath"
												>
													<label>
														<en>Location</en>
														<de>Standort</de>
													</label>
												</value-input>
												<field attribute="description"/>
												<field attribute="installationHints"/>
											</form>
										</stack>
									</case>
									<case test="$selected.instanceOf(`ehome.zigbee:ZigbeeDevice`)">
										<!-- A placed Zigbee device; it is named, placed and bound in the Zigbee tab ("Go to the Zigbee device"). -->
										<form
											input="selected"
											with-inset="true"
											withEditMode="false"
										>
											<field attribute="name"/>
											<value-input
												readonly="true"
												type="tl.core:String"
												value="zigbeeLocationPath"
											>
												<label>
													<en>Location</en>
													<de>Standort</de>
												</label>
											</value-input>
											<field attribute="manufacturer"/>
											<field attribute="model"/>
											<field attribute="ieee"/>
										</form>
									</case>
								</switch>
							</panel>
						</pane>
						<pane
							size="60"
							unit="%"
						>
							<panel>
								<title>
									<en>In this building part</en>
									<de>In diesem Gebäudeteil</de>
								</title>
								<tab-bar active-tab="devices">
									<tabs>
										<tab id="devices"
											icon="css:fa-solid fa-mobile-screen-button"
										>
											<label>
												<en>Devices</en>
												<de>Geräte</de>
											</label>
											<table
												observed-types="ehome.physical:Device"
												selection="selectedRow"
												types="ehome.physical:Device"
											>
												<inputs>
													<input channel="part"/>
												</inputs>
												<columns>
													<computed-column name="device"
														type="tl.core:String"
														width="240"
													>
														<label>
															<en>Device</en>
															<de>Gerät</de>
														</label>
														<value>deviceLabel($row)</value>
													</computed-column>
													<column attribute="type"
														width="260"
													/>
													<column attribute="description"
														width="200"
													/>
												</columns>
												<rows>if($part == null, [], buildingDevices($part))</rows>
											</table>
										</tab>
										<tab id="zigbeeDevices"
											icon="css:bi bi-broadcast-pin"
										>
											<label>
												<en>Zigbee devices</en>
												<de>Zigbee-Geräte</de>
											</label>
											<table
												observed-types="ehome.zigbee:ZigbeeDevice"
												types="ehome.zigbee:ZigbeeDevice"
											>
												<inputs>
													<input channel="part"/>
												</inputs>
												<columns>
													<column attribute="name"
														width="240"
													/>
													<column attribute="manufacturer"
														width="160"
													/>
													<column attribute="model"
														width="160"
													/>
													<column attribute="ieee"
														width="160"
													/>
												</columns>
												<rows>if($part == null, [], $part.get(`ehome.building:BuildingDefinition#zigbeeDevices`).sort(a -> b -> compare($a.get(`ehome.zigbee:ZigbeeDevice#name`), $b.get(`ehome.zigbee:ZigbeeDevice#name`))))</rows>
											</table>
										</tab>
										<tab id="addresses"
											icon="css:fa-solid fa-wifi"
										>
											<label>
												<en>Group addresses in use</en>
												<de>Verwendete Gruppenadressen</de>
											</label>
											<!--
												The group addresses the devices placed in the part and in its sub-parts are
												connected to, one row per connection.
											-->
											<table
												observed-types="ehome.physical:Connection,ehome.physical:Connector,ehome.physical:Device,ehome.building:BuildingDefinition"
												types="ehome.physical:Connection"
											>
												<inputs>
													<input channel="part"/>
												</inputs>
												<columns>
													<column attribute="target"
														width="200"
													>
														<label>
															<en>Group address</en>
															<de>Gruppenadresse</de>
														</label>
													</column>
													<computed-column name="device"
														type="tl.core:String"
														width="200"
													>
														<label>
															<en>Device</en>
															<de>Gerät</de>
														</label>
														<value>deviceLabel(connectionDevice($row))</value>
													</computed-column>
													<computed-column name="number"
														type="tl.core:Integer"
														width="90"
													>
														<label>
															<en>No.</en>
															<de>Nr.</de>
														</label>
														<value>connectionObject($row).get(`ehome.operational:Interface#port`).get(`ehome.operational:Port#index`)</value>
													</computed-column>
													<computed-column name="object"
														type="tl.core:String"
														width="170"
													>
														<label>
															<en>Object</en>
															<de>Objekt</de>
														</label>
														<value>connectionObject($row).get(`ehome.operational:Interface#displayName`)</value>
													</computed-column>
													<column attribute="kind"
														width="130"
													>
														<label>
															<en>Direction</en>
															<de>Richtung</de>
														</label>
													</column>
													<computed-column name="location"
														type="tl.core:String"
														width="200"
													>
														<label>
															<en>Placed in</en>
															<de>Platziert in</de>
														</label>
														<value>buildingPath(connectionDevice($row).get(`ehome.physical:Device#location`))</value>
													</computed-column>
												</columns>
												<rows>if($part == null, [], buildingConnections($part))</rows>
											</table>
										</tab>
									</tabs>
								</tab-bar>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</pane>
		</panes>
	</split-panel>
</view>
