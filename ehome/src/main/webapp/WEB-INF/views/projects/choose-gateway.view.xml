<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog choosing the path of a project to the bus: its KNX gateway (ehome.project:Project#gateway), an
	address entered (address or address:port) or a gateway the search found (its control endpoint); or
	one of the project's enrolled controllers (ehome.project:Project#programmingController, haumacher/ehome
	#148), through whose bus session E-Home programs and reads the devices. The two are exclusive: "Use"
	sets the one chosen and clears the other; there is no fallback from one to the other.

	"project" is the project. The dialog opens with the current path filled in: the gateway's address
	in the field, or the controller selected in its table. The search is the one of discover.view.xml
	with its default settings (<discover-knx-gateways>, de.haumacher.ehome.discover.DiscoverGatewaysAction).
	What differs from the current path wins: an address entered (or a gateway selected from the search,
	while the field still holds the current address), or another controller selected; a new gateway and
	a new controller chosen together are refused. The decision is the channel "choice", which "Use" carries
	out; the line above the buttons ("outcome") states it before, so that it is visible which of the
	address and the controller "Use" takes (haumacher/ehome #161).
	The table of controllers shows each one's connection state (controllerConnection) and whether
	programming through it is possible now (controllerBusState: connected, firmware with the bus
	session, no session open); a controller that cannot be used now can still be chosen, the commands
	using the path then say why.

	Unless the installation reaches local networks (configuration variable tl_ehome_local_network,
	haumacher/ehome #150, TL-Script localNetworkVeto()), the dialog offers neither the search nor the entry
	of an address and says why; the controllers stay available.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="gateways"/>
		<channel name="selectedGateway"/>
		<!-- The current path, pre-filled: the gateway's address, or the controller selected in its table. -->
		<channel name="address"
			init="$project.get(`ehome.project:Project#gateway`)"
			inputs="project"
		/>
		<channel name="selectedController"
			init="$project.get(`ehome.project:Project#programmingController`)"
			inputs="project"
		/>
		<!--
			What "Use" sets: {"gateway": address} or {"controller": controller}, or {"error": reason} when nothing
			or both a new gateway and a new controller are chosen.
		-->
		<derived-channel name="choice"
			inputs="project, address, selectedGateway, selectedController"
		>
			<expr><![CDATA[{
    current = $project.get(`ehome.project:Project#gateway`);
    entered = if($address == null or $address.trim() == "", null, $address.trim());
    found = if($selectedGateway == null, null, $selectedGateway["endpoint"]);
    gateway = if($found != null and ($entered == null or $entered == $current), $found, $entered);
    newGateway = $gateway != null and $gateway != $current;
    newController = $selectedController != null and $selectedController != $project.get(`ehome.project:Project#programmingController`);
    if($newGateway and $newController,
        {"error": #("A new gateway and a new controller are chosen: clear the address or choose the current controller again."@en, "Ein neues Gateway und ein neuer Controller sind gewählt: Bitte die Adresse leeren oder wieder den aktuellen Controller wählen."@de)},
        if($newController or ($gateway == null and $selectedController != null),
            {"controller": $selectedController},
            if($gateway != null,
                {"gateway": $gateway},
                {"error": #("Enter an address, choose a gateway the search found or choose a controller."@en, "Bitte eine Adresse eingeben, ein gefundenes Gateway oder einen Controller wählen."@de)})));
}]]></expr>
		</derived-channel>
		<!-- The decision for a person, shown above the buttons. -->
		<derived-channel name="outcome"
			inputs="choice"
		>
			<expr><![CDATA[
if($choice["error"] != null,
    $choice["error"].localize(),
    if($choice["controller"] != null,
        #("\"Use\" sets the path through the controller {0}; the gateway address of the project is removed."@en, "„Übernehmen“ legt den Weg über den Controller {0} fest; die Gateway-Adresse des Projekts wird entfernt."@de).fill($choice["controller"].get(`ehome.runtime:Controller#name`)).localize(),
        #("\"Use\" sets the path through the gateway {0}; the controller of the project is no longer used for programming."@en, "„Übernehmen“ legt den Weg über das Gateway {0} fest; der Controller des Projekts wird zum Programmieren nicht mehr verwendet."@de).fill($choice["gateway"]).localize()))
]]></expr>
		</derived-channel>
		<derived-channel name="current"
			expr='#("Current path to the bus: {0}"@en, "Aktueller Weg zum Bus: {0}"@de).fill(if(busPath($project) == null, "-", busPath($project))).localize()'
			inputs="project"
		/>
		<!-- Why this installation does not reach local networks, null if it does (haumacher/ehome #150). -->
		<derived-channel name="localNetworkVeto"
			expr="localNetworkVeto()"
		/>
		<derived-channel name="localNetworkReason"
			expr="if($localNetworkVeto == null, null, $localNetworkVeto.localize())"
			inputs="localNetworkVeto"
		/>
	</channels>
	<window width="800px">
		<title>
			<en>Choose the gateway or controller</en>
			<de>Gateway oder Controller wählen</de>
		</title>
		<inset>
			<stack gap="default">
				<text input="current"
					tone="secondary"
				/>
				<panel>
					<title>
						<en>Through a KNXnet/IP gateway</en>
						<de>Über ein KNXnet/IP-Gateway</de>
					</title>
					<inset>
						<switch input="localNetworkVeto">
							<case test="$localNetworkVeto == null">
								<stack gap="default">
									<button>
										<action class="com.top_logic.layout.view.command.GenericViewCommand"
											image="css:bi bi-broadcast"
											inputs="project"
										>
											<label>
												<en>Search gateways</en>
												<de>Gateways suchen</de>
											</label>
											<access>
												<!-- The search only lists the gateways that answer, for the project. -->
												<operation name="Read"
													object="$project"
													type="ehome.project:Project"
												/>
											</access>
											<discover-knx-gateways>
												<with-result as="rows">
													<write-channel name="gateways"/>
													<notify expr="if($rows.isEmpty(), #('No gateway answered.'@en, 'Kein Gateway hat geantwortet.'@de))"
														kind="warning"
													/>
												</with-result>
											</discover-knx-gateways>
										</action>
									</button>
									<fields>
										<value-input
											type="tl.core:String"
											value="address"
										>
											<label>
												<en>Address (address or address:port)</en>
												<de>Adresse (Adresse oder Adresse:Port)</de>
											</label>
										</value-input>
									</fields>
									<table selection="selectedGateway">
										<inputs>
											<input channel="gateways"/>
										</inputs>
										<columns>
											<computed-column name="name"
												type="tl.core:String"
											>
												<label>
													<en>Name</en>
													<de>Name</de>
												</label>
												<value>$row["name"]</value>
											</computed-column>
											<computed-column name="endpoint"
												type="tl.core:String"
											>
												<label>
													<en>Control endpoint</en>
													<de>Steuerungs-Endpunkt</de>
												</label>
												<value>$row["endpoint"]</value>
											</computed-column>
											<computed-column name="address"
												type="tl.core:String"
											>
												<label>
													<en>Individual address</en>
													<de>Physikalische Adresse</de>
												</label>
												<value>$row["address"]</value>
											</computed-column>
											<computed-column name="mac"
												type="tl.core:String"
											>
												<label>
													<en>MAC address</en>
													<de>MAC-Adresse</de>
												</label>
												<value>$row["mac"]</value>
											</computed-column>
										</columns>
										<rows>if($gateways == null, [], $gateways)</rows>
									</table>
								</stack>
							</case>
							<default>
								<text
									input="localNetworkReason"
									tone="secondary"
								/>
							</default>
						</switch>
					</inset>
				</panel>
				<panel>
					<title>
						<en>Through a controller of the project</en>
						<de>Über einen Controller des Projekts</de>
					</title>
					<inset>
						<stack gap="compact">
							<text tone="helper"
								variant="caption"
							>
								<label>
									<en>The controller connected to E-Home passes the frames through its KNX tunnel (bus session); its firmware must have the bus session. Only enrolled controllers are listed.</en>
									<de>Der mit E-Home verbundene Controller leitet die Telegramme durch seinen KNX-Tunnel (Bus-Sitzung); seine Firmware muss die Bus-Sitzung kennen. Aufgeführt sind nur angemeldete Controller.</de>
								</label>
							</text>
							<table selection="selectedController">
								<inputs>
									<input channel="project"/>
								</inputs>
								<columns>
									<computed-column name="name"
										type="tl.core:String"
									>
										<label>
											<en>Name</en>
											<de>Name</de>
										</label>
										<value>$row.get(`ehome.runtime:Controller#name`)</value>
									</computed-column>
									<computed-column name="connection"
										type="tl.core:String"
									>
										<label>
											<en>Connection</en>
											<de>Verbindung</de>
										</label>
										<value>controllerConnection($row)</value>
									</computed-column>
									<computed-column name="bus"
										type="tl.core:String"
									>
										<label>
											<en>Programming through it</en>
											<de>Programmieren darüber</de>
										</label>
										<value>controllerBusState($row)</value>
									</computed-column>
								</columns>
								<rows>if($project == null, [], $project.get(`ehome.project:Project#controllers`).filter(c -> $c.get(`ehome.runtime:Controller#controllerId`) != null))</rows>
							</table>
						</stack>
					</inset>
				</panel>
				<text input="outcome"/>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-check-lg"
					inputs="project, choice"
				>
					<label>
						<en>Use</en>
						<de>Übernehmen</de>
					</label>
					<access>
						<operation name="Write"
							object="$project"
							type="ehome.project:Project"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<disabled-if expr='$choice["error"]'/>
					</executability>
					<with-transaction>
						<execute-script>
							<!-- One path: the one chosen is set, the other cleared (haumacher/ehome #148). -->
							<function><![CDATA[
if($choice["controller"] != null,
    {
        $project.set(`ehome.project:Project#programmingController`, $choice["controller"]);
        $project.set(`ehome.project:Project#gateway`, null);
    },
    {
        $project.set(`ehome.project:Project#gateway`, $choice["gateway"]);
        $project.set(`ehome.project:Project#programmingController`, null);
    })
]]></function>
						</execute-script>
					</with-transaction>
					<close-dialog/>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
