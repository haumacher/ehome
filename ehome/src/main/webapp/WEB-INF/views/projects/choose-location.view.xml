<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog choosing the building part a device is placed in (ehome.physical:Device#location): the
	counterpart of projects/place-device.view.xml from the device's side.

	"device" carries the device. The building parts of the device's project are offered as the tree
	of the building view, so that a part is chosen together with its path; "Place" places the device
	in the chosen part (buildingPlace), "Remove the placement" takes it out of its part. The device
	stays selected ("selection" is written with it).
-->
<view>
	<channels>
		<channel name="device"/>
		<channel name="selection"/>
		<channel name="selectedNode"/>
		<!-- The chosen building part; the project at the root is no part. -->
		<derived-channel name="part"
			expr="if($selectedNode.instanceOf(`ehome.building:BuildingDefinition`), $selectedNode, null)"
			inputs="selectedNode"
		/>
		<derived-channel name="hint"
			inputs="device"
			observed-types="ehome.physical:Device"
		>
			<expr><![CDATA[{
    location = $device.get(`ehome.physical:Device#location`);
    if($location == null,
        #("{0} is placed in no building part."@en, "{0} ist in keinem Gebäudeteil platziert."@de).fill(deviceLabel($device)),
        #("{0} is placed in {1}."@en, "{0} ist in {1} platziert."@de).fill(deviceLabel($device), buildingPath($location)))
        .localize()
}]]></expr>
		</derived-channel>
	</channels>
	<window width="560px">
		<title>
			<en>Choose the location</en>
			<de>Standort wählen</de>
		</title>
		<inset>
			<stack gap="default">
				<text
					input="hint"
					tone="secondary"
				/>
				<tree
					observed-types="ehome.building:BuildingDefinition"
					selection="selectedNode"
				>
					<inputs>
						<input channel="device"/>
					</inputs>
					<root>recursion($device, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()</root>
					<children><![CDATA[switch {
    $node.instanceOf(`ehome.project:Project`):
        $node.get(`ehome.project:Project#buildings`);
    $node.instanceOf(`ehome.building:BuildingDefinition`):
        $node.get(`ehome.building:BuildingDefinition#parts`);
    default: [];
}]]></children>
					<parents>$node.container()</parents>
				</tree>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-box-arrow-in-down-right"
					inputs="part"
				>
					<label>
						<en>Place</en>
						<de>Zuordnen</de>
					</label>
					<executability>
						<null-input-disabled/>
					</executability>
					<with-transaction>
						<execute-script function="buildingPlace($device, $part)">
							<inputs>
								<input channel="device"/>
							</inputs>
						</execute-script>
						<with-result>
							<write-channel name="selection"/>
							<close-dialog/>
						</with-result>
					</with-transaction>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-box-arrow-up-left"
					inputs="device"
					observed-types="ehome.physical:Device"
				>
					<label>
						<en>Remove the placement</en>
						<de>Zuordnung entfernen</de>
					</label>
					<executability>
						<null-input-disabled/>
						<disabled-if expr="if($device.get(`ehome.physical:Device#location`) == null, #('The device is placed in no building part.'@en, 'Das Gerät ist in keinem Gebäudeteil platziert.'@de))"/>
					</executability>
					<with-transaction>
						<execute-script function="buildingPlace($device, null)"/>
						<with-result>
							<write-channel name="selection"/>
							<close-dialog/>
						</with-result>
					</with-transaction>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
