<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog attaching the group monitor of a project (projects/monitor.view.xml) to a HomeControl controller
	(haumacher/ehome #56): the project's controller (chosen when the dialog opens), any registered controller
	(ehome.runtime:Controller), or one entered by host, port and token.

	"project" and "state" are the channels of the monitor view; "controller" is seeded with the project's
	controller. An entered host wins over the chosen controller; a token entered with a chosen controller is
	used instead of its stored one. Neither the entered controller nor the token is stored: the token lives
	in the connection only (de.haumacher.ehome.monitor.ControllerTarget). "Connect" runs
	<group-monitor-connect source="controller"> (ConnectMonitorAction) with a dictionary of these values; a
	refused token or an unreachable controller keeps the dialog open with the reason.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="state"/>
		<channel name="controller"/>
		<channel name="host"/>
		<channel name="port"/>
		<channel name="token"/>
		<derived-channel name="current"
			expr="if($project == null or $project.get(`ehome.project:Project#controller`) == null, #('The project has no controller.'@en, 'Das Projekt hat keinen Controller.'@de), #('Controller of the project: {0}'@en, 'Controller des Projekts: {0}'@de).fill($project.get(`ehome.project:Project#controller`).get(`ehome.runtime:Controller#name`)))"
			inputs="project"
		/>
	</channels>
	<window width="800px">
		<title>
			<en>Connect to a controller</en>
			<de>Mit einem Controller verbinden</de>
		</title>
		<inset>
			<stack gap="default">
				<text
					input="current"
					tone="secondary"
				/>
				<text>
					<label>
						<en>Choose a registered controller, or enter the address and token of another one. An entered address and token are used for this connection only and are not stored.</en>
						<de>Einen registrierten Controller wählen oder Adresse und Token eines anderen eingeben. Eine eingegebene Adresse und ein eingegebenes Token gelten nur für diese Verbindung und werden nicht gespeichert.</de>
					</label>
				</text>
				<table
					observed-types="ehome.runtime:Controller"
					selection="controller"
					types="ehome.runtime:Controller"
				>
					<columns>
						<column attribute="name"/>
						<column attribute="host"/>
						<column attribute="port"/>
						<computed-column name="token"
							type="tl.core:String"
						>
							<label>
								<en>Token</en>
								<de>Token</de>
							</label>
							<value>controllerTokenHint($row)</value>
						</computed-column>
					</columns>
					<rows>all(`ehome.runtime:Controller`)</rows>
				</table>
				<fields>
					<value-input
						type="tl.core:String"
						value="host"
					>
						<label>
							<en>Host (instead of the chosen controller)</en>
							<de>Host (statt des gewählten Controllers)</de>
						</label>
						<placeholder>
							<en>Host name or IP address</en>
							<de>Hostname oder IP-Adresse</de>
						</placeholder>
					</value-input>
					<value-input
						type="tl.core:String"
						value="port"
					>
						<label>
							<en>Port</en>
							<de>Port</de>
						</label>
						<placeholder>
							<en>80</en>
							<de>80</de>
						</placeholder>
					</value-input>
					<value-input
						type="tl.core:String"
						value="token"
					>
						<label>
							<en>Token (for this connection only)</en>
							<de>Token (nur für diese Verbindung)</de>
						</label>
						<input-control class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
					</value-input>
				</fields>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-plug-fill"
					inputs="project"
				>
					<label>
						<en>Connect</en>
						<de>Verbinden</de>
					</label>
					<access>
						<!-- The monitor listens to the stream of the controller; sending needs "Allow sending" (Write). -->
						<operation name="Read"
							object="$project"
							type="ehome.project:Project"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<execute-script function="{'project': $project, 'controller': $controller, 'host': $host, 'port': $port, 'token': $token}">
						<inputs>
							<input channel="controller"/>
							<input channel="host"/>
							<input channel="port"/>
							<input channel="token"/>
						</inputs>
						<with-result>
							<group-monitor-connect
								source="controller"
								state="state"
							/>
							<close-dialog/>
						</with-result>
					</execute-script>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
