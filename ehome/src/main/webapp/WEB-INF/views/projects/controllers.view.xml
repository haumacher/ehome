<?xml version="1.0" encoding="utf-8" ?>

<!--
	The controllers of the project (doc/controllers.md): every controller is a part of exactly one project
	(haumacher/ehome #151), the one enrolled for it (haumacher/ehome #54), which connects to E-Home by
	itself over its WebSocket, as well as the one on the LAN, reached by host and token (haumacher/ehome
	#69). The table shows whether it is connected now (controllerConnection,
	de.haumacher.ehome.connection.ConnectionFunctions; "On the LAN" for one reached by host and token
	only), its address, its last contact and the firmware it reported.

	"Controller on the LAN" creates a controller on the LAN in the project by name, host, port and token
	(controllers/create-controller.view.xml), "Search controllers" lists the controllers announcing
	themselves over mDNS and creates the one chosen (controllers/discover-controllers.view.xml, haumacher/ehome
	#42), "Set token" stores the token of the selected controller (controllers/controller-token.view.xml);
	the token is never shown again, the detail says only whether one is set. All three reach the local
	network and are not offered unless the installation reaches local networks (configuration variable
	tl_ehome_local_network, haumacher/ehome #150, TL-Script localNetworkVeto()); the Java paths refuse
	as well (de.haumacher.ehome.connection.ProjectControllers#create). A controller created here becomes
	the project's deployment target if the project has none.

	"Add controller" creates an enrollment code for the project (de.haumacher.ehome.connection
	.CreateEnrollmentCodeAction): valid 15 minutes for one controller, shown once in a dialog with the
	time it expires; a new code replaces an open one. Below the table, whether a code is open and until
	when, without the code. "Forget" deletes the selected controller after a confirmation and closes its
	connection, which is refused from then on (ForgetControllerAction).

	The installation key (homecontrol issue #35, de.haumacher.ehome.connection.InstallationKeys, doc/controllers.md
	"Signatures"): below the table the fingerprint of the project's key and a rotation under way, which the
	owner compares with the controller's Settings page; "Create key" makes one for a project without (it
	is generated at the enrollment of the first controller), "Renew key" starts a rotation. The detail
	shows the key the selected controller holds and a mismatch with the project's.

	The connection state is held in memory, not in the knowledge base: the table shows it as of its
	last refresh; the last contact, stored at the connection and at its end, refreshes it.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="controller"/>
		<derived-channel name="codeState"
			expr="if($project == null, null, enrollmentCodeState($project))"
			inputs="project"
			observed-types="ehome.project:Project"
		/>
		<derived-channel name="keyState"
			expr="if($project == null, null, installationKeyState($project))"
			inputs="project"
			observed-types="ehome.project:Project"
		/>
		<derived-channel name="controllerKey"
			expr="if($controller == null, null, controllerKeyState($controller))"
			inputs="controller"
			observed-types="ehome.runtime:Controller,ehome.project:Project"
		/>
		<derived-channel name="connection"
			expr="if($controller == null, null, controllerConnection($controller))"
			inputs="controller"
			observed-types="ehome.runtime:Controller"
		/>
		<!-- Whether the selected controller has a token, without the token. -->
		<derived-channel name="tokenHint"
			expr="if($controller == null, null, #('Token: {0}'@en, 'Token: {0}'@de).fill(controllerTokenHint($controller)))"
			inputs="controller"
			observed-types="ehome.runtime:Controller"
		/>
		<!-- The name of this page for the assistant (app.view.xml, <page-selection> below). -->
		<derived-channel name="assistantPage"
			expr="'Project, tab Controllers'"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="320"
				size="60"
				unit="%"
			>
				<!-- What the assistant is told about this page: its name and its selection (app.view.xml). -->
				<page-selection to="pageView">
					<inputs>
						<input channel="assistantPage"/>
					</inputs>
				</page-selection>
				<page-selection to="pageSelection">
					<inputs>
						<input channel="controller"/>
						<input channel="project"/>
					</inputs>
				</page-selection>
				<panel>
					<title>
						<en>Controllers of the project</en>
						<de>Controller des Projekts</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-hdd-network"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Controller on the LAN</en>
								<de>Controller im LAN</de>
							</label>
							<tooltip>
								<en>Creates a controller on the local network, reached by its address and the token created on its console (web token create e-home).</en>
								<de>Legt einen Controller im lokalen Netz an, erreicht über seine Adresse und das auf seiner Konsole erzeugte Token (web token create e-home).</de>
							</tooltip>
							<access>
								<create
									in="$project"
									reference="ehome.project:Project#controllers"
								/>
							</access>
							<executability>
								<!-- Not offered unless the installation reaches local networks (haumacher/ehome #150). -->
								<visible-if expr="localNetworkVeto() == null"/>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="project"
								dialog-view="controllers/create-controller.view.xml"
							>
								<bind
									channel="selection"
									to="controller"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-broadcast"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Search controllers</en>
								<de>Controller suchen</de>
							</label>
							<tooltip>
								<en>Lists the HomeControl controllers that announce themselves in the local networks (mDNS) and creates the one chosen in the project; its token is set afterwards.</en>
								<de>Listet die HomeControl-Controller, die sich in den lokalen Netzen ankündigen (mDNS), und legt den gewählten im Projekt an; sein Token wird danach gesetzt.</de>
							</tooltip>
							<access>
								<create
									in="$project"
									reference="ehome.project:Project#controllers"
								/>
							</access>
							<executability>
								<!-- Not offered unless the installation reaches local networks (haumacher/ehome #150). -->
								<visible-if expr="localNetworkVeto() == null"/>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="project"
								dialog-view="controllers/discover-controllers.view.xml"
							>
								<bind
									channel="selection"
									to="controller"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-key"
							inputs="controller"
							placement="TOOLBAR"
						>
							<label>
								<en>Set token</en>
								<de>Token setzen</de>
							</label>
							<tooltip>
								<en>Stores the token created on the controller's console (web token create e-home), with which E-Home authenticates on the local network when it deploys, unloads or asks the status. It is never shown again.</en>
								<de>Speichert das auf der Konsole des Controllers erzeugte Token (web token create e-home), mit dem sich E-Home im lokalen Netz beim Bereitstellen, Entladen und Abfragen des Status ausweist. Es wird nie wieder angezeigt.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$controller"
									type="ehome.runtime:Controller"
								/>
							</access>
							<executability>
								<!-- The token is used on the local network only (haumacher/ehome #150). -->
								<visible-if expr="localNetworkVeto() == null"/>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="controller"
								dialog-view="controllers/controller-token.view.xml"
							/>
						</generic-command>
						<generic-command
							image="css:bi bi-plus-lg"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Add controller</en>
								<de>Controller hinzufügen</de>
							</label>
							<tooltip>
								<en>Creates an enrollment code, valid for 15 minutes and one controller, which is entered on the controller's Settings page; a new code replaces an open one.</en>
								<de>Erzeugt einen Anmeldecode, 15 Minuten für einen Controller gültig, der auf der Seite „Einstellungen“ des Controllers eingegeben wird; ein neuer Code ersetzt einen offenen.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-enrollment-code>
								<with-result>
									<notify
										display="dialog"
										expr="$result"
									/>
								</with-result>
							</create-enrollment-code>
						</generic-command>
						<generic-command
							image="css:bi bi-key"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Create key</en>
								<de>Schlüssel erzeugen</de>
							</label>
							<tooltip>
								<en>Creates the installation key the runtime images of the project are signed with and offers it to the controllers; each owner accepts it on the device after comparing its fingerprint.</en>
								<de>Erzeugt den Installationsschlüssel, mit dem die Laufzeitabbilder des Projekts signiert werden, und bietet ihn den Controllern an; jeder Besitzer nimmt ihn am Gerät an, nachdem er den Fingerabdruck verglichen hat.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="installationKeyCreateVeto($project)"/>
							</executability>
							<create-installation-key>
								<with-result>
									<notify
										display="dialog"
										expr="$result"
									/>
								</with-result>
							</create-installation-key>
						</generic-command>
						<generic-command
							image="css:bi bi-arrow-repeat"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Renew key</en>
								<de>Schlüssel erneuern</de>
							</label>
							<tooltip>
								<en>Offers a new installation key to the controllers; the images are signed with the current key until the owner accepts the new one on the device.</en>
								<de>Bietet den Controllern einen neuen Installationsschlüssel an; die Abbilder werden mit dem bisherigen signiert, bis der Besitzer den neuen am Gerät annimmt.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="installationKeyRenewVeto($project)"/>
							</executability>
							<confirm expr="#('Renew the installation key? A new key is offered to the controllers; each owner accepts it on the device after comparing its fingerprint. Until then images are signed with the current key.'@en, 'Den Installationsschlüssel erneuern? Den Controllern wird ein neuer Schlüssel angeboten; jeder Besitzer nimmt ihn am Gerät an, nachdem er den Fingerabdruck verglichen hat. Bis dahin werden die Abbilder mit dem bisherigen Schlüssel signiert.'@de)"/>
							<renew-installation-key>
								<with-result>
									<notify
										display="dialog"
										expr="$result"
									/>
								</with-result>
							</renew-installation-key>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="controller"
							placement="TOOLBAR"
						>
							<label>
								<en>Forget</en>
								<de>Vergessen</de>
							</label>
							<tooltip>
								<en>Deletes the controller from E-Home and closes its connection, which is refused from then on; to connect it again, it is enrolled with a new code, as a new controller.</en>
								<de>Löscht den Controller aus E-Home und schließt seine Verbindung, die ab dann abgelehnt wird; um ihn wieder zu verbinden, wird er mit einem neuen Code als neuer Controller angemeldet.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$controller"
									type="ehome.runtime:Controller"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="forgetConfirmation($controller)"/>
							<forget-controller>
								<with-result>
									<notify
										expr="$result"
										kind="info"
									/>
								</with-result>
							</forget-controller>
						</generic-command>
					</commands>
					<stack>
						<table
							observed-types="ehome.runtime:Controller,ehome.project:Project"
							selection="controller"
							types="ehome.runtime:Controller"
						>
							<inputs>
								<input channel="project"/>
							</inputs>
							<columns>
								<column attribute="name"/>
								<computed-column name="connection"
									type="tl.core:String"
								>
									<label>
										<en>Connection</en>
										<de>Verbindung</de>
									</label>
									<value>controllerConnection($row)</value>
								</computed-column>
								<column attribute="host"/>
								<column attribute="lastContact"/>
								<column attribute="firmwareVersion"/>
								<column attribute="firmwareBuild"/>
								<column attribute="deviceKey"/>
								<column attribute="enrolled"/>
							</columns>
							<rows>if($project == null, [], $project.get(`ehome.project:Project#controllers`))</rows>
						</table>
						<inset>
							<text input="keyState"/>
						</inset>
						<inset>
							<text
								input="codeState"
								tone="helper"
								variant="caption"
							/>
						</inset>
					</stack>
				</panel>
			</pane>
			<pane
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Controller</en>
						<de>Controller</de>
					</title>
					<stack>
						<inset>
							<text input="connection"/>
						</inset>
						<inset>
							<text input="controllerKey"/>
						</inset>
						<inset>
							<text input="tokenHint"/>
						</inset>
						<form
							input="controller"
							with-inset="true"
						>
							<field attribute="name"/>
							<field attribute="host"/>
							<field attribute="port"/>
							<field attribute="installation"
								readonly="true"
							/>
							<field attribute="controllerId"
								readonly="true"
							/>
							<field attribute="lastContact"
								readonly="true"
							/>
							<field attribute="firmwareVersion"
								readonly="true"
							/>
							<field attribute="firmwareBuild"
								readonly="true"
							/>
							<field attribute="deviceKey"
								readonly="true"
							/>
							<field attribute="enrolled"
								readonly="true"
							/>
							<field attribute="enrolledBy"
								readonly="true"
							/>
						</form>
					</stack>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
