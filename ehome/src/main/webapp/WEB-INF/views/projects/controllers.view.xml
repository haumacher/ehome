<?xml version="1.0" encoding="utf-8" ?>

<!--
	The controllers enrolled for the project (haumacher/ehome #54, doc/controllers.md): each connects to
	E-Home by itself over its WebSocket; the table shows whether it is connected now
	(controllerConnection, de.haumacher.ehome.connection.ConnectionFunctions), its last contact and the
	firmware it reported.

	"Add controller" creates an enrollment code for the project (de.haumacher.ehome.connection
	.CreateEnrollmentCodeAction): valid 15 minutes for one controller, shown once in a dialog with the
	time it expires; a new code replaces an open one. Below the table, whether a code is open and until
	when, without the code. "Forget" deletes the selected controller after a confirmation and closes its
	connection, which is refused from then on (ForgetControllerAction).

	The installation key (homecontrol issue #35, de.haumacher.ehome.connection.InstallationKeys, doc/controllers.md
	"Signatures"): below the table the fingerprint of the project's key and a rotation under way, which the
	owner compares with the controller's Settings page; "Create key" makes one for a project without (it
	is generated at the enrollment of the first controller), "Renew key" starts a rotation. The detail
	shows the key the selected controller holds and a mismatch with the project's.

	The connection state is held in memory, not in the knowledge base: the table shows it as of its
	last refresh; the last contact, stored at the connection and at its end, refreshes it.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="controller"/>
		<derived-channel name="codeState"
			expr="if($project == null, null, enrollmentCodeState($project))"
			inputs="project"
			observed-types="ehome.project:Project"
		/>
		<derived-channel name="keyState"
			expr="if($project == null, null, installationKeyState($project))"
			inputs="project"
			observed-types="ehome.project:Project"
		/>
		<derived-channel name="controllerKey"
			expr="if($controller == null, null, controllerKeyState($controller))"
			inputs="controller"
			observed-types="ehome.runtime:Controller,ehome.project:Project"
		/>
		<derived-channel name="connection"
			expr="if($controller == null, null, controllerConnection($controller))"
			inputs="controller"
			observed-types="ehome.runtime:Controller"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="320"
				size="60"
				unit="%"
			>
				<panel>
					<title>
						<en>Controllers of the project</en>
						<de>Controller des Projekts</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-plus-lg"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Add controller</en>
								<de>Controller hinzufügen</de>
							</label>
							<tooltip>
								<en>Creates an enrollment code, valid for 15 minutes and one controller, which is entered on the controller's Settings page; a new code replaces an open one.</en>
								<de>Erzeugt einen Anmeldecode, 15 Minuten für einen Controller gültig, der auf der Seite „Einstellungen“ des Controllers eingegeben wird; ein neuer Code ersetzt einen offenen.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-enrollment-code>
								<with-result>
									<notify
										display="dialog"
										expr="$result"
									/>
								</with-result>
							</create-enrollment-code>
						</generic-command>
						<generic-command
							image="css:bi bi-key"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Create key</en>
								<de>Schlüssel erzeugen</de>
							</label>
							<tooltip>
								<en>Creates the installation key the runtime images of the project are signed with and offers it to the controllers; each owner accepts it on the device after comparing its fingerprint.</en>
								<de>Erzeugt den Installationsschlüssel, mit dem die Laufzeitabbilder des Projekts signiert werden, und bietet ihn den Controllern an; jeder Besitzer nimmt ihn am Gerät an, nachdem er den Fingerabdruck verglichen hat.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="installationKeyCreateVeto($project)"/>
							</executability>
							<create-installation-key>
								<with-result>
									<notify
										display="dialog"
										expr="$result"
									/>
								</with-result>
							</create-installation-key>
						</generic-command>
						<generic-command
							image="css:bi bi-arrow-repeat"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Renew key</en>
								<de>Schlüssel erneuern</de>
							</label>
							<tooltip>
								<en>Offers a new installation key to the controllers; the images are signed with the current key until the owner accepts the new one on the device.</en>
								<de>Bietet den Controllern einen neuen Installationsschlüssel an; die Abbilder werden mit dem bisherigen signiert, bis der Besitzer den neuen am Gerät annimmt.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="installationKeyRenewVeto($project)"/>
							</executability>
							<confirm expr="#('Renew the installation key? A new key is offered to the controllers; each owner accepts it on the device after comparing its fingerprint. Until then images are signed with the current key.'@en, 'Den Installationsschlüssel erneuern? Den Controllern wird ein neuer Schlüssel angeboten; jeder Besitzer nimmt ihn am Gerät an, nachdem er den Fingerabdruck verglichen hat. Bis dahin werden die Abbilder mit dem bisherigen Schlüssel signiert.'@de)"/>
							<renew-installation-key>
								<with-result>
									<notify
										display="dialog"
										expr="$result"
									/>
								</with-result>
							</renew-installation-key>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="controller"
							placement="TOOLBAR"
						>
							<label>
								<en>Forget</en>
								<de>Vergessen</de>
							</label>
							<tooltip>
								<en>Deletes the controller from E-Home and closes its connection, which is refused from then on; to connect it again, it is enrolled with a new code, as a new controller.</en>
								<de>Löscht den Controller aus E-Home und schließt seine Verbindung, die ab dann abgelehnt wird; um ihn wieder zu verbinden, wird er mit einem neuen Code als neuer Controller angemeldet.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$controller"
									type="ehome.runtime:Controller"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="forgetConfirmation($controller)"/>
							<forget-controller>
								<with-result>
									<notify
										expr="$result"
										kind="info"
									/>
								</with-result>
							</forget-controller>
						</generic-command>
					</commands>
					<stack>
						<table
							observed-types="ehome.runtime:Controller,ehome.project:Project"
							selection="controller"
							types="ehome.runtime:Controller"
						>
							<inputs>
								<input channel="project"/>
							</inputs>
							<columns>
								<column attribute="name"/>
								<computed-column name="connection"
									type="tl.core:String"
								>
									<label>
										<en>Connection</en>
										<de>Verbindung</de>
									</label>
									<value>controllerConnection($row)</value>
								</computed-column>
								<column attribute="lastContact"/>
								<column attribute="firmwareVersion"/>
								<column attribute="firmwareBuild"/>
								<column attribute="deviceKey"/>
								<column attribute="enrolled"/>
							</columns>
							<rows>if($project == null, [], $project.get(`ehome.project:Project#controllers`))</rows>
						</table>
						<inset>
							<text input="keyState"/>
						</inset>
						<inset>
							<text
								input="codeState"
								tone="helper"
								variant="caption"
							/>
						</inset>
					</stack>
				</panel>
			</pane>
			<pane
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Controller</en>
						<de>Controller</de>
					</title>
					<stack>
						<inset>
							<text input="connection"/>
						</inset>
						<inset>
							<text input="controllerKey"/>
						</inset>
						<form
							input="controller"
							with-inset="true"
						>
							<field attribute="name"/>
							<field attribute="installation"
								readonly="true"
							/>
							<field attribute="controllerId"
								readonly="true"
							/>
							<field attribute="lastContact"
								readonly="true"
							/>
							<field attribute="firmwareVersion"
								readonly="true"
							/>
							<field attribute="firmwareBuild"
								readonly="true"
							/>
							<field attribute="deviceKey"
								readonly="true"
							/>
							<field attribute="enrolled"
								readonly="true"
							/>
							<field attribute="enrolledBy"
								readonly="true"
							/>
						</form>
					</stack>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
