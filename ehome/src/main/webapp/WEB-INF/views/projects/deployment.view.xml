<?xml version="1.0" encoding="utf-8" ?>

<!--
	Deployment of the project's runtime image to a HomeControl controller (haumacher/ehome #39,
	de.haumacher.ehome.runtime): the controller the project is deployed to, the revision a controller
	last loaded, and the deployments, newest first, with the refusals of the selected one against the
	objects of the project their paths lead to. A refusal shows its reason in the language of the user
	where E-Home gave it one (haumacher/ehome #95), the controller's English text otherwise; that text
	is a column of its own, hidden at the start.

	"Download image" checks the image as the controller would and offers it as a JSON file with its
	detached signature (the .sig file, when the project has an installation key), or shows why it
	would be refused (runtime-image.view.xml). Each deployment is signed with the key its controller
	holds and records the signature and the key's fingerprint (homecontrol issue #35). "Deploy" first compares the image with the one
	the controller stores (GET /api/image, de.haumacher.ehome.runtime.ImageComparison, haumacher/ehome
	#47) and asks, naming what differs or that nothing does; it then sends the image (PUT /api/image)
	with the revision after the last loaded one and records the outcome; a refusal is an outcome, shown
	in the table, not a failure. "Unload" removes the image from the controller (DELETE /api/image)
	after a confirmation naming what it runs, recorded as a deployment marked as an unload. "Status"
	compares what the controller runs (GET /api/status) with the last deployment.

	Beside it, the runtime settings of the project (haumacher/ehome #45) and below them what the
	histories of the datapoints cost against the history budget (haumacher/ehome #73). The functions are edited in
	their own tab (functions.view.xml), the rules and the schedule in theirs (rules.view.xml,
	schedules.view.xml, haumacher/ehome #57), the settings of each datapoint with its group address
	(addresses.view.xml).
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="deployment"/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="280"
				size="35"
				unit="%"
			>
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="60"
							unit="%"
						>
							<!--
								The settings of the controller the project fixes (time zone, location, NTP server), the
								KNX time master and the history budget (#45); each part of the image only where set.
							-->
							<panel>
								<title>
									<en>Runtime settings</en>
									<de>Laufzeiteinstellungen</de>
								</title>
								<form
									input="project"
									with-inset="true"
								>
									<group>
										<label>
											<en>Controller</en>
											<de>Controller</de>
										</label>
										<field attribute="timeZone"/>
										<field attribute="latitude"/>
										<field attribute="longitude"/>
										<field attribute="elevation"/>
										<field attribute="ntpServer"/>
									</group>
									<group>
										<label>
											<en>KNX time master</en>
											<de>KNX-Zeitgeber</de>
										</label>
										<field attribute="timeMasterTime"/>
										<field attribute="timeMasterDate"/>
										<field attribute="timeMasterDateTime"/>
										<field attribute="timeMasterInterval"/>
										<field attribute="timeMasterAtMidnight"/>
										<field attribute="timeMasterOnSynchronized"/>
									</group>
									<group>
										<label>
											<en>History</en>
											<de>Verlauf</de>
										</label>
										<field attribute="historyBudget"/>
										<field attribute="historyUsage"/>
									</group>
								</form>
							</panel>
						</pane>
						<pane
							size="40"
							unit="%"
						>
							<!--
								What the histories cost (haumacher/ehome #73, homecontrol #56): the datapoints with a
								history in the image, the biggest first, and the charts with the bytes of the
								histories of the datapoints they draw (a datapoint two charts draw counts in both),
								each as RAM (the raw rings and the archives' open slots, against history.budget) and
								flash (the archives' segments, against the device's archive cap). The totals against
								the budget and the caps are the field "History memory" above; exceeding them is
								refused by the image's check, naming the biggest histories.
							-->
							<panel>
								<title>
									<en>History memory</en>
									<de>Verlaufsspeicher</de>
								</title>
								<table
									observed-types="ehome.logical:GroupAddress,ehome.runtime:ApplicationDatapoint,ehome.logical:HistoryArchive,ehome.runtime:ChartElement,ehome.runtime:ChartSeries,ehome.project:Project"
								>
									<inputs>
										<input channel="project"/>
									</inputs>
									<columns>
										<computed-column name="datapoint"
											type="tl.core:String"
										>
											<label>
												<en>Datapoint</en>
												<de>Datenpunkt</de>
											</label>
											<value>pageTargetLabel($row)</value>
										</computed-column>
										<computed-column name="history"
											type="tl.core:String"
										>
											<label>
												<en>History</en>
												<de>Verlauf</de>
											</label>
											<value>runtimeHistoryEffective($row)</value>
										</computed-column>
										<computed-column name="ram"
											type="tl.core:Long"
										>
											<label>
												<en>RAM (bytes)</en>
												<de>RAM (Bytes)</de>
											</label>
											<value>runtimeHistoryRam($row)</value>
										</computed-column>
										<computed-column name="flash"
											type="tl.core:Long"
										>
											<label>
												<en>Flash (bytes)</en>
												<de>Flash (Bytes)</de>
											</label>
											<value>runtimeHistoryFlash($row)</value>
										</computed-column>
									</columns>
									<rows>runtimeHistoryDatapoints($project)</rows>
								</table>
								<table
									observed-types="ehome.logical:GroupAddress,ehome.runtime:ApplicationDatapoint,ehome.logical:HistoryArchive,ehome.runtime:ChartElement,ehome.runtime:ChartSeries,ehome.project:Project"
								>
									<inputs>
										<input channel="project"/>
									</inputs>
									<columns>
										<computed-column name="chart"
											type="tl.core:String"
										>
											<label>
												<en>Chart</en>
												<de>Diagramm</de>
											</label>
											<value>pageLabel($row)</value>
										</computed-column>
										<computed-column name="page"
											type="tl.core:String"
										>
											<label>
												<en>Page</en>
												<de>Seite</de>
											</label>
											<value>pageLabel($row.container().container())</value>
										</computed-column>
										<computed-column name="ram"
											type="tl.core:Long"
										>
											<label>
												<en>RAM (bytes)</en>
												<de>RAM (Bytes)</de>
											</label>
											<value>runtimeHistoryRam($row)</value>
										</computed-column>
										<computed-column name="flash"
											type="tl.core:Long"
										>
											<label>
												<en>Flash (bytes)</en>
												<de>Flash (Bytes)</de>
											</label>
											<value>runtimeHistoryFlash($row)</value>
										</computed-column>
									</columns>
									<rows>runtimeHistoryCharts($project)</rows>
								</table>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</pane>
			<pane
				size="65"
				unit="%"
			>
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="45"
							unit="%"
						>
							<panel>
								<title>
									<en>Deployment</en>
									<de>Bereitstellung</de>
								</title>
								<commands>
									<generic-command
										image="css:fa-solid fa-download"
										inputs="project"
										placement="TOOLBAR"
									>
										<label>
											<en>Download image</en>
											<de>Abbild herunterladen</de>
										</label>
										<tooltip>
											<en>Checks the runtime image as the controller would and offers it as a JSON file, signed where the project has an installation key, or shows why it would be refused; nothing is sent.</en>
											<de>Prüft das Laufzeitabbild wie der Controller und bietet es als JSON-Datei an, signiert, wenn das Projekt einen Installationsschlüssel hat, oder zeigt, warum es abgelehnt würde; es wird nichts gesendet.</de>
										</tooltip>
										<access>
											<!--
												Not a mere read: a valid image is signed with the private installation key of the project,
												which nobody reads through the model (InstallationKeys); a signed image carries the authority
												of a deployment, which is an installer's (Write, as "Deploy").
											-->
											<operation name="Write"
												object="$project"
												type="ehome.project:Project"
											/>
										</access>
										<executability>
											<null-input-disabled/>
										</executability>
										<export-runtime-image>
											<with-result>
												<open-dialog
													bind-input-to="result"
													dialog-view="projects/runtime-image.view.xml"
												/>
											</with-result>
										</export-runtime-image>
									</generic-command>
									<generic-command
										image="css:bi bi-cloud-upload"
										inputs="project"
										placement="TOOLBAR"
									>
										<label>
											<en>Deploy</en>
											<de>Bereitstellen</de>
										</label>
										<tooltip>
											<en>Sends the runtime image to the project's controller after showing what differs from the one it holds. Once it accepts it, the controller runs the functions, rules and pages of this image.</en>
											<de>Sendet das Laufzeitabbild an den Controller des Projekts, nachdem angezeigt wurde, was sich von seinem gespeicherten unterscheidet. Nimmt er es an, arbeitet der Controller danach mit den Funktionen, Regeln und Seiten dieses Abbilds.</de>
										</tooltip>
										<access>
											<operation name="Write"
												object="$project"
												type="ehome.project:Project"
											/>
										</access>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="deploymentVeto($project)"/>
										</executability>
										<confirm expr="deploymentConfirmation($project)"/>
										<deploy-runtime-image>
											<with-result>
												<write-channel name="deployment"/>
												<if test="$result.get(`ehome.runtime:Deployment#accepted`)">
													<then>
														<notify
															expr="$result.get(`ehome.runtime:Deployment#message`)"
															kind="info"
														/>
													</then>
													<else>
														<notify
															expr="$result.get(`ehome.runtime:Deployment#message`)"
															kind="warning"
														/>
													</else>
												</if>
											</with-result>
										</deploy-runtime-image>
									</generic-command>
									<generic-command
										image="css:bi bi-eject"
										inputs="project"
										placement="TOOLBAR"
									>
										<label>
											<en>Unload</en>
											<de>Entladen</de>
										</label>
										<tooltip>
											<en>Removes the runtime image from the controller, with its stored values and history; the controller returns to setup and runs no rules or pages until the next deployment.</en>
											<de>Entfernt das Laufzeitabbild mit seinen gespeicherten Werten und seinem Verlauf vom Controller; er kehrt in die Einrichtung zurück und führt bis zur nächsten Bereitstellung keine Regeln und Seiten mehr aus.</de>
										</tooltip>
										<access>
											<operation name="Write"
												object="$project"
												type="ehome.project:Project"
											/>
										</access>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="deploymentVeto($project)"/>
										</executability>
										<confirm expr="unloadConfirmation($project)"/>
										<unload-runtime-image>
											<with-result>
												<write-channel name="deployment"/>
												<if test="$result.get(`ehome.runtime:Deployment#accepted`)">
													<then>
														<notify
															expr="$result.get(`ehome.runtime:Deployment#message`)"
															kind="info"
														/>
													</then>
													<else>
														<notify
															expr="$result.get(`ehome.runtime:Deployment#message`)"
															kind="warning"
														/>
													</else>
												</if>
											</with-result>
										</unload-runtime-image>
									</generic-command>
									<generic-command
										image="css:bi bi-activity"
										inputs="project"
										placement="TOOLBAR"
									>
										<label>
											<en>Status</en>
											<de>Status</de>
										</label>
										<tooltip>
											<en>Asks the project's controller what it runs and compares it with the last deployment; nothing is changed.</en>
											<de>Fragt den Controller des Projekts, was er ausführt, und vergleicht es mit der letzten Bereitstellung; es wird nichts geändert.</de>
										</tooltip>
										<access>
											<!-- Only asks the controller of the project what it runs. -->
											<operation name="Read"
												object="$project"
												type="ehome.project:Project"
											/>
										</access>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="if($project.get(`ehome.project:Project#controller`) == null, #('The project has no controller.'@en, 'Das Projekt hat keinen Controller.'@de), null)"/>
										</executability>
										<controller-status>
											<with-result>
												<notify
													display="dialog"
													expr="$result"
												/>
											</with-result>
										</controller-status>
									</generic-command>
								</commands>
								<form
									input="project"
									with-inset="true"
								>
									<field attribute="controller"/>
									<field attribute="imageRevision"
										readonly="true"
									/>
								</form>
								<table
									observed-types="ehome.runtime:Deployment"
									selection="deployment"
									types="ehome.runtime:Deployment"
								>
									<inputs>
										<input channel="project"/>
									</inputs>
									<columns>
										<column attribute="time"/>
										<column attribute="revision"/>
										<column attribute="unload"/>
										<column attribute="target"/>
										<column attribute="accepted"/>
										<column attribute="status"/>
										<column attribute="code"/>
										<column attribute="keyFingerprint"/>
										<column attribute="message"/>
									</columns>
									<rows>if($project == null, [], $project.get(`ehome.project:Project#deployments`))</rows>
								</table>
							</panel>
						</pane>
						<pane
							size="55"
							unit="%"
						>
							<panel>
								<title>
									<en>Outcome</en>
									<de>Ergebnis</de>
								</title>
								<form
									input="deployment"
									with-inset="true"
									withEditMode="false"
								>
									<field attribute="message"/>
									<field attribute="keyFingerprint"/>
									<field attribute="signature"/>
									<field attribute="before"/>
									<field attribute="bytes"/>
									<field attribute="total"/>
								</form>
								<table
									observed-types="ehome.runtime:Refusal"
									types="ehome.runtime:Refusal"
								>
									<inputs>
										<input channel="deployment"/>
									</inputs>
									<columns>
										<column attribute="path"/>
										<computed-column name="text"
											type="tl.core:String"
										>
											<label>
												<en>Reason</en>
												<de>Grund</de>
											</label>
											<value>$row.get(`ehome.runtime:Refusal#message`).localize() || $row.get(`ehome.runtime:Refusal#reason`)</value>
										</computed-column>
										<column attribute="element"/>
										<column attribute="reason"
											visible="false"
										/>
									</columns>
									<rows>if($deployment == null, [], $deployment.get(`ehome.runtime:Deployment#refusals`))</rows>
								</table>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</pane>
		</panes>
	</split-panel>
</view>
