<?xml version="1.0" encoding="utf-8" ?>

<!--
	The programming of a device (tab "Programming" of projects/devices.view.xml): the path of the
	project to the bus (its KNX gateway, or its connected controller, haumacher/ehome #148), the plan of
	the full download (the operations with their addresses and bytes), and the commands reaching the
	device on that path.

	"device" is the device, "project" its project. The plan and the reasons a command is refused are
	computed by the TL-Script functions of de.haumacher.ehome.programming.download.ProgrammingFunctions
	(implemented in Java; the views name the types they depend on in observed-types).

	- Read out reads the device and keeps what was read as a snapshot of the device (ReadOutJob,
	  haumacher/ehome #193); it never writes.
	- Compare reads the device out in the same way and compares the snapshot with the download image; it
	  never writes. The panel "Snapshots" compares a stored snapshot again, takes it over into the project,
	  downloads it as a file or uploads one, all without the bus; "Restore" writes a snapshot back into the
	  device (projects/restore-snapshot.view.xml, RestoreJob, haumacher/ehome #194).
	- Device info asks the device who it is and in what state, beside the project's values
	  (DeviceInfoJob, projects/device-info.view.xml, haumacher/ehome #175); it never writes.
	- Download appends the device to the project's queue of downloads after a confirmation naming the device,
	  its address and the path (gateway or controller); the queue (projects/download-queue.view.xml, below the
	  panels, haumacher/ehome #218) works through it in the background, one device after another, and keeps
	  its outcome and report. "Parameters only" (channel parametersOnly, haumacher/ehome #195) chooses the
	  download of the parameters and tables without the program's code; it is set for a device holding the
	  program of its last download (ProgrammingFunctions.parametersOnlyByDefault) and decides the plan shown,
	  the veto and the confirmation. A device waiting in the queue already is not appended again, unless the
	  full download is asked for a device waiting with the parameters only, which raises its entry.
	- Write address writes the individual address into the one device in programming mode.
	Both writing commands are disabled, with the reason, unless the configuration variable
	tl_ehome_programming_write_enabled is true (de.haumacher.ehome.programming.download.CalimeroWriter,
	de.haumacher.ehome.settings.OperatorSettings), whatever the path. Unless the installation reaches local
	networks (tl_ehome_local_network), a gateway is refused with that reason; the controller stays
	available, and "Choose the gateway" offers only it then.
	The other commands run as jobs (DownloadJob for the address and the layout, CompareJob, ReadOutJob, DeviceInfoJob) with their progress shown here, and end with
	the report (projects/programming-report.view.xml), which replaces the progress display; a job
	that fails keeps its display with the error. One job of the tab at a time: its progress is shown
	with the device it was started for (jobDevice), and the commands of all devices are disabled with
	that reason while it runs. The vetoes read the state of the bus sessions and the controllers, which
	no model event reflects: the commands name the channel busState among their inputs, which changes
	with that state, so that they are decided anew when a session ends (haumacher/ehome #161).
-->
<view>
	<channels>
		<channel name="device"/>
		<channel name="project"/>
		<channel name="programmingJob"/>
		<!-- The snapshot selected in the panel "Snapshots" (haumacher/ehome #193). -->
		<channel name="snapshot"/>
		<!-- The device the job in programmingJob was started for: its progress is shown only with that device (haumacher/ehome #161). -->
		<channel name="jobDevice"/>
		<derived-channel name="deviceJob"
			expr="if($device != null and $device == $jobDevice, $programmingJob, null)"
			inputs="device, jobDevice, programmingJob"
		/>
		<!--
			Changes whenever a bus session through a controller opens or ends, or a controller connects,
			disconnects or changes what it offers (BusStateSource): the commands using the bus name it among
			their inputs, so that their vetoes, which read this runtime state, are decided anew - e.g. when a job
			of another device or another view gives the controller's bus session free (haumacher/ehome #161).
		-->
		<source-channel name="busState"
			update-interval="500"
		>
			<source class="de.haumacher.ehome.programming.download.BusStateSource"/>
		</source-channel>
		<!-- Changes with every change of the project's queue of downloads (DownloadQueueSource, haumacher/ehome #218). -->
		<source-channel name="queueState"
			update-interval="250"
		>
			<source class="de.haumacher.ehome.programming.download.DownloadQueueSource"/>
		</source-channel>
		<!-- The path to the bus: "Gateway <address>" or "Controller <name>" (ProgrammingFunctions busPath). -->
		<derived-channel name="gateway"
			expr="if($project == null, null, busPath($project))"
			inputs="project"
			observed-types="ehome.project:Project"
		/>
		<!-- Whether the download writes the parameters only; set anew for each device (haumacher/ehome #195). -->
		<channel name="parametersOnly"
			init="$device != null and downloadParametersOnly($device)"
			inputs="device"
		/>
		<derived-channel name="summary"
			expr="if($device == null, null, downloadSummary($device, $parametersOnly))"
			inputs="device, parametersOnly"
			observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection"
		/>
	</channels>
	<stack gap="default">
		<panel>
			<title>
				<en>Path to the bus</en>
				<de>Weg zum Bus</de>
			</title>
			<commands>
				<generic-command
					image="css:bi bi-broadcast"
					inputs="project"
					placement="TOOLBAR"
				>
					<label>
						<en>Choose the gateway</en>
						<de>Gateway wählen</de>
					</label>
					<tooltip>
						<en>Sets the path of the project to the bus: a KNXnet/IP gateway, entered by address or chosen from a search, or the project's connected controller. All devices of the project are read and programmed through it.</en>
						<de>Legt den Weg des Projekts zum Bus fest: ein KNXnet/IP-Gateway, als Adresse eingegeben oder aus einer Suche gewählt, oder den verbundenen Controller des Projekts. Darüber werden alle Geräte des Projekts gelesen und programmiert.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$project"
							type="ehome.project:Project"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<open-dialog
						bind-input-to="project"
						dialog-view="projects/choose-gateway.view.xml"
					/>
				</generic-command>
			</commands>
			<inset>
				<stack gap="compact">
					<text input="gateway"/>
					<text tone="helper"
						variant="caption"
					>
						<label>
							<en>The KNXnet/IP gateway of the project, or its controller connected to E-Home, through which the devices are read and programmed. Through the controller, E-Home passes the frames through the controller's KNX tunnel.</en>
							<de>Das KNXnet/IP-Gateway des Projekts oder sein mit E-Home verbundener Controller, über den die Geräte gelesen und programmiert werden. Über den Controller leitet E-Home die Telegramme durch den KNX-Tunnel des Controllers.</de>
						</label>
					</text>
				</stack>
			</inset>
		</panel>
		<panel>
			<title>
				<en>Download</en>
				<de>Download</de>
			</title>
			<commands>
				<generic-command
					image="css:bi bi-file-earmark-binary"
					inputs="device"
					placement="TOOLBAR"
				>
					<label>
						<en>Download image</en>
						<de>Download-Abbild</de>
					</label>
					<tooltip>
						<en>Shows the bytes the download writes into the device, block by block; nothing is sent.</en>
						<de>Zeigt die Bytes, die der Download in das Gerät schreibt, Block für Block; es wird nichts gesendet.</de>
					</tooltip>
					<executability>
						<null-input-disabled/>
					</executability>
					<open-dialog
						bind-input-to="device"
						dialog-view="projects/download-image.view.xml"
					/>
				</generic-command>
				<generic-command
					image="css:bi bi-arrow-left-right"
					inputs="device, busState, programmingJob, jobDevice"
					observed-types="ehome.project:Project,ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection"
					placement="TOOLBAR"
				>
					<label>
						<en>Compare with the device</en>
						<de>Mit dem Gerät vergleichen</de>
					</label>
					<tooltip>
						<en>Reads the device out through the project's gateway or controller, keeps what was read as a snapshot, and compares it with the download image; nothing is written. Takes seconds to minutes, depending on the device.</en>
						<de>Liest das Gerät über das Gateway oder den Controller des Projekts aus, behält das Gelesene als Speicherabbild und vergleicht es mit dem Download-Abbild; es wird nichts geschrieben. Dauert je nach Gerät Sekunden bis Minuten.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<!-- One job of this tab at a time: its progress and its report belong to its device. -->
						<disabled-if expr='if(jobIsRunning($programmingJob), #("The job for {0} is still running."@en, "Der Auftrag für {0} läuft noch."@de).fill($jobDevice), null)'/>
						<disabled-if expr="compareVeto($device)"/>
					</executability>
					<!-- The job's progress is shown with this device only. -->
					<write-channel name="jobDevice"/>
					<start-job
						cancelable="true"
						job="programmingJob"
						update-interval="200"
					>
						<inputs>
							<input channel="device"/>
						</inputs>
						<body class="de.haumacher.ehome.programming.download.CompareJob"/>
						<with-result>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/programming-report.view.xml"
							/>
							<!-- The report says how the job ended; its progress display is cleared when the report opens. -->
							<write-channel name="programmingJob" clear="true"/>
						</with-result>
						<!--
							A cancelled comparison (haumacher/ehome #190): the report of what was compared up to the
							cancel. Cancelled before the device was read, it has none; the display of the job stays.
						-->
						<on-cancel as="report">
							<if test="$report != null">
								<then>
									<open-dialog
										bind-input-to="report"
										dialog-view="projects/programming-report.view.xml"
									/>
									<write-channel name="programmingJob" clear="true"/>
								</then>
							</if>
						</on-cancel>
					</start-job>
				</generic-command>
				<!--
					Read out (haumacher/ehome #193): reads the device as the comparison does and keeps what was read
					as a snapshot of the device (panel "Snapshots" below); nothing is written into the device.
				-->
				<generic-command
					image="css:bi bi-sd-card"
					inputs="device, busState, programmingJob, jobDevice"
					observed-types="ehome.project:Project"
					placement="TOOLBAR"
				>
					<label>
						<en>Read out</en>
						<de>Auslesen</de>
					</label>
					<tooltip>
						<en>Reads the memory, the properties, the program version and the load states of the device through the project's gateway or controller and keeps them as a snapshot of the device; nothing is written. Takes seconds to minutes, depending on the device.</en>
						<de>Liest Speicher, Eigenschaften, Programmversion und Ladezustände des Geräts über das Gateway oder den Controller des Projekts und behält sie als Speicherabbild des Geräts; es wird nichts geschrieben. Dauert je nach Gerät Sekunden bis Minuten.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<!-- One job of this tab at a time: its progress and its report belong to its device. -->
						<disabled-if expr='if(jobIsRunning($programmingJob), #("The job for {0} is still running."@en, "Der Auftrag für {0} läuft noch."@de).fill($jobDevice), null)'/>
						<disabled-if expr="compareVeto($device)"/>
					</executability>
					<!-- The job's progress is shown with this device only. -->
					<write-channel name="jobDevice"/>
					<start-job
						cancelable="true"
						job="programmingJob"
						update-interval="200"
					>
						<inputs>
							<input channel="device"/>
						</inputs>
						<body class="de.haumacher.ehome.programming.download.ReadOutJob"/>
						<with-result>
							<write-channel name="snapshot"/>
							<write-channel name="programmingJob" clear="true"/>
						</with-result>
						<!-- Cancelled: what was read up to then is kept as a snapshot that is not complete. -->
						<on-cancel as="stored">
							<if test="$stored != null">
								<then>
									<write-channel name="snapshot"
										value="stored"
									/>
									<write-channel name="programmingJob" clear="true"/>
								</then>
							</if>
						</on-cancel>
					</start-job>
				</generic-command>
				<!--
					The device info (haumacher/ehome #175): asks the device at its individual address who it is and in
					what state, point to point; nothing is written, so a viewer of the project may ask and the write
					switch does not apply. The result opens as projects/device-info.view.xml.
				-->
				<generic-command
					image="css:bi bi-info-circle"
					inputs="device, project, busState, programmingJob, jobDevice"
					observed-types="ehome.project:Project"
					placement="TOOLBAR"
				>
					<label>
						<en>Device info</en>
						<de>Geräte-Info</de>
					</label>
					<tooltip>
						<en>Asks the device at its individual address through the project's gateway or controller who it is (mask version, manufacturer, serial number, order info, hardware type, program) and in what state (load states, run state, programming mode), and shows it beside the project's values; nothing is written.</en>
						<de>Fragt das Gerät unter seiner physikalischen Adresse über das Gateway oder den Controller des Projekts, wer es ist (Maskenversion, Hersteller, Seriennummer, Bestellinformation, Hardware-Typ, Programm) und in welchem Zustand (Ladezustände, Laufzustand, Programmiermodus), und zeigt es neben den Werten des Projekts; es wird nichts geschrieben.</de>
					</tooltip>
					<access>
						<operation name="Read"
							object="$project"
							type="ehome.project:Project"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<!-- One job of this tab at a time: its progress and its report belong to its device. -->
						<disabled-if expr='if(jobIsRunning($programmingJob), #("The job for {0} is still running."@en, "Der Auftrag für {0} läuft noch."@de).fill($jobDevice), null)'/>
						<disabled-if expr="deviceInfoVeto($device)"/>
					</executability>
					<!-- The job's progress is shown with this device only. -->
					<write-channel name="jobDevice"/>
					<start-job
						cancelable="true"
						job="programmingJob"
						update-interval="200"
					>
						<inputs>
							<input channel="device"/>
						</inputs>
						<body class="de.haumacher.ehome.scan.DeviceInfoJob"/>
						<with-result>
							<open-dialog
								bind-input-to="info"
								dialog-view="projects/device-info.view.xml"
							/>
							<!-- The dialog shows how the job ended; its progress display is cleared when the dialog opens. -->
							<write-channel name="programmingJob" clear="true"/>
						</with-result>
					</start-job>
				</generic-command>
				<!--
					The download (full or the parameters only) is an entry of the project's queue (haumacher/ehome #218,
					projects/download-queue.view.xml below): appended at its end, worked through in the background.
				-->
				<generic-command
					image="css:bi bi-download"
					inputs="device, parametersOnly, busState, queueState"
					observed-types="ehome.project:Project,ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection"
					placement="TOOLBAR"
				>
					<label>
						<en>Download</en>
						<de>Herunterladen</de>
					</label>
					<tooltip>
						<en>Appends the download into the device to the project's queue: the application, the parameters and the group addresses, written at its individual address (a new device gets its address first). With "Parameters only", the parameters and the group addresses without the program's code, into a device holding the program. The device does not work until the download is complete, which takes seconds to minutes.</en>
						<de>Reiht den Download in das Gerät in die Warteschlange des Projekts ein: Applikation, Parameter und Gruppenadressen, geschrieben unter seiner physikalischen Adresse (ein neues Gerät erhält zuerst seine Adresse). Mit „Nur Parameter“ die Parameter und Gruppenadressen ohne den Code des Programms, in ein Gerät, das das Programm hält. Das Gerät arbeitet erst wieder, wenn der Download abgeschlossen ist; das dauert Sekunden bis Minuten.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<disabled-if expr="downloadVeto($device, $parametersOnly)"/>
					</executability>
					<confirm expr="downloadConfirmation($device, $parametersOnly)"/>
					<execute-script function="downloadQueueEnqueueDevice($device, $parametersOnly)"/>
				</generic-command>
				<!--
					A full download replacing the device's layout of its dynamic modules (haumacher/ehome #119): only
					where an imported project recorded that the device holds another layout than E-Home computes;
					the confirmation names the difference.
				-->
				<generic-command
					image="css:bi bi-arrow-repeat"
					inputs="device, busState, programmingJob, jobDevice"
					observed-types="ehome.project:Project,ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:InstanceArgument"
					placement="TOOLBAR"
				>
					<label>
						<en>Download with E-Home's module layout</en>
						<de>Mit E-Homes Modul-Layout herunterladen</de>
					</label>
					<tooltip>
						<en>The device holds another layout of its dynamic modules than E-Home computes (recorded by the import of its project). This full download writes E-Home's layout: the device's configuration is then E-Home's.</en>
						<de>Das Gerät hält ein anderes Layout seiner dynamischen Module als E-Home berechnet (beim Import seines Projekts festgestellt). Dieser vollständige Download schreibt E-Homes Layout: die Konfiguration des Geräts ist danach die von E-Home.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<!-- One job of this tab at a time: its progress and its report belong to its device. -->
						<disabled-if expr='if(jobIsRunning($programmingJob), #("The job for {0} is still running."@en, "Der Auftrag für {0} läuft noch."@de).fill($jobDevice), null)'/>
						<disabled-if expr="layoutVeto($device)"/>
					</executability>
					<confirm expr="layoutConfirmation($device)"/>
					<!-- The job's progress is shown with this device only. -->
					<write-channel name="jobDevice"/>
					<start-job
						cancelable="false"
						job="programmingJob"
						update-interval="200"
					>
						<inputs>
							<input channel="device"/>
						</inputs>
						<body class="de.haumacher.ehome.programming.download.DownloadJob"
							kind="LAYOUT"
						/>
						<with-result>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/programming-report.view.xml"
							/>
							<!-- The report says how the job ended; its progress display is cleared when the report opens. -->
							<write-channel name="programmingJob" clear="true"/>
						</with-result>
					</start-job>
				</generic-command>
				<generic-command
					image="css:bi bi-hand-index"
					inputs="device, busState, programmingJob, jobDevice"
					observed-types="ehome.project:Project"
					placement="TOOLBAR"
				>
					<label>
						<en>Write the individual address</en>
						<de>Physikalische Adresse programmieren</de>
					</label>
					<tooltip>
						<en>Writes the individual address of this device into the one device in programming mode. Press the programming button of exactly one device first.</en>
						<de>Schreibt die physikalische Adresse dieses Geräts in das eine Gerät im Programmiermodus. Vorher die Programmiertaste genau eines Geräts drücken.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<!-- One job of this tab at a time: its progress and its report belong to its device. -->
						<disabled-if expr='if(jobIsRunning($programmingJob), #("The job for {0} is still running."@en, "Der Auftrag für {0} läuft noch."@de).fill($jobDevice), null)'/>
						<disabled-if expr="addressVeto($device)"/>
					</executability>
					<confirm expr="addressConfirmation($device)"/>
					<!-- The job's progress is shown with this device only. -->
					<write-channel name="jobDevice"/>
					<start-job
						cancelable="false"
						job="programmingJob"
						update-interval="200"
					>
						<inputs>
							<input channel="device"/>
						</inputs>
						<body class="de.haumacher.ehome.programming.download.DownloadJob"
							kind="ADDRESS"
						/>
						<with-result>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/programming-report.view.xml"
							/>
							<!-- The report says how the job ended; its progress display is cleared when the report opens. -->
							<write-channel name="programmingJob" clear="true"/>
						</with-result>
					</start-job>
				</generic-command>
			</commands>
			<inset>
				<stack gap="default">
					<job-status input="deviceJob"/>
					<value-input
						type="tl.core:Boolean"
						value="parametersOnly"
					>
						<label>
							<en>Parameters only</en>
							<de>Nur Parameter</de>
						</label>
					</value-input>
					<text input="summary"/>
					<!-- Why the download is refused. -->
					<object-list
						gap="compact"
						inputs="device, parametersOnly"
						items="if($device == null, [], downloadProblems($device, $parametersOnly))"
						observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection"
					>
						<item>
							<text
								input="element"
								tone="error"
							/>
						</item>
					</object-list>
					<table>
						<inputs>
							<input channel="device"/>
							<input channel="parametersOnly"/>
						</inputs>
						<columns>
							<computed-column name="number"
								type="tl.core:Integer"
								width="90"
							>
								<label>
									<en>No.</en>
									<de>Nr.</de>
								</label>
								<value>$row["number"]</value>
							</computed-column>
							<computed-column name="step"
								type="tl.core:String"
								width="170"
							>
								<label>
									<en>Step</en>
									<de>Schritt</de>
								</label>
								<value>$row["step"]</value>
							</computed-column>
							<computed-column name="operation"
								type="tl.core:String"
								width="600"
							>
								<label>
									<en>Operation</en>
									<de>Operation</de>
								</label>
								<value>$row["operation"]</value>
							</computed-column>
							<computed-column name="bytes"
								type="tl.core:Integer"
								width="100"
							>
								<label>
									<en>Bytes</en>
									<de>Bytes</de>
								</label>
								<value>$row["bytes"]</value>
							</computed-column>
						</columns>
						<rows>if($device == null, [], downloadPlanRows($device, $parametersOnly))</rows>
					</table>
				</stack>
			</inset>
		</panel>
		<!--
			The snapshots of the device (haumacher/ehome #193): what "Read out" and "Compare" read from it, or a
			file uploaded, newest first. Compare and take-over work on a snapshot without the bus; a snapshot
			downloads as a file (JSON, de.haumacher.ehome.programming.download.SnapshotFile) and a file
			uploads into a device of the same program and mask.
		-->
		<panel>
			<title>
				<en>Snapshots</en>
				<de>Speicherabbilder</de>
			</title>
			<commands>
				<upload-command
					accept=".json,application/json"
					image="css:bi bi-upload"
					inputs="device"
					multiple="false"
					placement="TOOLBAR"
				>
					<label>
						<en>Upload a snapshot</en>
						<de>Speicherabbild hochladen</de>
					</label>
					<tooltip>
						<en>Takes a snapshot file (JSON) as a snapshot of this device; a file read from a device of another program or mask is refused.</en>
						<de>Übernimmt eine Speicherabbild-Datei (JSON) als Speicherabbild dieses Geräts; eine Datei eines Geräts mit anderem Programm oder anderer Maske wird abgelehnt.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<!-- Not <null-input-disabled/>: the uploaded file is an input that is empty until the upload. -->
						<disabled-if expr="$device == null"/>
					</executability>
					<with-transaction>
						<execute-script function="snapshotUpload($device, $file)">
							<inputs>
								<input channel="device"/>
							</inputs>
						</execute-script>
						<with-result>
							<write-channel name="snapshot"/>
						</with-result>
					</with-transaction>
				</upload-command>
				<generic-command
					image="css:bi bi-arrow-left-right"
					inputs="snapshot"
					observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection"
					placement="TOOLBAR"
				>
					<label>
						<en>Compare</en>
						<de>Vergleichen</de>
					</label>
					<tooltip>
						<en>Compares the selected snapshot with the download image, block by block, with the device's and the plan's bytes where they differ; the bus is not used.</en>
						<de>Vergleicht das gewählte Speicherabbild Block für Block mit dem Download-Abbild, mit den Bytes des Geräts und des Plans, wo sie sich unterscheiden; der Bus wird nicht benutzt.</de>
					</tooltip>
					<access>
						<operation name="Read"
							object="$snapshot"
							type="ehome.physical:DeviceSnapshot"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<execute-script function="snapshotCompare($snapshot)">
						<with-result>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/programming-report.view.xml"
							/>
						</with-result>
					</execute-script>
				</generic-command>
				<generic-command
					image="css:bi bi-box-arrow-in-left"
					inputs="snapshot"
					placement="TOOLBAR"
				>
					<label>
						<en>Take over</en>
						<de>Übernehmen</de>
					</label>
					<tooltip>
						<en>Takes the parameter values, connections and flags of the selected snapshot into the project, as "Take over" of the bus scan does; the bus is not used.</en>
						<de>Übernimmt Parameterwerte, Verbindungen und Flags des gewählten Speicherabbilds in das Projekt, wie „Übernehmen“ der Bussuche; der Bus wird nicht benutzt.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$snapshot"
							type="ehome.physical:DeviceSnapshot"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<confirm expr='#("Take the configuration of the snapshot {0} into the project? The device&apos;s parameter values and connections in the project are replaced."@en, "Die Konfiguration des Speicherabbilds {0} in das Projekt übernehmen? Parameterwerte und Verbindungen des Geräts im Projekt werden ersetzt."@de).fill(snapshotLabel($snapshot))'/>
					<execute-script function="snapshotTakeOver($snapshot)">
						<with-result>
							<notify
								expr="$result"
								kind="info"
							/>
						</with-result>
					</execute-script>
				</generic-command>
				<!--
					Restore (haumacher/ehome #194): writes the selected snapshot back into the device, as a download
					whose bytes are the snapshot's; the dialog projects/restore-snapshot.view.xml shows the refusals and
					the plan and runs the job.
				-->
				<generic-command
					image="css:bi bi-arrow-counterclockwise"
					inputs="snapshot"
					placement="TOOLBAR"
				>
					<label>
						<en>Restore</en>
						<de>Wiederherstellen</de>
					</label>
					<tooltip>
						<en>Writes the selected snapshot back into the device through the project's gateway or controller: the program's load procedure with the snapshot's bytes. The project is not changed.</en>
						<de>Schreibt das gewählte Speicherabbild über das Gateway oder den Controller des Projekts in das Gerät zurück: die Ladeprozedur des Programms mit den Bytes des Speicherabbilds. Das Projekt wird nicht geändert.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$snapshot"
							type="ehome.physical:DeviceSnapshot"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<open-dialog
						bind-input-to="snapshot"
						dialog-view="projects/restore-snapshot.view.xml"
					/>
				</generic-command>
				<generic-command
					image="css:bi bi-download"
					inputs="snapshot"
					placement="TOOLBAR"
				>
					<label>
						<en>Download the file</en>
						<de>Datei herunterladen</de>
					</label>
					<tooltip>
						<en>Saves the selected snapshot as a file (JSON).</en>
						<de>Speichert das gewählte Speicherabbild als Datei (JSON).</de>
					</tooltip>
					<access>
						<operation name="Read"
							object="$snapshot"
							type="ehome.physical:DeviceSnapshot"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<execute-script function="snapshotFile($snapshot)">
						<with-result>
							<download/>
						</with-result>
					</execute-script>
				</generic-command>
				<generic-command
					image="css:bi bi-trash"
					inputs="snapshot"
					placement="TOOLBAR"
				>
					<label>
						<en>Delete</en>
						<de>Löschen</de>
					</label>
					<access>
						<operation name="Write"
							object="$snapshot"
							type="ehome.physical:DeviceSnapshot"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<confirm expr='#("Delete the snapshot {0}?"@en, "Das Speicherabbild {0} löschen?"@de).fill(snapshotLabel($snapshot))'/>
					<delete-object/>
					<write-channel name="snapshot" clear="true"/>
				</generic-command>
			</commands>
			<inset>
				<table
					observed-types="ehome.physical:DeviceSnapshot,ehome.physical:Device"
					selection="snapshot"
					types="ehome.physical:DeviceSnapshot"
				>
					<inputs>
						<input channel="device"/>
					</inputs>
					<columns>
						<column attribute="time"
							width="170"
						/>
						<computed-column name="source"
							type="tl.core:String"
							width="260"
						>
							<label>
								<en>Read through</en>
								<de>Gelesen über</de>
							</label>
							<value>if($row.get(`ehome.physical:DeviceSnapshot#file`) != null, $row.get(`ehome.physical:DeviceSnapshot#file`), $row.get(`ehome.physical:DeviceSnapshot#busPath`))</value>
						</computed-column>
						<column attribute="account"
							width="140"
						/>
						<column attribute="descriptor"
							width="80"
						/>
						<column attribute="programVersion"
							width="130"
						/>
						<computed-column name="content"
							type="tl.core:String"
							width="300"
						>
							<label>
								<en>Content</en>
								<de>Inhalt</de>
							</label>
							<value>snapshotSummary($row)</value>
						</computed-column>
						<column attribute="notes"
							width="300"
						/>
					</columns>
					<rows>if($device == null, [], deviceSnapshots($device))</rows>
				</table>
			</inset>
		</panel>
		<view-ref view="projects/download-queue.view.xml">
			<bind
				channel="project"
				to="project"
			/>
		</view-ref>
	</stack>
</view>
