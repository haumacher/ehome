<?xml version="1.0" encoding="utf-8" ?>

<!--
	The programming of a device (tab "Programming" of projects/devices.view.xml): the path of the
	project to the bus (its KNX gateway, or its connected controller, haumacher/ehome #148), the plan of
	the full download (the operations with their addresses and bytes), and the commands reaching the
	device on that path.

	"device" is the device, "project" its project. The plan and the reasons a command is refused are
	computed by the TL-Script functions of de.haumacher.ehome.programming.download.ProgrammingFunctions
	(implemented in Java; the views name the types they depend on in observed-types).

	- Compare reads the device and compares it with the download image; it never writes.
	- Download runs the plan after a confirmation naming the device, its address and the path (gateway
	  or controller).
	- Write address writes the individual address into the one device in programming mode.
	Both writing commands are disabled, with the reason, unless the configuration variable
	tl_ehome_programming_write_enabled is true (de.haumacher.ehome.programming.download.CalimeroWriter,
	de.haumacher.ehome.settings.OperatorSettings), whatever the path. Unless the installation reaches local
	networks (tl_ehome_local_network), a gateway is refused with that reason; the controller stays
	available, and "Choose the gateway" offers only it then.
	The commands run as jobs (DownloadJob, CompareJob) with their progress shown here, and end with
	the report (projects/programming-report.view.xml), which replaces the progress display; a job
	that fails keeps its display with the error.
-->
<view>
	<channels>
		<channel name="device"/>
		<channel name="project"/>
		<channel name="programmingJob"/>
		<!-- The path to the bus: "Gateway <address>" or "Controller <name>" (ProgrammingFunctions busPath). -->
		<derived-channel name="gateway"
			expr="if($project == null, null, busPath($project))"
			inputs="project"
			observed-types="ehome.project:Project"
		/>
		<derived-channel name="summary"
			expr="if($device == null, null, downloadSummary($device))"
			inputs="device"
			observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection"
		/>
	</channels>
	<stack gap="default">
		<panel>
			<title>
				<en>Path to the bus</en>
				<de>Weg zum Bus</de>
			</title>
			<commands>
				<generic-command
					image="css:bi bi-broadcast"
					inputs="project"
					placement="TOOLBAR"
				>
					<label>
						<en>Choose the gateway</en>
						<de>Gateway wählen</de>
					</label>
					<tooltip>
						<en>Sets the path of the project to the bus: a KNXnet/IP gateway, entered by address or chosen from a search, or the project's connected controller. All devices of the project are read and programmed through it.</en>
						<de>Legt den Weg des Projekts zum Bus fest: ein KNXnet/IP-Gateway, als Adresse eingegeben oder aus einer Suche gewählt, oder den verbundenen Controller des Projekts. Darüber werden alle Geräte des Projekts gelesen und programmiert.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$project"
							type="ehome.project:Project"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<open-dialog
						bind-input-to="project"
						dialog-view="projects/choose-gateway.view.xml"
					/>
				</generic-command>
			</commands>
			<inset>
				<stack gap="compact">
					<text input="gateway"/>
					<text tone="helper"
						variant="caption"
					>
						<label>
							<en>The KNXnet/IP gateway of the project, or its controller connected to E-Home, through which the devices are read and programmed. Through the controller, E-Home passes the frames through the controller's KNX tunnel.</en>
							<de>Das KNXnet/IP-Gateway des Projekts oder sein mit E-Home verbundener Controller, über den die Geräte gelesen und programmiert werden. Über den Controller leitet E-Home die Telegramme durch den KNX-Tunnel des Controllers.</de>
						</label>
					</text>
				</stack>
			</inset>
		</panel>
		<panel>
			<title>
				<en>Download</en>
				<de>Download</de>
			</title>
			<commands>
				<generic-command
					image="css:bi bi-file-earmark-binary"
					inputs="device"
					placement="TOOLBAR"
				>
					<label>
						<en>Download image</en>
						<de>Download-Abbild</de>
					</label>
					<tooltip>
						<en>Shows the bytes the download writes into the device, block by block; nothing is sent.</en>
						<de>Zeigt die Bytes, die der Download in das Gerät schreibt, Block für Block; es wird nichts gesendet.</de>
					</tooltip>
					<executability>
						<null-input-disabled/>
					</executability>
					<open-dialog
						bind-input-to="device"
						dialog-view="projects/download-image.view.xml"
					/>
				</generic-command>
				<generic-command
					image="css:bi bi-arrow-left-right"
					inputs="device"
					observed-types="ehome.project:Project,ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection"
					placement="TOOLBAR"
				>
					<label>
						<en>Compare with the device</en>
						<de>Mit dem Gerät vergleichen</de>
					</label>
					<tooltip>
						<en>Reads the memory of the device through the project's gateway or controller and compares it with the download image; nothing is written. Takes seconds to minutes, depending on the device.</en>
						<de>Liest den Speicher des Geräts über das Gateway oder den Controller des Projekts und vergleicht ihn mit dem Download-Abbild; es wird nichts geschrieben. Dauert je nach Gerät Sekunden bis Minuten.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<disabled-if expr="compareVeto($device)"/>
					</executability>
					<start-job
						cancelable="true"
						job="programmingJob"
						update-interval="200"
					>
						<inputs>
							<input channel="device"/>
						</inputs>
						<body class="de.haumacher.ehome.programming.download.CompareJob"/>
						<with-result>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/programming-report.view.xml"
							/>
							<!-- The report says how the job ended; its progress display is cleared when the report opens. -->
							<write-channel name="programmingJob" clear="true"/>
						</with-result>
					</start-job>
				</generic-command>
				<generic-command
					image="css:bi bi-download"
					inputs="device"
					observed-types="ehome.project:Project,ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection"
					placement="TOOLBAR"
				>
					<label>
						<en>Download</en>
						<de>Herunterladen</de>
					</label>
					<tooltip>
						<en>Writes the application, the parameters and the group addresses into the device at its individual address (a new device gets its address first). The device does not work until the download is complete, which takes seconds to minutes.</en>
						<de>Schreibt Applikation, Parameter und Gruppenadressen in das Gerät mit seiner physikalischen Adresse (ein neues Gerät erhält zuerst seine Adresse). Das Gerät arbeitet erst wieder, wenn der Download abgeschlossen ist; das dauert Sekunden bis Minuten.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<disabled-if expr="downloadVeto($device)"/>
					</executability>
					<confirm expr="downloadConfirmation($device)"/>
					<start-job
						cancelable="false"
						job="programmingJob"
						update-interval="200"
					>
						<inputs>
							<input channel="device"/>
						</inputs>
						<body class="de.haumacher.ehome.programming.download.DownloadJob"/>
						<with-result>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/programming-report.view.xml"
							/>
							<!-- The report says how the job ended; its progress display is cleared when the report opens. -->
							<write-channel name="programmingJob" clear="true"/>
						</with-result>
					</start-job>
				</generic-command>
				<!--
					A full download replacing the device's layout of its dynamic modules (haumacher/ehome #119): only
					where an imported project recorded that the device holds another layout than E-Home computes;
					the confirmation names the difference.
				-->
				<generic-command
					image="css:bi bi-arrow-repeat"
					inputs="device"
					observed-types="ehome.project:Project,ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:InstanceArgument"
					placement="TOOLBAR"
				>
					<label>
						<en>Download with E-Home's module layout</en>
						<de>Mit E-Homes Modul-Layout herunterladen</de>
					</label>
					<tooltip>
						<en>The device holds another layout of its dynamic modules than E-Home computes (recorded by the import of its project). This full download writes E-Home's layout: the device's configuration is then E-Home's.</en>
						<de>Das Gerät hält ein anderes Layout seiner dynamischen Module als E-Home berechnet (beim Import seines Projekts festgestellt). Dieser vollständige Download schreibt E-Homes Layout: die Konfiguration des Geräts ist danach die von E-Home.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<disabled-if expr="layoutVeto($device)"/>
					</executability>
					<confirm expr="layoutConfirmation($device)"/>
					<start-job
						cancelable="false"
						job="programmingJob"
						update-interval="200"
					>
						<inputs>
							<input channel="device"/>
						</inputs>
						<body class="de.haumacher.ehome.programming.download.DownloadJob"
							kind="LAYOUT"
						/>
						<with-result>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/programming-report.view.xml"
							/>
							<!-- The report says how the job ended; its progress display is cleared when the report opens. -->
							<write-channel name="programmingJob" clear="true"/>
						</with-result>
					</start-job>
				</generic-command>
				<generic-command
					image="css:bi bi-hand-index"
					inputs="device"
					observed-types="ehome.project:Project"
					placement="TOOLBAR"
				>
					<label>
						<en>Write the individual address</en>
						<de>Physikalische Adresse programmieren</de>
					</label>
					<tooltip>
						<en>Writes the individual address of this device into the one device in programming mode. Press the programming button of exactly one device first.</en>
						<de>Schreibt die physikalische Adresse dieses Geräts in das eine Gerät im Programmiermodus. Vorher die Programmiertaste genau eines Geräts drücken.</de>
					</tooltip>
					<access>
						<operation name="Write"
							object="$device"
							type="ehome.physical:Device"
						/>
					</access>
					<executability>
						<null-input-disabled/>
						<disabled-if expr="addressVeto($device)"/>
					</executability>
					<confirm expr="addressConfirmation($device)"/>
					<start-job
						cancelable="false"
						job="programmingJob"
						update-interval="200"
					>
						<inputs>
							<input channel="device"/>
						</inputs>
						<body class="de.haumacher.ehome.programming.download.DownloadJob"
							kind="ADDRESS"
						/>
						<with-result>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/programming-report.view.xml"
							/>
							<!-- The report says how the job ended; its progress display is cleared when the report opens. -->
							<write-channel name="programmingJob" clear="true"/>
						</with-result>
					</start-job>
				</generic-command>
			</commands>
			<inset>
				<stack gap="default">
					<job-status input="programmingJob"/>
					<text input="summary"/>
					<!-- Why the download is refused. -->
					<object-list
						gap="compact"
						inputs="device"
						items="if($device == null, [], downloadProblems($device))"
						observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection"
					>
						<item>
							<text
								input="element"
								tone="error"
							/>
						</item>
					</object-list>
					<table>
						<inputs>
							<input channel="device"/>
						</inputs>
						<columns>
							<computed-column name="number"
								type="tl.core:Integer"
								width="90"
							>
								<label>
									<en>No.</en>
									<de>Nr.</de>
								</label>
								<value>$row["number"]</value>
							</computed-column>
							<computed-column name="step"
								type="tl.core:String"
								width="170"
							>
								<label>
									<en>Step</en>
									<de>Schritt</de>
								</label>
								<value>$row["step"]</value>
							</computed-column>
							<computed-column name="operation"
								type="tl.core:String"
								width="600"
							>
								<label>
									<en>Operation</en>
									<de>Operation</de>
								</label>
								<value>$row["operation"]</value>
							</computed-column>
							<computed-column name="bytes"
								type="tl.core:Integer"
								width="100"
							>
								<label>
									<en>Bytes</en>
									<de>Bytes</de>
								</label>
								<value>$row["bytes"]</value>
							</computed-column>
						</columns>
						<rows>if($device == null, [], downloadPlanRows($device))</rows>
					</table>
				</stack>
			</inset>
		</panel>
	</stack>
</view>
