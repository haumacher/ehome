<?xml version="1.0" encoding="utf-8" ?>

<!--
	The topology of a project: areas, their lines and the devices on a line; devices not placed in a
	line yet follow the areas. A device changed since its last download is marked (DeviceChangeFunctions,
	haumacher/ehome #15). The selected node is shown beside the tree; a device in its tabs: its data,
	its configuration by the structure of its program (projects/device-item.view.xml for each entry of a
	page; a page holding a change since the last download is marked), its communication objects with the
	group addresses they are connected to, its changes against the state of the last download or the
	defaults (projects/device-change-group.view.xml per page), and its programming
	(projects/device-programming.view.xml).

	Besides the import and the bus scan, a device is planned here (haumacher/ehome #104): "New",
	"Device" plans one from the catalog in the selected line (projects/create-device.view.xml), and
	"Duplicate the device" copies the selected one with its parameter settings to the next free address
	of its line (DevicePlanning).

	The changes are computed by the Java functions of DeviceChangeFunctions (haumacher/ehome #15): the
	channels and lists reading them name the settings, connectors and connections of devices and the
	devices (a download moves the reference) as observed types.

	The switch "Structure" above the tree shows the devices by line (the topology above, the default)
	or by building part (haumacher/ehome #106): the buildings of the project and their parts, nested in
	their order, all parts including the empty ones, each part with the KNX devices placed in it
	(ehome.physical:Device#location) by individual address, and the node "No location" (the text
	"noLocation", no object) with the devices placed in no part. There one or several selected devices
	are dragged onto a building part to place them there, or onto "No location" to remove their
	placement (buildingPlace); dragging a device takes the access check Write on it. Areas and lines
	are created only in the structure by line, building parts only in the tab Buildings; a selected
	part shows its name, type and path. The tree selects several nodes (for the drag); "selected" is
	the single selected node. The choice holds for the session: remembering it per user waits for
	TL #30215 (doc/tl-todo.md).

	The tab bar of a device has the id "device-tabs" and its tabs are keyed by their ids, so that a
	module depending on the app adds a tab with a same-path overlay of this view addressing the tab
	bar by config:ref (TL #29896): the development tooling (module ehome-virtual) adds its "Virtual
	device" tab that way.
-->
<view>
	<channels>
		<channel name="project"/>
		<!--
			The structure the tree shows the devices in: "line" (areas, lines, devices) or "building"
			(buildings, their parts, devices by location). For the session: remembered per user once a
			value channel can be (TL #30215), then personalize="true".
		-->
		<channel name="structure"
			init="'line'"
		/>
		<!-- The nodes selected in the tree: one node, the set of several, or nothing. -->
		<channel name="treeSelection"/>
		<!-- The single selected node; writing it selects that node in the tree. -->
		<derived-channel name="selected"
			expr="if($treeSelection.size() == 1, $treeSelection.singleElement(), null)"
			inputs="treeSelection"
			reverse="$value"
		/>
		<!-- The selected node deleted by "Delete": an area, a line or a device, not a building part. -->
		<derived-channel name="selectedNode"
			expr="if($selected.instanceOf(`ehome.physical:Area`) or $selected.instanceOf(`ehome.physical:Line`) or $selected.instanceOf(`ehome.physical:Device`), $selected, null)"
			inputs="selected"
		/>
		<!-- The selected building part (structure by building part), shown read-only. -->
		<derived-channel name="part"
			expr="if($selected.instanceOf(`ehome.building:BuildingDefinition`), $selected, null)"
			inputs="selected"
		/>
		<derived-channel name="partName"
			expr="$part.get(`ehome.building:BuildingDefinition#name`)"
			inputs="part"
			observed-types="ehome.building:BuildingDefinition"
		/>
		<derived-channel name="partType"
			expr="if($part == null, null, $part.type().label())"
			inputs="part"
		/>
		<derived-channel name="partPath"
			expr="buildingPath($part)"
			inputs="part"
			observed-types="ehome.building:BuildingDefinition"
		/>
		<derived-channel name="selectedArea"
			expr="if($selected.instanceOf(`ehome.physical:Area`), $selected, null)"
			inputs="selected"
		/>
		<!-- The line a new device is planned in: the selected line, or the line of the selected device. -->
		<derived-channel name="planLine"
			expr="devicePlanLine($selected)"
			inputs="selected"
		/>
		<!-- The tabs of a device. -->
		<!-- The selected device. -->
		<derived-channel name="device"
			expr="if($selected.instanceOf(`ehome.physical:Device`), $selected, null)"
			inputs="selected"
		/>
		<!-- Where the selected device is placed, as the path of its building part, details first ("Küche, Erdgeschoss"). -->
		<derived-channel name="locationPath"
			expr="buildingPath($device.get(`ehome.physical:Device#location`))"
			inputs="device"
			observed-types="ehome.physical:Device,ehome.building:BuildingDefinition"
		/>
		<!--
			What the device's values select in the structure of its program (the cases of its switches);
			changes when a value opens or closes a part of the structure, which rebuilds the pages. The
			channel observes the settings, so a changed value recomputes it.
		-->
		<derived-channel name="configuration"
			expr="if($device == null, null, deviceSelectedCases($device))"
			inputs="device"
			observed-types="ehome.physical:ParameterSetting"
		/>
		<!-- The page selected in the device's configuration; the device itself (the top) without one. -->
		<channel name="page"/>
		<derived-channel name="shownPage"
			expr="if($page == null, $device, $page)"
			inputs="device, page"
		/>
		<!-- The communication object selected (only one of the selected device), and the connection selected of it. -->
		<channel name="selectedInterface"/>
		<derived-channel name="interface"
			expr="if($device != null and $selectedInterface != null and deviceInterfaces($device).containsElement($selectedInterface), $selectedInterface, null)"
			inputs="device, selectedInterface"
			observed-types="ehome.physical:Connector,ehome.physical:Connection,ehome.physical:ParameterSetting"
		/>
		<channel name="selectedConnection"/>
		<derived-channel name="connection"
			expr="if($interface != null and $selectedConnection != null and deviceConnections($device, $interface).containsElement($selectedConnection), $selectedConnection, null)"
			inputs="device, interface, selectedConnection"
			observed-types="ehome.physical:Connection"
		/>
		<!--
			The pages of the configuration holding a change since the last download; an input of the tree
			of pages, which is built anew with its marks when they change.
		-->
		<derived-channel name="changedPages"
			expr="if($device == null, [], deviceChangedPages($device))"
			inputs="device"
			observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
		/>
		<!--
			What the changes of the device are listed against: the state of the last download (the
			default where one is known) or the defaults of the program, until the user chooses. The
			choice is the first input: the reverse writes it.
		-->
		<channel name="chosenReference"/>
		<derived-channel name="reference"
			expr="if($device == null, null, deviceChangeReference($device, $chosenReference))"
			inputs="chosenReference, device"
			observed-types="ehome.physical:Device"
			reverse="$value"
		/>
		<derived-channel name="changeSummary"
			inputs="device, reference"
			observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
		>
			<expr><![CDATA[if($device == null, null, {
    count = deviceChangeCount($device, $reference);
    if($reference == `ehome.physical:ChangeReference#device`,
        #("Changes since the last download: {0}"@en, "Änderungen seit dem letzten Download: {0}"@de),
        #("Values other than the default: {0}"@en, "Von der Vorgabe abweichende Werte: {0}"@de))
        .fill($count).localize()
})]]></expr>
		</derived-channel>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="240"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Devices</en>
						<de>Geräte</de>
					</title>
					<commands>
						<!-- Areas and lines are created in the structure by line only. -->
						<generic-command
							clique="new"
							image="css:bi bi-diagram-3"
							inputs="project, structure"
							placement="TOOLBAR"
						>
							<label>
								<en>Area</en>
								<de>Bereich</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<visible-if expr="$structure == 'line'"/>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.physical:Area">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="project"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-dash-lg"
							inputs="selectedArea, structure"
							placement="TOOLBAR"
						>
							<label>
								<en>Line</en>
								<de>Linie</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedArea"
									type="ehome.physical:Area"
								/>
							</access>
							<executability>
								<visible-if expr="$structure == 'line'"/>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.physical:Line">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="create-node.view.xml"
									>
										<bind
											channel="container"
											to="selectedArea"
										/>
										<bind
											channel="selection"
											to="selected"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<!--
							A device planned from the catalog in the selected line (or the line of the selected
							device), haumacher/ehome #104: projects/create-device.view.xml.
						-->
						<generic-command
							clique="new"
							image="css:fa-solid fa-mobile-screen-button"
							inputs="planLine"
							placement="TOOLBAR"
						>
							<label>
								<en>Device</en>
								<de>Gerät</de>
							</label>
							<tooltip>
								<en>Plans a new device from the catalog in the selected line: product, application program, individual address. The device is configured in the app and needs a full download.</en>
								<de>Plant ein neues Gerät aus dem Katalog in der gewählten Linie: Produkt, Applikationsprogramm, physikalische Adresse. Das Gerät wird in der App konfiguriert und braucht einen vollständigen Download.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$planLine"
									type="ehome.physical:Line"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="line"
								dialog-view="projects/create-device.view.xml"
							>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<!--
							A copy of the selected device with its parameter settings in its line, at the next
							free address, without connections, nothing loaded (haumacher/ehome #104).
						-->
						<generic-command
							image="css:bi bi-copy"
							inputs="device"
							placement="TOOLBAR"
						>
							<label>
								<en>Duplicate the device</en>
								<de>Gerät duplizieren</de>
							</label>
							<tooltip>
								<en>Creates a copy of the selected device with its parameter values in the same line, at the next free individual address. The copy has no group addresses connected and needs a full download.</en>
								<de>Erstellt eine Kopie des gewählten Geräts mit seinen Parameterwerten in derselben Linie, an der nächsten freien physikalischen Adresse. Die Kopie hat keine Gruppenadressen verbunden und braucht einen vollständigen Download.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$device"
									type="ehome.physical:Device"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="devicePlanDuplicateVeto($device)"/>
							</executability>
							<with-transaction>
								<execute-script function="devicePlanDuplicate($device)"/>
								<with-result>
									<write-channel name="selected"/>
								</with-result>
							</with-transaction>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="selectedNode"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Delete {0}?'@en, '{0} löschen?'@de).fill($selectedNode.label())"/>
							<delete-object/>
							<write-channel name="selected" clear="true"/>
						</generic-command>
						<generic-command
							image="css:bi bi-arrow-counterclockwise"
							inputs="project"
							observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
							placement="TOOLBAR"
						>
							<label>
								<en>Discard all changes of all devices since their last download</en>
								<de>Alle Änderungen aller Geräte seit dem letzten Download verwerfen</de>
							</label>
							<tooltip>
								<en>Sets the parameter values and connections of every device back to the state of its last download; the changes since are lost.</en>
								<de>Setzt die Parameterwerte und Verbindungen aller Geräte auf den Stand ihres letzten Downloads zurück; die Änderungen seither gehen verloren.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="projectDiscardVeto($project)"/>
							</executability>
							<confirm expr="projectDiscardConfirmation($project)"/>
							<with-transaction>
								<execute-script function="projectDiscardChanges($project)"/>
							</with-transaction>
						</generic-command>
					</commands>
					<stack>
						<inset>
							<fields>
								<!-- The structure of the tree (haumacher/ehome #106); a further structure is a further option. -->
								<value-input
									mandatory="true"
									options="['line', 'building']"
									value="structure"
								>
									<label>
										<en>Structure</en>
										<de>Struktur</de>
									</label>
									<input-control class="com.top_logic.layout.view.form.SelectControlProvider"
										display="radio"
										orientation="horizontal"
									>
										<option-labels class="com.top_logic.model.search.providers.LabelProviderByExpression"
											label="x -> if($x == 'building', #('Building'@en, 'Gebäude'@de), #('Line'@en, 'Linie'@de)).localize()"
										/>
									</input-control>
									<!--
										The tree built anew for the other structure keeps the selected nodes selected but
										does not open the nodes above them (engine gap, TL #30217): the selection is
										written again, which reveals it.
									-->
									<on-submit inputs="treeSelection as kept">
										<write-channel name="treeSelection" clear="true"/>
										<execute-script function="$kept">
											<with-result>
												<write-channel name="treeSelection"/>
											</with-result>
										</execute-script>
									</on-submit>
								</value-input>
							</fields>
						</inset>
						<!--
							The devices in the chosen structure with the columns of the classic tree grid (exported
							to Excel as an outline, in the structure shown). By building part, the devices are
							dragged onto a part or onto "No location"; by line there is no drag (another line is
							another individual address).
						-->
						<tree-table
							observed-types="ehome.physical:Area,ehome.physical:Line,ehome.physical:Device,ehome.building:BuildingDefinition"
							selection="treeSelection"
							selection-mode="multi"
						>
							<inputs>
								<input channel="project"/>
								<input channel="structure"/>
							</inputs>
							<root>$project</root>
							<children><![CDATA[if($structure == 'building',
    switch {
        $node.instanceOf(`ehome.project:Project`):
            concat($node.get(`ehome.project:Project#buildings`), ['noLocation']);
        $node.instanceOf(`ehome.building:BuildingDefinition`):
            concat($node.get(`ehome.building:BuildingDefinition#parts`), buildingDevices($node));
        $node == 'noLocation':
            buildingUnplacedDevices($project);
        default: [];
    },
    switch {
        $node.instanceOf(`ehome.project:Project`):
            concat(
                $node.get(`ehome.project:Project#areas`),
                $node.get(`ehome.project:Project#unassignedDevices`));
        $node.instanceOf(`ehome.physical:Area`):
            $node.get(`ehome.physical:Area#lines`);
        $node.instanceOf(`ehome.physical:Line`):
            $node.get(`ehome.physical:Line#devices`);
        default: [];
    })]]></children>
							<parents><![CDATA[if($structure == 'building',
    switch {
        $node == 'noLocation':
            $project;
        $node.instanceOf(`ehome.physical:Device`):
            if($node.get(`ehome.physical:Device#location`) == null, 'noLocation', $node.get(`ehome.physical:Device#location`));
        $node.instanceOf(`ehome.building:BuildingDefinition`):
            $node.container();
        default: null;
    },
    if($node.instanceOf(`ehome.physical:Area`) or $node.instanceOf(`ehome.physical:Line`) or $node.instanceOf(`ehome.physical:Device`), $node.container(), null))]]></parents>
							<!--
								By building part, the selected devices (only devices, and only those the user may
								change) are dragged onto a part or onto "No location"; there is no place between two
								devices, as the devices of a part have no order.
							-->
							<drag
								input="structure"
								kind="ehomeDevice"
							>
								<executability>
									<disabled-if expr="$structure != 'building'"/>
								</executability>
								<row-executability>
									<disabled-if expr="if(!$row.instanceOf(`ehome.physical:Device`), #('Only devices are placed in a building part.'@en, 'Nur Geräte werden einem Gebäudeteil zugeordnet.'@de))"/>
									<operation name="Write"
										object="$row"
										type="ehome.physical:Device"
									/>
								</row-executability>
							</drag>
							<drop
								accept="ehomeDevice"
								input="structure"
								target="row"
							>
								<executability>
									<disabled-if expr="$structure != 'building'"/>
								</executability>
								<refuse-if><![CDATA[switch {
    !$objects.filter(d -> !$d.instanceOf(`ehome.physical:Device`)).isEmpty():
        #("Only devices are placed in a building part."@en, "Nur Geräte werden einem Gebäudeteil zugeordnet."@de);
    !$objects.filter(d -> !canWrite($d)).isEmpty():
        #("You may not change the location of these devices."@en, "Sie dürfen den Standort dieser Geräte nicht ändern."@de);
    !$target.instanceOf(`ehome.building:BuildingDefinition`) and $target != 'noLocation':
        #("Drop the devices onto a building part or onto \"No location\"."@en, "Die Geräte auf ein Gebäudeteil oder auf „Ohne Standort“ ziehen."@de);
    default: null;
}]]></refuse-if>
								<with-transaction>
									<!--
										The dropped devices stay selected in their new place, which is opened: the selection
										is written again, as the tree does not reveal a selection that moved (see the switch).
									-->
									<execute-script>
										<function><![CDATA[{
    part = if($target.instanceOf(`ehome.building:BuildingDefinition`), $target, null);
    $objects.foreach(d -> buildingPlace($d, $part));
    $objects
}]]></function>
									</execute-script>
									<with-result>
										<write-channel name="treeSelection" clear="true"/>
										<write-channel name="treeSelection"/>
									</with-result>
								</with-transaction>
							</drop>
							<export download-name="#('Devices of {0}'@en, 'Geräte von {0}'@de).fill($project.get(`ehome.project:Project#name`))">
								<sheet-name>
									<en>Devices</en>
									<de>Geräte</de>
								</sheet-name>
							</export>
							<columns>
								<!--
									A device changed since its last download is marked (it changes with every change of its
									configuration). The node "No location" (no object, structure by building part) is shown by its
									text, also in the Excel export.
								-->
								<computed-column name="name"
									width="260"
								>
									<label>
										<en>Name</en>
										<de>Name</de>
									</label>
									<value>if($row == 'noLocation', #('No location'@en, 'Ohne Standort'@de).localize(), $row)</value>
									<display class="com.top_logic.layout.view.element.ResourceDisplayByExpression"
										css-class="if($value.instanceOf(`ehome.physical:Device`) and deviceChanged($value, $value), 'ehomeChanged', null)"
										icon="if($value.instanceOf(`ehome.core:Externalized`), null, 'css:bi bi-question-circle')"
									/>
								</computed-column>
								<computed-column name="extId"
									type="tl.core:String"
									width="160"
								>
									<label>
										<en>External ID</en>
										<de>Externe ID</de>
									</label>
									<value>if($row.instanceOf(`ehome.core:Externalized`), $row.get(`ehome.core:Externalized#extId`), null)</value>
								</computed-column>
								<!-- Where a device is placed in the building structure. -->
								<computed-column name="location"
									type="tl.core:String"
									width="200"
								>
									<label>
										<en>Location</en>
										<de>Standort</de>
									</label>
									<value>if($row.instanceOf(`ehome.physical:Device`), buildingPath($row.get(`ehome.physical:Device#location`)), null)</value>
								</computed-column>
								<!-- The individual address: area, area.line, area.line.device; the number alone of a device in no line. -->
								<computed-column name="address"
									type="tl.core:String"
									width="100"
								>
									<label>
										<en>Address</en>
										<de>Adresse</de>
									</label>
									<value><![CDATA[switch {
    $row.instanceOf(`ehome.physical:Area`):
        toString($row.get(`ehome.physical:Area#address`));
    $row.instanceOf(`ehome.physical:Line`):
        toString($row.container().get(`ehome.physical:Area#address`), ".", $row.get(`ehome.physical:Line#address`));
    $row.instanceOf(`ehome.physical:Device`) and $row.container().instanceOf(`ehome.physical:Line`):
        toString($row.container().container().get(`ehome.physical:Area#address`), ".", $row.container().get(`ehome.physical:Line#address`), ".", $row.get(`ehome.physical:Device#address`));
    $row.instanceOf(`ehome.physical:Device`):
        toString($row.get(`ehome.physical:Device#address`));
    default: null;
}]]></value>
								</computed-column>
							</columns>
						</tree-table>
					</stack>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<panel>
					<title>
						<en>Details</en>
						<de>Details</de>
					</title>
					<switch input="selected">
						<case test="$selected.instanceOf(`ehome.physical:Area`) or $selected.instanceOf(`ehome.physical:Line`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="address"/>
								<field attribute="extId"/>
							</form>
						</case>
						<!-- A building part (structure by building part), read-only: parts are edited in the tab Buildings. -->
						<case test="$selected.instanceOf(`ehome.building:BuildingDefinition`)">
							<inset>
								<fields>
									<value-input
										readonly="true"
										type="tl.core:String"
										value="partName"
									>
										<label>
											<en>Name</en>
											<de>Name</de>
										</label>
									</value-input>
									<value-input
										readonly="true"
										type="tl.core:String"
										value="partType"
									>
										<label>
											<en>Type</en>
											<de>Typ</de>
										</label>
									</value-input>
									<value-input
										readonly="true"
										type="tl.core:String"
										value="partPath"
									>
										<label>
											<en>Path</en>
											<de>Pfad</de>
										</label>
									</value-input>
								</fields>
							</inset>
						</case>
						<case test="$selected.instanceOf(`ehome.physical:Device`)">
							<!--
								A device: its data, its configuration by the structure of its program, its
								communication objects with their group addresses, and the values the project
								changed.
							-->
							<tab-bar id="device-tabs"
								active-tab="parameters"
							>
								<tabs>
									<tab id="device"
										icon="css:bi bi-info-circle"
									>
										<label>
											<en>Device</en>
											<de>Gerät</de>
										</label>
										<!--
											The location is chosen from the building parts of the project in a dialog
											(projects/choose-location.view.xml), not from the plain reference field, which
											would offer the parts of every project without their path.
										-->
										<form
											input="selected"
											with-inset="true"
										>
											<commands>
												<generic-command
													image="css:fa-solid fa-location-dot"
													inputs="device"
													placement="TOOLBAR"
												>
													<label>
														<en>Choose the location</en>
														<de>Standort wählen</de>
													</label>
													<tooltip>
														<en>Places the device in a building part of the project (a room, a floor, …) or removes it from its part. The building parts are created in the tab Buildings.</en>
														<de>Ordnet das Gerät einem Gebäudeteil des Projekts zu (einem Raum, einer Etage …) oder hebt die Zuordnung auf. Die Gebäudeteile werden im Reiter „Gebäude“ angelegt.</de>
													</tooltip>
													<access>
														<operation name="Write"
															object="$device"
															type="ehome.physical:Device"
														/>
													</access>
													<executability>
														<null-input-disabled/>
													</executability>
													<open-dialog
														bind-input-to="device"
														dialog-view="projects/choose-location.view.xml"
													>
														<bind
															channel="selection"
															to="selected"
														/>
													</open-dialog>
												</generic-command>
											</commands>
											<field attribute="title"/>
											<field attribute="address"/>
											<field attribute="type"/>
											<field attribute="program"/>
											<value-input
												readonly="true"
												type="tl.core:String"
												value="locationPath"
											>
												<label>
													<en>Location</en>
													<de>Standort</de>
												</label>
											</value-input>
											<field attribute="description"/>
											<field attribute="installationHints"/>
											<field attribute="serialText"/>
											<field attribute="loaded"/>
											<field attribute="lastModified"/>
											<field attribute="lastDownload"/>
											<field attribute="downloadPending"/>
											<field attribute="extId"/>
										</form>
									</tab>
									<tab id="parameters"
										icon="css:bi bi-sliders"
									>
										<label>
											<en>Parameters</en>
											<de>Parameter</de>
										</label>
										<!--
											The configuration as ETS shows it: the pages of the program's structure
											(channels, the channel independent part, parameter blocks) in effect with the
											device's values, and the parameters and communication objects of the selected
											page, each parameter with the input of its type. A change that selects another
											case of a switch changes the pages and the entries at once.
										-->
										<split-panel
											orientation="horizontal"
											resizable="true"
										>
											<panes>
												<pane
													min-size="200"
													size="35"
													unit="%"
												>
													<tree
														observed-types="ehome.physical:ParameterSetting"
														selection="page"
													>
														<inputs>
															<input channel="device"/>
															<input channel="configuration"/>
															<input channel="changedPages"/>
														</inputs>
														<root>$device</root>
														<children>devicePages($device, $node)</children>
														<parents>deviceParentPage($device, $node)</parents>
														<!-- A page holding a change since the last download (on it or below it) is marked. -->
														<!-- The label with {{0}} filled from the device's values (DeviceTexts). -->
														<nodeContent class="de.haumacher.ehome.view.ScriptLabelControlProvider"
															css-class="if(deviceChanged($device, $value), 'ehomeChanged', null)"
															label="deviceText($device, $value)"
															inputs="device"
														/>
													</tree>
												</pane>
												<pane
													min-size="300"
													size="65"
													unit="%"
												>
													<inset>
														<object-list
															element-channel="item"
															gap="compact"
															inputs="device, shownPage, configuration"
															items="deviceItems($device, $shownPage)"
															observed-types="ehome.physical:ParameterSetting"
														>
															<item>
																<view-ref view="projects/device-item.view.xml">
																	<bind
																		channel="device"
																		to="device"
																	/>
																	<bind
																		channel="item"
																		to="item"
																	/>
																</view-ref>
															</item>
															<empty-text>
																<en>Nothing to set here; the parameters are on the pages below.</en>
																<de>Hier ist nichts einzustellen; die Parameter stehen auf den Seiten darunter.</de>
															</empty-text>
														</object-list>
													</inset>
												</pane>
											</panes>
										</split-panel>
									</tab>
									<tab id="objects"
										icon="css:bi bi-plug-fill"
									>
										<label>
											<en>Communication objects</en>
											<de>Kommunikationsobjekte</de>
										</label>
										<!--
											The communication objects in effect (and those no longer in effect that still
											have connections), and the group addresses the selected one is connected to.
										-->
										<split-panel
											orientation="horizontal"
											resizable="true"
										>
											<panes>
												<pane
													min-size="240"
													size="65"
													unit="%"
												>
													<table
														observed-types="ehome.physical:Connection,ehome.physical:Connector,ehome.physical:ParameterSetting,ehome.physical:Device"
														selection="selectedInterface"
														types="ehome.operational:Interface"
													>
														<inputs>
															<input channel="device"/>
															<input channel="configuration"/>
														</inputs>
														<columns>
															<computed-column name="number"
																type="tl.core:Integer"
																width="90"
															>
																<label>
																	<en>No.</en>
																	<de>Nr.</de>
																</label>
																<value>$row.get(`ehome.operational:Interface#port`).get(`ehome.operational:Port#index`)</value>
															</computed-column>
															<!-- The text with {{0}} filled from the device's values (DeviceTexts). -->
															<computed-column name="displayName"
																type="tl.core:String"
																width="170"
															>
																<inputs>
																	<input channel="device"/>
																</inputs>
																<label>
																	<en>Text</en>
																	<de>Text</de>
																</label>
																<value>deviceText($device, $row)</value>
															</computed-column>
															<column attribute="function"
																width="130"
															/>
															<computed-column name="connections"
																multiple="true"
																type="ehome.physical:Connection"
																width="200"
															>
																<inputs>
																	<input channel="device"/>
																</inputs>
							<label>
																	<en>Group addresses</en>
																	<de>Gruppenadressen</de>
																</label>
																<value>deviceConnections($device, $row)</value>
															</computed-column>
															<!-- What the device holds where the connections changed since the last download. -->
															<computed-column name="device"
																type="tl.core:String"
																width="220"
															>
																<inputs>
																	<input channel="device"/>
																</inputs>
							<label>
																	<en>Since the last download</en>
																	<de>Seit dem letzten Download</de>
																</label>
																<value>deviceReferenceHint($device, $row)</value>
															</computed-column>
														</columns>
														<rows>deviceInterfaces($device)</rows>
													</table>
												</pane>
												<pane
													min-size="200"
													size="35"
													unit="%"
												>
													<panel>
														<title>
															<en>Group addresses</en>
															<de>Gruppenadressen</de>
														</title>
														<commands>
															<generic-command
																image="css:bi bi-link-45deg"
																inputs="interface, device"
																placement="TOOLBAR"
															>
																<label>
																	<en>Connect a group address</en>
																	<de>Gruppenadresse verbinden</de>
																</label>
																<tooltip>
																	<en>Connects the selected communication object to a group address of the project, sending to it or receiving from it. The device gets the connection with its next download.</en>
																	<de>Verbindet das gewählte Kommunikationsobjekt mit einer Gruppenadresse des Projekts, an die es sendet oder von der es empfängt. Das Gerät erhält die Verbindung mit seinem nächsten Download.</de>
																</tooltip>
																<access>
																	<operation name="Write"
																		object="$device"
																		type="ehome.physical:Device"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																</executability>
																<open-dialog
																	bind-input-to="interface"
																	dialog-view="projects/connect-group-address.view.xml"
																>
																	<bind
																		channel="device"
																		to="device"
																	/>
																	<bind
																		channel="selection"
																		to="selectedConnection"
																	/>
																</open-dialog>
															</generic-command>
															<generic-command
																image="css:bi bi-x-lg"
																inputs="connection"
																placement="TOOLBAR"
															>
																<label>
																	<en>Remove the connection</en>
																	<de>Verbindung entfernen</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$connection"
																		type="ehome.physical:Connection"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																</executability>
																<with-transaction>
																	<execute-script function="deviceDisconnect($connection)"/>
																	<with-result>
																		<write-channel name="selectedConnection"/>
																	</with-result>
																</with-transaction>
															</generic-command>
														</commands>
														<table
															observed-types="ehome.physical:Connection,ehome.physical:Connector"
															selection="selectedConnection"
															types="ehome.physical:Connection"
														>
															<inputs>
																<input channel="device"/>
																<input channel="interface"/>
															</inputs>
															<columns>
																<column attribute="target"
																	width="220"
																/>
																<column attribute="kind"
																	width="130"
																/>
															</columns>
															<rows>if($interface == null, [], deviceConnections($device, $interface))</rows>
														</table>
													</panel>
												</pane>
											</panes>
										</split-panel>
									</tab>
									<tab id="settings"
										icon="css:bi bi-pencil-square"
									>
										<label>
											<en>Changed values</en>
											<de>Geänderte Werte</de>
										</label>
										<!--
											The changes of the device against the state of its last download (offered when
											one is known, and the default then) or against the defaults of its program, grouped
											by the page of the structure they are shown on, each entry with its input and the
											ways back to the default and to the device's state. Discarding all changes since
											the last download sets the device back to that state.
										-->
										<panel>
											<title>
												<en>Changed values</en>
												<de>Geänderte Werte</de>
											</title>
											<commands>
												<generic-command
													image="css:bi bi-arrow-counterclockwise"
													inputs="device"
													observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
													placement="TOOLBAR"
												>
													<label>
														<en>Discard all changes since the last download</en>
														<de>Alle Änderungen seit dem letzten Download verwerfen</de>
													</label>
													<tooltip>
														<en>Sets the parameter values and connections of this device back to the state of its last download; the changes since are lost.</en>
														<de>Setzt die Parameterwerte und Verbindungen dieses Geräts auf den Stand seines letzten Downloads zurück; die Änderungen seither gehen verloren.</de>
													</tooltip>
													<access>
														<operation name="Write"
															object="$device"
															type="ehome.physical:Device"
														/>
													</access>
													<executability>
														<null-input-disabled/>
														<disabled-if expr="deviceDiscardVeto($device)"/>
													</executability>
													<confirm expr="deviceDiscardConfirmation($device)"/>
													<with-transaction>
														<execute-script function="deviceDiscardChanges($device)"/>
													</with-transaction>
												</generic-command>
											</commands>
											<inset>
												<stack gap="default">
													<fields>
														<value-input
															inputs="device"
															label-position="hide-label"
															mandatory="true"
															options="deviceChangeReferences($device)"
															type="ehome.physical:ChangeReference"
															value="reference"
														>
															<label>
																<en>Compared with</en>
																<de>Verglichen mit</de>
															</label>
															<input-control class="com.top_logic.layout.view.form.SelectControlProvider"
																display="radio"
																orientation="horizontal"
															/>
														</value-input>
													</fields>
													<text
														input="changeSummary"
														tone="secondary"
													/>
													<object-list
														element-channel="changeGroup"
														gap="default"
														inputs="device, reference"
														items="if($device == null, [], deviceChangeGroups($device, $reference))"
														observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
													>
														<item>
															<view-ref view="projects/device-change-group.view.xml">
																<bind
																	channel="device"
																	to="device"
																/>
																<bind
																	channel="group"
																	to="changeGroup"
																/>
															</view-ref>
														</item>
														<empty-text>
															<en>No changes.</en>
															<de>Keine Änderungen.</de>
														</empty-text>
													</object-list>
												</stack>
											</inset>
										</panel>
									</tab>
									<tab id="programming"
										icon="css:bi bi-cpu"
									>
										<label>
											<en>Programming</en>
											<de>Programmierung</de>
										</label>
										<!--
											The download into the device over the project's KNX gateway: the plan, the
											comparison with the device, the download (projects/device-programming.view.xml).
										-->
										<view-ref view="projects/device-programming.view.xml">
											<bind
												channel="device"
												to="device"
											/>
											<bind
												channel="project"
												to="project"
											/>
										</view-ref>
									</tab>
								</tabs>
							</tab-bar>
						</case>
					</switch>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
