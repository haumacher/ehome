<?xml version="1.0" encoding="utf-8" ?>

<!--
	The queue of the downloads of a project (haumacher/ehome #200, #218), below the commands of the tab
	"Programming" of every selection in the tree of the devices (projects/device-programming.view.xml for a
	device, projects/devices-programming.view.xml for several).

	"project" is the project. The queue (de.haumacher.ehome.programming.download.DownloadQueue) is runtime
	state of the project in the application (no model), the same for every session; a background task works
	through it, one device after another on the project's path to the bus, so the user keeps working. The
	functions downloadQueue* are de.haumacher.ehome.programming.download.DownloadQueueFunctions. Each row is
	an entry: the device, the kind of its download (full or the parameters only), its state (waiting, running,
	done, failed, cancelled, aborted) and the details (the operation running, the outcome, the reason of a
	failure).

	"All with changes" appends every device of the project with downloadPending, whatever is selected in the
	tree; "Cancel" takes the selected waiting entries out, "Cancel all waiting" every waiting one, untouched;
	"Abort" stops the running download before its next operation and the queue goes on with the next device;
	"Remove finished" removes the done, failed, cancelled and aborted entries; "Report" opens the report of
	the selected finished download (projects/programming-report.view.xml). Every member of the project sees
	the queue; the commands changing it check Write on the project.

	The queue's changes reach the view through the source channel "queueState"
	(de.haumacher.ehome.programming.download.DownloadQueueSource), an input of the table's cells and of the
	commands.
-->
<view>
	<channels>
		<channel name="project"/>
		<!-- The rows selected in the table: one entry, the set of several, or nothing. -->
		<channel name="selected"/>
		<!-- Changes with every change of the project's queue (DownloadQueueSource). -->
		<source-channel name="queueState"
			update-interval="250"
		>
			<source class="de.haumacher.ehome.programming.download.DownloadQueueSource"/>
		</source-channel>
		<!-- Re-decides "All with changes" when the state of the path to the bus changes (BusStateSource). -->
		<source-channel name="busState"
			update-interval="500"
		>
			<source class="de.haumacher.ehome.programming.download.BusStateSource"/>
		</source-channel>
	</channels>
	<panel>
		<title>
			<en>Queue</en>
			<de>Warteschlange</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-cloud-download"
				inputs="project, busState, queueState"
				observed-types="ehome.physical:Device"
				placement="TOOLBAR"
			>
				<label>
					<en>All with changes</en>
					<de>Alle mit Änderungen</de>
				</label>
				<tooltip>
					<en>Appends every device of the project that needs a download to the queue, each fully or the parameters only as its state suggests.</en>
					<de>Reiht jedes Gerät des Projekts, das einen Download braucht, in die Warteschlange ein, jedes vollständig oder nur die Parameter, wie es sein Zustand nahelegt.</de>
				</tooltip>
				<access>
					<operation name="Write"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="downloadQueuePendingVeto($project)"/>
				</executability>
				<confirm expr="downloadQueuePendingConfirmation($project)"/>
				<execute-script function="downloadQueueEnqueuePending($project)"/>
			</generic-command>
			<generic-command
				image="css:bi bi-stop-circle"
				inputs="project, queueState"
				placement="TOOLBAR"
			>
				<label>
					<en>Abort</en>
					<de>Abbrechen</de>
				</label>
				<tooltip>
					<en>Stops the running download before its next operation; the device stays without a complete download. The next waiting device follows.</en>
					<de>Hält den laufenden Download vor seiner nächsten Operation an; das Gerät bleibt ohne vollständigen Download. Das nächste wartende Gerät folgt.</de>
				</tooltip>
				<access>
					<operation name="Write"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="downloadQueueAbortVeto($project)"/>
				</executability>
				<execute-script function="downloadQueueAbort($project)"/>
			</generic-command>
			<generic-command
				image="css:bi bi-x-circle"
				inputs="project, selected, queueState"
				placement="TOOLBAR"
			>
				<label>
					<en>Cancel</en>
					<de>Stornieren</de>
				</label>
				<tooltip>
					<en>Takes the selected waiting devices out of the queue; nothing is written into them.</en>
					<de>Nimmt die gewählten wartenden Geräte aus der Warteschlange; in sie wird nichts geschrieben.</de>
				</tooltip>
				<access>
					<operation name="Write"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<disabled-if expr="downloadQueueCancelVeto($project, $selected)"/>
				</executability>
				<execute-script function="downloadQueueCancel($project, $selected)"/>
			</generic-command>
			<generic-command
				image="css:bi bi-x-octagon"
				inputs="project, queueState"
				placement="TOOLBAR"
			>
				<label>
					<en>Cancel all waiting</en>
					<de>Alle wartenden stornieren</de>
				</label>
				<tooltip>
					<en>Takes every waiting device out of the queue; nothing is written into them. A running download goes on.</en>
					<de>Nimmt alle wartenden Geräte aus der Warteschlange; in sie wird nichts geschrieben. Ein laufender Download geht weiter.</de>
				</tooltip>
				<access>
					<operation name="Write"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="downloadQueueCancelAllVeto($project)"/>
				</executability>
				<execute-script function="downloadQueueCancelAll($project)"/>
			</generic-command>
			<generic-command
				image="css:bi bi-file-earmark-text"
				inputs="selected, project, queueState"
				placement="TOOLBAR"
			>
				<label>
					<en>Report</en>
					<de>Bericht</de>
				</label>
				<tooltip>
					<en>Shows the report of the selected finished download: the outcome, the failing operation with the device's answer, the steps not executed.</en>
					<de>Zeigt den Bericht des gewählten beendeten Downloads: das Ergebnis, die fehlgeschlagene Operation mit der Antwort des Geräts, die nicht ausgeführten Schritte.</de>
				</tooltip>
				<access>
					<operation name="Read"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<disabled-if expr="downloadQueueReportVeto($selected)"/>
				</executability>
				<execute-script function="downloadQueueReport($selected)">
					<with-result>
						<open-dialog
							bind-input-to="report"
							dialog-view="projects/programming-report.view.xml"
						/>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				image="css:bi bi-eraser"
				inputs="project, queueState"
				placement="TOOLBAR"
			>
				<label>
					<en>Remove finished</en>
					<de>Erledigte entfernen</de>
				</label>
				<tooltip>
					<en>Removes the done, failed, cancelled and aborted devices from the queue.</en>
					<de>Entfernt die fertigen, fehlgeschlagenen, stornierten und abgebrochenen Geräte aus der Warteschlange.</de>
				</tooltip>
				<access>
					<operation name="Write"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="downloadQueueClearVeto($project)"/>
				</executability>
				<execute-script function="downloadQueueClear($project)"/>
			</generic-command>
		</commands>
		<inset>
			<table
				selection="selected"
				selection-mode="multi"
			>
				<inputs>
					<input channel="project"/>
					<input channel="queueState"/>
				</inputs>
				<columns>
					<computed-column name="device"
						type="tl.core:String"
						width="320"
					>
						<label>
							<en>Device</en>
							<de>Gerät</de>
						</label>
						<value>downloadQueueDevice($row)</value>
					</computed-column>
					<computed-column name="kind"
						type="tl.core:String"
						width="140"
					>
						<label>
							<en>Kind</en>
							<de>Art</de>
						</label>
						<inputs>
							<input channel="queueState"/>
						</inputs>
						<value>downloadQueueKind($row)</value>
					</computed-column>
					<computed-column name="state"
						cell-role="downloadQueueStateRole($row)"
						type="tl.core:String"
						width="140"
					>
						<label>
							<en>State</en>
							<de>Zustand</de>
						</label>
						<inputs>
							<input channel="queueState"/>
						</inputs>
						<value>downloadQueueState($row)</value>
					</computed-column>
					<computed-column name="details"
						type="tl.core:String"
						width="520"
					>
						<label>
							<en>Details</en>
							<de>Details</de>
						</label>
						<inputs>
							<input channel="queueState"/>
						</inputs>
						<value>downloadQueueDetails($row)</value>
						<tooltip>downloadQueueDetails($row)</tooltip>
					</computed-column>
				</columns>
				<rows>if($project == null, [], downloadQueueEntries($project))</rows>
			</table>
		</inset>
	</panel>
</view>
