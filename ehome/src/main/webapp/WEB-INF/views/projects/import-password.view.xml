<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the ETS import for a project file whose project is protected by a password (ETS 5/6,
	haumacher/ehome #32): asks for the project password and imports the file with it.

	"request" carries the result of the import job for the file uploaded without a password
	(de.haumacher.ehome.etsImport.ImportEtsProjectJob): the file in "file", the reason in "message".
	The import runs as a cancelable job with the request and the password (haumacher/ehome #84), shown
	in the dialog ("job"); while it runs, the dialog stays open and the job is cancelled in its display.
	A wrong password fails the job in its first phase with the reason, shown in the dialog, which stays
	open with the uploaded file: the password is typed again and the import started again, without
	uploading the file again. The job that completes closes the dialog first (TL #30193), then writes
	the imported project to "project" and shows the messages of the import in the report dialog
	(import-report.view.xml).
-->
<view>
	<channels>
		<channel name="request"/>
		<channel name="password"/>
		<channel name="project"/>
		<channel name="job"/>
		<derived-channel name="reason"
			expr='if($request == null, null, $request["message"])'
			inputs="request"
		/>
	</channels>
	<window width="600px">
		<title>
			<en>ETS import: project password</en>
			<de>ETS-Import: Projektpasswort</de>
		</title>
		<inset>
			<stack gap="default">
				<text input="reason"/>
				<fields>
					<value-input
						type="tl.core:String"
						value="password"
					>
						<label>
							<en>Project password</en>
							<de>Projektpasswort</de>
						</label>
						<input-control class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
					</value-input>
				</fields>
				<!-- The job of the dialog; a failed one stays displayed with its reason until it is closed or started again. -->
				<visible-if
					expr="$job != null"
					input="job"
				>
					<job-status input="job"/>
				</visible-if>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:fa-solid fa-upload"
					inputs="request, password, job"
				>
					<label>
						<en>Import</en>
						<de>Importieren</de>
					</label>
					<access>
						<!-- As the ETS import of the project overview: the import creates a project. -->
						<create type="ehome.project:Project"/>
					</access>
					<executability>
						<disabled-if expr="if($request == null || $password == null, #('Enter the project password.'@en, 'Geben Sie das Projektpasswort ein.'@de), if(jobIsRunning($job), #('An import is running.'@en, 'Ein Import läuft.'@de), null))"/>
					</executability>
					<start-job
						cancelable="true"
						job="job"
						update-interval="200"
					>
						<phases>
							<phase name="read">
								<label>
									<en>Reading</en>
									<de>Lesen</de>
								</label>
							</phase>
							<phase name="import">
								<label>
									<en>Importing</en>
									<de>Importieren</de>
								</label>
							</phase>
							<phase name="save">
								<label>
									<en>Saving</en>
									<de>Speichern</de>
								</label>
							</phase>
						</phases>
						<body class="de.haumacher.ehome.etsImport.ImportEtsProjectJob"/>
						<with-result as="report">
							<!-- The dialog closes first, then the report says how the job ended (TL #30193). -->
							<close-dialog/>
							<if test='$report["messages"]'>
								<then>
									<open-dialog
										bind-input-to="report"
										dialog-view="projects/import-report.view.xml"
									/>
								</then>
							</if>
							<execute-script function='$report["project"]'>
								<with-result>
									<write-channel name="project"/>
								</with-result>
							</execute-script>
						</with-result>
					</start-job>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
