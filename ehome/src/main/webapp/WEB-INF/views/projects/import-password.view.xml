<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the ETS import for a project file whose project is protected by a password (ETS 5/6,
	haumacher/ehome #32): asks for the project password and imports the file with it.

	"request" carries the result of the import job for the file uploaded without a password
	(de.haumacher.ehome.etsImport.ImportEtsProjectJob): the file in "file", the reason in "message".
	The import runs as a cancelable job with the request and the password (haumacher/ehome #84). The
	dialog closes before the job starts, and the job is shown on "importJob", bound to the job channel
	of the projects overview: a dialog cannot close itself in the follow-up of a job it started
	(TL #30193, doc/tl-todo.md). A wrong password fails the job in its first phase with the reason,
	shown in the overview; the file is then uploaded again. The imported project is written to
	"project"; messages of the import are shown in the report dialog (import-report.view.xml).
-->
<view>
	<channels>
		<channel name="request"/>
		<channel name="password"/>
		<channel name="project"/>
		<channel name="importJob"/>
		<derived-channel name="reason"
			expr='if($request == null, null, $request["message"])'
			inputs="request"
		/>
	</channels>
	<window width="600px">
		<title>
			<en>ETS import: project password</en>
			<de>ETS-Import: Projektpasswort</de>
		</title>
		<inset>
			<stack gap="default">
				<text input="reason"/>
				<fields>
					<value-input
						type="tl.core:String"
						value="password"
					>
						<label>
							<en>Project password</en>
							<de>Projektpasswort</de>
						</label>
						<input-control class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
					</value-input>
				</fields>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:fa-solid fa-upload"
					inputs="request, password"
				>
					<label>
						<en>Import</en>
						<de>Importieren</de>
					</label>
					<access>
						<!-- As the ETS import of the project overview: the import creates a project. -->
						<create type="ehome.project:Project"/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<!-- Closed first: closing the dialog in the follow-up of its job is refused (TL #30193). -->
					<close-dialog/>
					<start-job
						cancelable="true"
						job="importJob"
						update-interval="200"
					>
						<phases>
							<phase name="read">
								<label>
									<en>Reading</en>
									<de>Lesen</de>
								</label>
							</phase>
							<phase name="import">
								<label>
									<en>Importing</en>
									<de>Importieren</de>
								</label>
							</phase>
							<phase name="save">
								<label>
									<en>Saving</en>
									<de>Speichern</de>
								</label>
							</phase>
						</phases>
						<body class="de.haumacher.ehome.etsImport.ImportEtsProjectJob"/>
						<with-result as="report">
							<!-- The report says how the job ended; its progress display is cleared. -->
							<write-channel name="importJob" clear="true"/>
							<if test='$report["messages"]'>
								<then>
									<open-dialog
										bind-input-to="report"
										dialog-view="projects/import-report.view.xml"
									/>
								</then>
							</if>
							<execute-script function='$report["project"]'>
								<with-result>
									<write-channel name="project"/>
								</with-result>
							</execute-script>
						</with-result>
					</start-job>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
