<?xml version="1.0" encoding="utf-8" ?>

<!--
	Initial frame of the project drill-down: all projects. Activating a row (its activation button,
	a double-click or Enter) selects it and pushes the frame showing the structures of the project.

	A project is created empty or imported from an ETS project file (.knxproj); an import that
	reports messages (values kept as text, unresolved references) shows them in a dialog
	(import-report.view.xml). A project protected by a password is imported from a dialog asking for
	the password (import-password.view.xml). The import runs as a cancelable job
	(de.haumacher.ehome.etsImport.ImportEtsProjectJob, haumacher/ehome #84) shown above the table while
	it runs: its phases, the progress by the entries of the file and what is being imported; a failed
	import stays shown there with its reason, a cancelled one has imported nothing. The selected project is exported as an (unsigned) ETS project file
	offered for download in a dialog (export-knxproj.view.xml). A whole project moves to another installation or
	is backed up as project file (.ehome, de.haumacher.ehome.projectfile.ProjectFile, haumacher/ehome #117):
	exported without secrets and operating history (export-ehome.view.xml), imported as a new project
	by the same kind of job as the ETS import (de.haumacher.ehome.etsImport.ImportProjectFileJob), whose
	report always shows (the controllers have to be paired again). "Update from ETS" brings the selected
	project up to date with a new export of the same project from ETS (de.haumacher.ehome.etsImport.UpdateFromEtsJob,
	de.haumacher.ehome.importer.ProjectUpdate, haumacher/ehome #125): the same kind of job, the password
	dialog update-password.view.xml for a protected project, and a report that always shows (what was
	added, changed, removed, kept or adopted, or that nothing changed); a refusal fails the job with its
	reasons and changes nothing. "Read the installation" builds the
	selected project from the devices on the bus (scan.view.xml, haumacher/ehome #9). The table observes
	projects, so a created, imported or deleted project is reflected without a reload.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="importJob"/>
	</channels>

	<panel>
		<title>
			<en>Projects</en>
			<de>Projekte</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-plus-lg"
				placement="TOOLBAR"
			>
				<label>
					<en>New project</en>
					<de>Neues Projekt</de>
				</label>
				<create-transient type="ehome.project:Project">
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="projects/create-project.view.xml"
						>
							<bind
								channel="selection"
								to="project"
							/>
						</open-dialog>
					</with-result>
				</create-transient>
			</generic-command>
			<upload-command
				accept=".knxproj"
				image="css:fa-solid fa-upload"
				inputs="importJob"
				placement="TOOLBAR"
			>
				<label>
					<en>ETS import</en>
					<de>ETS-Import</de>
				</label>
				<tooltip>
					<en>Reads an ETS project file (.knxproj) into a new project; existing projects stay as they are. Manufacturers, products and application programs go into the shared catalogs, programs already known are not read again.</en>
					<de>Liest eine ETS-Projektdatei (.knxproj) als neues Projekt ein; bestehende Projekte bleiben unverändert. Hersteller, Produkte und Applikationsprogramme kommen in die gemeinsamen Kataloge, bereits bekannte Programme werden nicht erneut eingelesen.</de>
				</tooltip>
				<access>
					<create type="ehome.project:Project"/>
				</access>
				<executability>
					<disabled-if expr="if(jobIsRunning($importJob), #('An import is running.'@en, 'Ein Import läuft.'@de), null)"/>
				</executability>
				<start-job
					cancelable="true"
					job="importJob"
					update-interval="200"
				>
					<phases>
						<phase name="read">
							<label>
								<en>Reading</en>
								<de>Lesen</de>
							</label>
						</phase>
						<phase name="import">
							<label>
								<en>Importing</en>
								<de>Importieren</de>
							</label>
						</phase>
						<phase name="save">
							<label>
								<en>Saving</en>
								<de>Speichern</de>
							</label>
						</phase>
					</phases>
					<body class="de.haumacher.ehome.etsImport.ImportEtsProjectJob"/>
					<with-result as="report">
						<!-- The report or the password dialog says how the job ended; its progress display is cleared. -->
						<write-channel name="importJob" clear="true"/>
						<if test='$report["passwordRequired"]'>
							<then>
								<!-- A protected project: the dialog asks for the password and imports the file again. -->
								<open-dialog
									bind-input-to="request"
									dialog-view="projects/import-password.view.xml"
								>
									<bind
										channel="project"
										to="project"
									/>
									<bind
										channel="importJob"
										to="importJob"
									/>
								</open-dialog>
							</then>
							<else>
								<if test='$report["messages"]'>
									<then>
										<open-dialog
											bind-input-to="report"
											dialog-view="projects/import-report.view.xml"
										/>
									</then>
								</if>
								<execute-script function='$report["project"]'>
									<with-result>
										<write-channel name="project"/>
									</with-result>
								</execute-script>
							</else>
						</if>
					</with-result>
				</start-job>
			</upload-command>
			<upload-command
				accept=".ehome"
				image="css:bi bi-box-arrow-in-down"
				inputs="importJob"
				placement="TOOLBAR"
			>
				<label>
					<en>Import project file</en>
					<de>Projektdatei importieren</de>
				</label>
				<tooltip>
					<en>Reads a project file (.ehome) exported by E-Home into a new project: the KNX part with rules, schedules, virtual devices, functions, pages, Zigbee devices and settings. The file holds no secrets: controllers have to be paired again.</en>
					<de>Liest eine von E-Home exportierte Projektdatei (.ehome) als neues Projekt ein: den KNX-Teil mit Regeln, Zeitplänen, virtuellen Geräten, Funktionen, Seiten, Zigbee-Geräten und Einstellungen. Die Datei enthält keine Geheimnisse: Controller müssen neu gekoppelt werden.</de>
				</tooltip>
				<access>
					<create type="ehome.project:Project"/>
				</access>
				<executability>
					<disabled-if expr="if(jobIsRunning($importJob), #('An import is running.'@en, 'Ein Import läuft.'@de), null)"/>
				</executability>
				<start-job
					cancelable="true"
					job="importJob"
					update-interval="200"
				>
					<phases>
						<phase name="read">
							<label>
								<en>Reading</en>
								<de>Lesen</de>
							</label>
						</phase>
						<phase name="import">
							<label>
								<en>Importing</en>
								<de>Importieren</de>
							</label>
						</phase>
						<phase name="save">
							<label>
								<en>Saving</en>
								<de>Speichern</de>
							</label>
						</phase>
					</phases>
					<body class="de.haumacher.ehome.etsImport.ImportProjectFileJob"/>
					<with-result as="report">
						<write-channel name="importJob" clear="true"/>
						<if test='$report["messages"]'>
							<then>
								<open-dialog
									bind-input-to="report"
									dialog-view="projects/import-report.view.xml"
								/>
							</then>
						</if>
						<execute-script function='$report["project"]'>
							<with-result>
								<write-channel name="project"/>
							</with-result>
						</execute-script>
					</with-result>
				</start-job>
			</upload-command>
			<upload-command
				accept=".knxproj"
				image="css:bi bi-arrow-repeat"
				inputs="importJob, project"
				placement="TOOLBAR"
			>
				<label>
					<en>Update from ETS</en>
					<de>Aus ETS aktualisieren</de>
				</label>
				<tooltip>
					<en>Brings the selected project up to date with a new export of the same project from ETS (.knxproj): topology, devices with their parameters, connections, group addresses and buildings as in ETS. Rules, functions, pages, Zigbee devices, controllers, settings and recordings stay, as do devices and addresses created in E-Home. Objects ETS removed but E-Home still uses refuse the update.</en>
					<de>Bringt das ausgewählte Projekt mit einem neuen Export desselben Projekts aus der ETS (.knxproj) auf den aktuellen Stand: Topologie, Geräte mit ihren Parametern, Verbindungen, Gruppenadressen und Gebäude wie in der ETS. Regeln, Funktionen, Seiten, Zigbee-Geräte, Controller, Einstellungen und Aufzeichnungen bleiben erhalten, ebenso in E-Home angelegte Geräte und Adressen. Objekte, die die ETS entfernt hat und E-Home noch verwendet, lehnen die Aktualisierung ab.</de>
				</tooltip>
				<access>
					<!-- The update changes the project through Java (de.haumacher.ehome.importer.ProjectUpdate). -->
					<operation name="Write"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<disabled-if expr="if($project == null, #('Select the project to update.'@en, 'Wählen Sie das zu aktualisierende Projekt aus.'@de), if(jobIsRunning($importJob), #('An import is running.'@en, 'Ein Import läuft.'@de), null))"/>
				</executability>
				<start-job
					cancelable="true"
					job="importJob"
					update-interval="200"
				>
					<phases>
						<phase name="read">
							<label>
								<en>Reading</en>
								<de>Lesen</de>
							</label>
						</phase>
						<phase name="import">
							<label>
								<en>Importing</en>
								<de>Importieren</de>
							</label>
						</phase>
						<phase name="save">
							<label>
								<en>Saving</en>
								<de>Speichern</de>
							</label>
						</phase>
					</phases>
					<body class="de.haumacher.ehome.etsImport.UpdateFromEtsJob"/>
					<with-result as="report">
						<!-- The report or the password dialog says how the job ended; its progress display is cleared. -->
						<write-channel name="importJob" clear="true"/>
						<if test='$report["passwordRequired"]'>
							<then>
								<!-- A protected project: the dialog asks for the password and updates from the file again. -->
								<open-dialog
									bind-input-to="request"
									dialog-view="projects/update-password.view.xml"
								>
									<bind
										channel="project"
										to="project"
									/>
									<bind
										channel="importJob"
										to="importJob"
									/>
								</open-dialog>
							</then>
							<else>
								<!-- The report always has something to say: the changes, or that there are none. -->
								<open-dialog
									bind-input-to="report"
									dialog-view="projects/import-report.view.xml"
								/>
							</else>
						</if>
					</with-result>
				</start-job>
			</upload-command>
			<generic-command
				image="css:fa-solid fa-download"
				inputs="project"
				placement="TOOLBAR"
			>
				<label>
					<en>Export as .knxproj</en>
					<de>Als .knxproj exportieren</de>
				</label>
				<tooltip>
					<en>Writes the project with the catalog data it uses into a .knxproj file to download. The file is not signed: ETS does not import it, E-Home does.</en>
					<de>Schreibt das Projekt mit den Katalogdaten, die es verwendet, in eine .knxproj-Datei zum Herunterladen. Die Datei ist nicht signiert: Die ETS importiert sie nicht, E-Home schon.</de>
				</tooltip>
				<access>
					<!-- The export only reads the project. -->
					<operation name="Read"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<export-knxproj>
					<with-result>
						<open-dialog
							bind-input-to="file"
							dialog-view="projects/export-knxproj.view.xml"
						/>
					</with-result>
				</export-knxproj>
			</generic-command>
			<generic-command
				image="css:bi bi-box-arrow-up"
				inputs="project"
				placement="TOOLBAR"
			>
				<label>
					<en>Export project file</en>
					<de>Projektdatei exportieren</de>
				</label>
				<tooltip>
					<en>Writes the whole project into a project file (.ehome) to download, to move it to another E-Home or to back it up: the KNX part as .knxproj with rules, schedules, virtual devices, functions, pages, Zigbee devices and settings. Without secrets and without recordings or deployments.</en>
					<de>Schreibt das ganze Projekt in eine Projektdatei (.ehome) zum Herunterladen, um es in ein anderes E-Home umzuziehen oder zu sichern: den KNX-Teil als .knxproj mit Regeln, Zeitplänen, virtuellen Geräten, Funktionen, Seiten, Zigbee-Geräten und Einstellungen. Ohne Geheimnisse und ohne Aufzeichnungen oder Bereitstellungen.</de>
				</tooltip>
				<access>
					<!-- The export only reads the project; it holds no secrets. -->
					<operation name="Read"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<export-ehome>
					<with-result>
						<open-dialog
							bind-input-to="file"
							dialog-view="projects/export-ehome.view.xml"
						/>
					</with-result>
				</export-ehome>
			</generic-command>
			<generic-command
				image="css:bi bi-broadcast-pin"
				inputs="project"
				placement="TOOLBAR"
			>
				<label>
					<en>Read the installation</en>
					<de>Installation einlesen</de>
				</label>
				<tooltip>
					<en>Scans the bus behind the project's gateway or controller, matches the devices found against the catalog and creates or updates them in the project. The scan and the reading of configurations write nothing into the devices.</en>
					<de>Durchsucht den Bus hinter dem Gateway oder dem Controller des Projekts, ordnet die gefundenen Geräte dem Katalog zu und legt sie im Projekt an oder aktualisiert sie. Suche und Einlesen der Konfiguration schreiben nichts in die Geräte.</de>
				</tooltip>
				<access>
					<operation name="Write"
						object="$project"
						type="ehome.project:Project"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<open-dialog
					bind-input-to="project"
					dialog-view="projects/scan.view.xml"
				/>
			</generic-command>
			<generic-command
				image="css:bi bi-trash"
				inputs="project"
				placement="TOOLBAR"
			>
				<label>
					<en>Delete</en>
					<de>Löschen</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<confirm expr="#('Delete project {0}?'@en, 'Projekt {0} löschen?'@de).fill($project.get(`ehome.project:Project#name`))"/>
				<delete-object/>
				<write-channel name="project" clear="true"/>
			</generic-command>
		</commands>
		<stack>
			<visible-if
				expr="$importJob != null"
				input="importJob"
			>
				<inset>
					<stack gap="default">
					<job-status input="importJob"/>
					<!-- An ended job that failed or was cancelled stays displayed (its follow-up clears it only on success): the reader closes it (TL #30250). -->
					<visible-if
						expr="!jobIsRunning($importJob)"
						input="importJob"
					>
						<button>
							<action class="com.top_logic.layout.view.command.GenericViewCommand"
								image="css:bi bi-x-lg"
							>
								<label>
									<en>Close</en>
									<de>Schließen</de>
								</label>
								<write-channel
									clear="true"
									name="importJob"
								/>
							</action>
						</button>
					</visible-if>
				</stack>
				</inset>
			</visible-if>
			<table
				observed-types="ehome.project:Project"
				selection="project"
				types="ehome.project:Project"
			>
				<columns>
					<column attribute="name"/>
					<column attribute="extId"/>
				</columns>
				<rows>all(`ehome.project:Project`)</rows>
				<on-activate class="com.top_logic.layout.view.tiles.NavigatePushCommand"
					bind-input-to="project"
					frame="project"
				/>
			</table>
		</stack>
	</panel>
</view>
