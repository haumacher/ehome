<?xml version="1.0" encoding="utf-8" ?>

<!--
	Second frame of the project drill-down: the structures of the project the frame was opened for,
	one tab each, and the properties of the project itself.
-->
<view>
	<channels>
		<channel name="project"/>
	</channels>

	<tab-bar active-tab="buildings">
		<tabs>
			<tab id="buildings"
				icon="css:fa-solid fa-city"
			>
				<label>
					<en>Buildings</en>
					<de>Gebäude</de>
				</label>
				<view-ref view="projects/buildings.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="addresses"
				icon="css:fa-solid fa-wifi"
			>
				<label>
					<en>Group addresses</en>
					<de>Gruppenadressen</de>
				</label>
				<view-ref view="projects/addresses.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="devices"
				icon="css:bi bi-hdd-network-fill"
			>
				<label>
					<en>Devices</en>
					<de>Geräte</de>
				</label>
				<view-ref view="projects/devices.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="zigbee"
				icon="css:bi bi-broadcast-pin"
			>
				<label>
					<en>Zigbee</en>
					<de>Zigbee</de>
				</label>
				<view-ref view="projects/zigbee.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="monitor"
				icon="css:bi bi-activity"
			>
				<label>
					<en>Monitor</en>
					<de>Monitor</de>
				</label>
				<view-ref view="projects/monitor.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="functions"
				icon="css:bi bi-lightbulb"
			>
				<label>
					<en>Functions</en>
					<de>Funktionen</de>
				</label>
				<view-ref view="projects/functions.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="rules"
				icon="css:bi bi-diagram-3"
			>
				<label>
					<en>Rules</en>
					<de>Regeln</de>
				</label>
				<view-ref view="projects/rules.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="schedules"
				icon="css:bi bi-calendar-event"
			>
				<label>
					<en>Schedule</en>
					<de>Zeitplan</de>
				</label>
				<view-ref view="projects/schedules.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="simulation"
				icon="css:bi bi-play-btn"
			>
				<label>
					<en>Simulation</en>
					<de>Simulation</de>
				</label>
				<view-ref view="projects/simulation.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="controllers"
				icon="css:bi bi-cpu"
			>
				<label>
					<en>Controllers</en>
					<de>Controller</de>
				</label>
				<view-ref view="projects/controllers.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="deployment"
				icon="css:bi bi-cloud-upload"
			>
				<label>
					<en>Deployment</en>
					<de>Bereitstellung</de>
				</label>
				<view-ref view="projects/deployment.view.xml">
					<bind
						channel="project"
						to="project"
					/>
				</view-ref>
			</tab>
			<tab id="properties"
				icon="css:fa-solid fa-gear"
			>
				<label>
					<en>Properties</en>
					<de>Eigenschaften</de>
				</label>
				<panel>
					<title>
						<en>Project</en>
						<de>Projekt</de>
					</title>
					<form
						input="project"
						with-inset="true"
					>
						<field attribute="name"/>
						<field attribute="extId"/>
						<field attribute="groupAddressStyle"/>
					</form>
				</panel>
			</tab>
		</tabs>
	</tab-bar>
</view>
