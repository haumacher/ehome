<?xml version="1.0" encoding="utf-8" ?>

<!--
	An action list of a rule (haumacher/ehome #57): the actions of a reaction (then, else) or the entry
	and exit actions of a state. "owner" is the reaction or state, "listName" the name of its reference
	holding the list (actions, elseActions, entry, exit). The actions run in the order of the list;
	"Move up" and "Move down" change it. The form shows the fields of the selected action's kind;
	expressions are written in the rule language (de.haumacher.ehome.rules.RuleText) and checked as the
	controller would check them, the reason shown at the field.
	"New" opens the create dialog projects/create-part.view.xml (haumacher/ehome #91) over a draft for
	the end of the list; nothing is stored before "Create".
-->
<view>
	<channels>
		<channel name="owner"/>
		<channel name="listName"/>
		<channel name="action"/>
	</channels>
	<panel>
		<title>
			<en>Actions</en>
			<de>Aktionen</de>
		</title>
		<commands>
			<generic-command
				clique="new"
				image="css:bi bi-pencil"
				inputs="owner"
				placement="TOOLBAR"
			>
				<label>
					<en>Write</en>
					<de>Schreiben</de>
				</label>
				<access>
					<operation name="Write"
						object="$owner"
						type="tl.model:TLObject"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<execute-script function="ruleDraft($owner, $listName, `ehome.runtime:WriteAction`)">
					<inputs>
						<input channel="listName"/>
					</inputs>
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="projects/create-part.view.xml"
						>
							<bind
								channel="selection"
								to="action"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				clique="new"
				image="css:bi bi-arrow-down-circle"
				inputs="owner"
				placement="TOOLBAR"
			>
				<label>
					<en>Read</en>
					<de>Lesen</de>
				</label>
				<access>
					<operation name="Write"
						object="$owner"
						type="tl.model:TLObject"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<execute-script function="ruleDraft($owner, $listName, `ehome.runtime:ReadAction`)">
					<inputs>
						<input channel="listName"/>
					</inputs>
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="projects/create-part.view.xml"
						>
							<bind
								channel="selection"
								to="action"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				clique="new"
				image="css:bi bi-play"
				inputs="owner"
				placement="TOOLBAR"
			>
				<label>
					<en>Start timer</en>
					<de>Timer starten</de>
				</label>
				<access>
					<operation name="Write"
						object="$owner"
						type="tl.model:TLObject"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<execute-script function="ruleDraft($owner, $listName, `ehome.runtime:StartTimerAction`)">
					<inputs>
						<input channel="listName"/>
					</inputs>
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="projects/create-part.view.xml"
						>
							<bind
								channel="selection"
								to="action"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				clique="new"
				image="css:bi bi-arrow-repeat"
				inputs="owner"
				placement="TOOLBAR"
			>
				<label>
					<en>Restart timer</en>
					<de>Timer neu starten</de>
				</label>
				<access>
					<operation name="Write"
						object="$owner"
						type="tl.model:TLObject"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<execute-script function="ruleDraft($owner, $listName, `ehome.runtime:RestartTimerAction`)">
					<inputs>
						<input channel="listName"/>
					</inputs>
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="projects/create-part.view.xml"
						>
							<bind
								channel="selection"
								to="action"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				clique="new"
				image="css:bi bi-stop"
				inputs="owner"
				placement="TOOLBAR"
			>
				<label>
					<en>Cancel timer</en>
					<de>Timer abbrechen</de>
				</label>
				<access>
					<operation name="Write"
						object="$owner"
						type="tl.model:TLObject"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<execute-script function="ruleDraft($owner, $listName, `ehome.runtime:CancelTimerAction`)">
					<inputs>
						<input channel="listName"/>
					</inputs>
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="projects/create-part.view.xml"
						>
							<bind
								channel="selection"
								to="action"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				clique="new"
				image="css:bi bi-sliders"
				inputs="owner"
				placement="TOOLBAR"
			>
				<label>
					<en>Set parameter</en>
					<de>Parameter setzen</de>
				</label>
				<access>
					<operation name="Write"
						object="$owner"
						type="tl.model:TLObject"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<execute-script function="ruleDraft($owner, $listName, `ehome.runtime:SetParameterAction`)">
					<inputs>
						<input channel="listName"/>
					</inputs>
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="projects/create-part.view.xml"
						>
							<bind
								channel="selection"
								to="action"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				clique="new"
				image="css:bi bi-journal-text"
				inputs="owner"
				placement="TOOLBAR"
			>
				<label>
					<en>Log</en>
					<de>Protokollieren</de>
				</label>
				<access>
					<operation name="Write"
						object="$owner"
						type="tl.model:TLObject"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<execute-script function="ruleDraft($owner, $listName, `ehome.runtime:LogAction`)">
					<inputs>
						<input channel="listName"/>
					</inputs>
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="projects/create-part.view.xml"
						>
							<bind
								channel="selection"
								to="action"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				image="css:bi bi-trash"
				inputs="action"
				placement="TOOLBAR"
			>
				<label>
					<en>Delete</en>
					<de>Löschen</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<confirm expr="#('Delete the action?'@en, 'Die Aktion löschen?'@de)"/>
				<delete-object/>
				<write-channel name="action" clear="true"/>
			</generic-command>
			<generic-command
				clique="edit"
				image="css:bi bi-arrow-up"
				inputs="action"
				placement="TOOLBAR"
			>
				<label>
					<en>Move up</en>
					<de>Nach oben</de>
				</label>
				<access>
					<operation name="Write"
						object="$action"
						type="ehome.runtime:Action"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="ruleMoveVeto($action, -1)"/>
				</executability>
				<with-transaction>
					<execute-script function="ruleMove($action, -1)"/>
				</with-transaction>
			</generic-command>
			<generic-command
				clique="edit"
				image="css:bi bi-arrow-down"
				inputs="action"
				placement="TOOLBAR"
			>
				<label>
					<en>Move down</en>
					<de>Nach unten</de>
				</label>
				<access>
					<operation name="Write"
						object="$action"
						type="ehome.runtime:Action"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="ruleMoveVeto($action, 1)"/>
				</executability>
				<with-transaction>
					<execute-script function="ruleMove($action, 1)"/>
				</with-transaction>
			</generic-command>
		</commands>
		<split-panel
			orientation="vertical"
			resizable="true"
		>
			<panes>
				<pane
					size="50"
					unit="%"
				>
					<table
						observed-types="ehome.runtime:Action,ehome.runtime:Reaction,ehome.runtime:RuleState"
						selection="action"
						types="ehome.runtime:Action"
					>
						<inputs>
							<input channel="owner"/>
							<input channel="listName"/>
						</inputs>
						<columns>
							<computed-column name="summary"
								type="tl.core:String"
							>
								<label>
									<en>Action</en>
									<de>Aktion</de>
								</label>
								<value>ruleSummary($row)</value>
							</computed-column>
						</columns>
						<rows>ruleList($owner, $listName)</rows>
					</table>
				</pane>
				<pane
					size="50"
					unit="%"
				>
					<form
						input="action"
						with-inset="true"
					>
						<field attribute="datapoint"/>
						<!-- Offers the datapoints of the project while a reference @"… is typed (TL #29887). -->
						<field attribute="value">
							<input-control class="com.top_logic.layout.view.form.TextInputControlProvider">
								<suggestions>self -> text -> caret -> ruleSuggestions($self, $text, $caret)</suggestions>
							</input-control>
						</field>
						<field attribute="onlyOnChange"/>
						<field attribute="timer"/>
						<field attribute="duration"/>
						<field attribute="parameter"/>
						<field attribute="level"/>
						<field attribute="message"/>
					</form>
				</pane>
			</panes>
		</split-panel>
	</panel>
</view>
