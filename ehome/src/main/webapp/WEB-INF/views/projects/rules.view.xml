<?xml version="1.0" encoding="utf-8" ?>

<!--
	The rules of a project (haumacher/ehome #57, homecontrol spec/rules.md): what the HomeControl
	controller does on its own. A rule has adjustable parameters, timers, optional states (a state
	machine) and reactions; a reaction has triggers, an optional condition, actions and else actions,
	and in a rule with states the states it applies in and the state it leads to. The rules are part
	of the runtime image (Deployment tab), in the order of their "Order".

	Conditions, values, durations and log messages are expressions of the rule language, written as
	text (@"1/2/3" names the datapoint of a group address, $id a parameter, running(t) a timer);
	parameter values are literals (3min, 21.5, 06:30). Each field is checked while it is edited as the
	controller would check it (de.haumacher.ehome.runtime.RuleExport): a text that is not in the
	language is an error, a refusal of the controller (a type error, an unknown timer, a datapoint that
	is not writable) a warning with the controller's reason; each field is checked on its own, so two
	refused fields of an object both show their refusal (haumacher/ehome #60). An entered text is
	stored in its canonical form, the form the image carries (the value normalizer rule-text of the
	model, RuleTextNormalizer). "Import rules"
	adds the rules and schedule entries of a runtime image (a JSON file) to the project. A condition
	or a value offers, while a reference @"… is typed, the datapoints of the project's image that
	expressions and actions may name (ruleSuggestions, TL #29887): those of the
	group addresses (KNX) and the application datapoints (haumacher/ehome #59), which no technology
	owns and which are edited in the tab "Application datapoints" (application-datapoints.view.xml):
	they are the rules' and the schedule's own values, so they are edited where they are used. The
	choices of a parameter are listed beside its form, each with its value and label.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="rule"/>
		<channel name="parameter"/>
		<channel name="choice"/>
		<channel name="timer"/>
		<channel name="state"/>
		<channel name="reaction"/>
		<channel name="trigger"/>
		<derived-channel name="thenList"
			expr="'actions'"
			inputs="reaction"
		/>
		<derived-channel name="elseList"
			expr="'elseActions'"
			inputs="reaction"
		/>
		<derived-channel name="entryList"
			expr="'entry'"
			inputs="state"
		/>
		<derived-channel name="exitList"
			expr="'exit'"
			inputs="state"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				size="30"
				unit="%"
			>
				<panel>
					<title>
						<en>Rules</en>
						<de>Regeln</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-plus-lg"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>New rule</en>
								<de>Neue Regel</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<with-transaction>
								<execute-script function="ruleCreate($project, 'rules', `ehome.runtime:Rule`)"/>
								<with-result>
									<write-channel name="rule"/>
								</with-result>
							</with-transaction>
						</generic-command>
						<upload-command
							accept=".json,application/json"
							image="css:bi bi-box-arrow-in-down"
							inputs="project"
							multiple="false"
							placement="TOOLBAR"
						>
							<label>
								<en>Import rules</en>
								<de>Regeln importieren</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<with-transaction>
								<execute-script function="ruleImportImage($project, $file)">
									<inputs>
										<input channel="project"/>
									</inputs>
								</execute-script>
								<with-result>
									<notify
										expr="$result"
										kind="info"
									/>
								</with-result>
							</with-transaction>
						</upload-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="rule"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Delete the rule with its reactions?'@en, 'Die Regel mit ihren Reaktionen löschen?'@de)"/>
							<delete-object/>
							<write-channel name="rule" clear="true"/>
						</generic-command>
					</commands>
					<table
						observed-types="ehome.runtime:Rule"
						selection="rule"
						types="ehome.runtime:Rule"
					>
						<inputs>
							<input channel="project"/>
						</inputs>
						<columns>
							<column attribute="order"/>
							<column attribute="name"/>
							<column attribute="identifier"/>
							<column attribute="enabled"/>
						</columns>
						<rows>if($project == null, [], $project.get(`ehome.project:Project#rules`))</rows>
					</table>
				</panel>
			</pane>
			<pane
				size="70"
				unit="%"
			>
				<tab-bar active-tab="reactions">
					<tabs>
						<tab id="rule"
							icon="css:bi bi-diagram-3"
						>
							<label>
								<en>Rule</en>
								<de>Regel</de>
							</label>
							<panel>
								<title>
									<en>Rule</en>
									<de>Regel</de>
								</title>
								<form
									input="rule"
									with-inset="true"
								>
									<field attribute="name"/>
									<field attribute="identifier"/>
									<field attribute="order"/>
									<field attribute="enabled"/>
									<field attribute="enabledAdjustable"/>
									<field attribute="initialState"/>
									<field attribute="description"/>
								</form>
							</panel>
						</tab>
						<tab id="reactions"
							icon="css:bi bi-arrow-right-circle"
						>
							<label>
								<en>Reactions</en>
								<de>Reaktionen</de>
							</label>
							<split-panel
								orientation="horizontal"
								resizable="true"
							>
								<panes>
									<pane
										size="45"
										unit="%"
									>
										<panel>
											<title>
												<en>Reactions</en>
												<de>Reaktionen</de>
											</title>
											<commands>
												<generic-command
													image="css:bi bi-plus-lg"
													inputs="rule"
													placement="TOOLBAR"
												>
													<label>
														<en>New reaction</en>
														<de>Neue Reaktion</de>
													</label>
													<access>
														<operation name="Write"
															object="$rule"
															type="ehome.runtime:Rule"
														/>
													</access>
													<executability>
														<null-input-disabled/>
													</executability>
													<with-transaction>
														<execute-script function="ruleCreate($rule, 'reactions', `ehome.runtime:Reaction`)"/>
														<with-result>
															<write-channel name="reaction"/>
														</with-result>
													</with-transaction>
												</generic-command>
												<generic-command
													image="css:bi bi-trash"
													inputs="reaction"
													placement="TOOLBAR"
												>
													<label>
														<en>Delete</en>
														<de>Löschen</de>
													</label>
													<executability>
														<null-input-disabled/>
													</executability>
													<confirm expr="#('Delete the reaction?'@en, 'Die Reaktion löschen?'@de)"/>
													<delete-object/>
													<write-channel name="reaction" clear="true"/>
												</generic-command>
												<generic-command
													clique="edit"
													image="css:bi bi-arrow-up"
													inputs="reaction"
													placement="TOOLBAR"
												>
													<label>
														<en>Move up</en>
														<de>Nach oben</de>
													</label>
													<access>
														<operation name="Write"
															object="$reaction"
															type="ehome.runtime:Reaction"
														/>
													</access>
													<executability>
														<null-input-disabled/>
														<disabled-if expr="ruleMoveVeto($reaction, -1)"/>
													</executability>
													<with-transaction>
														<execute-script function="ruleMove($reaction, -1)"/>
													</with-transaction>
												</generic-command>
												<generic-command
													clique="edit"
													image="css:bi bi-arrow-down"
													inputs="reaction"
													placement="TOOLBAR"
												>
													<label>
														<en>Move down</en>
														<de>Nach unten</de>
													</label>
													<access>
														<operation name="Write"
															object="$reaction"
															type="ehome.runtime:Reaction"
														/>
													</access>
													<executability>
														<null-input-disabled/>
														<disabled-if expr="ruleMoveVeto($reaction, 1)"/>
													</executability>
													<with-transaction>
														<execute-script function="ruleMove($reaction, 1)"/>
													</with-transaction>
												</generic-command>
											</commands>
											<split-panel
												orientation="vertical"
												resizable="true"
											>
												<panes>
													<pane
														size="55"
														unit="%"
													>
														<table
															observed-types="ehome.runtime:Reaction,ehome.runtime:Trigger,ehome.runtime:Rule"
															selection="reaction"
															types="ehome.runtime:Reaction"
														>
															<inputs>
																<input channel="rule"/>
															</inputs>
															<columns>
																<computed-column name="summary"
																	type="tl.core:String"
																>
																	<label>
																		<en>Reaction</en>
																		<de>Reaktion</de>
																	</label>
																	<value>ruleSummary($row)</value>
																</computed-column>
															</columns>
															<rows>if($rule == null, [], $rule.get(`ehome.runtime:Rule#reactions`))</rows>
														</table>
													</pane>
													<pane
														size="45"
														unit="%"
													>
														<form
															input="reaction"
															with-inset="true"
														>
															<!-- Offers the datapoints of the project while a reference @"… is typed (TL #29887). -->
															<field attribute="condition">
																<input-control class="com.top_logic.layout.view.form.TextInputControlProvider">
																	<suggestions>self -> text -> caret -> ruleSuggestions($self, $text, $caret)</suggestions>
																</input-control>
															</field>
															<field attribute="from"/>
															<field attribute="to"/>
														</form>
													</pane>
												</panes>
											</split-panel>
										</panel>
									</pane>
									<pane
										size="55"
										unit="%"
									>
										<tab-bar active-tab="triggers">
											<tabs>
												<tab id="triggers"
													icon="css:bi bi-lightning-charge"
												>
													<label>
														<en>Triggers</en>
														<de>Auslöser</de>
													</label>
													<panel>
														<title>
															<en>Triggers</en>
															<de>Auslöser</de>
														</title>
														<commands>
															<generic-command
																clique="new"
																image="css:bi bi-broadcast"
																inputs="reaction"
																placement="TOOLBAR"
															>
																<label>
																	<en>Datapoint trigger</en>
																	<de>Datenpunkt-Auslöser</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$reaction"
																		type="ehome.runtime:Reaction"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																</executability>
																<with-transaction>
																	<execute-script function="ruleCreate($reaction, 'triggers', `ehome.runtime:DatapointTrigger`)"/>
																	<with-result>
																		<write-channel name="trigger"/>
																	</with-result>
																</with-transaction>
															</generic-command>
															<generic-command
																clique="new"
																image="css:bi bi-check2-square"
																inputs="reaction"
																placement="TOOLBAR"
															>
																<label>
																	<en>Condition trigger</en>
																	<de>Bedingungs-Auslöser</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$reaction"
																		type="ehome.runtime:Reaction"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																</executability>
																<with-transaction>
																	<execute-script function="ruleCreate($reaction, 'triggers', `ehome.runtime:MatchTrigger`)"/>
																	<with-result>
																		<write-channel name="trigger"/>
																	</with-result>
																</with-transaction>
															</generic-command>
															<generic-command
																clique="new"
																image="css:bi bi-stopwatch"
																inputs="reaction"
																placement="TOOLBAR"
															>
																<label>
																	<en>Timer trigger</en>
																	<de>Timer-Auslöser</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$reaction"
																		type="ehome.runtime:Reaction"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																</executability>
																<with-transaction>
																	<execute-script function="ruleCreate($reaction, 'triggers', `ehome.runtime:TimerTrigger`)"/>
																	<with-result>
																		<write-channel name="trigger"/>
																	</with-result>
																</with-transaction>
															</generic-command>
															<generic-command
																clique="new"
																image="css:bi bi-calendar-event"
																inputs="reaction"
																placement="TOOLBAR"
															>
																<label>
																	<en>Schedule trigger</en>
																	<de>Zeitplan-Auslöser</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$reaction"
																		type="ehome.runtime:Reaction"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																</executability>
																<with-transaction>
																	<execute-script function="ruleCreate($reaction, 'triggers', `ehome.runtime:ScheduleTrigger`)"/>
																	<with-result>
																		<write-channel name="trigger"/>
																	</with-result>
																</with-transaction>
															</generic-command>
															<generic-command
																clique="new"
																image="css:bi bi-sliders"
																inputs="reaction"
																placement="TOOLBAR"
															>
																<label>
																	<en>Parameter trigger</en>
																	<de>Parameter-Auslöser</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$reaction"
																		type="ehome.runtime:Reaction"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																</executability>
																<with-transaction>
																	<execute-script function="ruleCreate($reaction, 'triggers', `ehome.runtime:ParameterTrigger`)"/>
																	<with-result>
																		<write-channel name="trigger"/>
																	</with-result>
																</with-transaction>
															</generic-command>
															<generic-command
																clique="new"
																image="css:bi bi-hourglass-split"
																inputs="reaction"
																placement="TOOLBAR"
															>
																<label>
																	<en>Silence trigger</en>
																	<de>Stille-Auslöser</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$reaction"
																		type="ehome.runtime:Reaction"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																</executability>
																<with-transaction>
																	<execute-script function="ruleCreate($reaction, 'triggers', `ehome.runtime:SilenceTrigger`)"/>
																	<with-result>
																		<write-channel name="trigger"/>
																	</with-result>
																</with-transaction>
															</generic-command>
															<generic-command
																clique="new"
																image="css:bi bi-power"
																inputs="reaction"
																placement="TOOLBAR"
															>
																<label>
																	<en>Start trigger</en>
																	<de>Start-Auslöser</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$reaction"
																		type="ehome.runtime:Reaction"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																</executability>
																<with-transaction>
																	<execute-script function="ruleCreate($reaction, 'triggers', `ehome.runtime:StartTrigger`)"/>
																	<with-result>
																		<write-channel name="trigger"/>
																	</with-result>
																</with-transaction>
															</generic-command>
															<generic-command
																image="css:bi bi-trash"
																inputs="trigger"
																placement="TOOLBAR"
															>
																<label>
																	<en>Delete</en>
																	<de>Löschen</de>
																</label>
																<executability>
																	<null-input-disabled/>
																</executability>
																<confirm expr="#('Delete the trigger?'@en, 'Den Auslöser löschen?'@de)"/>
																<delete-object/>
																<write-channel name="trigger" clear="true"/>
															</generic-command>
															<generic-command
																clique="edit"
																image="css:bi bi-arrow-up"
																inputs="trigger"
																placement="TOOLBAR"
															>
																<label>
																	<en>Move up</en>
																	<de>Nach oben</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$trigger"
																		type="ehome.runtime:Trigger"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																	<disabled-if expr="ruleMoveVeto($trigger, -1)"/>
																</executability>
																<with-transaction>
																	<execute-script function="ruleMove($trigger, -1)"/>
																</with-transaction>
															</generic-command>
															<generic-command
																clique="edit"
																image="css:bi bi-arrow-down"
																inputs="trigger"
																placement="TOOLBAR"
															>
																<label>
																	<en>Move down</en>
																	<de>Nach unten</de>
																</label>
																<access>
																	<operation name="Write"
																		object="$trigger"
																		type="ehome.runtime:Trigger"
																	/>
																</access>
																<executability>
																	<null-input-disabled/>
																	<disabled-if expr="ruleMoveVeto($trigger, 1)"/>
																</executability>
																<with-transaction>
																	<execute-script function="ruleMove($trigger, 1)"/>
																</with-transaction>
															</generic-command>
														</commands>
														<split-panel
															orientation="vertical"
															resizable="true"
														>
															<panes>
																<pane
																	size="45"
																	unit="%"
																>
																	<table
																		observed-types="ehome.runtime:Trigger,ehome.runtime:Reaction"
																		selection="trigger"
																		types="ehome.runtime:Trigger"
																	>
																		<inputs>
																			<input channel="reaction"/>
																		</inputs>
																		<columns>
																			<computed-column name="summary"
																				type="tl.core:String"
																			>
																				<label>
																					<en>Trigger</en>
																					<de>Auslöser</de>
																				</label>
																				<value>ruleSummary($row)</value>
																			</computed-column>
																		</columns>
																		<rows>if($reaction == null, [], $reaction.get(`ehome.runtime:Reaction#triggers`))</rows>
																	</table>
																</pane>
																<pane
																	size="55"
																	unit="%"
																>
																	<form
																		input="trigger"
																		with-inset="true"
																	>
																		<field attribute="datapoint"/>
																		<field attribute="on"/>
																		<field attribute="origin"/>
																		<!-- Offers the datapoints of the project while a reference @"… is typed (TL #29887). -->
																		<field attribute="condition">
																			<input-control class="com.top_logic.layout.view.form.TextInputControlProvider">
																				<suggestions>self -> text -> caret -> ruleSuggestions($self, $text, $caret)</suggestions>
																			</input-control>
																		</field>
																		<field attribute="timer"/>
																		<field attribute="schedule"/>
																		<field attribute="parameter"/>
																		<field attribute="after"/>
																		<field attribute="onBoot"/>
																		<field attribute="onImage"/>
																		<field attribute="onEnable"/>
																	</form>
																</pane>
															</panes>
														</split-panel>
													</panel>
												</tab>
												<tab id="then"
													icon="css:bi bi-check-circle"
												>
													<label>
														<en>Then</en>
														<de>Dann</de>
													</label>
													<view-ref view="projects/rule-actions.view.xml">
														<bind
															channel="owner"
															to="reaction"
														/>
														<bind
															channel="listName"
															to="thenList"
														/>
