														<en>Else</en>
														<de>Sonst</de>
													</label>
													<view-ref view="projects/rule-actions.view.xml">
														<bind
															channel="owner"
															to="reaction"
														/>
														<bind
															channel="listName"
															to="elseList"
														/>
													</view-ref>
												</tab>
											</tabs>
										</tab-bar>
									</pane>
								</panes>
