<?xml version="1.0" encoding="utf-8" ?>

<!--
	Report of switching the programming LED of a device found by a scan (projects/scan.view.xml): the
	outcome as a sentence, then the messages.

	"report" carries the result of the job (de.haumacher.ehome.programming.download.ProgrammingReport,
	written by de.haumacher.ehome.scan.LedJob): "summary" and "messages" with the keys of the messages
	of the ETS import, shown by import-message.view.xml.
-->
<view>
	<channels>
		<channel name="report"/>
		<derived-channel name="summary"
			expr='$report["summary"]'
			inputs="report"
		/>
	</channels>
	<window width="900px">
		<title>
			<en>Installation: report</en>
			<de>Installation: Bericht</de>
		</title>
		<inset>
			<stack gap="loose">
				<text input="summary"/>
				<object-list
					gap="default"
					inputs="report"
					items='if($report == null, [], $report["messages"])'
				>
					<item>
						<view-ref view="projects/import-message.view.xml">
							<bind
								channel="message"
								to="element"
							/>
						</view-ref>
					</item>
				</object-list>
			</stack>
		</inset>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
