<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog "Read the installation" of a project (haumacher/ehome #9): scans the bus behind the
	project's gateway, matches the devices found against the catalog, creates or updates them in the
	project, and reads their configuration back.

	"project" is the project. The scan and the read-back run as jobs (de.haumacher.ehome.scan.ScanJob,
	ReadBackJob) and never write to the bus; the result is a dictionary in "result" (summary, rows,
	notes, see de.haumacher.ehome.scan.ScanRows). The functions scan* are
	de.haumacher.ehome.scan.ScanFunctions. Unidentified devices are kept in the project
	(ehome.project:Project#unidentifiedDevices) and matched again by "Match kept devices", e.g. after
	an import of product data.

	"LED on/off" switches the programming mode of the selected device: it writes into the device, so
	it is disabled with the reason unless the application runs with
	-Dehome.programming.writeEnabled=true, and asks for a confirmation naming device and gateway.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="scanJob"/>
		<channel name="deviceJob"/>
		<channel name="area"/>
		<channel name="line"/>
		<channel name="routers"/>
		<channel name="gatewayDevice"/>
		<channel name="programming"/>
		<channel name="result"/>
		<channel name="selected"/>
		<derived-channel name="gateway"
			expr='p -> #("Gateway: {0}"@en, "Gateway: {0}"@de).fill(if($p.get(`ehome.project:Project#gateway`) == null, "-", $p.get(`ehome.project:Project#gateway`))).localize()'
			inputs="project"
			observed-types="ehome.project:Project"
		/>
		<derived-channel name="summary"
			expr='r -> if($r == null, null, $r["summary"])'
			inputs="result"
		/>
	</channels>
	<window width="1300px">
		<title>
			<en>Read the installation</en>
			<de>Installation einlesen</de>
		</title>
		<inset>
			<stack gap="default">
				<panel>
					<title>
						<en>Search</en>
						<de>Suche</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-broadcast"
							input="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Choose the gateway</en>
								<de>Gateway wählen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="project"
								dialog-view="projects/choose-gateway.view.xml"
							/>
						</generic-command>
						<generic-command
							image="css:bi bi-search"
							input="project"
							observed-types="ehome.project:Project"
							placement="TOOLBAR"
						>
							<label>
								<en>Scan</en>
								<de>Suchen</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="p -> scanVeto($p, null, null, false, true, false)"/>
							</executability>
							<start-job
								cancelable="true"
								job="scanJob"
								update-interval="200"
							>
								<inputs>
									<input channel="project"/>
									<input channel="area"/>
									<input channel="line"/>
									<input channel="routers"/>
									<input channel="gatewayDevice"/>
									<input channel="programming"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.ScanJob"/>
							</start-job>
							<write-channel name="result"/>
						</generic-command>
						<generic-command
							image="css:bi bi-arrow-repeat"
							input="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Match kept devices</en>
								<de>Vorgemerkte Geräte zuordnen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="p -> scanRematch($p)"/>
							<write-channel name="result"/>
						</generic-command>
					</commands>
					<inset>
						<stack gap="compact">
							<text input="gateway"/>
							<text tone="helper"
								variant="caption"
							>
								<label>
									<en>The scan only reads: it connects to the devices and reads their descriptor, properties and memory. Choose the gateway of the installation to read; never a gateway of another installation.</en>
									<de>Die Suche liest nur: Sie verbindet sich mit den Geräten und liest Gerätebeschreibung, Eigenschaften und Speicher. Wählen Sie das Gateway der Installation, die eingelesen werden soll, nie das einer anderen Installation.</de>
								</label>
							</text>
							<fields>
								<value-input
									type="tl.core:Integer"
									value="area"
								>
									<label>
										<en>Area of the line</en>
										<de>Bereich der Linie</de>
									</label>
								</value-input>
								<value-input
									type="tl.core:Integer"
									value="line"
								>
									<label>
										<en>Line</en>
										<de>Linie</de>
									</label>
								</value-input>
								<value-input
									type="tl.core:Boolean"
									value="routers"
								>
									<label>
										<en>Couplers and routers of all lines</en>
										<de>Koppler und Router aller Linien</de>
									</label>
								</value-input>
								<value-input
									type="tl.core:Boolean"
									value="gatewayDevice"
								>
									<label>
										<en>The gateway itself (local device management)</en>
										<de>Das Gateway selbst (lokales Gerätemanagement)</de>
									</label>
								</value-input>
								<value-input
									type="tl.core:Boolean"
									value="programming"
								>
									<label>
										<en>Devices in programming mode</en>
										<de>Geräte im Programmiermodus</de>
									</label>
								</value-input>
							</fields>
							<job-status input="scanJob"/>
						</stack>
					</inset>
				</panel>
				<panel>
					<title>
						<en>Devices found</en>
						<de>Gefundene Geräte</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-plus-lg"
							input="selected"
							observed-types="ehome.physical:Device"
							placement="TOOLBAR"
						>
							<label>
								<en>Create / update</en>
								<de>Anlegen / Aktualisieren</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="r -> scanApplyVeto($r)"/>
							</executability>
							<if test='r -> $r["kind"] == "choice"'>
								<then>
									<open-dialog
										bind-input-to="row"
										dialog-view="projects/scan-choose.view.xml"
									>
										<bind
											channel="result"
											to="result"
										/>
									</open-dialog>
								</then>
								<else>
									<with-transaction>
										<execute-script function="r -> scanApply($r, null)"/>
									</with-transaction>
									<notify expr="m -> $m"/>
									<execute-script function='r -> x -> {"summary": $r["summary"], "rows": scanRefresh($r["rows"]), "notes": $r["notes"]}'>
										<inputs>
											<input channel="result"/>
										</inputs>
									</execute-script>
									<write-channel name="result"/>
								</else>
							</if>
						</generic-command>
						<generic-command
							image="css:bi bi-cloud-download"
							input="selected"
							observed-types="ehome.physical:Device,ehome.project:Project"
							placement="TOOLBAR"
						>
							<label>
								<en>Read the configuration</en>
								<de>Konfiguration einlesen</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="r -> scanReadVeto($r)"/>
							</executability>
							<start-job
								cancelable="true"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="selected"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.ReadBackJob"/>
							</start-job>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/scan-report.view.xml"
							/>
						</generic-command>
						<generic-command
							clique="more"
							image="css:bi bi-lightbulb"
							input="selected"
							placement="TOOLBAR"
						>
							<label>
								<en>Programming LED on</en>
								<de>Programmier-LED an</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="r -> scanLedVeto($r)"/>
							</executability>
							<confirm expr="r -> scanLedConfirmation($r, true)"/>
							<start-job
								cancelable="false"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="selected"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.LedJob"
									on="true"
								/>
							</start-job>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/scan-report.view.xml"
							/>
						</generic-command>
						<generic-command
							clique="more"
							image="css:bi bi-lightbulb-off"
							input="selected"
							placement="TOOLBAR"
						>
							<label>
								<en>Programming LED off</en>
								<de>Programmier-LED aus</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="r -> scanLedVeto($r)"/>
							</executability>
							<confirm expr="r -> scanLedConfirmation($r, false)"/>
							<start-job
								cancelable="false"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="selected"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.LedJob"
									on="false"
								/>
							</start-job>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/scan-report.view.xml"
							/>
						</generic-command>
					</commands>
					<inset>
						<stack gap="default">
							<text input="summary"/>
							<object-list
								gap="compact"
								inputs="result"
								items='r -> if($r == null, [], $r["notes"])'
							>
								<item>
									<text
										input="element"
										tone="secondary"
									/>
								</item>
							</object-list>
							<job-status input="deviceJob"/>
							<table selection="selected">
								<inputs>
									<input channel="result"/>
								</inputs>
								<columns>
									<computed-column name="address"
										type="tl.core:String"
										width="120"
									>
										<label>
											<en>Address</en>
											<de>Adresse</de>
										</label>
										<value>row -> $row["address"]</value>
									</computed-column>
									<computed-column name="source"
										type="tl.core:String"
										width="160"
									>
										<label>
											<en>Read via</en>
											<de>Gelesen über</de>
										</label>
										<value>row -> $row["source"]</value>
									</computed-column>
									<computed-column name="descriptor"
										type="tl.core:String"
										width="110"
									>
										<label>
											<en>Mask</en>
											<de>Maske</de>
										</label>
										<value>row -> $row["descriptor"]</value>
									</computed-column>
									<computed-column name="manufacturer"
										type="tl.core:String"
										width="170"
									>
										<label>
											<en>Manufacturer</en>
											<de>Hersteller</de>
										</label>
										<value>row -> $row["manufacturer"]</value>
									</computed-column>
									<computed-column name="serial"
										type="tl.core:String"
										width="170"
									>
										<label>
											<en>Serial number</en>
											<de>Seriennummer</de>
										</label>
										<value>row -> $row["serial"]</value>
									</computed-column>
									<computed-column name="programVersion"
										type="tl.core:String"
										width="180"
									>
										<label>
											<en>Program version</en>
											<de>Programmversion</de>
										</label>
										<value>row -> $row["programVersion"]</value>
									</computed-column>
									<computed-column name="states"
										type="tl.core:String"
										width="180"
									>
										<label>
											<en>Load states</en>
											<de>Ladezustände</de>
										</label>
										<value>row -> $row["states"]</value>
									</computed-column>
									<computed-column name="match"
										type="tl.core:String"
										width="300"
									>
										<label>
											<en>Catalog</en>
											<de>Katalog</de>
										</label>
										<value>row -> $row["matchText"]</value>
									</computed-column>
									<computed-column name="state"
										type="tl.core:String"
										width="220"
									>
										<label>
											<en>In the project</en>
											<de>Im Projekt</de>
										</label>
										<value>row -> $row["state"]</value>
									</computed-column>
									<computed-column name="notes"
										type="tl.core:String"
										width="250"
									>
										<label>
											<en>Not readable</en>
											<de>Nicht lesbar</de>
										</label>
										<value>row -> $row["notes"]</value>
									</computed-column>
								</columns>
								<rows>r -> if($r == null, [], $r["rows"])</rows>
							</table>
						</stack>
					</inset>
				</panel>
			</stack>
		</inset>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
