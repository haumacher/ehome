<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog "Scan the bus" of the area "Devices" of a project (haumacher/ehome #9, #180): scans the bus
	behind the project's gateway or its connected controller (haumacher/ehome #148) for one thing
	chosen under "Search for" (haumacher/ehome #182), matches the devices found against the catalog,
	and takes them over into the project: creates or updates each and reads its configuration back in
	one go.

	"project" is the project, "startLine" the line selected in the tree of the devices as entered for
	a scan ("1.1"), which fills the field "Line"; the tree does not switch the choice. The scan and the
	take-over run as jobs (de.haumacher.ehome.scan.ScanJob, TakeOverJob) and never write to the bus;
	the result is a dictionary in "result" (summary, rows, notes, see de.haumacher.ehome.scan.ScanRows).
	The functions scan* are de.haumacher.ehome.scan.ScanFunctions. "New devices only" leaves the
	addresses at which the project has a device unread. The scan itself changes nothing in the project.
	"Choose the product" decides between several candidates of the catalog (projects/scan-choose.view.xml)
	before the row is taken over. A device the catalog does not identify is taken over as a stub in its
	line (ehome.physical:DeviceStub, haumacher/ehome #183), without program and without reading its
	configuration; "Assign" at the stub matches it again after an import of product data. The table
	shows the order number a device reports, empty where it reports no text there (haumacher/ehome #206).

	The table selects several rows; "Take over" works on the selected rows, "Take over all" on every
	row, each row saying in its state what happened. "LED on/off" switches the programming mode of the
	single selected device: it writes into the device, so it is disabled with the reason unless the
	configuration variable tl_ehome_programming_write_enabled is true, and asks for a confirmation
	naming device and path (gateway or controller). Unless the installation reaches local networks
	(tl_ehome_local_network), a gateway is refused with that reason; the controller stays available,
	and "Choose the gateway" offers only it then.
-->
<view>
	<channels>
		<channel name="project"/>
		<!-- The line selected in the tree of the devices, as entered for a scan; nothing for another node. -->
		<channel name="startLine"/>
		<channel name="scanJob"/>
		<channel name="deviceJob"/>
		<!-- What the scan searches for, one de.haumacher.ehome.scan.ScanTarget (haumacher/ehome #182). -->
		<channel name="target"
			init="scanTarget('PROGRAMMING_MODE')"
		/>
		<!-- The line to scan, as entered ("1.1"), for the target LINE; starts with the line selected in the tree. -->
		<channel name="line"
			init="$startLine"
			inputs="startLine"
		/>
		<!-- Whether the addresses at which the project has a device are left unread (haumacher/ehome #180). -->
		<channel name="newOnly"
			init="false"
		/>
		<channel name="result"/>
		<!-- The rows selected in the table: one row, the set of several, or nothing. -->
		<channel name="selected"/>
		<!-- The single selected row. -->
		<derived-channel name="row"
			expr="scanRow($selected)"
			inputs="selected"
		/>
		<!-- Re-decides the commands using the bus when a bus session or a controller changes (BusStateSource, haumacher/ehome #161). -->
		<source-channel name="busState"
			update-interval="500"
		>
			<source class="de.haumacher.ehome.programming.download.BusStateSource"/>
		</source-channel>
		<derived-channel name="gateway"
			expr='#("Path to the bus: {0}"@en, "Weg zum Bus: {0}"@de).fill(if(busPath($project) == null, "-", busPath($project))).localize()'
			inputs="project"
			observed-types="ehome.project:Project"
		/>
		<derived-channel name="summary"
			expr='if($result == null, null, $result["summary"])'
			inputs="result"
		/>
	</channels>
	<window width="1300px">
		<title>
			<en>Scan the bus</en>
			<de>Bus durchsuchen</de>
		</title>
		<inset>
			<stack gap="default">
				<panel>
					<title>
						<en>Search</en>
						<de>Suche</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-broadcast"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Choose the gateway</en>
								<de>Gateway wählen</de>
							</label>
							<tooltip>
								<en>Sets the path of the project to the bus: a KNXnet/IP gateway, entered by address or chosen from a search, or the project's connected controller; the scan reads the installation behind it. It is the path of the whole project, for programming as well.</en>
								<de>Legt den Weg des Projekts zum Bus fest: ein KNXnet/IP-Gateway, als Adresse eingegeben oder aus einer Suche gewählt, oder den verbundenen Controller des Projekts; die Suche liest die Installation dahinter. Es ist der Weg des ganzen Projekts, auch für das Programmieren.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="project"
								dialog-view="projects/choose-gateway.view.xml"
							/>
						</generic-command>
						<generic-command
							image="css:bi bi-search"
							inputs="project, target, line, busState"
							observed-types="ehome.project:Project"
							placement="TOOLBAR"
						>
							<label>
								<en>Scan</en>
								<de>Suchen</de>
							</label>
							<tooltip>
								<en>Searches for what is chosen under "Search for" and reads descriptor, properties and memory of the devices found; nothing is written.</en>
								<de>Sucht nach dem unter „Suchen nach“ Gewählten und liest Gerätebeschreibung, Eigenschaften und Speicher der gefundenen Geräte; es wird nichts geschrieben.</de>
							</tooltip>
							<access>
								<!-- The scan prepares the take-over into the project. -->
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<!-- The job's own check, with the target and the line as chosen (a controller cannot read the gateway itself, haumacher/ehome #148). -->
								<disabled-if expr="scanVeto($project, $target, $line)"/>
							</executability>
							<start-job
								cancelable="true"
								job="scanJob"
								update-interval="200"
							>
								<inputs>
									<input channel="project"/>
									<input channel="target"/>
									<input channel="line"/>
									<input channel="newOnly"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.ScanJob"/>
								<!-- The summary of the scan stands above the table; the display of the finished job is cleared. -->
								<with-result>
									<write-channel name="result"/>
									<write-channel name="scanJob" clear="true"/>
								</with-result>
							</start-job>
						</generic-command>
					</commands>
					<inset>
						<stack gap="compact">
							<text input="gateway"/>
							<fields>
								<value-input
									mandatory="true"
									options="scanTargets()"
									value="target"
								>
									<label>
										<en>Search for</en>
										<de>Suchen nach</de>
									</label>
									<!-- The labels and the explanations of the targets are those of the Java enum. -->
									<input-control class="com.top_logic.layout.view.form.SelectControlProvider"
										display="radio"
										order="as-given"
									/>
								</value-input>
								<visible-if
									expr="$target == scanTarget('LINE')"
									input="target"
								>
									<!-- Entered as "area.line", refused at the field otherwise; the text reaches the channel when the field is left. -->
									<value-input
										mandatory="true"
										value="line"
									>
										<label>
											<en>Line</en>
											<de>Linie</de>
										</label>
										<input-control class="de.haumacher.ehome.scan.LineInputControlProvider"/>
									</value-input>
								</visible-if>
								<value-input
									type="tl.core:Boolean"
									value="newOnly"
								>
									<label>
										<en>New devices only</en>
										<de>Nur neue Geräte</de>
										<tooltip>
											<en>The addresses at which the project has a device are not read.</en>
											<de>Die Adressen, an denen das Projekt ein Gerät hat, werden nicht gelesen.</de>
										</tooltip>
									</label>
								</value-input>
							</fields>
							<job-status input="scanJob"/>
						</stack>
					</inset>
				</panel>
				<!--
					The table takes the height left in the dialog and scrolls in itself; in a low window the
					panel keeps a minimum height (style/ehome.css) and the dialog scrolls (haumacher/ehome #180).
				-->
				<panel css-class="ehomeScanFound">
					<title>
						<en>Devices found</en>
						<de>Gefundene Geräte</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-box-arrow-in-down"
							inputs="project, selected, result"
							observed-types="ehome.physical:BusDevice"
							placement="TOOLBAR"
						>
							<label>
								<en>Take over</en>
								<de>Übernehmen</de>
							</label>
							<tooltip>
								<en>Creates the selected devices in the project, or updates them, and reads their configuration from the devices; nothing is written into the devices. A device whose configuration cannot be read is created all the same; a device the catalog does not identify is created without program, marked as a problem. Each row says what happened.</en>
								<de>Legt die gewählten Geräte im Projekt an oder aktualisiert sie und liest ihre Konfiguration aus den Geräten; in die Geräte wird nichts geschrieben. Ein Gerät, dessen Konfiguration sich nicht lesen lässt, wird trotzdem angelegt; ein Gerät, das der Katalog nicht identifiziert, wird ohne Programm angelegt und als Problem markiert. Jede Zeile sagt, was geschah.</de>
							</tooltip>
							<access>
								<!-- The devices are created or updated in the project and their configuration written there. -->
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanTakeOverVeto($selected)"/>
							</executability>
							<start-job
								cancelable="true"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="selected"/>
									<input channel="result"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.TakeOverJob"/>
								<with-result as="outcome">
									<write-channel name="result"/>
								</with-result>
								<!-- Cancelled after some rows: the rows taken over before say so (TL #30195); the display of the job says what was done. -->
								<on-cancel as="outcome">
									<if test="$outcome != null">
										<then>
											<write-channel name="result"/>
										</then>
									</if>
								</on-cancel>
							</start-job>
						</generic-command>
						<generic-command
							image="css:bi bi-box-arrow-in-down-right"
							inputs="project, result"
							observed-types="ehome.physical:BusDevice"
							placement="TOOLBAR"
						>
							<label>
								<en>Take over all</en>
								<de>Alle übernehmen</de>
							</label>
							<tooltip>
								<en>Takes over every device found, as "Take over" does with the selected ones.</en>
								<de>Übernimmt alle gefundenen Geräte, wie „Übernehmen“ die gewählten.</de>
							</tooltip>
							<access>
								<!-- The devices are created or updated in the project and their configuration written there. -->
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanTakeOverVeto($result)"/>
							</executability>
							<start-job
								cancelable="true"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="result"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.TakeOverJob"
									all="true"
								/>
								<with-result as="outcome">
									<write-channel name="result"/>
								</with-result>
								<!-- Cancelled after some rows: the rows taken over before say so (TL #30195); the display of the job says what was done. -->
								<on-cancel as="outcome">
									<if test="$outcome != null">
										<then>
											<write-channel name="result"/>
										</then>
									</if>
								</on-cancel>
							</start-job>
						</generic-command>
						<generic-command
							image="css:bi bi-list-check"
							inputs="row"
							placement="TOOLBAR"
						>
							<label>
								<en>Choose the product</en>
								<de>Produkt wählen</de>
							</label>
							<tooltip>
								<en>Decides which of the products and programs of the catalog the selected device is, where several fit; "Take over" then takes it as that.</en>
								<de>Legt fest, welches der Produkte und Programme des Katalogs das gewählte Gerät ist, wenn mehrere passen; „Übernehmen“ übernimmt es dann so.</de>
							</tooltip>
							<access>
								<!-- Only the result of the scan changes. -->
								<operation name="Read"
									object='$row["project"]'
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanChooseVeto($row)"/>
							</executability>
							<open-dialog
								bind-input-to="row"
								dialog-view="projects/scan-choose.view.xml"
							>
								<bind
									channel="result"
									to="result"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							clique="more"
							image="css:bi bi-lightbulb"
							inputs="row, busState"
							placement="TOOLBAR"
						>
							<label>
								<en>Programming LED on</en>
								<de>Programmier-LED an</de>
							</label>
							<tooltip>
								<en>Switches the programming mode of the selected device on, so that its programming LED shows where it is installed. This writes into the device.</en>
								<de>Schaltet den Programmiermodus des gewählten Geräts ein, damit seine Programmier-LED zeigt, wo es eingebaut ist. Das schreibt in das Gerät.</de>
							</tooltip>
							<access>
								<!-- Switches the programming mode of a device on the bus of the project of the row. -->
								<operation name="Write"
									object='$row["project"]'
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanLedVeto($row)"/>
							</executability>
							<confirm expr="scanLedConfirmation($row, true)"/>
							<start-job
								cancelable="false"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="row"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.LedJob"
									on="true"
								/>
								<with-result>
									<open-dialog
										bind-input-to="report"
										dialog-view="projects/scan-report.view.xml"
									/>
								</with-result>
							</start-job>
						</generic-command>
						<generic-command
							clique="more"
							image="css:bi bi-lightbulb-off"
							inputs="row, busState"
							placement="TOOLBAR"
						>
							<label>
								<en>Programming LED off</en>
								<de>Programmier-LED aus</de>
							</label>
							<tooltip>
								<en>Switches the programming mode of the selected device off again; its programming LED goes out. This writes into the device.</en>
								<de>Schaltet den Programmiermodus des gewählten Geräts wieder aus; seine Programmier-LED erlischt. Das schreibt in das Gerät.</de>
							</tooltip>
							<access>
								<!-- Switches the programming mode of a device on the bus of the project of the row. -->
								<operation name="Write"
									object='$row["project"]'
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanLedVeto($row)"/>
							</executability>
							<confirm expr="scanLedConfirmation($row, false)"/>
							<start-job
								cancelable="false"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="row"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.LedJob"
									on="false"
								/>
								<with-result>
									<open-dialog
										bind-input-to="report"
										dialog-view="projects/scan-report.view.xml"
									/>
								</with-result>
							</start-job>
						</generic-command>
					</commands>
					<inset>
						<stack gap="default">
							<text input="summary"/>
							<object-list
								gap="compact"
								inputs="result"
								items='if($result == null, [], $result["notes"])'
							>
								<item>
									<text
										input="element"
										tone="secondary"
									/>
								</item>
							</object-list>
							<job-status input="deviceJob"/>
							<table
								css-class="ehomeScanTable"
								selection="selected"
								selection-mode="multi"
							>
								<inputs>
									<input channel="result"/>
								</inputs>
								<columns>
									<computed-column name="address"
										type="tl.core:String"
										width="110"
									>
										<label>
											<en>Address</en>
											<de>Adresse</de>
										</label>
										<value>$row["address"]</value>
										<!-- How the device was read, its mask version and its load states (haumacher/ehome #180). -->
										<tooltip>$row["details"]</tooltip>
									</computed-column>
									<!-- A marker where something of the device could not be read, the reasons as its tooltip. -->
									<computed-column name="notes"
										type="tl.core:String"
										width="60"
									>
										<label>
											<en>Not readable</en>
											<de>Nicht lesbar</de>
										</label>
										<value>$row["notes"]</value>
										<display class="com.top_logic.layout.view.element.ResourceDisplayByExpression"
											icon="'css:bi bi-exclamation-triangle'"
											label="''"
											role="'warning'"
											tooltip="$value"
										/>
									</computed-column>
									<computed-column name="manufacturer"
										type="tl.core:String"
										width="170"
									>
										<label>
											<en>Manufacturer</en>
											<de>Hersteller</de>
										</label>
										<value>$row["manufacturer"]</value>
									</computed-column>
									<!-- The order number the device reports, empty where it reports no text there (haumacher/ehome #206). -->
									<computed-column name="order"
										type="tl.core:String"
										width="160"
									>
										<label>
											<en>Order number</en>
											<de>Bestellnummer</de>
										</label>
										<value>$row["order"]</value>
									</computed-column>
									<computed-column name="serial"
										type="tl.core:String"
										width="160"
									>
										<label>
											<en>Serial number</en>
											<de>Seriennummer</de>
										</label>
										<value>$row["serial"]</value>
									</computed-column>
									<computed-column name="programVersion"
										type="tl.core:String"
										width="150"
									>
										<label>
											<en>Program version</en>
											<de>Programmversion</de>
										</label>
										<value>$row["programVersion"]</value>
									</computed-column>
									<computed-column name="match"
										type="tl.core:String"
										width="320"
									>
										<label>
											<en>Catalog</en>
											<de>Katalog</de>
										</label>
										<value>$row["matchText"]</value>
										<tooltip>$row["matchText"]</tooltip>
									</computed-column>
									<computed-column name="state"
										cell-role='$row["stateRole"]'
										type="tl.core:String"
										width="320"
									>
										<label>
											<en>In the project</en>
											<de>Im Projekt</de>
										</label>
										<value>$row["state"]</value>
										<tooltip>if($row["stateDetails"] == null, $row["state"], $row["stateDetails"])</tooltip>
									</computed-column>
								</columns>
								<rows>if($result == null, [], $result["rows"])</rows>
							</table>
						</stack>
					</inset>
				</panel>
			</stack>
		</inset>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
