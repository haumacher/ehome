<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog "Read the installation" of a project (haumacher/ehome #9): scans the bus behind the
	project's gateway, matches the devices found against the catalog, creates or updates them in the
	project, and reads their configuration back.

	"project" is the project. The scan and the read-back run as jobs (de.haumacher.ehome.scan.ScanJob,
	ReadBackJob) and never write to the bus; the result is a dictionary in "result" (summary, rows,
	notes, see de.haumacher.ehome.scan.ScanRows). The functions scan* are
	de.haumacher.ehome.scan.ScanFunctions. Unidentified devices are kept in the project
	(ehome.project:Project#unidentifiedDevices) and matched again by "Match kept devices", e.g. after
	an import of product data.

	"LED on/off" switches the programming mode of the selected device: it writes into the device, so
	it is disabled with the reason unless the application runs with
	-Dehome.programming.writeEnabled=true, and asks for a confirmation naming device and gateway.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="scanJob"/>
		<channel name="deviceJob"/>
		<channel name="area"/>
		<channel name="line"/>
		<channel name="routers"/>
		<channel name="gatewayDevice"/>
		<channel name="programming"/>
		<channel name="result"/>
		<channel name="selected"/>
		<derived-channel name="gateway"
			expr='#("Gateway: {0}"@en, "Gateway: {0}"@de).fill(if($project.get(`ehome.project:Project#gateway`) == null, "-", $project.get(`ehome.project:Project#gateway`))).localize()'
			inputs="project"
			observed-types="ehome.project:Project"
		/>
		<derived-channel name="summary"
			expr='if($result == null, null, $result["summary"])'
			inputs="result"
		/>
	</channels>
	<window width="1300px">
		<title>
			<en>Read the installation</en>
			<de>Installation einlesen</de>
		</title>
		<inset>
			<stack gap="default">
				<panel>
					<title>
						<en>Search</en>
						<de>Suche</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-broadcast"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Choose the gateway</en>
								<de>Gateway wählen</de>
							</label>
							<tooltip>
								<en>Sets the KNXnet/IP gateway of the project, entered by address or chosen from a search; the scan reads the installation behind it. It is the gateway of the whole project, for programming as well.</en>
								<de>Legt das KNXnet/IP-Gateway des Projekts fest, als Adresse eingegeben oder aus einer Suche gewählt; die Suche liest die Installation dahinter. Es ist das Gateway des ganzen Projekts, auch für das Programmieren.</de>
							</tooltip>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="project"
								dialog-view="projects/choose-gateway.view.xml"
							/>
						</generic-command>
						<generic-command
							image="css:bi bi-search"
							inputs="project"
							observed-types="ehome.project:Project"
							placement="TOOLBAR"
						>
							<label>
								<en>Scan</en>
								<de>Suchen</de>
							</label>
							<tooltip>
								<en>Searches the chosen line and the targets checked for devices and reads their descriptor, properties and memory; nothing is written. Devices the catalog does not identify are kept in the project; devices of the project are created only by "Create / update".</en>
								<de>Sucht auf der gewählten Linie und bei den angekreuzten Zielen nach Geräten und liest Gerätebeschreibung, Eigenschaften und Speicher; es wird nichts geschrieben. Vom Katalog nicht erkannte Geräte werden im Projekt vorgemerkt; Geräte des Projekts legt erst „Anlegen / Aktualisieren“ an.</de>
							</tooltip>
							<access>
								<!-- The scan creates and updates the devices of the project. -->
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanVeto($project, null, null, false, true, false)"/>
							</executability>
							<start-job
								cancelable="true"
								job="scanJob"
								update-interval="200"
							>
								<inputs>
									<input channel="project"/>
									<input channel="area"/>
									<input channel="line"/>
									<input channel="routers"/>
									<input channel="gatewayDevice"/>
									<input channel="programming"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.ScanJob"/>
								<with-result>
									<write-channel name="result"/>
								</with-result>
							</start-job>
						</generic-command>
						<generic-command
							image="css:bi bi-arrow-repeat"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Match kept devices</en>
								<de>Vorgemerkte Geräte zuordnen</de>
							</label>
							<tooltip>
								<en>Matches the unidentified devices kept from earlier scans against the catalog again, for example after an import of product data; the bus is not accessed.</en>
								<de>Ordnet die bei früheren Suchen vorgemerkten, nicht erkannten Geräte erneut dem Katalog zu, etwa nach einem Import von Produktdaten; der Bus wird dabei nicht angesprochen.</de>
							</tooltip>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="scanRematch($project)">
								<with-result>
									<write-channel name="result"/>
								</with-result>
							</execute-script>
						</generic-command>
					</commands>
					<inset>
						<stack gap="compact">
							<text input="gateway"/>
							<text tone="helper"
								variant="caption"
							>
								<label>
									<en>The scan only reads: it connects to the devices and reads their descriptor, properties and memory. Choose the gateway of the installation to read; never a gateway of another installation.</en>
									<de>Die Suche liest nur: Sie verbindet sich mit den Geräten und liest Gerätebeschreibung, Eigenschaften und Speicher. Wählen Sie das Gateway der Installation, die eingelesen werden soll, nie das einer anderen Installation.</de>
								</label>
							</text>
							<fields>
								<value-input
									type="tl.core:Integer"
									value="area"
								>
									<label>
										<en>Area of the line</en>
										<de>Bereich der Linie</de>
									</label>
								</value-input>
								<value-input
									type="tl.core:Integer"
									value="line"
								>
									<label>
										<en>Line</en>
										<de>Linie</de>
									</label>
								</value-input>
								<value-input
									type="tl.core:Boolean"
									value="routers"
								>
									<label>
										<en>Couplers and routers of all lines</en>
										<de>Koppler und Router aller Linien</de>
									</label>
								</value-input>
								<value-input
									type="tl.core:Boolean"
									value="gatewayDevice"
								>
									<label>
										<en>The gateway itself (local device management)</en>
										<de>Das Gateway selbst (lokales Gerätemanagement)</de>
									</label>
								</value-input>
								<value-input
									type="tl.core:Boolean"
									value="programming"
								>
									<label>
										<en>Devices in programming mode</en>
										<de>Geräte im Programmiermodus</de>
									</label>
								</value-input>
							</fields>
							<job-status input="scanJob"/>
						</stack>
					</inset>
				</panel>
				<panel>
					<title>
						<en>Devices found</en>
						<de>Gefundene Geräte</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-plus-lg"
							inputs="selected"
							observed-types="ehome.physical:Device"
							placement="TOOLBAR"
						>
							<label>
								<en>Create / update</en>
								<de>Anlegen / Aktualisieren</de>
							</label>
							<tooltip>
								<en>Creates the selected device in the project with the product and program found, its parameters at their defaults until "Read the configuration". A device of the project with its address only takes the serial number; one running another program is not changed.</en>
								<de>Legt das gewählte Gerät mit dem gefundenen Produkt und Programm im Projekt an, mit den Vorgabewerten der Parameter bis „Konfiguration einlesen“. Ein Gerät des Projekts mit seiner Adresse übernimmt nur die Seriennummer; eines mit einem anderen Programm bleibt unverändert.</de>
							</tooltip>
							<access>
								<!-- The device is created or updated in the project of the row. -->
								<operation name="Write"
									object='$selected["project"]'
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanApplyVeto($selected)"/>
							</executability>
							<if test='$selected["kind"] == "choice"'>
								<then>
									<open-dialog
										bind-input-to="row"
										dialog-view="projects/scan-choose.view.xml"
									>
										<bind
											channel="result"
											to="result"
										/>
									</open-dialog>
								</then>
								<else>
									<with-transaction>
										<execute-script function="scanApply($selected, null)"/>
										<with-result>
											<notify expr="$result"/>
											<execute-script function='{"summary": $result["summary"], "rows": scanRefresh($result["rows"]), "notes": $result["notes"]}'>
												<inputs>
													<input channel="result"/>
												</inputs>
												<with-result>
													<write-channel name="result"/>
												</with-result>
											</execute-script>
										</with-result>
									</with-transaction>
								</else>
							</if>
						</generic-command>
						<generic-command
							image="css:bi bi-cloud-download"
							inputs="selected"
							observed-types="ehome.physical:Device,ehome.project:Project"
							placement="TOOLBAR"
						>
							<label>
								<en>Read the configuration</en>
								<de>Konfiguration einlesen</de>
							</label>
							<tooltip>
								<en>Reads the memory of the selected device and takes its parameter values and connections into the project's device, overwriting those there; nothing is written into the device. The device then counts as downloaded.</en>
								<de>Liest den Speicher des gewählten Geräts und übernimmt seine Parameterwerte und Verbindungen in das Gerät des Projekts, wobei die bisherigen überschrieben werden; in das Gerät wird nichts geschrieben. Das Gerät gilt danach als heruntergeladen.</de>
							</tooltip>
							<access>
								<!-- The read-back writes the configuration into the device of the project of the row. -->
								<operation name="Write"
									object='$selected["project"]'
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanReadVeto($selected)"/>
							</executability>
							<start-job
								cancelable="true"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="selected"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.ReadBackJob"/>
								<with-result>
									<open-dialog
										bind-input-to="report"
										dialog-view="projects/scan-report.view.xml"
									/>
								</with-result>
							</start-job>
						</generic-command>
						<generic-command
							clique="more"
							image="css:bi bi-lightbulb"
							inputs="selected"
							placement="TOOLBAR"
						>
							<label>
								<en>Programming LED on</en>
								<de>Programmier-LED an</de>
							</label>
							<tooltip>
								<en>Switches the programming mode of the selected device on, so that its programming LED shows where it is installed. This writes into the device.</en>
								<de>Schaltet den Programmiermodus des gewählten Geräts ein, damit seine Programmier-LED zeigt, wo es eingebaut ist. Das schreibt in das Gerät.</de>
							</tooltip>
							<access>
								<!-- Switches the programming mode of a device on the bus of the project of the row. -->
								<operation name="Write"
									object='$selected["project"]'
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanLedVeto($selected)"/>
							</executability>
							<confirm expr="scanLedConfirmation($selected, true)"/>
							<start-job
								cancelable="false"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="selected"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.LedJob"
									on="true"
								/>
								<with-result>
									<open-dialog
										bind-input-to="report"
										dialog-view="projects/scan-report.view.xml"
									/>
								</with-result>
							</start-job>
						</generic-command>
						<generic-command
							clique="more"
							image="css:bi bi-lightbulb-off"
							inputs="selected"
							placement="TOOLBAR"
						>
							<label>
								<en>Programming LED off</en>
								<de>Programmier-LED aus</de>
							</label>
							<tooltip>
								<en>Switches the programming mode of the selected device off again; its programming LED goes out. This writes into the device.</en>
								<de>Schaltet den Programmiermodus des gewählten Geräts wieder aus; seine Programmier-LED erlischt. Das schreibt in das Gerät.</de>
							</tooltip>
							<access>
								<!-- Switches the programming mode of a device on the bus of the project of the row. -->
								<operation name="Write"
									object='$selected["project"]'
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="scanLedVeto($selected)"/>
							</executability>
							<confirm expr="scanLedConfirmation($selected, false)"/>
							<start-job
								cancelable="false"
								job="deviceJob"
								update-interval="200"
							>
								<inputs>
									<input channel="selected"/>
								</inputs>
								<body class="de.haumacher.ehome.scan.LedJob"
									on="false"
								/>
								<with-result>
									<open-dialog
										bind-input-to="report"
										dialog-view="projects/scan-report.view.xml"
									/>
								</with-result>
							</start-job>
						</generic-command>
					</commands>
					<inset>
						<stack gap="default">
							<text input="summary"/>
							<object-list
								gap="compact"
								inputs="result"
								items='if($result == null, [], $result["notes"])'
							>
								<item>
									<text
										input="element"
										tone="secondary"
									/>
								</item>
							</object-list>
							<job-status input="deviceJob"/>
							<table selection="selected">
								<inputs>
									<input channel="result"/>
								</inputs>
								<columns>
									<computed-column name="address"
										type="tl.core:String"
										width="120"
									>
										<label>
											<en>Address</en>
											<de>Adresse</de>
										</label>
										<value>$row["address"]</value>
									</computed-column>
									<computed-column name="source"
										type="tl.core:String"
										width="160"
									>
										<label>
											<en>Read via</en>
											<de>Gelesen über</de>
										</label>
										<value>$row["source"]</value>
									</computed-column>
									<computed-column name="descriptor"
										type="tl.core:String"
										width="110"
									>
										<label>
											<en>Mask</en>
											<de>Maske</de>
										</label>
										<value>$row["descriptor"]</value>
									</computed-column>
									<computed-column name="manufacturer"
										type="tl.core:String"
										width="170"
									>
										<label>
											<en>Manufacturer</en>
											<de>Hersteller</de>
										</label>
										<value>$row["manufacturer"]</value>
									</computed-column>
									<computed-column name="serial"
										type="tl.core:String"
										width="170"
									>
										<label>
											<en>Serial number</en>
											<de>Seriennummer</de>
										</label>
										<value>$row["serial"]</value>
									</computed-column>
									<computed-column name="programVersion"
										type="tl.core:String"
										width="180"
									>
										<label>
											<en>Program version</en>
											<de>Programmversion</de>
										</label>
										<value>$row["programVersion"]</value>
									</computed-column>
									<computed-column name="states"
										type="tl.core:String"
										width="180"
									>
										<label>
											<en>Load states</en>
											<de>Ladezustände</de>
										</label>
										<value>$row["states"]</value>
									</computed-column>
									<computed-column name="match"
										type="tl.core:String"
										width="300"
									>
										<label>
											<en>Catalog</en>
											<de>Katalog</de>
										</label>
										<value>$row["matchText"]</value>
									</computed-column>
									<computed-column name="state"
										type="tl.core:String"
										width="220"
									>
										<label>
											<en>In the project</en>
											<de>Im Projekt</de>
										</label>
										<value>$row["state"]</value>
									</computed-column>
									<computed-column name="notes"
										type="tl.core:String"
										width="250"
									>
										<label>
											<en>Not readable</en>
											<de>Nicht lesbar</de>
										</label>
										<value>$row["notes"]</value>
									</computed-column>
								</columns>
								<rows>if($result == null, [], $result["rows"])</rows>
							</table>
						</stack>
					</inset>
				</panel>
			</stack>
		</inset>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
