<?xml version="1.0" encoding="utf-8" ?>

<!--
	The schedule of a project (haumacher/ehome #57, homecontrol spec/schedules.md): moments in local
	time at which the HomeControl controller fires an entry, and the rules with a schedule trigger on
	the entry's id react. Six kinds: weekly, yearly, on dates, at a sun event, at intervals, once.
	Times are written as 06:30, dates as 2027-01-08, durations as 15min; each field is checked while
	it is edited as the controller would check it. The entries are part of the runtime image.
	"New" opens the create dialog projects/create-part.view.xml (haumacher/ehome #91) over a draft
	of the kind, asking for the fields that define it; nothing is stored before "Create".
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="entry"/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				size="50"
				unit="%"
			>
				<panel>
					<title>
						<en>Schedule</en>
						<de>Zeitplan</de>
					</title>
					<commands>
						<generic-command
							clique="new"
							image="css:bi bi-calendar-week"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Weekly</en>
								<de>Wöchentlich</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="ruleDraft($project, 'schedules', `ehome.runtime:WeeklySchedule`)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="projects/create-part.view.xml"
									>
										<bind
											channel="selection"
											to="entry"
										/>
									</open-dialog>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-calendar-heart"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Yearly</en>
								<de>Jährlich</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="ruleDraft($project, 'schedules', `ehome.runtime:YearlySchedule`)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="projects/create-part.view.xml"
									>
										<bind
											channel="selection"
											to="entry"
										/>
									</open-dialog>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-calendar3"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>On dates</en>
								<de>An Daten</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="ruleDraft($project, 'schedules', `ehome.runtime:DatesSchedule`)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="projects/create-part.view.xml"
									>
										<bind
											channel="selection"
											to="entry"
										/>
									</open-dialog>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-sunset"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Sun</en>
								<de>Sonne</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="ruleDraft($project, 'schedules', `ehome.runtime:AstroSchedule`)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="projects/create-part.view.xml"
									>
										<bind
											channel="selection"
											to="entry"
										/>
									</open-dialog>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-clock-history"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Interval</en>
								<de>Intervall</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="ruleDraft($project, 'schedules', `ehome.runtime:IntervalSchedule`)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="projects/create-part.view.xml"
									>
										<bind
											channel="selection"
											to="entry"
										/>
									</open-dialog>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-calendar-check"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Once</en>
								<de>Einmalig</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="ruleDraft($project, 'schedules', `ehome.runtime:OnceSchedule`)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="projects/create-part.view.xml"
									>
										<bind
											channel="selection"
											to="entry"
										/>
									</open-dialog>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="entry"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="deleteConfirmation($entry)"/>
							<delete-object/>
							<write-channel name="entry" clear="true"/>
						</generic-command>
						<generic-command
							clique="edit"
							image="css:bi bi-arrow-up"
							inputs="entry"
							placement="TOOLBAR"
						>
							<label>
								<en>Move up</en>
								<de>Nach oben</de>
							</label>
							<access>
								<operation name="Write"
									object="$entry"
									type="ehome.runtime:ScheduleEntry"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="ruleMoveVeto($entry, -1)"/>
							</executability>
							<with-transaction>
								<execute-script function="ruleMove($entry, -1)"/>
							</with-transaction>
						</generic-command>
						<generic-command
							clique="edit"
							image="css:bi bi-arrow-down"
							inputs="entry"
							placement="TOOLBAR"
						>
							<label>
								<en>Move down</en>
								<de>Nach unten</de>
							</label>
							<access>
								<operation name="Write"
									object="$entry"
									type="ehome.runtime:ScheduleEntry"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="ruleMoveVeto($entry, 1)"/>
							</executability>
							<with-transaction>
								<execute-script function="ruleMove($entry, 1)"/>
							</with-transaction>
						</generic-command>
					</commands>
					<table
						observed-types="ehome.runtime:ScheduleEntry,ehome.project:Project"
						selection="entry"
						types="ehome.runtime:ScheduleEntry"
					>
						<inputs>
							<input channel="project"/>
						</inputs>
						<columns>
							<column attribute="label"/>
							<column attribute="identifier"/>
							<column attribute="enabled"/>
							<computed-column name="summary"
								type="tl.core:String"
							>
								<label>
									<en>When</en>
									<de>Wann</de>
								</label>
								<value>ruleSummary($row)</value>
							</computed-column>
						</columns>
						<rows>if($project == null, [], $project.get(`ehome.project:Project#schedules`))</rows>
					</table>
				</panel>
			</pane>
			<pane
				size="50"
				unit="%"
			>
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="70"
							unit="%"
						>
							<panel>
								<title>
									<en>Schedule entry</en>
									<de>Zeitplaneintrag</de>
								</title>
								<form
									input="entry"
									with-inset="true"
								>
									<field attribute="label"/>
									<field attribute="identifier"/>
									<field attribute="enabled"/>
									<field attribute="enabledAdjustable"/>
									<field attribute="missed"/>
									<field attribute="output"/>
									<field attribute="time"/>
									<field attribute="month"/>
									<field attribute="day"/>
									<field attribute="dates"/>
									<field attribute="sun"/>
									<field attribute="offset"/>
									<field attribute="notBefore"/>
									<field attribute="notAfter"/>
									<field attribute="every"/>
									<field attribute="from"/>
									<field attribute="until"/>
									<field attribute="at"/>
									<field attribute="days"/>
									<!--
										What the inhabitant may change on the controller (homecontrol #58,
										spec/schedules.md 2.1), with bounds and a step; only the members of the entry's
										kind. An adjustable time of a weekly, yearly or dates entry is also the datapoint
										schedule/<id>/time, which rules and control pages name.
									-->
									<group>
										<label>
											<en>Adjustable by the inhabitant</en>
											<de>Vom Bewohner einstellbar</de>
										</label>
										<field attribute="timeAdjustable"/>
										<field attribute="timeMin"/>
										<field attribute="timeMax"/>
										<field attribute="timeStep"/>
										<field attribute="offsetAdjustable"/>
										<field attribute="offsetMin"/>
										<field attribute="offsetMax"/>
										<field attribute="offsetStep"/>
										<field attribute="notBeforeAdjustable"/>
										<field attribute="notBeforeMin"/>
										<field attribute="notBeforeMax"/>
										<field attribute="notBeforeStep"/>
										<field attribute="notAfterAdjustable"/>
										<field attribute="notAfterMin"/>
										<field attribute="notAfterMax"/>
										<field attribute="notAfterStep"/>
										<field attribute="everyAdjustable"/>
										<field attribute="everyMin"/>
										<field attribute="everyMax"/>
										<field attribute="everyStep"/>
										<field attribute="fromAdjustable"/>
										<field attribute="fromMin"/>
										<field attribute="fromMax"/>
										<field attribute="fromStep"/>
										<field attribute="untilAdjustable"/>
										<field attribute="untilMin"/>
										<field attribute="untilMax"/>
										<field attribute="untilStep"/>
										<field attribute="atAdjustable"/>
										<field attribute="atMin"/>
										<field attribute="atMax"/>
										<field attribute="daysAdjustable"/>
									</group>
								</form>
							</panel>
						</pane>
						<pane
							size="30"
							unit="%"
						>
							<!--
								The datapoints an entry may set as its output (haumacher/ehome #59): the boolean
								application datapoints of the project, edited in the rules' tab "Application
								datapoints". A datapoint of a group address is owned by the KNX adapter and refused.
							-->
							<panel>
								<title>
									<en>Possible outputs</en>
									<de>Mögliche Ausgänge</de>
								</title>
								<table observed-types="ehome.runtime:ApplicationDatapoint,ehome.project:Project">
									<inputs>
										<input channel="project"/>
									</inputs>
									<columns>
										<computed-column name="id"
											type="tl.core:String"
										>
											<label>
												<en>Id</en>
												<de>Id</de>
											</label>
											<value>$row["id"]</value>
										</computed-column>
										<computed-column name="label"
											type="tl.core:String"
										>
											<label>
												<en>Name</en>
												<de>Name</de>
											</label>
											<value>$row["label"]</value>
										</computed-column>
										<computed-column name="writable"
											type="tl.core:String"
										>
											<label>
												<en>Writable</en>
												<de>Schreibbar</de>
											</label>
											<value>if($row["writable"] == true, '✓', '')</value>
										</computed-column>
									</columns>
									<rows>ruleDatapoints($project).filter(d -> $d["type"] == "boolean" &amp;&amp; $d["knx"] == null &amp;&amp; $d["parameter"] == null)</rows>
								</table>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</pane>
		</panes>
	</split-panel>
</view>
