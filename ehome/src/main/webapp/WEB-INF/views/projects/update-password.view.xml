<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the update of a project from ETS (haumacher/ehome #125) for a project file whose project
	is protected by a password (ETS 5/6): asks for the project password and updates the project from
	the file with it, as import-password.view.xml does for the import.

	"request" carries the result of the update job for the file uploaded without a password
	(de.haumacher.ehome.etsImport.UpdateFromEtsJob): the file in "file", the project to update in
	"project", the reason in "message". "project" is the project selected in the projects overview,
	on which the update needs the right to write. The update runs as a cancelable job shown in the
	dialog ("job"), as in import-password.view.xml. A wrong password or a refused update fails the job
	with the reason, shown in the dialog, which stays open with the uploaded file: the password is
	typed again and the update started again. The job that completes closes the dialog first
	(TL #30193) and shows the report of the update in the report dialog (import-report.view.xml).
-->
<view>
	<channels>
		<channel name="request"/>
		<channel name="password"/>
		<channel name="project"/>
		<channel name="job"/>
		<derived-channel name="reason"
			expr='if($request == null, null, $request["message"])'
			inputs="request"
		/>
	</channels>
	<window width="600px">
		<title>
			<en>Update from ETS: project password</en>
			<de>Aus ETS aktualisieren: Projektpasswort</de>
		</title>
		<inset>
			<stack gap="default">
				<text input="reason"/>
				<fields>
					<value-input
						type="tl.core:String"
						value="password"
					>
						<label>
							<en>Project password</en>
							<de>Projektpasswort</de>
						</label>
						<input-control class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
					</value-input>
				</fields>
				<!-- The job of the dialog; a failed one stays displayed with its reason until it is closed or started again. -->
				<visible-if
					expr="$job != null"
					input="job"
				>
					<job-status input="job"/>
				</visible-if>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:fa-solid fa-upload"
					inputs="request, password, project, job"
				>
					<label>
						<en>Update</en>
						<de>Aktualisieren</de>
					</label>
					<access>
						<!-- As the command of the project overview: the update changes the project. -->
						<operation name="Write"
							object="$project"
							type="ehome.project:Project"
						/>
					</access>
					<executability>
						<disabled-if expr="if($request == null || $project == null || $password == null, #('Enter the project password.'@en, 'Geben Sie das Projektpasswort ein.'@de), if(jobIsRunning($job), #('An import is running.'@en, 'Ein Import läuft.'@de), null))"/>
					</executability>
					<start-job
						cancelable="true"
						job="job"
						update-interval="200"
					>
						<phases>
							<phase name="read">
								<label>
									<en>Reading</en>
									<de>Lesen</de>
								</label>
							</phase>
							<phase name="import">
								<label>
									<en>Importing</en>
									<de>Importieren</de>
								</label>
							</phase>
							<phase name="save">
								<label>
									<en>Saving</en>
									<de>Speichern</de>
								</label>
							</phase>
						</phases>
						<body class="de.haumacher.ehome.etsImport.UpdateFromEtsJob"/>
						<with-result as="report">
							<!-- The dialog closes first, then the report says how the job ended (TL #30193). -->
							<close-dialog/>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/import-report.view.xml"
							/>
						</with-result>
					</start-job>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
