<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the update of a project from ETS (haumacher/ehome #125) for a project file whose project
	is protected by a password (ETS 5/6): asks for the project password and updates the project from
	the file with it, as import-password.view.xml does for the import.

	"request" carries the result of the update job for the file uploaded without a password
	(de.haumacher.ehome.etsImport.UpdateFromEtsJob): the file in "file", the project to update in
	"project", the reason in "message". "project" is the project selected in the projects overview,
	on which the update needs the right to write. The dialog closes before the job starts, and the job
	is shown on "importJob", bound to the job channel of the projects overview (TL #30193,
	doc/tl-todo.md). A wrong password or a refused update fails the job with the reason, shown in the
	overview; the report of the update is shown in the report dialog (import-report.view.xml).
-->
<view>
	<channels>
		<channel name="request"/>
		<channel name="password"/>
		<channel name="project"/>
		<channel name="importJob"/>
		<derived-channel name="reason"
			expr='if($request == null, null, $request["message"])'
			inputs="request"
		/>
	</channels>
	<window width="600px">
		<title>
			<en>Update from ETS: project password</en>
			<de>Aus ETS aktualisieren: Projektpasswort</de>
		</title>
		<inset>
			<stack gap="default">
				<text input="reason"/>
				<fields>
					<value-input
						type="tl.core:String"
						value="password"
					>
						<label>
							<en>Project password</en>
							<de>Projektpasswort</de>
						</label>
						<input-control class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
					</value-input>
				</fields>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:fa-solid fa-upload"
					inputs="request, password, project"
				>
					<label>
						<en>Update</en>
						<de>Aktualisieren</de>
					</label>
					<access>
						<!-- As the command of the project overview: the update changes the project. -->
						<operation name="Write"
							object="$project"
							type="ehome.project:Project"
						/>
					</access>
					<executability>
						<null-input-disabled/>
					</executability>
					<!-- Closed first: closing the dialog in the follow-up of its job is refused (TL #30193). -->
					<close-dialog/>
					<start-job
						cancelable="true"
						job="importJob"
						update-interval="200"
					>
						<phases>
							<phase name="read">
								<label>
									<en>Reading</en>
									<de>Lesen</de>
								</label>
							</phase>
							<phase name="import">
								<label>
									<en>Importing</en>
									<de>Importieren</de>
								</label>
							</phase>
							<phase name="save">
								<label>
									<en>Saving</en>
									<de>Speichern</de>
								</label>
							</phase>
						</phases>
						<body class="de.haumacher.ehome.etsImport.UpdateFromEtsJob"/>
						<with-result as="report">
							<!-- The report says how the job ended; its progress display is cleared. -->
							<write-channel name="importJob" clear="true"/>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/import-report.view.xml"
							/>
						</with-result>
					</start-job>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
