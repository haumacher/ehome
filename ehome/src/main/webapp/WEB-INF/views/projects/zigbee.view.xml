<?xml version="1.0" encoding="utf-8" ?>

<!--
	The Zigbee devices of a project (haumacher/ehome #40, de.haumacher.ehome.zigbee): what the
	project's HomeControl controller paired and interviewed in the field, named and placed here, their
	functions bound to datapoints of the project, which the runtime image carries as Zigbee bindings.

	Two ways to get the devices in, both the same import, idempotent by the IEEE address
	(ZigbeeImport): "Import Zigbee devices" takes the file the controller's Zigbee page downloads
	(homecontrol spec/zigbee.md "Export"); "Read Zigbee devices" reads the same export from the
	project's controller (GET /api/zigbee/export). "Open network for pairing" opens the controller's
	network for 254 s (POST /api/zigbee/permit), "Close network" closes it; the user puts the device
	into pairing mode and reads the devices afterwards. Refusals of the controller show as errors.

	A function of the selected device gets a new datapoint with "Create datapoint" (an application
	datapoint bound to it, its id derived from the device's name and the function), or an existing
	unbound datapoint of a fitting type with "Bind datapoint" (projects/zigbee-bind.view.xml);
	"Unbind" keeps the datapoint as a value of the application. The datapoints themselves are edited
	with the application datapoints (application-datapoints.view.xml, the rules' tab); whether the
	bindings are valid is checked with the image (Deployment tab).

	Live (haumacher/ehome #64, ZigbeeLive): while the project's controller is connected to E-Home, its
	zigbee events (a device joined, interviewed, failed, left, removed, changed, the network changed)
	read the export again, debounced, with the same import as "Read Zigbee devices". Above the table,
	the network of the controller (PAN ID, channel, joining open with the seconds left, or closed),
	when the devices were last read (live or on request) and, in red, why the last live import failed.
	The column "Status" shows what the events tell of each device (interviewing, interview failed, left
	the network), else whether its interview finished. The source of "refresh" (ZigbeeSource) publishes
	on every change of the live state, taken at most once a second, and once a second while the
	network is open for joining; the texts and the table are computed again from it.
	"Remove absent functions" deletes the functions of the selected device the controller no longer
	exports that no datapoint is bound to and names the bound ones it keeps.

	Reporting (haumacher/ehome #64, ZigbeeReporting): the column "Reports" and the form below the
	functions show what the controller does with a function's reporting (the effective values of its
	last export, else the defaults of its function table); the form edits the installer's override
	(minimum and maximum interval, reportable change in the function's unit), which the runtime image
	carries as the binding's reporting, refused when saved as the controller's loader would refuse it.

	Catalog (haumacher/ehome #64, ZigbeeCatalog, zigbee-catalog.view.xml): a device whose manufacturer
	and model the Zigbee catalog knows shows its type (column and field "Type"), its functions the
	catalog's names; functions the catalog hides (a quirk such as a controller endpoint that is no
	button) are left out of the function table by its preset "Visible functions", which the user
	drops to see them. "Create datapoints" on the device creates a datapoint for every function that
	is exported, unbound and not hidden, named, typed and with the reporting the catalog recommends
	(an override the installer set is kept). The match is computed whenever the device is shown, so a
	type added later applies; a device without a type shows the functions by their keys as before.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="device"/>
		<channel name="function"/>
		<source-channel name="refresh"
			update-interval="1000"
		>
			<source class="de.haumacher.ehome.zigbee.ZigbeeSource"
				project="project"
			/>
		</source-channel>
		<derived-channel name="networkState"
			expr="if($project == null, null, zigbeeNetworkState($project, $refresh))"
			inputs="project, refresh"
			observed-types="ehome.runtime:Controller,ehome.project:Project"
		/>
		<derived-channel name="readState"
			expr="if($project == null, null, zigbeeReadState($project, $refresh))"
			inputs="project, refresh"
			observed-types="ehome.runtime:Controller,ehome.project:Project"
		/>
		<derived-channel name="liveProblem"
			expr="if($project == null, null, zigbeeLiveProblem($project, $refresh))"
			inputs="project, refresh"
			observed-types="ehome.runtime:Controller,ehome.project:Project"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="320"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Zigbee devices</en>
						<de>Zigbee-Geräte</de>
					</title>
					<commands>
						<upload-command
							accept=".json,application/json"
							image="css:fa-solid fa-upload"
							inputs="project"
							multiple="false"
							placement="TOOLBAR"
						>
							<label>
								<en>Import Zigbee devices</en>
								<de>Zigbee-Geräte importieren</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<disabled-if expr="$project == null"/>
							</executability>
							<with-transaction>
								<execute-script function="zigbeeImport($project, $file)">
									<inputs>
										<input channel="project"/>
									</inputs>
								</execute-script>
								<with-result>
									<notify
										expr="$result"
										kind="info"
									/>
								</with-result>
							</with-transaction>
						</upload-command>
						<generic-command
							image="css:bi bi-broadcast"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Open network for pairing</en>
								<de>Netz zum Koppeln öffnen</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="deploymentVeto($project)"/>
							</executability>
							<zigbee-permit seconds="254">
								<with-result>
									<notify
										expr="$result"
										kind="info"
									/>
								</with-result>
							</zigbee-permit>
						</generic-command>
						<generic-command
							image="css:bi bi-x-octagon"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Close network</en>
								<de>Netz schließen</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="deploymentVeto($project)"/>
							</executability>
							<zigbee-permit seconds="0">
								<with-result>
									<notify
										expr="$result"
										kind="info"
									/>
								</with-result>
							</zigbee-permit>
						</generic-command>
						<generic-command
							image="css:bi bi-cloud-download"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Read Zigbee devices</en>
								<de>Zigbee-Geräte lesen</de>
							</label>
							<access>
								<operation name="Write"
									object="$project"
									type="ehome.project:Project"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="deploymentVeto($project)"/>
							</executability>
							<read-zigbee-devices>
								<with-result>
									<notify
										expr="$result"
										kind="info"
									/>
								</with-result>
							</read-zigbee-devices>
						</generic-command>
						<generic-command
							image="css:bi bi-plus-square"
							inputs="device"
							placement="TOOLBAR"
						>
							<label>
								<en>Create datapoints</en>
								<de>Datenpunkte anlegen</de>
							</label>
							<access>
								<operation name="Write"
									object="$device"
									type="ehome.zigbee:ZigbeeDevice"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="zigbeeCreateDatapointsVeto($device)"/>
							</executability>
							<with-transaction>
								<execute-script function="zigbeeCreateDatapoints($device)"/>
								<with-result>
									<notify
										expr="$result"
										kind="info"
									/>
								</with-result>
							</with-transaction>
						</generic-command>
						<generic-command
							image="css:bi bi-eraser"
							inputs="device"
							placement="TOOLBAR"
						>
							<label>
								<en>Remove absent functions</en>
								<de>Fehlende Funktionen entfernen</de>
							</label>
							<access>
								<operation name="Write"
									object="$device"
									type="ehome.zigbee:ZigbeeDevice"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="zigbeeRemoveAbsentVeto($device)"/>
							</executability>
							<with-transaction>
								<execute-script function="zigbeeRemoveAbsent($device)"/>
								<with-result>
									<notify
										expr="$result"
										kind="info"
									/>
								</with-result>
							</with-transaction>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="device"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="#('Delete the Zigbee device {0} from the project? Datapoints bound to its functions stay as values of the application. The controller keeps the device.'@en, 'Das Zigbee-Gerät {0} aus dem Projekt löschen? An seine Funktionen gebundene Datenpunkte bleiben als Werte der Anwendung erhalten. Der Controller behält das Gerät.'@de).fill($device.get(`ehome.zigbee:ZigbeeDevice#name`))"/>
							<delete-object/>
							<write-channel name="device" clear="true"/>
						</generic-command>
					</commands>
					<stack>
						<inset>
							<text input="networkState"/>
							<text
								input="readState"
								tone="helper"
								variant="caption"
							/>
							<text
								input="liveProblem"
								tone="error"
							/>
						</inset>
						<table
							observed-types="ehome.zigbee:ZigbeeDevice,ehome.project:Project,ehome.building:BuildingDefinition"
							selection="device"
							types="ehome.zigbee:ZigbeeDevice"
						>
							<inputs>
								<input channel="project"/>
								<input channel="refresh"/>
							</inputs>
							<columns>
								<column attribute="name"/>
								<computed-column name="state"
									type="tl.core:String"
								>
									<label>
										<en>Status</en>
										<de>Status</de>
									</label>
									<value>zigbeeDeviceState($row)</value>
								</computed-column>
								<!-- Where the device is placed, details first (haumacher/ehome #85). -->
								<computed-column name="location"
									type="tl.core:String"
									width="200"
								>
									<label>
										<en>Location</en>
										<de>Standort</de>
									</label>
									<value>buildingPath($row.get(`ehome.zigbee:ZigbeeDevice#location`))</value>
								</computed-column>
								<column attribute="deviceType"/>
								<column attribute="manufacturer"/>
								<column attribute="model"/>
								<column attribute="ieee"/>
							</columns>
							<rows>if($project == null, [], $project.get(`ehome.project:Project#zigbeeDevices`))</rows>
						</table>
					</stack>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="40"
							unit="%"
						>
							<panel>
								<title>
									<en>Zigbee device</en>
									<de>Zigbee-Gerät</de>
								</title>
								<form
									input="device"
									with-inset="true"
								>
									<field attribute="name"/>
									<field attribute="location"/>
									<field attribute="deviceType"
										readonly="true"
									/>
									<field attribute="label"
										readonly="true"
									/>
									<field attribute="manufacturer"
										readonly="true"
									/>
									<field attribute="model"
										readonly="true"
									/>
									<field attribute="ieee"
										readonly="true"
									/>
									<field attribute="interviewed"
										readonly="true"
									/>
									<field attribute="controllerName"
										readonly="true"
									/>
								</form>
							</panel>
						</pane>
						<pane
							size="60"
							unit="%"
						>
							<tab-bar active-tab="functions">
								<tabs>
									<tab id="functions"
										icon="css:bi bi-sliders"
									>
										<label>
											<en>Functions</en>
											<de>Funktionen</de>
										</label>
										<panel>
											<title>
												<en>Functions</en>
												<de>Funktionen</de>
											</title>
											<commands>
												<generic-command
													image="css:bi bi-plus-lg"
													inputs="function"
													placement="TOOLBAR"
												>
													<label>
														<en>Create datapoint</en>
														<de>Datenpunkt anlegen</de>
													</label>
													<access>
														<operation name="Write"
															object="$function"
															type="ehome.zigbee:ZigbeeFunction"
														/>
													</access>
													<executability>
														<null-input-disabled/>
														<disabled-if expr="zigbeeBindVeto($function)"/>
													</executability>
													<with-transaction>
														<execute-script function="zigbeeCreateDatapoint($function)"/>
														<with-result>
															<notify
																expr="#('Datapoint {0} created.'@en, 'Datenpunkt {0} angelegt.'@de).fill($result.get(`ehome.runtime:ApplicationDatapoint#identifier`))"
																kind="info"
															/>
														</with-result>
													</with-transaction>
												</generic-command>
												<generic-command
													image="css:bi bi-link-45deg"
													inputs="function"
													placement="TOOLBAR"
												>
													<label>
														<en>Bind datapoint</en>
														<de>Datenpunkt binden</de>
													</label>
													<access>
														<operation name="Write"
															object="$function"
															type="ehome.zigbee:ZigbeeFunction"
														/>
													</access>
													<executability>
														<null-input-disabled/>
														<disabled-if expr="zigbeeBindVeto($function)"/>
													</executability>
													<open-dialog
														bind-input-to="function"
														dialog-view="projects/zigbee-bind.view.xml"
													/>
												</generic-command>
												<generic-command
													image="css:bi bi-x-lg"
													inputs="function"
													placement="TOOLBAR"
												>
													<label>
														<en>Unbind</en>
														<de>Bindung lösen</de>
													</label>
													<access>
														<operation name="Write"
															object="$function"
															type="ehome.zigbee:ZigbeeFunction"
														/>
													</access>
													<executability>
														<null-input-disabled/>
														<disabled-if expr="zigbeeUnbindVeto($function)"/>
													</executability>
													<with-transaction>
														<execute-script function="zigbeeUnbind($function)"/>
													</with-transaction>
												</generic-command>
											</commands>
											<split-panel
												orientation="vertical"
												resizable="true"
											>
												<panes>
													<pane
														size="55"
														unit="%"
													>
														<table
															observed-types="ehome.zigbee:ZigbeeFunction,ehome.zigbee:ZigbeeDevice,ehome.runtime:ApplicationDatapoint,ehome.zigbee.catalog:ZigbeeFunctionEntry"
															selection="function"
															types="ehome.zigbee:ZigbeeFunction"
														>
															<presets initial="visible">
																<preset name="visible">
																	<label>
																		<en>Visible functions</en>
																		<de>Sichtbare Funktionen</de>
																	</label>
																	<criterion
																		column="hidden"
																		expr="false"
																	/>
																</preset>
															</presets>
															<inputs>
																<input channel="device"/>
															</inputs>
															<columns>
																<computed-column name="label"
																	type="tl.core:String"
																>
																	<label>
																		<en>Function</en>
																		<de>Funktion</de>
																	</label>
																	<value>zigbeeFunctionLabel($row)</value>
																</computed-column>
																<column attribute="endpoint"/>
																<column attribute="valueType"/>
																<column attribute="unit"/>
																<column attribute="writable"/>
																<column attribute="datapoints"/>
																<column attribute="reportingSummary"/>
																<column attribute="cluster"/>
																<column attribute="attribute"/>
																<column attribute="absent"/>
																<column attribute="hidden"/>
																<column attribute="function">
																	<label>
																		<en>Key</en>
																		<de>Schlüssel</de>
																	</label>
																</column>
															</columns>
															<rows>if($device == null, [], $device.get(`ehome.zigbee:ZigbeeDevice#functions`))</rows>
														</table>
													</pane>
													<pane
														size="45"
														unit="%"
													>
														<!--
															The reporting of the selected function (haumacher/ehome #64): what the
															controller does (from its last export, else the defaults of its function
															table) and the installer's override, which the image carries as the
															binding's reporting. ReportingConstraint refuses what the controller's
															loader would refuse, with its reason.
														-->
														<panel>
															<title>
																<en>Reporting</en>
																<de>Berichte</de>
															</title>
															<form
																input="function"
																with-inset="true"
															>
																<field attribute="displayName"/>
																<field attribute="reportingSummary"/>
																<group>
																	<label>
																		<en>Reporting override</en>
																		<de>Vorgabe für die Berichte</de>
																	</label>
																	<field attribute="reportingMin"/>
																	<field attribute="reportingMax"/>
																	<field attribute="reportingChange"/>
																	<field attribute="unit"
																		readonly="true"
																	/>
																</group>
																<group>
																	<label>
																		<en>Reported by the controller</en>
																		<de>Vom Controller gemeldet</de>
																	</label>
																	<field attribute="reportedMin"
																		readonly="true"
																	/>
																	<field attribute="reportedMax"
																		readonly="true"
																	/>
																	<field attribute="reportedChange"
																		readonly="true"
																	/>
																</group>
															</form>
														</panel>
													</pane>
												</panes>
											</split-panel>
										</panel>
									</tab>
									<tab id="endpoints"
										icon="css:bi bi-diagram-2"
									>
										<label>
											<en>Endpoints</en>
											<de>Endpunkte</de>
										</label>
										<table
											observed-types="ehome.zigbee:ZigbeeEndpoint,ehome.zigbee:ZigbeeDevice"
											types="ehome.zigbee:ZigbeeEndpoint"
										>
											<inputs>
												<input channel="device"/>
											</inputs>
											<columns>
												<column attribute="endpoint"/>
												<column attribute="profile"/>
												<column attribute="deviceType"/>
												<column attribute="inputClusters"/>
												<column attribute="outputClusters"/>
												<column attribute="zoneType"/>
											</columns>
											<rows>if($device == null, [], $device.get(`ehome.zigbee:ZigbeeDevice#endpoints`))</rows>
										</table>
									</tab>
								</tabs>
							</tab-bar>
						</pane>
					</panes>
				</split-panel>
			</pane>
		</panes>
	</split-panel>
</view>
