<?xml version="1.0" encoding="utf-8" ?>

<!--
	The catalog of known Zigbee devices (haumacher/ehome #64, de.haumacher.ehome.zigbee.ZigbeeCatalog):
	shared master data saying what a device of a manufacturer and model is ("Hue Bewegungsmelder") and,
	per function of the device (endpoint and the controller's function key), its name for the
	installer, the datapoint type and unit recommended for it, whether it is hidden (a quirk of the
	device that means nothing to the installer) and the reporting recommended for it. The tab
	"Zigbee" of a project shows a device by its type and creates the recommended datapoints with one
	click (projects/zigbee.view.xml).

	The table lists the device types; the form edits the selected one with its functions (a
	composition table: rows are added and removed in edit mode). The model refuses what does not fit
	when it is saved: a second type of the same manufacturer and model, a function listed twice, a
	datapoint type that does not fit the function's value type (CatalogTypeConstraint), a reporting
	recommendation the controller would refuse (ReportingConstraint).

	"Import" reads a catalog file (ZigbeeCatalogJson, doc/zigbee.md "Catalog"): a type unknown by
	manufacturer and model is created, a known one takes the file's content. "Export" writes the
	selected type, "Export all" every type, as such a file. E-Home ships the device types it has real
	data for (WEB-INF/zigbee-catalog/*.json, loaded once per database, ZigbeeCatalogSeed).
-->
<view>
	<channels>
		<channel name="selected"/>
		<derived-channel name="catalog"
			expr="x -> `ehome.zigbee.catalog#ROOT`"
			inputs="selected"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="320"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Zigbee device types</en>
						<de>Zigbee-Gerätetypen</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-plus-lg"
							input="catalog"
							placement="TOOLBAR"
						>
							<label>
								<en>New device type</en>
								<de>Neuer Gerätetyp</de>
							</label>
							<executability>
								<model-access operation="Write"/>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.zigbee.catalog:ZigbeeDeviceType"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="zigbee-catalog/create-type.view.xml"
							>
								<bind
									channel="catalog"
									to="catalog"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<upload-command
							accept=".json,application/json"
							image="css:fa-solid fa-upload"
							input="catalog"
							multiple="false"
							placement="TOOLBAR"
						>
							<label>
								<en>Import</en>
								<de>Importieren</de>
							</label>
							<executability>
								<!-- The import is Java, which the model access check does not cover. -->
								<model-access operation="Write"/>
								<null-input-disabled/>
							</executability>
							<with-transaction>
								<execute-script function="c -> file -> zigbeeCatalogImport($c, $file)">
									<inputs>
										<input channel="catalog"/>
									</inputs>
								</execute-script>
							</with-transaction>
							<notify
								expr="t -> $t"
								kind="info"
							/>
						</upload-command>
						<generic-command
							image="css:fa-solid fa-download"
							input="selected"
							placement="TOOLBAR"
						>
							<label>
								<en>Export</en>
								<de>Exportieren</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="t -> zigbeeCatalogExport($t)"/>
							<open-dialog
								bind-input-to="file"
								dialog-view="zigbee-catalog/export.view.xml"
							/>
						</generic-command>
						<generic-command
							image="css:bi bi-box-arrow-down"
							input="catalog"
							placement="TOOLBAR"
						>
							<label>
								<en>Export all</en>
								<de>Alle exportieren</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="c -> zigbeeCatalogExport($c.get(`ehome.zigbee.catalog:ZigbeeCatalog#types`))"/>
							<open-dialog
								bind-input-to="file"
								dialog-view="zigbee-catalog/export.view.xml"
							/>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							input="selected"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="t -> #('Delete the device type {0}? Devices of its manufacturer and model are shown without a type again; datapoints created from it stay.'@en, 'Den Gerätetyp {0} löschen? Geräte seines Herstellers und Modells werden wieder ohne Typ angezeigt; aus ihm angelegte Datenpunkte bleiben.'@de).fill($t.get(`ehome.zigbee.catalog:ZigbeeDeviceType#name`))"/>
							<delete-object/>
							<write-channel name="selected"/>
						</generic-command>
					</commands>
					<table
						observed-types="ehome.zigbee.catalog:ZigbeeDeviceType,ehome.zigbee.catalog:ZigbeeCatalog"
						selection="selected"
						types="ehome.zigbee.catalog:ZigbeeDeviceType"
					>
						<inputs>
							<input channel="catalog"/>
						</inputs>
						<columns>
							<column attribute="name"/>
							<column attribute="manufacturer"/>
							<column attribute="model"/>
						</columns>
						<rows>c -> if($c == null, [], $c.get(`ehome.zigbee.catalog:ZigbeeCatalog#types`))</rows>
					</table>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<panel>
					<title>
						<en>Device type</en>
						<de>Gerätetyp</de>
					</title>
					<form
						input="selected"
						with-inset="true"
					>
						<field attribute="name"/>
						<field attribute="manufacturer"/>
						<field attribute="model"/>
						<field attribute="description"/>
						<composition-table attribute="functions">
							<columns>
								<column attribute="endpoint"/>
								<column attribute="function"/>
								<column attribute="name"/>
								<column attribute="type"/>
								<column attribute="unit"/>
								<column attribute="hidden"/>
								<column attribute="reportingMin"/>
								<column attribute="reportingMax"/>
								<column attribute="reportingChange"/>
							</columns>
						</composition-table>
					</form>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
