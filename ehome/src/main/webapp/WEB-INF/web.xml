  xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
  version="3.0"
>
    <display-name>E-Home</display-name>

	<!-- The WebSocket endpoints registered by the WebSocketEndpointListener (see the listener section). -->
	<context-param>
		<param-name>websocket.endpoints</param-name>
		<param-value>de.haumacher.ehome.connection.ControllerSocket</param-value>
	</context-param>
    
