<!-- Optional login servlet which logs on the user via HTTP basic authentication -->
<!-- 
    <servlet>
        <servlet-name>BasicAuth</servlet-name>
        <servlet-class>com.top_logic.base.accesscontrol.BasicAuthenticationServlet</servlet-class>
    </servlet>
 -->

	<!--
		The E-Home connection of HomeControl controllers (haumacher/ehome #54): the open enrollment
		(POST /api/controllers/enroll) and the answer to a request for the socket that is no WebSocket
		upgrade (the socket itself is ControllerSocket, see above; doc/controllers.md).
	-->
	<servlet>
		<servlet-name>ControllerServlet</servlet-name>
		<servlet-class>de.haumacher.ehome.connection.ControllerServlet</servlet-class>
	</servlet>

<!-- ======================================================================= -->
<!--  Custom servlet mappings                                                -->
<!-- ======================================================================= -->

	<servlet-mapping>
		<servlet-name>ControllerServlet</servlet-name>
		<url-pattern>/api/controllers/*</url-pattern>
	</servlet-mapping>

