<!-- ======================================================================= -->
<!--  Listener section                                                       -->
<!-- ======================================================================= -->

    <listener>
         <listener-class>com.top_logic.element.ElementStartStop</listener-class>
    </listener>

	<!--
		The WebSocket of HomeControl controllers (/api/controllers/{id}/socket, haumacher/ehome #54),
		registered with the container's Jakarta WebSocket implementation (doc/controllers.md) by the
		engine's listener: the endpoint classes of the context parameter websocket.endpoints.
	-->
	<listener>
		<listener-class>com.top_logic.util.WebSocketEndpointListener</listener-class>
	</listener>

	<!--
		The Zigbee devices of the projects follow their connected controllers (haumacher/ehome #64):
		the controllers' zigbee events re-read the export (de.haumacher.ehome.zigbee.ZigbeeLive).
	-->
	<listener>
		<listener-class>de.haumacher.ehome.zigbee.ZigbeeLiveRegistration</listener-class>
	</listener>

<!-- ======================================================================= -->
<!--  Custom servlet definitions                                             -->
<!-- ======================================================================= -->

	<!-- Allow installing new web services at runtime. -->
