# Settings of E-Home (lines name=value). After a change: dpkg-reconfigure ehome
# The app is deployed again with them; Tomcat and its other applications keep running.
# The generated passwords (h2_passwd, tl_initial_password) are in /etc/ehome/secrets.env;
# a name set here wins over that file.

# The data: H2 database and documents (the log is /var/log/ehome/ehome.log).
tl_storage_path=/var/lib/ehome
h2_name=/var/lib/ehome/h2;DB_CLOSE_ON_EXIT=FALSE

# The public address the users open in the browser (the nginx in front of Tomcat). Needed for
# passkeys, which are bound to its host: changing the host invalidates every registered passkey.
# Default: none (no passkeys).
#tl_host=https://ehome.example.org

# The API key of Anthropic for the assistant (console.anthropic.com), billed to its account.
# Default: none (the chat says the key is missing).
#tl_anthropic_api_key=sk-ant-...

# The models of the assistant, comma separated, the default first; and the model it runs on.
#tl_anthropic_models=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
#tl_ai_default_model=claude-sonnet-5-5

# Writing to the KNX bus: download, individual address, programming LED. true or false, default false.
#tl_ehome_programming_write_enabled=true

# Reaching the local networks of this server: gateway search and address, controller search,
# controller by host and token. true or false, default true; false on a hosted installation.
#tl_ehome_local_network=false
