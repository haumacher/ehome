<?xml version="1.0" encoding="UTF-8"?>
<!--
	E-Home in Tomcat at the context path /ehome (package ehome): postinst copies it to
	/etc/tomcat10/Catalina/localhost/ehome.xml. The war is unpacked into /var/lib/tomcat10/webapps/ehome;
	the data stay in /var/lib/ehome (/etc/ehome/ehome.env).

	The RemoteIpValve takes the client's address and the scheme from the X-Forwarded-For and
	X-Forwarded-Proto headers of a reverse proxy terminating TLS on this host (doc/controllers.md "TLS is
	operations", the example /usr/share/doc/ehome/nginx-ehome.conf), so that the enrollment's rate limit
	counts the clients, not the proxy. Only a proxy connecting from the loopback interface is trusted;
	from any other address the headers are ignored.
-->
<Context docBase="/usr/share/ehome/ehome.war">
	<Valve className="org.apache.catalina.valves.RemoteIpValve"
		internalProxies="127\.\d{1,3}\.\d{1,3}\.\d{1,3}|0:0:0:0:0:0:0:1"
		remoteIpHeader="X-Forwarded-For"
		protocolHeader="X-Forwarded-Proto"
		hostHeader="X-Forwarded-Host"
	/>
</Context>
