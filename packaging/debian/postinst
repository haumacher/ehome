#!/bin/sh
set -e

# Configures E-Home in the running Tomcat 10 without ever restarting Tomcat (doc/debian.md): other
# applications of the same Tomcat keep running through an installation, an upgrade and a change of
# the settings.
#
# - The settings of /etc/ehome/ehome.env (a conffile) and the generated passwords of
#   /etc/ehome/secrets.env reach the app as JNDI entries of its context descriptor
#   (java:comp/env/tl/<name>, which TopLogic reads before system properties and environment
#   variables): writing the descriptor deploys the app with them, and only the app.
# - tomcat10.service runs with ProtectSystem=strict. The drop-in grants the data directory and the log
#   directory for the next start of Tomcat; a Tomcat that runs already gets them bound into its
#   namespace with "systemctl bind" (systemd >= 248), instead of a restart.
# - The app logs into its own file $LOG_DIR/ehome.log (the log4j2.xml of the war, rolled daily, 14
#   kept), not into Tomcat's journal shared with the other applications.
#
# "dpkg-reconfigure ehome" applies a changed ehome.env: it rewrites the descriptor, and Tomcat deploys
# the app again.

ENV_FILE=/etc/ehome/ehome.env
SECRETS=/etc/ehome/secrets.env
DATA_DIR=/var/lib/ehome
LOG_DIR=/var/log/ehome
CONTEXT_DIR=/etc/tomcat10/Catalina/localhost
CONTEXT=$CONTEXT_DIR/ehome.xml
TEMPLATE=/usr/share/ehome/tomcat/ehome.xml
UPGRADE=$DATA_DIR/.upgrade

# The <Environment> entries for the lines NAME=VALUE of $ENV_FILE and $SECRETS (comments and other
# lines are skipped). A name of $ENV_FILE wins over $SECRETS; in one file the last line of a name wins.
environment_entries() {
	files=
	for file in "$ENV_FILE" "$SECRETS"; do
		[ -e "$file" ] && files="$files $file"
	done
	[ -n "$files" ] || return 0
	# shellcheck disable=SC2086
	awk -v env="$ENV_FILE" '
		!/^[A-Za-z_][A-Za-z0-9_]*=/ { next }
		{
			name = substr($0, 1, index($0, "=") - 1)
			if (FILENAME != env && (name in fromEnv)) next
			if (FILENAME == env) fromEnv[name] = 1
			if (!(name in value)) order[++count] = name
			value[name] = substr($0, index($0, "=") + 1)
		}
		END {
			for (i = 1; i <= count; i++) {
				v = value[order[i]]
				gsub(/&/, "\\&amp;", v); gsub(/</, "\\&lt;", v); gsub(/>/, "\\&gt;", v); gsub(/"/, "\\&quot;", v)
				printf "\t<Environment name=\"tl/%s\" value=\"%s\" type=\"java.lang.String\" override=\"false\"/>\n", order[i], v
			}
		}
	' $files
}

# Writes the context descriptor: the template with the settings in place of its marker. It holds the
# passwords, so only root and Tomcat read it. It is written beside the directory Tomcat watches and
# moved in, so that Tomcat never deploys a half-written file.
write_context() {
	tmp=/etc/tomcat10/Catalina/.ehome.xml.new
	entries=$(environment_entries)
	umask 077
	while IFS= read -r line || [ -n "$line" ]; do
		if [ "$line" = "	<!-- @SETTINGS@ -->" ]; then
			printf '%s\n' "$entries"
		else
			printf '%s\n' "$line"
		fi
	done < "$TEMPLATE" > "$tmp"
	chown root:tomcat "$tmp"
	chmod 0640 "$tmp"
	mv "$tmp" "$CONTEXT"
}

# The process id of the running Tomcat of the service, empty if it does not run under systemd.
tomcat_pid() {
	if [ -d /run/systemd/system ]; then
		pid=$(systemctl show -p MainPID --value tomcat10 2>/dev/null || true)
		if [ -n "$pid" ] && [ "$pid" != 0 ]; then
			echo "$pid"
		fi
	fi
}

# Whether Tomcat can write the given directory: it does not run under systemd, or the directory is a
# mount point in its namespace (the drop-in's ReadWritePaths at its start, or an earlier bind).
writable() {
	pid=$(tomcat_pid)
	[ -z "$pid" ] && return 0
	awk -v dir="$1" '$5 == dir { found = 1 } END { exit !found }' "/proc/$pid/mountinfo" 2>/dev/null
}

if [ "$1" = "configure" ]; then
	install -d -o tomcat -g tomcat -m 0750 "$DATA_DIR"
	# As Tomcat's own logs: readable by the group adm, the rolled files keep the group.
	install -d -o tomcat -g adm -m 2750 "$LOG_DIR"

	# The generated passwords, once per installation (preinst moved those of an older ehome.env).
	if [ ! -e "$SECRETS" ]; then
		PASSWORD=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 16)
		DB_PASSWORD=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24)
		umask 077
		cat > "$SECRETS.new" <<END
# Generated at the installation of E-Home; a name set in /etc/ehome/ehome.env wins.

# The password of the H2 database, applied when the database is created at the first start.
h2_passwd=$DB_PASSWORD

# The password of the administrator "root", applied only when the database is created at the first
# start. Change it in the application afterwards.
tl_initial_password=$PASSWORD
END
		umask 022
		chown root:tomcat "$SECRETS.new"
		chmod 0640 "$SECRETS.new"
		mv "$SECRETS.new" "$SECRETS"
		echo "E-Home: the initial password of the user root is in $SECRETS." >&2
	fi

	install -d -o root -g tomcat -m 2775 /etc/tomcat10/Catalina "$CONTEXT_DIR"
	if [ -d /run/systemd/system ]; then
		# The drop-in applies from Tomcat's next start; the running one is not restarted.
		systemctl daemon-reload || true
	fi
	blocked=
	for dir in "$DATA_DIR" "$LOG_DIR"; do
		if writable "$dir"; then
			continue
		fi
		if systemctl bind tomcat10 "$dir" 2>/dev/null && writable "$dir"; then
			echo "E-Home: $dir is bound into the running Tomcat (no restart)." >&2
		else
			blocked="$blocked $dir"
		fi
	done
	if [ -n "$blocked" ]; then
		# Without write access the app would fail at its start (or log nowhere): it waits for Tomcat's
		# next start.
		rm -f "$CONTEXT"
		rm -rf "$UPGRADE"
		echo "E-Home: the running Tomcat cannot write$blocked, and this systemd cannot bind it" >&2
		echo "E-Home: into Tomcat (systemctl bind). E-Home is installed but not deployed: restart" >&2
		echo "E-Home: Tomcat when it suits its other applications (systemctl restart tomcat10)," >&2
		echo "E-Home: then run dpkg-reconfigure ehome." >&2
		exit 0
	fi

	# A first installation deploys the app, an upgrade the new version (preinst stopped the old one and
	# backed up the database), dpkg-reconfigure the app with changed settings.
	write_context
	rm -rf "$UPGRADE"
	echo "E-Home: deployed in the running Tomcat; Tomcat was not restarted." >&2
	echo "E-Home: http://localhost:8080/ehome/view/ (the first start takes about a minute)." >&2
	echo "E-Home: its log is $LOG_DIR/ehome.log." >&2
fi

exit 0
