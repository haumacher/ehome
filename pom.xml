<?xml version="1.0"?>
<!--
	The build of E-Home (haumacher/ehome #28): an aggregator of its modules, not their parent (each
	module has the TopLogic parent it needs).

	- ehome: the app (artifact de.haumacher.ehome, war ehome.war, context path ehome).
	- ehome-virtual: the development tooling (artifact de.haumacher.ehome.virtual), a TopLogic web
	  fragment depending on the app: the programmable virtual device and the recorder of ETS downloads.

	The profile "development" (active unless another profile of this POM is chosen) builds both; the
	production build (-Pproduction) builds the app alone. The app module has the same two profiles:
	"development" puts the tooling on the classpath of its exec:java start, "production" leaves it out.
	The deployable war (ehome/target/ehome.war) never contains the tooling.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.top-logic</groupId>
  <artifactId>de.haumacher.ehome.build</artifactId>
  <version>1.1.3</version>
  <packaging>pom</packaging>

  <modules>
    <module>ehome</module>
  </modules>

  <profiles>
    <profile>
      <id>development</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <modules>
        <module>ehome-virtual</module>
      </modules>
    </profile>
    <profile>
      <!-- The app without the development tooling. -->
      <id>production</id>
    </profile>
  </profiles>

  <build>
    <plugins>
      <!-- The aggregator has no sources; the modules check theirs against ../checkstyle.xml. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
