																	<list-linking name="ehome.building:BuildingDefinition#parts"/>
																</linking>

																<property name="extId" xml-attribute="Id"/>
																<property name="name" xml-attribute="Name"/>

																<ref handler-id="building-type"/>
															</object>
														</case>
														<case value="Room">
															<object model-type="ehome.building:Room" id-attribute="Id">
																<linking>
																	<list-linking name="ehome.project:Project#buildings"/>
																	<list-linking name="ehome.building:BuildingDefinition#parts"/>
																</linking>

																<property name="extId" xml-attribute="Id"/>
																<property name="name" xml-attribute="Name"/>

																<ref handler-id="building-type"/>
															</object>
														</case>
														<case value="Corridor">
															<object model-type="ehome.building:Corridor" id-attribute="Id">
																<linking>
																	<list-linking name="ehome.project:Project#buildings"/>
																	<list-linking name="ehome.building:BuildingDefinition#parts"/>
																</linking>

																<property name="extId" xml-attribute="Id"/>
																<property name="name" xml-attribute="Name"/>

																<ref handler-id="building-type"/>
															</object>
														</case>
														<case value="DistributionBoard">
															<object model-type="ehome.building:DistributionBoard" id-attribute="Id">
																<linking>
																	<list-linking name="ehome.project:Project#buildings"/>
																	<list-linking name="ehome.building:BuildingDefinition#parts"/>
																</linking>

																<property name="extId" xml-attribute="Id"/>
																<property name="name" xml-attribute="Name"/>

																<ref handler-id="building-type"/>
															</object>
														</case>
														<default>
															<object model-type="ehome.building:BuildingPart" id-attribute="Id">
																<linking>
																	<list-linking name="ehome.project:Project#buildings"/>
																	<list-linking name="ehome.building:BuildingDefinition#parts"/>
																</linking>

																<property name="extId" xml-attribute="Id"/>
																<property name="name" xml-attribute="Name"/>

																<ref handler-id="building-type"/>
															</object>
														</default>
													</switch>
												</tag>
											</dispatch>
										</tag>
										<tag name="GroupAddresses">
											<dispatch id="group-addresses-type">
												<tag name="GroupRanges">
													<ref handler-id="group-addresses-type"/>
												</tag>
												<tag name="GroupRange">
													<object model-type="ehome.logical:GroupRange" id-attribute="Id">
														<linking>
															<list-linking name="ehome.project:Project#groupAddresses"/>
															<list-linking name="ehome.logical:GroupRange#parts"/>
														</linking>
														
														<property name="extId" xml-attribute="Id"/>
														<property name="name" xml-attribute="Name"/>

														<ref handler-id="group-addresses-type"/>
													</object>
												</tag>
												<tag name="GroupAddress">
													<object model-type="ehome.logical:GroupAddress" id-attribute="Id">
														<linking>
															<list-linking name="ehome.project:Project#groupAddresses"/>
															<list-linking name="ehome.logical:GroupRange#parts"/>
														</linking>
														
														<property name="extId" xml-attribute="Id"/>
														<property name="name" xml-attribute="Name"/>
														<property name="address" xml-attribute="Address" format="com.top_logic.basic.config.format.IntegerWrapperFormat"/>
														<multi-reference name="datapointTypes" id-attribute="DatapointType"/>

														<dispatch/>
													</object>
												</tag>
											</dispatch>
										</tag>
									</dispatch>
								</tag>
							</dispatch>
						</tag>
					</dispatch>
				</object>
			</tag>
		</dispatch>
	</tag>
</handler>
