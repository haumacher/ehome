												<tag name="DeviceInstanceRef">
													<object-ref id-attribute="RefId">
														<linking>
															<ref-linking name="ehome.physical:Device#location" reverse="true"/>
														</linking>
														<dispatch/>
													</object-ref>
												</tag>
												<tag name="BuildingPart">
													<switch xml-attribute="Type">
														<case value="Building">
															<object model-type="ehome.building:Building" id-attribute="Id">
																<linking>
																	<list-linking name="ehome.project:Project#buildings"/>
																	<list-linking name="ehome.building:BuildingDefinition#parts"/>
																</linking>

																<property name="extId" xml-attribute="Id"/>
																<property name="name" xml-attribute="Name"/>

																<ref handler-id="building-type"/>
															</object>
														</case>
														<case value="Floor">
															<object model-type="ehome.building:Floor" id-attribute="Id">
																<linking>
																	<list-linking name="ehome.project:Project#buildings"/>
																	<list-linking name="ehome.building:BuildingDefinition#parts"/>
																</linking>

																<property name="extId" xml-attribute="Id"/>
																<property name="name" xml-attribute="Name"/>

																<ref handler-id="building-type"/>
															</object>
														</case>
														<case value="Stairway">
															<object model-type="ehome.building:Stairway" id-attribute="Id">
																<linking>
