<?xml version="1.0" encoding="utf-8"?>

<!--
	Deployment of runtime images to HomeControl controllers (haumacher/ehome #39, package
	de.haumacher.ehome.runtime): the model of the controllers, deployments and functions, and the
	TL-Script functions of the views controllers.view.xml, projects/deployment.view.xml,
	projects/functions.view.xml and of the runtime settings in the model.
-->
<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance class="com.top_logic.util.resource.analyzer.IDEResources">
				<bundles>
					<bundle name="model.ehome.runtime.messages"/>
				</bundles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/ehome.runtime.model.xml"/>
				</declarations>
			</instance>
		</config>
		<config service-class="com.top_logic.model.search.expr.config.SearchBuilder">
			<instance>
				<methods>
					<!-- The controllers and the runtime image (de.haumacher.ehome.runtime.RuntimeFunctions): one builder, the function by its name. -->
					<method name="controllerTokenHint" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="controllerAddress" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="deploymentVeto" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="nextImageRevision" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<!-- What differs from the image the controller stores, what it runs (haumacher/ehome #47). -->
					<method name="deploymentConfirmation" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="unloadConfirmation" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<!-- Functions and runtime settings (haumacher/ehome #43, #45). -->
					<method name="runtimeGroupAddresses" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="runtimeBuildingParts" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="runtimeIdentifierProblem" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="runtimeTimeZoneProblem" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="runtimeHostNameProblem" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="runtimeTimeMasterProblem" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="runtimeHistoryProblem" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="datapointWritable" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="datapointReadOnStart" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="datapointUnit" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
					<method name="datapointFlagsSource" class="de.haumacher.ehome.runtime.RuntimeFunctions$Builder"/>
				</methods>
			</instance>
		</config>
	</services>
</application>
