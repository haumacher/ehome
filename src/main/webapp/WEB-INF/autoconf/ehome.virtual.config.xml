<?xml version="1.0" encoding="utf-8"?>

<!--
	The virtual device (haumacher/ehome #27, package de.haumacher.ehome.virtual): development tooling that
	a production E-Home does not need. Its service (stopping the virtual interface when the application
	shuts down, the directory of the traces) and its TL-Script functions, used by the views in
	WEB-INF/views/virtual/.
-->
<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance class="com.top_logic.basic.module.ModuleSystem">
				<modules>
					<module key="de.haumacher.ehome.virtual.VirtualInterfaces$Module"
						value="true"
					/>
				</modules>
			</instance>
		</config>

		<config service-class="de.haumacher.ehome.virtual.VirtualInterfaces">
			<instance class="de.haumacher.ehome.virtual.VirtualInterfaces"
				directory="%STORAGE_PATH%/virtual-device"
			/>
		</config>

		<config service-class="com.top_logic.model.search.expr.config.SearchBuilder">
			<instance>
				<methods>
					<!-- The virtual device (de.haumacher.ehome.virtual.VirtualFunctions): one builder, the function by its name. -->
					<method name="virtualStatus" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualRunning" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualStartVeto" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualStart" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualStopVeto" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualStop" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualProgramming" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualProgrammingButton" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualTraces" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualTraceFile" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
					<method name="virtualRules" class="de.haumacher.ehome.virtual.VirtualFunctions$Builder"/>
				</methods>
			</instance>
		</config>
	</services>
</application>
