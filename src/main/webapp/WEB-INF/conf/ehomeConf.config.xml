<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="ehomeMessages" />
				</bundles>
			</instance>
		</config>
		
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
				</declarations>
			</instance>
		</config>

		<config service-class="com.top_logic.model.search.expr.config.SearchBuilder">
			<instance>
				<methods>
					<method name="knxNetworkInterfaces" class="de.haumacher.ehome.discover.KnxNetworkInterfaces$Builder"/>
					<method name="groupRangePrefix" class="de.haumacher.ehome.knx.GroupRangePrefix$Builder"/>
					<method name="encodedParameterValue" class="de.haumacher.ehome.knx.EncodedParameterValue$Builder"/>
					<method name="parameterValueType" class="de.haumacher.ehome.knx.ParameterValueType$Builder"/>
					<method name="matchesPattern" class="de.haumacher.ehome.knx.MatchesPattern$Builder"/>
				</methods>
			</instance>
		</config>

		<!-- Group addresses (model type ehome.logical:GA) are written in the notation they carry. -->
		<config service-class="com.top_logic.layout.provider.LabelProviderService">
			<instance>
				<label-providers>
					<provider kind="CODE" type="de.haumacher.ehome.knx.GA" implementation="de.haumacher.ehome.knx.GALabelProvider"/>
				</label-providers>
			</instance>
		</config>

		<!-- Animations of the React UI's dialog and drill-down transitions (see the stylesheet). -->
		<config service-class="com.top_logic.layout.react.resource.ClientResources">
			<instance class="com.top_logic.layout.react.resource.ClientResources">
				<resources>
					<stylesheet name="ehome-css"
						requires="tl-react-controls-css"
						resource="/style/ehome.css"
					/>
				</resources>
			</instance>
		</config>

		<!-- The create commands of the structure trees, one per node type, folded into a menu. -->
		<config service-class="com.top_logic.layout.view.command.CommandCliqueService">
			<instance>
				<cliques>
					<clique name="new"
						config:position="before"
						config:reference="create"
						display="menu"
						icon="css:bi bi-plus-lg"
					>
						<label>
							<en>New</en>
							<de>Neu</de>
						</label>
					</clique>
				</cliques>
			</instance>
		</config>
	</services>

	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default">
					<declarations>
						<declaration resource="webinf://kbase/EHomeMeta.xml" />
					</declarations>
				</type-system>
			</type-systems>
		</config>
	</configs>
</application>
