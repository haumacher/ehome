<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="ehomeMessages" />
				</bundles>
			</instance>
		</config>
		
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
				</declarations>
			</instance>
		</config>

		<config service-class="com.top_logic.model.search.expr.config.SearchBuilder">
			<instance>
				<methods>
					<method name="knxNetworkInterfaces" class="de.haumacher.ehome.discover.KnxNetworkInterfaces$Builder"/>
					<method name="groupRangePrefix" class="de.haumacher.ehome.knx.GroupRangePrefix$Builder"/>
					<method name="encodedParameterValue" class="de.haumacher.ehome.knx.EncodedParameterValue$Builder"/>
					<method name="parameterValueType" class="de.haumacher.ehome.knx.ParameterValueType$Builder"/>
					<method name="matchesPattern" class="de.haumacher.ehome.knx.MatchesPattern$Builder"/>
					<!-- Editing an application program (de.haumacher.ehome.knx.ProgramStructure): one builder per function. -->
					<method name="structureCanInsert" class="de.haumacher.ehome.knx.EhomeFunctions$StructureCanInsert$Builder"/>
					<method name="structureInsertVeto" class="de.haumacher.ehome.knx.EhomeFunctions$StructureInsertVeto$Builder"/>
					<method name="structureInsert" class="de.haumacher.ehome.knx.EhomeFunctions$StructureInsert$Builder"/>
					<method name="structureMoveVeto" class="de.haumacher.ehome.knx.EhomeFunctions$StructureMoveVeto$Builder"/>
					<method name="structureMove" class="de.haumacher.ehome.knx.EhomeFunctions$StructureMove$Builder"/>
					<method name="programDeleteVeto" class="de.haumacher.ehome.knx.EhomeFunctions$ProgramDeleteVeto$Builder"/>
					<method name="programDelete" class="de.haumacher.ehome.knx.EhomeFunctions$ProgramDelete$Builder"/>
					<!-- The parameters and communication objects of a program by the page they are placed on (de.haumacher.ehome.knx.ProgramPages): one builder, the function by its name. -->
					<method name="programParameterRows" class="de.haumacher.ehome.knx.ProgramPageFunctions$Builder"/>
					<method name="programPortRows" class="de.haumacher.ehome.knx.ProgramPageFunctions$Builder"/>
					<method name="programRowOf" class="de.haumacher.ehome.knx.ProgramPageFunctions$Builder"/>
					<!-- The configuration of a device (de.haumacher.ehome.programming.DeviceConfiguration, DeviceSettings): one builder, the function by its name. -->
					<method name="deviceValue" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceValueHolder" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceSetting" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceEditVeto" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceSetValue" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceApplyValue" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceResetSetting" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="devicePages" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceParentPage" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceItems" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceSelectedCases" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceInterfaces" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceConnections" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceDefaultConnectionKind" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceGroupAddresses" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceConnect" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<method name="deviceDisconnect" class="de.haumacher.ehome.programming.DeviceFunctions$Builder"/>
					<!-- The changes of a device since its last download (de.haumacher.ehome.programming.DeviceChangeFunctions): one builder, the function by its name. -->
					<method name="deviceHasReference" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceChangeReferences" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceChangeReference" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceChangeCount" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceChangeGroups" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceChanged" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceChangedPages" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceReferenceHint" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceResetToReference" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceDiscardVeto" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceDiscardConfirmation" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="deviceDiscardChanges" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="projectDiscardVeto" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="projectDiscardConfirmation" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<method name="projectDiscardChanges" class="de.haumacher.ehome.programming.DeviceChangeFunctions$Builder"/>
					<!-- The connections of a group address seen from the address (de.haumacher.ehome.programming.GroupAddressConnections): one builder, the function by its name. -->
					<method name="groupAddressConnections" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="groupAddressSenders" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="groupAddressProblems" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="groupAddressDevices" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="connectionLabel" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="connectionDevice" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="connectionObject" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="connectionFunction" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="connectionDatapointType" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="deviceLabel" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="deviceObjects" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<method name="existingObject" class="de.haumacher.ehome.programming.GroupAddressFunctions$Builder"/>
					<!-- The programming of a device (de.haumacher.ehome.programming.download.ProgrammingFunctions): one builder, the function by its name. -->
					<method name="downloadPlanRows" class="de.haumacher.ehome.programming.download.ProgrammingFunctions$Builder"/>
					<method name="downloadSummary" class="de.haumacher.ehome.programming.download.ProgrammingFunctions$Builder"/>
					<method name="downloadProblems" class="de.haumacher.ehome.programming.download.ProgrammingFunctions$Builder"/>
					<method name="downloadImageDump" class="de.haumacher.ehome.programming.download.ProgrammingFunctions$Builder"/>
					<method name="downloadVeto" class="de.haumacher.ehome.programming.download.ProgrammingFunctions$Builder"/>
					<method name="addressVeto" class="de.haumacher.ehome.programming.download.ProgrammingFunctions$Builder"/>
					<method name="compareVeto" class="de.haumacher.ehome.programming.download.ProgrammingFunctions$Builder"/>
					<method name="downloadConfirmation" class="de.haumacher.ehome.programming.download.ProgrammingFunctions$Builder"/>
					<method name="addressConfirmation" class="de.haumacher.ehome.programming.download.ProgrammingFunctions$Builder"/>
				</methods>
			</instance>
		</config>

		<!-- Group addresses (model type ehome.logical:GA) are written in the notation they carry. -->
		<config service-class="com.top_logic.layout.provider.LabelProviderService">
			<instance>
				<label-providers>
					<provider kind="CODE" type="de.haumacher.ehome.knx.GA" implementation="de.haumacher.ehome.knx.GALabelProvider"/>
				</label-providers>
			</instance>
		</config>

		<!-- Animations of the React UI's dialog and drill-down transitions (see the stylesheet). -->
		<config service-class="com.top_logic.layout.react.resource.ClientResources">
			<instance class="com.top_logic.layout.react.resource.ClientResources">
				<resources>
					<stylesheet name="ehome-css"
						requires="tl-react-controls-css"
						resource="/style/ehome.css"
					/>
				</resources>
			</instance>
		</config>

		<!-- The create commands of the structure trees, one per node type, folded into a menu. -->
		<config service-class="com.top_logic.layout.view.command.CommandCliqueService">
			<instance>
				<cliques>
					<clique name="new"
						config:position="before"
						config:reference="create"
						display="menu"
						icon="css:bi bi-plus-lg"
					>
						<label>
							<en>New</en>
							<de>Neu</de>
						</label>
					</clique>
				</cliques>
			</instance>
		</config>
	</services>

	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default">
					<declarations>
						<declaration resource="webinf://kbase/EHomeMeta.xml" />
					</declarations>
				</type-system>
			</type-systems>
		</config>
	</configs>
</application>
