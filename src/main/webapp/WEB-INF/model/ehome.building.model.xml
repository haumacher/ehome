<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.building">
		<interface name="BuildingDefinition">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<reference name="parts"
					composite="true"
					kind="forwards"
					multiple="true"
					type="BuildingDefinition"
				/>
				<!-- The devices placed in this part (ehome.physical:Device#location), not those of its sub-parts. -->
				<reference name="devices"
					inverse-reference="location"
					kind="backwards"
					multiple="true"
					type="ehome.physical:Device"
				/>
			</attributes>
		</interface>
		<class name="Building">
			<generalizations>
				<generalization type="BuildingDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHBuilding"/>
				<instance-presentation icon="css:fa-solid fa-building"/>
			</annotations>
		</class>
		<class name="BuildingPart">
			<generalizations>
				<generalization type="BuildingDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHBuilding"/>
				<instance-presentation icon="css:fa-solid fa-cube"/>
			</annotations>
		</class>
		<class name="Corridor">
			<generalizations>
				<generalization type="BuildingDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHBuilding"/>
				<instance-presentation icon="css:fa-solid fa-person-running"/>
			</annotations>
		</class>
		<class name="DistributionBoard">
			<generalizations>
				<generalization type="BuildingDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHBuilding"/>
				<instance-presentation icon="css:fa-solid fa-bolt-lightning"/>
			</annotations>
		</class>
		<class name="Floor">
			<generalizations>
				<generalization type="BuildingDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHBuilding"/>
				<instance-presentation icon="css:fa-solid fa-elevator"/>
			</annotations>
		</class>
		<class name="Location">
			<generalizations>
				<generalization type="BuildingDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHBuilding"/>
				<instance-presentation icon="css:fa-solid fa-location-dot"/>
			</annotations>
		</class>
		<class name="Room">
			<generalizations>
				<generalization type="BuildingDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHBuilding"/>
				<instance-presentation icon="css:fa-solid fa-door-closed"/>
			</annotations>
		</class>
		<class name="Stairway">
			<generalizations>
				<generalization type="BuildingDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHBuilding"/>
				<instance-presentation icon="css:fa-solid fa-stairs"/>
			</annotations>
		</class>
	</module>
</model>