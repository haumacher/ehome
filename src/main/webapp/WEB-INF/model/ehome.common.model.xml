<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.common">
		<enum name="Enablement">
			<classifier name="Disabled"/>
			<classifier name="Enabled"/>
		</enum>
		<!-- The transmission medium of a KNX bus (ETS: MediumType, MT-0 to MT-6). -->
		<enum name="Medium">
			<classifier name="TP"/>
			<classifier name="PL"/>
			<classifier name="RF"/>
			<classifier name="IP"/>
			<!-- KNX IoT (MT-6, ETS 6). -->
			<classifier name="IoT"/>
		</enum>
	</module>
</model>