<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.logical">
		<!--
			A KNX group address. The database stores the plain 16-bit number; the application sees a
			de.haumacher.ehome.knx.GA that carries the notation of its project (see GroupAddressStyle),
			so the address is written the same way in every form, table and label. An attribute of
			this type states where its notation comes from with a <ga-style> annotation; without one,
			addresses are written main/middle/sub.
		-->
		<datatype name="GA"
			db_type="int"
			kind="Custom"
		>
			<annotations>
				<storage-algorithm>
					<group-address-storage/>
				</storage-algorithm>
				<input-control>
					<impl class="de.haumacher.ehome.knx.GAControlProvider"/>
				</input-control>
			</annotations>
			<group-address-mapping/>
		</datatype>
		<!-- The notations of group addresses ETS offers, named like ETS names them. -->
		<enum name="GroupAddressStyle">
			<classifier name="ThreeLevel" default="true"/>
			<classifier name="TwoLevel"/>
			<classifier name="Free"/>
		</enum>
		<interface name="GroupAddressDefinition">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.core:Text"
				/>
				<!-- Couplers pass the telegrams to these addresses without filtering. -->
				<property name="unfiltered"
					type="tl.core:Boolean"
				/>
			</attributes>
		</interface>
		<!--
			A datapoint of the project in the runtime image (haumacher/ehome #61): a group address or an
			application datapoint (ehome.runtime:ApplicationDatapoint), what a role of a function refers
			to. The runtime image binds the role to the id of the datapoint either way.
		-->
		<interface name="ProjectDatapoint">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
		</interface>
		<class name="GroupAddress">
			<generalizations>
				<generalization type="GroupAddressDefinition"/>
				<generalization type="ProjectDatapoint"/>
			</generalizations>
			<annotations>
				<table name="EHGroupAddress"/>
				<instance-presentation icon="css:fa-solid fa-at"/>
				<id-column value="displayName"/>
			</annotations>
			<attributes>
				<property name="address"
					type="GA"
				>
					<annotations>
						<!-- The notation chosen by the project the address belongs to. -->
						<ga-style>
							<style><![CDATA[ga -> recursion($ga, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.project:Project`))
    .firstElement()
    .get(`ehome.project:Project#groupAddressStyle`)]]></style>
						</ga-style>
						<constraints>
							<constraint class="de.haumacher.ehome.knx.WithinGroupRange"/>
						</constraints>
					</annotations>
				</property>
				<!-- An address of a central function (e.g. all off), which couplers treat specially. -->
				<property name="central"
					type="tl.core:Boolean"
				/>
				<!-- The label ETS lists the address with: address and name. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[ga -> {
    address = $ga.get(`ehome.logical:GroupAddress#address`);
    name = $ga.get(`ehome.logical:GroupAddressDefinition#name`);
    if($address == null, $name, "{0} {1}".fill($address, $name))
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<reference name="datapointTypes"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.datapoint:DatapointType"
				/>
				<!--
					The datapoint type of the values sent to this address: its own one if set in the
					project or by the user, otherwise the one of the first communication object connected
					to it, otherwise the main type the size of the objects decides (1 bit, 4 bits). The
					rule is the one of the runtime image and the group monitor
					(de.haumacher.ehome.programming.GroupAddressTypes); empty for an untyped address.
				-->
				<reference name="effectiveDatapointType"
					kind="forwards"
					type="ehome.datapoint:DatapointType"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[ga -> groupAddressEffectiveType($ga)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
				<!--
					The runtime settings of the address's datapoint in the runtime image of a HomeControl
					controller (haumacher/ehome #45). Writable and read on start are derived from the flags of
					the connected objects (an actuator input makes the datapoint writable, a status answering
					reads makes it read on start); set, they override the derivation.
				-->
				<!-- Whether rules, the user interface and the API may command the datapoint; empty: derived from the connected objects. -->
				<property name="runtimeWritable"
					type="tl.core:Tristate"
				/>
				<!-- Whether the controller reads the value after a start or reconnect; empty: derived from the connected objects. -->
				<property name="runtimeReadOnStart"
					type="tl.core:Tristate"
				/>
				<!-- Whether the controller answers a read of the address with the datapoint's value. -->
				<property name="runtimeReadable"
					type="tl.core:Boolean"
				/>
				<!-- Whether the controller keeps the last value across restarts. -->
				<property name="runtimePersist"
					type="tl.core:Boolean"
				/>
				<!-- How long the controller keeps the history of the value, in seconds (with the spacing; numbers and truth values only). -->
				<property name="historyRetention"
					type="tl.core:Integer"
				>
					<annotations>
						<format>
							<decimal pattern="0" result-type="long"/>
						</format>
						<value-range
							max="2678400"
							min="10"
						/>
					</annotations>
				</property>
				<!-- The time between two samples of the history in seconds (10 to 86400). -->
				<property name="historySpacing"
					type="tl.core:Integer"
				>
					<annotations>
						<format>
							<decimal pattern="0" result-type="long"/>
						</format>
						<value-range
							max="86400"
							min="10"
						/>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> runtimeHistoryProblem($obj)]]></check>
							</constraint-by-expression>
						</constraints>
					</annotations>
				</property>
				<!-- The unit the controller shows (at most 15 bytes); empty: the unit of the datapoint type. -->
				<property name="runtimeUnit"
					type="tl.core:String"
				/>
				<!-- Whether the datapoint is writable in the runtime image: the setting, else the derivation. -->
				<property name="effectiveWritable"
					type="tl.core:Boolean"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[ga -> datapointWritable($ga)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- Whether the datapoint is read on start in the runtime image: the setting, else the derivation. -->
				<property name="effectiveReadOnStart"
					type="tl.core:Boolean"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[ga -> datapointReadOnStart($ga)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- The unit of the datapoint in the runtime image: the setting, else the one of the datapoint type. -->
				<property name="effectiveUnit"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[ga -> datapointUnit($ga)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- Where the runtime flags come from: derived from the connected objects or set for the address. -->
				<property name="runtimeFlagsSource"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[ga -> datapointFlagsSource($ga)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="GroupRange">
			<generalizations>
				<generalization type="GroupAddressDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHGroupAddress"/>
				<instance-presentation icon="css:fa-solid fa-arrows-left-right-to-line"/>
				<id-column value="displayName"/>
			</annotations>
			<attributes>
				<!-- The first address of the range, in the notation of the project. -->
				<property name="rangeStart"
					type="GA"
				>
					<annotations>
						<ga-style>
							<style><![CDATA[ga -> recursion($ga, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.project:Project`))
    .firstElement()
    .get(`ehome.project:Project#groupAddressStyle`)]]></style>
						</ga-style>
						<constraints>
							<constraint class="de.haumacher.ehome.knx.WithinGroupRange"/>
						</constraints>
					</annotations>
				</property>
				<!-- The last address of the range. -->
				<property name="rangeEnd"
					type="GA"
				>
					<annotations>
						<ga-style>
							<style><![CDATA[ga -> recursion($ga, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.project:Project`))
    .firstElement()
    .get(`ehome.project:Project#groupAddressStyle`)]]></style>
						</ga-style>
						<constraints>
							<constraint class="de.haumacher.ehome.knx.WithinGroupRange"/>
						</constraints>
					</annotations>
				</property>
				<!-- The label ETS lists the range with: the main group (8) or main and middle group (8/0), and the name. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[r -> {
    prefix = groupRangePrefix(
        $r.get(`ehome.logical:GroupRange#rangeStart`),
        $r.get(`ehome.logical:GroupRange#rangeEnd`));
    name = $r.get(`ehome.logical:GroupAddressDefinition#name`);
    if($prefix == null, $name, "{0} {1}".fill($prefix, $name))
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<reference name="parts"
					composite="true"
					kind="forwards"
					multiple="true"
					type="GroupAddressDefinition"
				/>
			</attributes>
		</class>
	</module>
</model>