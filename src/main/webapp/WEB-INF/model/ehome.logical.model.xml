<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.logical">
		<!--
			A KNX group address. The database stores the plain 16-bit number; the application sees a
			de.haumacher.ehome.knx.GA that carries the notation of its project (see GroupAddressStyle),
			so the address is written the same way in every form, table and label. An attribute of
			this type states where its notation comes from with a <ga-style> annotation; without one,
			addresses are written main/middle/sub.
		-->
		<datatype name="GA"
			db_type="int"
			kind="Custom"
		>
			<annotations>
				<storage-algorithm>
					<group-address-storage/>
				</storage-algorithm>
				<input-control>
					<impl class="de.haumacher.ehome.knx.GAControlProvider"/>
				</input-control>
			</annotations>
			<group-address-mapping/>
		</datatype>
		<!-- The notations of group addresses ETS offers, named like ETS names them. -->
		<enum name="GroupAddressStyle">
			<classifier name="ThreeLevel" default="true"/>
			<classifier name="TwoLevel"/>
			<classifier name="Free"/>
		</enum>
		<interface name="GroupAddressDefinition">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.core:Text"
				/>
				<!-- Couplers pass the telegrams to these addresses without filtering. -->
				<property name="unfiltered"
					type="tl.core:Boolean"
				/>
			</attributes>
		</interface>
		<class name="GroupAddress">
			<generalizations>
				<generalization type="GroupAddressDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHGroupAddress"/>
				<instance-presentation icon="css:fa-solid fa-at"/>
				<id-column value="displayName"/>
			</annotations>
			<attributes>
				<property name="address"
					type="GA"
				>
					<annotations>
						<!-- The notation chosen by the project the address belongs to. -->
						<ga-style>
							<style><![CDATA[ga -> recursion($ga, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.project:Project`))
    .firstElement()
    .get(`ehome.project:Project#groupAddressStyle`)]]></style>
						</ga-style>
						<constraints>
							<constraint class="de.haumacher.ehome.knx.WithinGroupRange"/>
						</constraints>
					</annotations>
				</property>
				<!-- An address of a central function (e.g. all off), which couplers treat specially. -->
				<property name="central"
					type="tl.core:Boolean"
				/>
				<!-- The label ETS lists the address with: address and name. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[ga -> {
    address = $ga.get(`ehome.logical:GroupAddress#address`);
    name = $ga.get(`ehome.logical:GroupAddressDefinition#name`);
    if($address == null, $name, "{0} {1}".fill($address, $name))
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<reference name="datapointTypes"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.datapoint:DatapointType"
				/>
				<!--
					The datapoint type of the values sent to this address: its own one if set in the
					project, otherwise the one of the first communication object connected to it.
				-->
				<reference name="effectiveDatapointType"
					kind="forwards"
					type="ehome.datapoint:DatapointType"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[ga -> {
    own = $ga.get(`ehome.logical:GroupAddress#datapointTypes`);
    if(!$own.isEmpty(), $own.firstElement(),
        $ga.referers(`ehome.physical:Connection#target`)
            .referers(`ehome.physical:Connector#connections`)
            .map(c -> $c.get(`ehome.physical:Connector#effectiveDatapointType`))
            .filter(t -> $t != null)
            .firstElement())
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
			</attributes>
		</class>
		<class name="GroupRange">
			<generalizations>
				<generalization type="GroupAddressDefinition"/>
			</generalizations>
			<annotations>
				<table name="EHGroupAddress"/>
				<instance-presentation icon="css:fa-solid fa-arrows-left-right-to-line"/>
				<id-column value="displayName"/>
			</annotations>
			<attributes>
				<!-- The first address of the range, in the notation of the project. -->
				<property name="rangeStart"
					type="GA"
				>
					<annotations>
						<ga-style>
							<style><![CDATA[ga -> recursion($ga, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.project:Project`))
    .firstElement()
    .get(`ehome.project:Project#groupAddressStyle`)]]></style>
						</ga-style>
						<constraints>
							<constraint class="de.haumacher.ehome.knx.WithinGroupRange"/>
						</constraints>
					</annotations>
				</property>
				<!-- The last address of the range. -->
				<property name="rangeEnd"
					type="GA"
				>
					<annotations>
						<ga-style>
							<style><![CDATA[ga -> recursion($ga, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.project:Project`))
    .firstElement()
    .get(`ehome.project:Project#groupAddressStyle`)]]></style>
						</ga-style>
						<constraints>
							<constraint class="de.haumacher.ehome.knx.WithinGroupRange"/>
						</constraints>
					</annotations>
				</property>
				<!-- The label ETS lists the range with: the main group (8) or main and middle group (8/0), and the name. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[r -> {
    prefix = groupRangePrefix(
        $r.get(`ehome.logical:GroupRange#rangeStart`),
        $r.get(`ehome.logical:GroupRange#rangeEnd`));
    name = $r.get(`ehome.logical:GroupAddressDefinition#name`);
    if($prefix == null, $name, "{0} {1}".fill($prefix, $name))
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<reference name="parts"
					composite="true"
					kind="forwards"
					multiple="true"
					type="GroupAddressDefinition"
				/>
			</attributes>
		</class>
	</module>
</model>