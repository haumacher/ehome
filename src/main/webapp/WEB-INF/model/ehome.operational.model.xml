			<annotations>
				<!-- Most parameter references have no name of their own; they are labeled by their text. -->
				<id-column value="title"/>
				<instance-presentation icon="css:bi bi-sliders"/>
				<table name="EHParameterView"/>
			</annotations>
			<attributes>
				<!-- The parameter definition this reference places. -->
				<reference name="parameter"
					inverse-reference="views"
					kind="forwards"
					mandatory="true"
					type="Parameter"
				>
					<annotations>
						<!-- Only the parameters of the program containing this placement. -->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> recursion($self, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.operational:Program`))
    .firstElement()
    .get(`ehome.operational:Program#parameters`)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.model.i18n:I18NString"
				/>
				<reference name="access"
					kind="forwards"
					type="AccessKind"
				/>
				<!--
					Who supplies the default at this place: the reference itself if it sets a default (its typed
					value), otherwise the parameter.
				-->
				<reference name="defaultSource"
					kind="forwards"
					type="ParameterValue"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[p -> if($p.get(`ehome.operational:ParameterValue#choice`) != null
        or $p.get(`ehome.operational:ParameterValue#number`) != null
        or $p.get(`ehome.operational:ParameterValue#decimal`) != null
        or $p.get(`ehome.operational:ParameterValue#text`) != null,
    $p,
    $p.get(`ehome.operational:ParameterView#parameter`))]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
				<!-- The access of the reference, otherwise of the parameter; ETS defaults to ReadWrite. -->
				<reference name="effectiveAccess"
					kind="forwards"
					type="AccessKind"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[p -> $p.get(`ehome.operational:ParameterView#access`)
    || $p.get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#access`)
    || `ehome.operational:AccessKind#ReadWrite`]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
				<!-- The text naming the parameter where the configuration shows it. -->
				<property name="title"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[p -> {
    parameter = $p.get(`ehome.operational:ParameterView#parameter`);
    $p.get(`ehome.operational:ParameterView#description`).localize()
        || $parameter.get(`ehome.operational:Parameter#description`).localize()
        || $p.get(`ehome.operational:ParameterView#name`)
        || $parameter.get(`ehome.operational:Parameter#name`)
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- The default in effect at this place as the user reads it (see defaultSource). -->
				<property name="displayDefault"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[p -> $p.get(`ehome.operational:ParameterView#defaultSource`).get(`ehome.operational:ParameterValue#displayValue`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<property name="order"
					type="tl.core:Integer"
				/>
				<property name="tag"
					type="tl.core:Integer"
				/>
			</attributes>
