		<class name="Program">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHProgram"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
