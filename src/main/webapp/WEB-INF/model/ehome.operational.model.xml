<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.operational">
		<annotations>
			<package-binding
				implementation-package="de.haumacher.ehome.model.operational.internal"
				interface-package="de.haumacher.ehome.model.operational"
			/>
		</annotations>
		<enum name="AccessKind">
			<classifier name="None"/>
			<classifier name="Read"/>
			<classifier name="Write"/>
			<classifier name="ReadWrite"/>
		</enum>
		<enum name="NumberKind">
			<classifier name="unsignedInt"/>
			<classifier name="signedInt"/>
		</enum>
		<enum name="ValueKind">
			<classifier name="Value"/>
			<classifier name="BinaryValue"/>
		</enum>
		<class name="CodeSegment">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHCodeSegment"/>
			</annotations>
			<attributes>
				<property name="address"
					type="tl.core:Integer"
				/>
				<property name="size"
					type="tl.core:Integer"
				/>
				<reference name="pointers"
					inverse-reference="segment"
					kind="backwards"
					multiple="true"
					type="Pointer"
				/>
			</attributes>
		</class>
		<interface name="ConfigFragment">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<attributes>
				<!-- The elements of the container, in the order of the configuration; owned by it. -->
				<reference name="contents"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="Option"
				/>
			</attributes>
		</interface>
		<class name="Case">
			<generalizations>
				<generalization type="ConfigFragment"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-signpost"/>
				<id-column value="displayName"/>
				<table name="EHConfigFragment"/>
			</annotations>
			<attributes>
				<!-- The values of the switch's parameter this case is taken for (ETS: when@test). -->
				<property name="pattern"
					type="tl.core:String"
				/>
				<!-- Whether the case is taken when no other one matches (ETS: when@default). -->
				<property name="isDefault"
					type="tl.core:Boolean"
				/>
				<!--
					The label in the structure tree: the values the case is taken for, with their text for an
					enumeration. The only case of a switch is taken always.
				-->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> {
    choice = $c.container();
    if($c.get(`ehome.operational:Case#isDefault`),
        if($choice.get(`ehome.operational:Switch#alternatives`).size() == 1,
            #("Always"@en, "Immer"@de).localize(),
            #("Otherwise"@en, "Sonst"@de).localize()),
        {
            pattern = $c.get(`ehome.operational:Case#pattern`);
            type = $choice.get(`ehome.operational:Switch#input`)
                .get(`ehome.operational:ParameterView#parameter`)
                .get(`ehome.operational:Parameter#type`);
            text = if($type.instanceOf(`ehome.operational:EnumerationType`),
                $type.get(`ehome.operational:EnumerationType#values`)
                    .filter(v -> numberFormat("0").format($v.get(`ehome.operational:EnumerationValue#value`)) == $pattern)
                    .firstElement()
                    .get(`ehome.operational:EnumerationValue#name`)
                    .localize(),
                null);
            if($text == null, "= {0}".fill($pattern), "= {0} ({1})".fill($pattern, $text))
        })
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="Channel">
			<generalizations>
				<generalization type="ConfigFragment"/>
				<generalization type="Option"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-diagram-3"/>
				<id-column value="displayName"/>
				<table name="EHConfigFragment"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.model.i18n:I18NString"
				/>
				<property name="number"
					type="tl.core:Integer"
				/>
				<!-- The label in the structure tree: number and text of the channel. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> {
    text = $c.get(`ehome.operational:Channel#description`).localize() || $c.get(`ehome.operational:Channel#name`);
    number = $c.get(`ehome.operational:Channel#number`);
    if($number == null, $text, "{0}: {1}".fill($number, $text))
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="ChannelIndependent">
			<generalizations>
				<generalization type="ConfigFragment"/>
				<generalization type="Option"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-collection"/>
				<id-column value="displayName"/>
				<table name="EHConfigFragment"/>
			</annotations>
			<attributes>
				<!-- The label in the structure tree. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> #("Independent of channels"@en, "Kanalunabhängig"@de).localize()]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="ParameterGroup">
			<generalizations>
				<generalization type="ConfigFragment"/>
				<generalization type="Option"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-card-list"/>
				<id-column value="displayName"/>
				<table name="EHConfigFragment"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.model.i18n:I18NString"
				/>
				<reference name="access"
					kind="forwards"
					type="AccessKind"
				/>
				<reference name="input"
					kind="forwards"
					type="ParameterView"
				>
					<annotations>
						<!-- Only the elements of the program containing this one. -->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> recursion($self, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.operational:Program`))
    .firstElement()
    .get(`ehome.operational:Program#parameters`)
    .get(`ehome.operational:Parameter#views`)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!-- The label in the structure tree: the text of the parameter block. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[g -> $g.get(`ehome.operational:ParameterGroup#description`).localize() || $g.get(`ehome.operational:ParameterGroup#name`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="EnumerationValue">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHEnumerationValue"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.model.i18n:I18NString"
				/>
				<property name="index"
					type="tl.core:Integer"
				/>
				<property name="value"
					mandatory="true"
					type="tl.core:Integer"
				/>
				<property name="binary"
					type="tl.core:Binary"
				/>
			</attributes>
		</class>
		<interface name="Option">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
		</interface>
		<!-- A parameter placed in the configuration structure (ETS: ParameterRefRef). -->
		<class name="ParameterEntry">
			<generalizations>
				<generalization type="Option"/>
			</generalizations>
			<annotations>
				<id-column value="displayName"/>
				<instance-presentation icon="css:bi bi-input-cursor-text"/>
			</annotations>
			<attributes>
				<reference name="parameter"
					kind="forwards"
					mandatory="true"
					type="ParameterView"
				>
					<annotations>
						<!-- Only the elements of the program containing this one. -->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> recursion($self, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.operational:Program`))
    .firstElement()
    .get(`ehome.operational:Program#parameters`)
    .get(`ehome.operational:Parameter#views`)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!-- The label in the structure tree: the text of the parameter. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[e -> $e.get(`ehome.operational:ParameterEntry#parameter`).get(`ehome.operational:ParameterView#title`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<!-- A communication object placed in the configuration structure (ETS: ComObjectRefRef). -->
		<class name="InterfaceEntry">
			<generalizations>
				<generalization type="Option"/>
			</generalizations>
			<annotations>
				<id-column value="displayName"/>
				<instance-presentation icon="css:bi bi-plug"/>
			</annotations>
			<attributes>
				<reference name="interface"
					kind="forwards"
					mandatory="true"
					type="Interface"
				>
					<annotations>
						<!-- Only the elements of the program containing this one. -->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> recursion($self, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.operational:Program`))
    .firstElement()
    .get(`ehome.operational:Program#ports`)
    .get(`ehome.operational:Port#interfaces`)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!-- The label in the structure tree: the text of the communication object. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[e -> $e.get(`ehome.operational:InterfaceEntry#interface`).get(`ehome.operational:Interface#displayName`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="Interface">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<id-column value="displayName"/>
				<instance-presentation icon="css:bi bi-plug-fill"/>
				<table name="EHInterface"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.model.i18n:I18NString"
				/>
				<property name="function"
					type="tl.model.i18n:I18NString"
				/>
				<reference name="port"
					aggregate="true"
					inverse-reference="interfaces"
					kind="backwards"
					type="Port"
				/>
				<reference name="datapointTypes"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.datapoint:DatapointType"
				/>
				<property name="tag"
					type="tl.core:Integer"
				/>
				<!-- The text of the communication object as the program shows it. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[i -> {
    port = $i.get(`ehome.operational:Interface#port`);
    $i.get(`ehome.operational:Interface#name`).localize()
        || $port.get(`ehome.operational:Port#text`).localize()
        || $port.get(`ehome.operational:Port#name`)
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="ParameterView">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<!-- Most parameter references have no name of their own; they are labeled by their text. -->
				<id-column value="title"/>
				<instance-presentation icon="css:bi bi-sliders"/>
				<table name="EHParameterView"/>
			</annotations>
			<attributes>
				<reference name="parameter"
					aggregate="true"
					inverse-reference="views"
					kind="backwards"
					type="Parameter"
				/>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.model.i18n:I18NString"
				/>
				<reference name="access"
					kind="forwards"
					type="AccessKind"
				/>
				<!-- The default this reference sets for the parameter; empty for the parameter's own one. -->
				<property name="defaultValue"
					type="tl.core:String"
				/>
				<property name="effectiveDefault"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[p -> $p.get(`ehome.operational:ParameterView#defaultValue`)
    || $p.get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#defaultValue`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- The access of the reference, otherwise of the parameter; ETS defaults to ReadWrite. -->
				<reference name="effectiveAccess"
					kind="forwards"
					type="AccessKind"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[p -> $p.get(`ehome.operational:ParameterView#access`)
    || $p.get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#access`)
    || `ehome.operational:AccessKind#ReadWrite`]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
				<!-- The text naming the parameter where the configuration shows it. -->
				<property name="title"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[p -> {
    parameter = $p.get(`ehome.operational:ParameterView#parameter`);
    $p.get(`ehome.operational:ParameterView#description`).localize()
        || $parameter.get(`ehome.operational:Parameter#description`).localize()
        || $p.get(`ehome.operational:ParameterView#name`)
        || $parameter.get(`ehome.operational:Parameter#name`)
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- The default as the user reads it: for an enumeration the text of the entry. -->
				<property name="displayDefault"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[p -> {
    value = $p.get(`ehome.operational:ParameterView#effectiveDefault`);
    type = $p.get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
    if($type.instanceOf(`ehome.operational:EnumerationType`),
        $type.get(`ehome.operational:EnumerationType#values`)
            .filter(v -> numberFormat("0").format($v.get(`ehome.operational:EnumerationValue#value`)) == $value)
            .firstElement()
            .get(`ehome.operational:EnumerationValue#name`).localize() || $value,
        $value)
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<property name="order"
					type="tl.core:Integer"
				/>
				<property name="tag"
					type="tl.core:Integer"
				/>
			</attributes>
		</class>
		<class name="Switch">
			<generalizations>
				<generalization type="Option"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-signpost-split"/>
				<id-column value="displayName"/>
				<table name="EHSwitch"/>
			</annotations>
			<attributes>
				<reference name="input"
					kind="forwards"
					type="ParameterView"
				>
					<annotations>
						<!-- Only the elements of the program containing this one. -->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> recursion($self, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.operational:Program`))
    .firstElement()
    .get(`ehome.operational:Program#parameters`)
    .get(`ehome.operational:Parameter#views`)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<reference name="alternatives"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="Case"
				/>
				<!--
					The label in the structure tree: the parameter the switch depends on. A switch on a
					parameter without a value (TypeNone) that has only a default case is how some programs
					group content; it is labeled as a group.
				-->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[s -> {
    view = $s.get(`ehome.operational:Switch#input`);
    title = $view.get(`ehome.operational:ParameterView#title`);
    grouping = $view.get(`ehome.operational:ParameterView#parameter`)
            .get(`ehome.operational:Parameter#type`)
            .instanceOf(`ehome.operational:VoidType`)
        and $s.get(`ehome.operational:Switch#alternatives`)
            .filter(c -> !$c.get(`ehome.operational:Case#isDefault`))
            .isEmpty();
    if($grouping,
        #("Group {0}"@en, "Gruppe {0}"@de).fill($title).localize(),
        #("If {0}"@en, "Wenn {0}"@de).fill($title).localize())
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="Parameter">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
