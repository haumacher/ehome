			<annotations>
				<table name="EHParameterType"/>
			</annotations>
			<attributes>
				<property name="bits"
					mandatory="true"
					type="tl.core:Integer"
				/>
				<reference name="kind"
					kind="forwards"
					mandatory="true"
					type="ValueKind"
				/>
				<reference name="values"
					composite="true"
					kind="forwards"
					mandatory="true"
					multiple="true"
					ordered="true"
					type="EnumerationValue"
