				<property name="text"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.core:String"
				/>
				<property name="index"
					mandatory="true"
					type="tl.core:Integer"
				/>
				<property name="size"
					mandatory="true"
					type="tl.core:Integer"
				/>
				<reference name="priority"
					kind="forwards"
					mandatory="true"
					type="ehome.physical:Priority"
				/>
				<reference name="canRead"
					kind="forwards"
					mandatory="true"
					type="ehome.common:Enablement"
				/>
				<reference name="canWrite"
					kind="forwards"
					mandatory="true"
					type="ehome.common:Enablement"
				/>
				<reference name="communication"
					kind="forwards"
					mandatory="true"
					type="ehome.common:Enablement"
				/>
				<reference name="transmission"
					kind="forwards"
					mandatory="true"
					type="ehome.common:Enablement"
				/>
				<reference name="update"
					kind="forwards"
					mandatory="true"
					type="ehome.common:Enablement"
				/>
				<reference name="readOnInit"
					kind="forwards"
					mandatory="true"
					type="ehome.common:Enablement"
				/>
				<reference name="interfaces"
					composite="true"
					inverse-reference="port"
					kind="forwards"
					multiple="true"
					type="Interface"
				/>
			</attributes>
