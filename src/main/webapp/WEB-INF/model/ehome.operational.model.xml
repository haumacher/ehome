<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.operational">
		<annotations>
			<package-binding
				implementation-package="de.haumacher.ehome.model.operational.internal"
				interface-package="de.haumacher.ehome.model.operational"
			/>
		</annotations>
		<enum name="AccessKind">
			<classifier name="None"/>
			<classifier name="Read"/>
			<classifier name="Write"/>
			<classifier name="ReadWrite"/>
		</enum>
		<enum name="NumberKind">
			<classifier name="unsignedInt"/>
			<classifier name="signedInt"/>
		</enum>
		<!-- How a floating point parameter is stored in the device (ETS: TypeFloat@Encoding). -->
		<enum name="FloatEncoding">
			<classifier name="DPT9"/>
			<classifier name="IEEE754Single"/>
			<classifier name="IEEE754Double"/>
		</enum>
		<!-- What a time parameter counts (ETS: TypeTime@Unit). -->
		<enum name="TimeUnit">
			<classifier name="Hours"/>
			<classifier name="Minutes"/>
			<classifier name="Seconds"/>
			<classifier name="HundredMilliseconds"/>
			<classifier name="TenMilliseconds"/>
			<classifier name="Milliseconds"/>
			<classifier name="PackedSecondsAndMilliseconds"/>
			<classifier name="PackedDaysHoursMinutesAndSeconds"/>
		</enum>
		<!-- The role of the address an IP address parameter holds (ETS: TypeIPAddress@AddressType). -->
		<!-- Where a new element of the configuration structure goes relative to the selected one. -->
		<enum name="InsertPosition">
			<classifier name="Inside"/>
			<classifier name="After"/>
		</enum>
		<enum name="IPAddressKind">
			<classifier name="HostAddress"/>
			<classifier name="GatewayAddress"/>
			<classifier name="UnicastAddress"/>
			<classifier name="BroadcastAddress"/>
			<classifier name="MulticastAddress"/>
			<classifier name="SubnetMask"/>
		</enum>
		<enum name="IPVersion">
			<classifier name="IPv4"/>
			<classifier name="IPv6"/>
		</enum>
		<enum name="ValueKind">
			<classifier name="Value"/>
			<classifier name="BinaryValue"/>
		</enum>
		<class name="CodeSegment">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHCodeSegment"/>
			</annotations>
			<attributes>
				<property name="address"
					type="tl.core:Integer"
				/>
				<property name="size"
					type="tl.core:Integer"
				/>
				<reference name="pointers"
					inverse-reference="segment"
					kind="backwards"
					multiple="true"
					type="Pointer"
				/>
			</attributes>
		</class>
		<interface name="ConfigFragment">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<attributes>
				<!-- The elements of the container, in the order of the configuration; owned by it. -->
				<reference name="contents"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="Option"
				/>
			</attributes>
		</interface>
		<class name="Case">
			<generalizations>
				<generalization type="ConfigFragment"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-signpost"/>
				<id-column value="displayName"/>
				<table name="EHConfigFragment"/>
			</annotations>
			<attributes>
				<!-- The values of the switch's parameter this case is taken for (ETS: when@test). -->
				<property name="pattern"
					type="tl.core:String"
				/>
				<!-- Whether the case is taken when no other one matches (ETS: when@default). -->
				<property name="isDefault"
					type="tl.core:Boolean"
				/>
				<!--
					The label in the structure tree: the values the case is taken for, with their text for an
					enumeration. The only case of a switch is taken always.
				-->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> {
    choice = $c.container();
    if($c.get(`ehome.operational:Case#isDefault`),
        if($choice.get(`ehome.operational:Switch#alternatives`).size() == 1,
            #("Always"@en, "Immer"@de).localize(),
            #("Otherwise"@en, "Sonst"@de).localize()),
        {
            pattern = $c.get(`ehome.operational:Case#pattern`);
            type = $choice.get(`ehome.operational:Switch#input`)
                .get(`ehome.operational:ParameterView#parameter`)
                .get(`ehome.operational:Parameter#type`);
            text = if($type.instanceOf(`ehome.operational:EnumerationType`),
                $type.get(`ehome.operational:EnumerationType#values`)
                    .filter(v -> numberFormat("0").format($v.get(`ehome.operational:EnumerationValue#value`)) == $pattern)
                    .firstElement()
                    .get(`ehome.operational:EnumerationValue#name`)
                    .localize(),
                null);
            if($text == null, "= {0}".fill($pattern), "= {0} ({1})".fill($pattern, $text))
        })
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="Channel">
			<generalizations>
				<generalization type="ConfigFragment"/>
				<generalization type="Option"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-diagram-3"/>
				<id-column value="displayName"/>
				<table name="EHConfigFragment"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.model.i18n:I18NString"
				/>
				<property name="number"
					type="tl.core:Integer"
				/>
				<!-- The label in the structure tree: number and text of the channel. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> {
    text = $c.get(`ehome.operational:Channel#description`).localize() || $c.get(`ehome.operational:Channel#name`);
    number = $c.get(`ehome.operational:Channel#number`);
    if($number == null, $text, "{0}: {1}".fill($number, $text))
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="ChannelIndependent">
			<generalizations>
				<generalization type="ConfigFragment"/>
				<generalization type="Option"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-collection"/>
				<id-column value="displayName"/>
				<table name="EHConfigFragment"/>
			</annotations>
			<attributes>
				<!-- The label in the structure tree. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> #("Independent of channels"@en, "Kanalunabhängig"@de).localize()]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<class name="ParameterGroup">
			<generalizations>
				<generalization type="ConfigFragment"/>
				<generalization type="Option"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-card-list"/>
				<id-column value="displayName"/>
				<table name="EHConfigFragment"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.model.i18n:I18NString"
				/>
				<reference name="access"
					kind="forwards"
					type="AccessKind"
				/>
				<reference name="input"
					kind="forwards"
					type="ParameterView"
				>
					<annotations>
						<!-- Only the elements of the program containing this one. -->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> recursion($self, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.operational:Program`))
    .firstElement()
    .get(`ehome.operational:Program#parameters`)
    .get(`ehome.operational:Parameter#views`)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!-- The label in the structure tree: the text of the parameter block. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[g -> $g.get(`ehome.operational:ParameterGroup#effectiveTitle`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- The title the parameter dialog shows: its own, otherwise the text of the title parameter, otherwise the internal name. -->
				<property name="effectiveTitle"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[g -> $g.get(`ehome.operational:ParameterGroup#description`).localize()
    || $g.get(`ehome.operational:ParameterGroup#input`).get(`ehome.operational:ParameterView#title`)
    || $g.get(`ehome.operational:ParameterGroup#name`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!-- How the parameter dialog shows the block: its own display, otherwise that of the title parameter, otherwise editable. -->
				<reference name="effectiveAccess"
					kind="forwards"
					type="AccessKind"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[g -> $g.get(`ehome.operational:ParameterGroup#access`)
    || $g.get(`ehome.operational:ParameterGroup#input`).get(`ehome.operational:ParameterView#effectiveAccess`)
    || `ehome.operational:AccessKind#ReadWrite`]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
			</attributes>
		</class>
		<class name="EnumerationValue">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHEnumerationValue"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.model.i18n:I18NString"
				/>
				<property name="index"
					type="tl.core:Integer"
				/>
				<property name="value"
					mandatory="true"
					type="tl.core:Integer"
				>
					<annotations>
						<default-value>
							<int value="0"/>
						</default-value>
					</annotations>
				</property>
				<property name="binary"
					type="tl.core:Binary"
				/>
			</attributes>
		</class>
		<interface name="Option">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
		</interface>
		<!--
			A communication object placed in the configuration structure (ETS: ComObjectRef, placed by
			ComObjectRefRef): the object definition with the texts and datapoint types it has at this place.
		-->
		<class name="Interface">
			<generalizations>
				<generalization type="Option"/>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<id-column value="displayName"/>
				<instance-presentation icon="css:bi bi-plug-fill"/>
				<table name="EHInterface"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.model.i18n:I18NString"
				/>
				<property name="function"
					type="tl.model.i18n:I18NString"
				/>
				<!-- The communication object definition this reference places. -->
				<reference name="port"
					inverse-reference="interfaces"
					kind="forwards"
					mandatory="true"
					type="Port"
				>
					<annotations>
						<!-- Only the communication objects of the program containing this placement. -->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> recursion($self, x -> $x.container())
    .filter(x -> $x.instanceOf(`ehome.operational:Program`))
    .firstElement()
    .get(`ehome.operational:Program#ports`)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<reference name="datapointTypes"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.datapoint:DatapointType"
				/>
				<property name="tag"
					type="tl.core:Integer"
				/>
				<!-- The text of the communication object as the program shows it. -->
				<property name="displayName"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[i -> {
    port = $i.get(`ehome.operational:Interface#port`);
    $i.get(`ehome.operational:Interface#name`).localize()
        || $port.get(`ehome.operational:Port#text`).localize()
        || $port.get(`ehome.operational:Port#name`)
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
		<!--
			A holder of a parameter value: the parameter definition (its default), a placement of it in the
			structure (the default at this place) and a device's setting (the value set in the project).

			The value is typed, not kept as the text ETS writes: of the attributes choice, number, decimal and
			text exactly the one fitting the kind of the holder's type (valueType) is used. An enumeration
			holds the chosen entry of its type, a number or time an integer, a floating point type a
			decimal, a text type its text. The text also keeps, unchanged, the values of the types the app
			does not decode (date, IP address) and every value the import could not decode for its type. A
			parameter without value (VoidType) holds nothing.

			The notation of ETS (encodedValue) and the text a person reads (displayValue) are derived from
			the typed value. Encoding and decoding live in one place (de.haumacher.ehome.knx.ParameterValues),
			shared by the import and encodedValue.

			The type of a holder is defined by the TL-Script function parameterValueType (Java:
			ParameterValues.valueType), which navigates the stored references: a parameter's type, the type
			of the parameter a placement places, the type of the parameter a setting sets. valueType is that
			function; the constraints and the display call the function instead of reading valueType,
			because a derived reference reads as empty where no user is logged in, as in the commit check
			of an import (doc/tl-todo.md, "Derived references and the commit check"). The scripts a form
			re-evaluates while editing (the visibility of the typed attributes and the options of choice)
			write the same navigation in TL-Script, because the form cannot trace what a Java function
			reads (doc/tl-todo.md, "Derived attributes in a form in edit mode").
		-->
		<interface name="ParameterValue">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<attributes>
				<!-- The type of the value (see parameterValueType). -->
				<reference name="valueType"
					kind="forwards"
					type="ParameterType"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[h -> parameterValueType($h)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
				<!-- The chosen entry of an enumeration type. -->
				<reference name="choice"
					kind="forwards"
					type="EnumerationValue"
				>
					<annotations>
						<!-- Navigates in TL-Script, not via parameterValueType, so that the form traces it (doc/tl-todo.md). -->
						<options>
							<options-by-expression>
								<function><![CDATA[self -> {
    t = switch {
        $self.instanceOf(`ehome.operational:Parameter`):
            $self.get(`ehome.operational:Parameter#type`);
        $self.instanceOf(`ehome.operational:ParameterView`):
            $self.get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
        default:
            $self.get(`ehome.physical:ParameterSetting#parameter`).get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
    };
    if($t.instanceOf(`ehome.operational:EnumerationType`), $t.get(`ehome.operational:EnumerationType#values`), [])
}]]></function>
							</options-by-expression>
						</options>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> {
    t = parameterValueType($obj);
    if($value == null
            or ($t.instanceOf(`ehome.operational:EnumerationType`)
                and $t.get(`ehome.operational:EnumerationType#values`).containsElement($value)),
        null,
        #("The entry “{0}” is no value of the type {1}."@en, "Der Eintrag „{0}“ ist kein Wert des Typs {1}."@de)
            .fill($value.get(`ehome.operational:EnumerationValue#name`).localize(), $t.get(`ehome.operational:ParameterType#name`)))
}]]></check>
							</constraint-by-expression>
						</constraints>
						<!-- Shown for a type of its kind, and wherever it holds a value, so that a value left from another type can be removed. -->
						<!-- Navigates in TL-Script, not via parameterValueType, so that the form traces it (doc/tl-todo.md). -->
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[obj -> editMode -> {
    t = switch {
        $obj.instanceOf(`ehome.operational:Parameter`):
            $obj.get(`ehome.operational:Parameter#type`);
        $obj.instanceOf(`ehome.operational:ParameterView`):
            $obj.get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
        default:
            $obj.get(`ehome.physical:ParameterSetting#parameter`).get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
    };
    if($t.instanceOf(`ehome.operational:EnumerationType`) or $obj.get(`ehome.operational:ParameterValue#choice`) != null, null, "hidden")
}]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The value of an integer or time type. -->
				<property name="number"
					type="tl.core:Long"
				>
					<annotations>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> {
    t = parameterValueType($obj);
    switch {
        $value == null: null;
        $t.instanceOf(`ehome.operational:NumericType`):
            if($value < $t.get(`ehome.operational:NumericType#min`) or $value > $t.get(`ehome.operational:NumericType#max`),
                #("The value must lie between {0} and {1}."@en, "Der Wert muss zwischen {0} und {1} liegen."@de)
                    .fill($t.get(`ehome.operational:NumericType#min`), $t.get(`ehome.operational:NumericType#max`)),
                null);
        $t.instanceOf(`ehome.operational:TimeType`):
            if($value < $t.get(`ehome.operational:TimeType#min`) or $value > $t.get(`ehome.operational:TimeType#max`),
                #("The value must lie between {0} and {1}."@en, "Der Wert muss zwischen {0} und {1} liegen."@de)
                    .fill($t.get(`ehome.operational:TimeType#min`), $t.get(`ehome.operational:TimeType#max`)),
                null);
        default: null;
    }
}]]></check>
							</constraint-by-expression>
						</constraints>
						<!-- Shown for a type of its kind, and wherever it holds a value, so that a value left from another type can be removed. -->
						<!-- Navigates in TL-Script, not via parameterValueType, so that the form traces it (doc/tl-todo.md). -->
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[obj -> editMode -> {
    t = switch {
        $obj.instanceOf(`ehome.operational:Parameter`):
            $obj.get(`ehome.operational:Parameter#type`);
        $obj.instanceOf(`ehome.operational:ParameterView`):
            $obj.get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
        default:
            $obj.get(`ehome.physical:ParameterSetting#parameter`).get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
    };
    if($t.instanceOf(`ehome.operational:NumericType`) or $t.instanceOf(`ehome.operational:TimeType`) or $obj.get(`ehome.operational:ParameterValue#number`) != null, null, "hidden")
}]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</property>
				<!-- The value of a floating point type. -->
				<property name="decimal"
					type="tl.core:Double"
				>
					<annotations>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> {
    t = parameterValueType($obj);
    if($value != null and $t.instanceOf(`ehome.operational:FloatingPointType`)
            and ($value < $t.get(`ehome.operational:FloatingPointType#min`) or $value > $t.get(`ehome.operational:FloatingPointType#max`)),
        #("The value must lie between {0} and {1}."@en, "Der Wert muss zwischen {0} und {1} liegen."@de)
            .fill($t.get(`ehome.operational:FloatingPointType#min`), $t.get(`ehome.operational:FloatingPointType#max`)),
        null)
}]]></check>
							</constraint-by-expression>
						</constraints>
						<!-- Shown for a type of its kind, and wherever it holds a value, so that a value left from another type can be removed. -->
						<!-- Navigates in TL-Script, not via parameterValueType, so that the form traces it (doc/tl-todo.md). -->
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[obj -> editMode -> {
    t = switch {
        $obj.instanceOf(`ehome.operational:Parameter`):
            $obj.get(`ehome.operational:Parameter#type`);
        $obj.instanceOf(`ehome.operational:ParameterView`):
            $obj.get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
        default:
            $obj.get(`ehome.physical:ParameterSetting#parameter`).get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
    };
    if($t.instanceOf(`ehome.operational:FloatingPointType`) or $obj.get(`ehome.operational:ParameterValue#decimal`) != null, null, "hidden")
}]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</property>
				<!--
					The value of a text type; for a date, an IP address and every value the app does not decode,
					the value as ETS writes it.
				-->
				<property name="text"
					type="tl.core:String"
				>
					<annotations>
						<!--
							Warnings only: a text is a fact from ETS, not user input, and a manufacturer's pattern must
							not reject an import. A pattern Java cannot compile restricts nothing (matchesPattern).
						-->
						<constraints>
							<constraint-by-expression type="warning">
								<check><![CDATA[value -> obj -> {
    t = parameterValueType($obj);
    pattern = if($t.instanceOf(`ehome.operational:TextType`), $t.get(`ehome.operational:TextType#pattern`), null);
    switch {
        $value == null or !$t.instanceOf(`ehome.operational:TextType`): null;
        $value.length() > $t.get(`ehome.operational:TextType#bits`) / 8:
            #("At most {0} characters are allowed."@en, "Höchstens {0} Zeichen sind erlaubt."@de)
                .fill(numberFormat("0").format($t.get(`ehome.operational:TextType#bits`) / 8));
        !matchesPattern($value, $pattern):
            #("The text does not match the pattern {0}."@en, "Der Text passt nicht zum Muster {0}."@de).fill($pattern);
        default: null;
    }
}]]></check>
							</constraint-by-expression>
						</constraints>
						<!-- Shown for a type of its kind, and wherever it holds a value, so that a value left from another type can be removed. -->
						<!-- Navigates in TL-Script, not via parameterValueType, so that the form traces it (doc/tl-todo.md). -->
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[obj -> editMode -> {
    t = switch {
        $obj.instanceOf(`ehome.operational:Parameter`):
            $obj.get(`ehome.operational:Parameter#type`);
        $obj.instanceOf(`ehome.operational:ParameterView`):
            $obj.get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
        default:
            $obj.get(`ehome.physical:ParameterSetting#parameter`).get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
    };
    if($t.instanceOf(`ehome.operational:TextType`) or $t.instanceOf(`ehome.operational:DateType`) or $t.instanceOf(`ehome.operational:IPAddressType`) or $obj.get(`ehome.operational:ParameterValue#text`) != null, null, "hidden")
}]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</property>
				<!-- The value in the notation ETS writes it in; empty if the holder holds no value. -->
				<property name="encodedValue"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[h -> encodedParameterValue($h)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<!--
					The value as a person reads it: the text of an enumeration entry, a time with its unit, a
					decimal in the format of the type; empty if the holder holds no value.
				-->
				<property name="displayValue"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[h -> {
    t = parameterValueType($h);
    choice = $h.get(`ehome.operational:ParameterValue#choice`);
    number = $h.get(`ehome.operational:ParameterValue#number`);
    decimal = $h.get(`ehome.operational:ParameterValue#decimal`);
    switch {
        $choice != null:
            $choice.get(`ehome.operational:EnumerationValue#name`).localize();
        $number != null and $t.instanceOf(`ehome.operational:TimeType`):
            "{0} {1}".fill(numberFormat("0").format($number), $t.get(`ehome.operational:TimeType#unit`).label());
        $number != null:
            numberFormat("0").format($number);
        $decimal != null: {
            decimals = if($t.instanceOf(`ehome.operational:FloatingPointType`), $t.get(`ehome.operational:FloatingPointType#decimals`), null);
            numberFormat(switch {
                $decimals == null: "0.##########";
                $decimals <= 0: "0";
                default: "0." + subString("0000000000", 0, if($decimals > 10, 10, $decimals));
            }).format($decimal)
        };
        default: $h.get(`ehome.operational:ParameterValue#text`);
    }
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</interface>
		<!--
			A parameter placed in the configuration structure (ETS: ParameterRef, placed by ParameterRefRef):
			the parameter definition with the text, default and access it has at this place.
		-->
		<class name="ParameterView">
			<generalizations>
