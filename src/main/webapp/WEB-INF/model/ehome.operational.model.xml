			<annotations>
				<table name="EHParameterType"/>
			</annotations>
		</class>
		<class name="IPAddressType">
			<generalizations>
				<generalization type="ParameterType"/>
			</generalizations>
			<annotations>
				<table name="EHParameterType"/>
			</annotations>
		</class>
		<class name="NumericType">
			<generalizations>
				<generalization type="ParameterType"/>
			</generalizations>
			<annotations>
				<table name="EHParameterType"/>
			</annotations>
			<attributes>
				<property name="min"
					mandatory="true"
					type="tl.core:Long"
				/>
				<property name="max"
					mandatory="true"
					type="tl.core:Long"
				/>
				<property name="bits"
					mandatory="true"
					type="tl.core:Integer"
				/>
				<reference name="kind"
					kind="forwards"
					mandatory="true"
					type="NumberKind"
				/>
			</attributes>
		</class>
		<class name="TextType">
			<generalizations>
				<generalization type="ParameterType"/>
			</generalizations>
			<annotations>
				<table name="EHParameterType"/>
			</annotations>
			<attributes>
				<property name="bits"
					mandatory="true"
					type="tl.core:Integer"
				/>
			</attributes>
		</class>
		<class name="TimeType">
			<generalizations>
				<generalization type="ParameterType"/>
			</generalizations>
			<annotations>
				<table name="EHParameterType"/>
			</annotations>
		</class>
		<class name="VoidType">
			<generalizations>
				<generalization type="ParameterType"/>
			</generalizations>
			<annotations>
				<table name="EHParameterType"/>
			</annotations>
		</class>
		<class name="Pointer">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<table name="EHPointer"/>
			</annotations>
			<attributes>
				<reference name="segment"
					inverse-reference="pointers"
					kind="forwards"
					mandatory="true"
					type="CodeSegment"
				/>
				<property name="byteOffset"
					mandatory="true"
					type="tl.core:Integer"
				/>
				<property name="bitOffset"
					mandatory="true"
					type="tl.core:Integer"
				/>
				<property name="bits"
					type="tl.core:Integer"
				/>
				<reference name="usage"
					inverse-reference="address"
					kind="backwards"
					multiple="true"
					type="Parameter"
				/>
			</attributes>
		</class>
		<class name="Port">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHPort"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="function"
					type="tl.core:String"
