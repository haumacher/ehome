<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.physical">
		<enum name="ConnectionType">
			<classifier name="send"/>
			<classifier name="receive"/>
		</enum>
		<enum name="Priority">
			<classifier name="Low"/>
			<classifier name="High"/>
			<classifier name="Alert"/>
		</enum>
		<class name="Area">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHLine"/>
				<instance-presentation icon="css:fa-solid fa-lock"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="address"
					type="tl.core:Integer"
				/>
				<reference name="lines"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Line"
				/>
			</attributes>
		</class>
		<class name="Connection">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHConnection"/>
				<instance-presentation icon="css:fa-solid fa-link"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr>x -&gt; "{0} ({1})".fill(     $x.get(`ehome.physical:Connection#target`)         .get(`ehome.logical:GroupAddress#name`),      $x.get(`ehome.physical:Connection#kind`))</expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<reference name="kind"
					kind="forwards"
					mandatory="true"
					type="ConnectionType"
				/>
				<reference name="target"
					kind="forwards"
					mandatory="true"
					type="ehome.logical:GroupAddress"
				/>
				<property name="acknowledge"
					type="tl.core:Boolean"
				/>
			</attributes>
		</class>
		<class name="Connector">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHConnector"/>
				<instance-presentation icon="css:fa-solid fa-plug"/>
			</annotations>
			<attributes>
				<reference name="port"
					kind="forwards"
					mandatory="true"
					type="ehome.operational:Interface"
				/>
				<property name="description"
					type="tl.core:String"
				/>
				<property name="function"
					type="tl.core:String"
				/>
				<reference name="datapointTypes"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.datapoint:DatapointType"
				/>
				<!--
					The datapoint type the values of this communication object have: its own one if set
					in the project, otherwise the one of the program's reference, otherwise the one of
					the program's communication object.
				-->
				<reference name="effectiveDatapointType"
					kind="forwards"
					type="ehome.datapoint:DatapointType"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[c -> {
    ref = $c.get(`ehome.physical:Connector#port`);
    own = $c.get(`ehome.physical:Connector#datapointTypes`);
    fromRef = $ref.get(`ehome.operational:Interface#datapointTypes`);
    fromPort = $ref.get(`ehome.operational:Interface#port`).get(`ehome.operational:Port#datapointTypes`);
    if(!$own.isEmpty(), $own.firstElement(),
        if(!$fromRef.isEmpty(), $fromRef.firstElement(), $fromPort.firstElement()))
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
				<reference name="priority"
					kind="forwards"
					type="Priority"
				/>
				<reference name="canRead"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="canWrite"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="communication"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="transmission"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="update"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="readOnInit"
					kind="forwards"
					type="ehome.common:Enablement"
				/>
				<reference name="connections"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Connection"
				/>
			</attributes>
		</class>
		<class name="Device">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHDevice"/>
				<instance-presentation icon="css:fa-solid fa-mobile-screen-button"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[d -> "{0} ({1})".fill(
    $d.get(`ehome.physical:Device#type`).label(),
    $d.get(`ehome.physical:Device#address`).label()
)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<property name="address"
					type="tl.core:Integer"
				/>
				<reference name="type"
					kind="forwards"
					mandatory="true"
					type="ehome.catalog:Variant"
				/>
				<reference name="program"
					kind="forwards"
					mandatory="true"
					type="ehome.catalog:ProgramAssignment"
				/>
				<reference name="location"
					kind="forwards"
					type="ehome.building:BuildingDefinition"
				/>
				<!-- The parameter values set in the project; all others have their default. -->
				<reference name="settings"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ParameterSetting"
				/>
				<reference name="connectors"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Connector"
				/>
			</attributes>
		</class>
		<class name="Line">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHLine"/>
				<instance-presentation icon="colored:tl-icon network-small"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<property name="address"
					type="tl.core:Integer"
				/>
				<reference name="devices"
					composite="true"
					kind="forwards"
					multiple="true"
					type="Device"
				/>
			</attributes>
		</class>
		<!--
			A parameter value of a device that differs from the default of its application program. The
			value is kept as ETS writes it; displayValue shows it as the user reads it.
		-->
		<class name="ParameterSetting">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-sliders"/>
			</annotations>
			<attributes>
				<reference name="parameter"
					kind="forwards"
					mandatory="true"
					type="ehome.operational:ParameterView"
				/>
				<property name="value"
					type="tl.core:String"
				/>
				<property name="name"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[s -> $s.get(`ehome.physical:ParameterSetting#parameter`).get(`ehome.operational:ParameterView#title`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<property name="displayValue"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[s -> {
    value = $s.get(`ehome.physical:ParameterSetting#value`);
    type = $s.get(`ehome.physical:ParameterSetting#parameter`).get(`ehome.operational:ParameterView#parameter`).get(`ehome.operational:Parameter#type`);
    if($type.instanceOf(`ehome.operational:EnumerationType`),
        $type.get(`ehome.operational:EnumerationType#values`)
            .filter(v -> numberFormat("0").format($v.get(`ehome.operational:EnumerationValue#value`)) == $value)
            .firstElement()
            .get(`ehome.operational:EnumerationValue#name`).localize() || $value,
        $value)
}]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<property name="displayDefault"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[s -> $s.get(`ehome.physical:ParameterSetting#parameter`).get(`ehome.operational:ParameterView#displayDefault`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
	</module>
</model>