<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="ehome.project">
		<class name="Project">
			<generalizations>
				<generalization type="ehome.core:Externalized"/>
			</generalizations>
			<annotations>
				<table name="EHProject"/>
				<instance-presentation icon="colored:tl-icon structure"/>
			</annotations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<reference name="areas"
					composite="true"
					kind="forwards"
					multiple="true"
					type="ehome.physical:Area"
				/>
				<!-- Devices of the project not placed in a line yet. -->
				<reference name="unassignedDevices"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="ehome.physical:Device"
				/>
				<reference name="buildings"
					composite="true"
					kind="forwards"
					multiple="true"
					type="ehome.building:BuildingDefinition"
				/>
				<reference name="groupAddresses"
					composite="true"
					kind="forwards"
					multiple="true"
					type="ehome.logical:GroupAddressDefinition"
				/>
				<!-- The notation of the project's group addresses, as chosen in ETS. -->
				<reference name="groupAddressStyle"
					type="ehome.logical:GroupAddressStyle"
				/>
				<!--
					The KNXnet/IP gateway the devices of the project are programmed and read through: an
					address, optionally with the port (192.168.178.81 or 192.168.178.81:3671).
				-->
				<property name="gateway"
					type="tl.core:String"
				/>
				<!-- The recordings of the group monitor (haumacher/ehome #10). -->
				<reference name="recordings"
					composite="true"
					kind="forwards"
					multiple="true"
					type="ehome.monitor:Recording"
				/>
			</attributes>
		</class>
	</module>
</model>