<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<!--
		Deployment of a project to a HomeControl controller (haumacher/ehome #39): the controllers E-Home
		knows and the deployments of a project's runtime image to one of them. The runtime image itself
		is not stored: it is derived from the project when it is exported or deployed
		(de.haumacher.ehome.runtime.RuntimeImage, format: homecontrol spec/runtime-image.md), from the
		group addresses with their runtime settings, the building structure, the functions of the
		project (#43) and its runtime settings (#45).
	-->
	<module name="ehome.runtime">
		<!--
			A HomeControl controller reachable over HTTP. The bearer token (hct_..., created on the
			controller's console with "web token create e-home") authenticates E-Home; it is entered once
			and never shown again (the views show whether one is set).
		-->
		<class name="Controller">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-cpu"/>
			</annotations>
			<attributes>
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				/>
				<!-- The host name or IP address of the controller. -->
				<property name="host"
					mandatory="true"
					type="tl.core:String"
				/>
				<!-- The HTTP port of the controller's web API. -->
				<property name="port"
					mandatory="true"
					type="tl.core:Integer"
				>
					<annotations>
						<!-- Written without thousands separator. -->
						<format>
							<decimal pattern="0" result-type="long"/>
						</format>
						<default-value>
							<int value="80"/>
						</default-value>
						<value-range
							max="65535"
							min="1"
						/>
					</annotations>
				</property>
				<!-- The bearer token E-Home authenticates with; never displayed. -->
				<property name="token"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</property>
			</attributes>
		</class>
		<!-- One attempt to deploy the runtime image of a project to a controller, with its outcome. -->
		<class name="Deployment">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-cloud-upload"/>
			</annotations>
			<attributes>
				<!--
					Whether the entry records an unload (DELETE /api/image, haumacher/ehome #47) instead of a
					deployment; its revision is the one the controller ran.
				-->
				<property name="unload"
					type="tl.core:Boolean"
				/>
				<!-- The revision the image carried (image.revision). -->
				<property name="revision"
					type="tl.core:Long"
				>
					<annotations>
						<!-- Written without thousands separator. -->
						<format>
							<decimal pattern="0" result-type="long"/>
						</format>
					</annotations>
				</property>
				<property name="time"
					type="tl.core:DateTime"
				/>
				<reference name="controller"
					kind="forwards"
					type="Controller"
				/>
				<!-- The controller as it was addressed: name and host:port. -->
				<property name="target"
					type="tl.core:String"
				/>
				<!-- Whether the controller accepted and loaded the image; for an unload, whether it unloaded its image. -->
				<property name="accepted"
					type="tl.core:Boolean"
				/>
				<!-- The HTTP status of the answer; empty where no answer came (or E-Home refused itself). -->
				<property name="status"
					type="tl.core:Integer"
				>
					<annotations>
						<!-- Written without thousands separator. -->
						<format>
							<decimal pattern="0" result-type="long"/>
						</format>
					</annotations>
				</property>
				<!-- The refusal code (image.invalid, auth.token_invalid, ...); empty for an accepted image. -->
				<property name="code"
					type="tl.core:String"
				/>
				<!-- What happened, in the words of the controller or E-Home. -->
				<property name="message"
					type="tl.core:Text"
				/>
				<!-- What the controller had loaded before (GET /api/status). -->
				<property name="before"
					type="tl.core:String"
				/>
				<!-- The size of the image in bytes. -->
				<property name="bytes"
					type="tl.core:Integer"
				/>
				<!-- The number of refusals; the list holds up to the number reported. -->
				<property name="total"
					type="tl.core:Integer"
				/>
				<reference name="refusals"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="Refusal"
				/>
			</attributes>
		</class>
		<!--
			What the inhabitant operates (haumacher/ehome #43): a light, a blind, a sensor, as the runtime
			image names it (homecontrol spec/runtime-image.md 3.5). The roles of its kind name the group
			addresses whose datapoints it consists of; the roles of the other kinds are hidden. "Propose
			functions" derives functions from the device channels of the project
			(de.haumacher.ehome.runtime.FunctionProposal); the user edits them afterwards.
		-->
		<enum name="FunctionKind">
			<classifier name="light" default="true"/>
			<classifier name="dimmer"/>
			<classifier name="blind"/>
			<classifier name="switch"/>
			<classifier name="sensor"/>
			<classifier name="climate"/>
			<classifier name="scene"/>
			<classifier name="button"/>
		</enum>
		<class name="Function">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-lightbulb"/>
			</annotations>
			<attributes>
				<!--
					The label the controller shows, in the languages it has (haumacher/ehome #51): a proposed
					function has the languages of the texts of its device's program.
				-->
				<property name="name"
					mandatory="true"
					type="tl.model.i18n:I18NString"
				/>
				<!-- The id of the function in the runtime image (letters, digits, _ . -, at most 32); derived from the name where empty. -->
				<property name="identifier"
					type="tl.core:String"
				>
					<annotations>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[value -> obj -> runtimeIdentifierProblem($value)]]></check>
							</constraint-by-expression>
						</constraints>
					</annotations>
				</property>
				<reference name="kind"
					kind="forwards"
					mandatory="true"
					type="FunctionKind"
				/>
				<!-- The part of the building the function is in. -->
				<reference name="room"
					kind="forwards"
					type="ehome.building:BuildingDefinition"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeBuildingParts($f)]]></function>
							</options-by-expression>
						</options>
					</annotations>
				</reference>
				<!-- The unit the controller shows; empty for the unit of the function's main datapoint. -->
				<property name="unit"
					type="tl.core:String"
				/>
				<!-- The scene number a scene function sends (1..64). -->
				<property name="scene"
					type="tl.core:Integer"
				>
					<annotations>
						<value-range
							max="64"
							min="1"
						/>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if($f.get(`ehome.runtime:Function#kind`) == `ehome.runtime:FunctionKind#scene`, null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</property>
				<!-- The datapoint the function is commanded with (light, switch: on/off; dimmer: on/off; scene: the scene number); writable. -->
				<reference name="command"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#light`, `ehome.runtime:FunctionKind#dimmer`, `ehome.runtime:FunctionKind#switch`, `ehome.runtime:FunctionKind#scene`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint reporting the state (on/off). -->
				<reference name="state"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#light`, `ehome.runtime:FunctionKind#dimmer`, `ehome.runtime:FunctionKind#switch`, `ehome.runtime:FunctionKind#button`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint the brightness is set with; writable. -->
				<reference name="levelCommand"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#dimmer`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint reporting the brightness. -->
				<reference name="level"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#dimmer`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint moving the blind up or down; writable. -->
				<reference name="move"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#blind`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint stopping the blind; writable. -->
				<reference name="stop"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#blind`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint reporting the position of the blind. -->
				<reference name="position"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#blind`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint the position of the blind is set with; writable. -->
				<reference name="positionCommand"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#blind`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint reporting the position of the slats. -->
				<reference name="slat"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#blind`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint the position of the slats is set with; writable. -->
				<reference name="slatCommand"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#blind`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint of the measured or reported value. -->
				<reference name="value"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#sensor`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint of the measured temperature. -->
				<reference name="temperature"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#climate`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint reporting the setpoint. -->
				<reference name="setpoint"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#climate`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint the setpoint is set with; writable. -->
				<reference name="setpointCommand"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#climate`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint reporting the operating mode. -->
				<reference name="mode"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#climate`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint the operating mode is set with; writable. -->
				<reference name="modeCommand"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#climate`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint reporting whether the room is heated. -->
				<reference name="heating"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#climate`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The datapoint the button sends when pressed. -->
				<reference name="press"
					kind="forwards"
					type="ehome.logical:GroupAddress"
				>
					<annotations>
						<options>
							<options-by-expression>
								<function><![CDATA[f -> runtimeGroupAddresses($f)]]></function>
							</options-by-expression>
						</options>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression">
								<function><![CDATA[f -> editMode -> if([`ehome.runtime:FunctionKind#button`].containsElement($f.get(`ehome.runtime:Function#kind`)), null, "hidden")]]></function>
							</mode-selector>
						</dynamic-visibility>
					</annotations>
				</reference>
				<!-- The device the function was proposed for; empty for a function the user created. -->
				<reference name="device"
					kind="forwards"
					type="ehome.physical:Device"
				/>
				<!-- The channel of the device the function was proposed for (its program channel or the name of its objects); a proposal adds no second function for it. -->
				<property name="channel"
					type="tl.core:String"
				/>
			</attributes>
		</class>
		<!--
			A proposed function the user deleted (haumacher/ehome #49): "Propose functions" proposes no
			function of this kind for this channel of the device again. Deleting the dismissal brings
			the proposal back on the next run.
		-->
		<class name="DismissedProposal">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-eye-slash"/>
			</annotations>
			<attributes>
				<!-- The name of the deleted function. -->
				<property name="name"
					type="tl.model.i18n:I18NString"
				/>
				<reference name="kind"
					kind="forwards"
					mandatory="true"
					type="FunctionKind"
				/>
				<!-- The device the function was proposed for. -->
				<reference name="device"
					kind="forwards"
					type="ehome.physical:Device"
				/>
				<!-- The channel of the device the function was proposed for (Function#channel). -->
				<property name="channel"
					type="tl.core:String"
				/>
			</attributes>
		</class>
		<!-- A reason why an image was refused, at a path of the image's JSON structure. -->
		<class name="Refusal">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-exclamation-triangle"/>
			</annotations>
			<attributes>
				<!-- The JSON path (datapoints[3].knx.send); empty for the document as a whole. -->
				<property name="path"
					type="tl.core:String"
				/>
				<property name="reason"
					type="tl.core:Text"
				/>
				<!-- The object of the project the path leads to: a group address, a part of a building. -->
				<reference name="element"
					kind="forwards"
					type="tl.model:TLObject"
				/>
			</attributes>
		</class>
	</module>
</model>
