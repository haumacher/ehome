<?xml version="1.0" encoding="utf-8" ?>

<!--
	The product catalogs imported from ETS projects: manufacturers, their catalogs with sections, and
	the product variants listed in a catalog, and below a variant the application programs of its
	product. A variant is referenced by its catalog, not contained in it, so the tree finds the
	catalog of a variant through that reference.

	The ETS import creates every manufacturer of the KNX master data. Only those with catalogs are
	shown, and those created here (they have no external ID).

	The detail pane shows the selected node in a form matching its type.
-->
<view>
	<channels>
		<channel name="selected"/>
		<derived-channel name="root"
			expr="x -> `ehome.catalog#ROOT`"
			inputs="selected"
		/>
		<derived-channel name="selectedManufacturer"
			expr="n -> if($n.instanceOf(`ehome.catalog:Manufacturer`), $n, null)"
			inputs="selected"
		/>
		<derived-channel name="selectedCatalog"
			expr="n -> if($n.instanceOf(`ehome.catalog:Catalog`), $n, null)"
			inputs="selected"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="240"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Catalogs</en>
						<de>Kataloge</de>
					</title>
					<commands>
						<generic-command
							clique="new"
							image="css:fa-solid fa-industry"
							input="root"
							placement="TOOLBAR"
						>
							<label>
								<en>Manufacturer</en>
								<de>Hersteller</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.catalog:Manufacturer"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="create-node.view.xml"
							>
								<bind
									channel="container"
									to="root"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-journal-plus"
							input="selectedManufacturer"
							placement="TOOLBAR"
						>
							<label>
								<en>Catalog</en>
								<de>Katalog</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.catalog:Catalog"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="create-node.view.xml"
							>
								<bind
									channel="container"
									to="selectedManufacturer"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-journal-text"
							input="selectedCatalog"
							placement="TOOLBAR"
						>
							<label>
								<en>Section</en>
								<de>Abschnitt</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.catalog:Catalog"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="create-node.view.xml"
							>
								<bind
									channel="container"
									to="selectedCatalog"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							input="selected"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="n -> #('Delete {0}?'@en, '{0} löschen?'@de).fill($n.label())"/>
							<delete-object/>
							<write-channel name="selected"/>
						</generic-command>
					</commands>
					<tree
						observed-types="ehome.catalog:Manufacturer,ehome.catalog:Catalog"
						selection="selected"
					>
						<root>`ehome.catalog#ROOT`</root>
						<children><![CDATA[node -> switch {
    $node.instanceOf(`ehome.catalog:ManufacturerRoot`):
        $node.get(`ehome.catalog:ManufacturerRoot#manufacturers`)
            .filter(m -> !$m.get(`ehome.catalog:Manufacturer#catalogs`).isEmpty()
                or $m.get(`ehome.core:Externalized#extId`) == null);
    $node.instanceOf(`ehome.catalog:Manufacturer`):
        $node.get(`ehome.catalog:Manufacturer#catalogs`);
    $node.instanceOf(`ehome.catalog:Catalog`):
        $node.get(`ehome.catalog:Catalog#sections`)
            .union($node.get(`ehome.catalog:Catalog#variants`));
    $node.instanceOf(`ehome.catalog:Variant`):
        $node.get(`ehome.catalog:Variant#product`).get(`ehome.catalog:Product#programs`);
    default: [];
}]]></children>
						<parents><![CDATA[node -> switch {
    $node.instanceOf(`ehome.catalog:Variant`):
        $node.referers(`ehome.catalog:Catalog#variants`);
    $node.instanceOf(`ehome.catalog:ProgramAssignment`):
        $node.get(`ehome.catalog:ProgramAssignment#product`).get(`ehome.catalog:Product#variants`);
    default: $node.container();
}]]></parents>
					</tree>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<panel>
					<title>
						<en>Details</en>
						<de>Details</de>
					</title>
					<switch input="selected">
						<case test="n -> $n.instanceOf(`ehome.catalog:Manufacturer`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="id"/>
								<field attribute="extId"/>
							</form>
						</case>
						<case test="n -> $n.instanceOf(`ehome.catalog:Catalog`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="extId"/>
							</form>
						</case>
						<case test="n -> $n.instanceOf(`ehome.catalog:Variant`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="orderNumber"/>
								<field attribute="product"/>
								<field attribute="extId"/>
							</form>
						</case>
						<!--
							An application program of the product: its parameters, as the configuration
							of a device shows them, with their defaults.
						-->
						<case test="n -> $n.instanceOf(`ehome.catalog:ProgramAssignment`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="program"/>
								<field attribute="extId"/>
							</form>
							<table
								types="ehome.operational:ParameterView"
							>
								<inputs>
									<input channel="selected"/>
								</inputs>
								<columns>
									<column attribute="title"
										width="320"
									/>
									<column attribute="displayDefault"
										width="220"
									/>
									<column attribute="effectiveAccess"
										width="120"
									/>
								</columns>
								<rows><![CDATA[a -> $a.get(`ehome.catalog:ProgramAssignment#program`)
    .get(`ehome.operational:Program#parameters`)
    .get(`ehome.operational:Parameter#views`)]]></rows>
							</table>
						</case>
					</switch>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
