<?xml version="1.0" encoding="utf-8" ?>

<!--
	An application program in the catalog: its configuration structure (channels, the channel
	independent part, parameter blocks, switches with their cases, and the parameters and
	communication objects placed in them), its parameters with their types and defaults, its
	communication objects, and its parameter types.

	Every tab creates, edits and deletes its elements. A new structure element goes into the selected
	element or after it (catalogs/create-structure.view.xml); "Move up" and "Move down" reorder an
	element among its siblings (the tree has no drag and drop yet, TL #29776). A placed parameter
	(communication object) is edited at its place: which definition it places, and its text, default
	and access there. The definitions are created in catalogs/create-program-element.view.xml.
	Imported programs are editable as well; a change applies to every device using the program.
-->
<view>
	<channels>
		<channel name="program"/>
		<channel name="selected"/>
		<derived-channel name="selectedNode"
			expr="n -> if($n.instanceOf(`ehome.operational:Program`), null, $n)"
			inputs="selected"
		/>
		<!-- What a new structure element is placed in or after: the selected element, otherwise the program. -->
		<derived-channel name="anchor"
			expr="p -> n -> if($n == null, $p, $n)"
			inputs="program, selected"
		/>
		<!-- The parameter definition a selected parameter reference places, and its type. -->
		<derived-channel name="placedParameter"
			expr="n -> if($n.instanceOf(`ehome.operational:ParameterView`), $n.get(`ehome.operational:ParameterView#parameter`), null)"
			inputs="selected"
		/>
		<derived-channel name="placedType"
			expr="p -> $p.get(`ehome.operational:Parameter#type`)"
			inputs="placedParameter"
		/>
		<!-- The parameter selected in the parameters tab. -->
		<channel name="selectedParameter"/>
		<!-- The communication object selected in the objects tab. -->
		<channel name="selectedPort"/>
		<!-- The parameter type selected in the types tab, and the entry selected of an enumeration type. -->
		<channel name="selectedType"/>
		<derived-channel name="selectedEnumeration"
			expr="t -> if($t.instanceOf(`ehome.operational:EnumerationType`), $t, null)"
			inputs="selectedType"
		/>
		<channel name="selectedEntry"/>
	</channels>

	<tab-bar active-tab="structure">
		<tabs>
			<tab id="structure"
				icon="css:bi bi-diagram-3"
			>
				<label>
					<en>Structure</en>
					<de>Struktur</de>
				</label>
				<split-panel
					orientation="horizontal"
					resizable="true"
				>
					<panes>
						<pane
							min-size="240"
							size="50"
							unit="%"
						>
							<panel>
								<title>
									<en>Structure</en>
									<de>Struktur</de>
								</title>
								<commands>
									<generic-command
										clique="new"
										image="css:bi bi-diagram-3"
										input="anchor"
										placement="TOOLBAR"
									>
										<label>
											<en>Channel</en>
											<de>Kanal</de>
										</label>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="a -> structureInsertVeto($a, `ehome.operational:Channel`)"/>
										</executability>
										<create-transient
											container="anchor"
											type="ehome.operational:Channel"
										/>
										<open-dialog
											bind-input-to="model"
											dialog-view="catalogs/create-structure.view.xml"
										>
											<bind
												channel="anchor"
												to="anchor"
											/>
											<bind
												channel="selection"
												to="selected"
											/>
										</open-dialog>
									</generic-command>
									<generic-command
										clique="new"
										image="css:bi bi-collection"
										input="anchor"
										placement="TOOLBAR"
									>
										<label>
											<en>Channel independent part</en>
											<de>Kanalunabhängiger Teil</de>
										</label>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="a -> structureInsertVeto($a, `ehome.operational:ChannelIndependent`)"/>
										</executability>
										<create-transient
											container="anchor"
											type="ehome.operational:ChannelIndependent"
										/>
										<open-dialog
											bind-input-to="model"
											dialog-view="catalogs/create-structure.view.xml"
										>
											<bind
												channel="anchor"
												to="anchor"
											/>
											<bind
												channel="selection"
												to="selected"
											/>
										</open-dialog>
									</generic-command>
									<generic-command
										clique="new"
										image="css:bi bi-card-list"
										input="anchor"
										placement="TOOLBAR"
									>
										<label>
											<en>Parameter block</en>
											<de>Parameterblock</de>
										</label>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="a -> structureInsertVeto($a, `ehome.operational:ParameterGroup`)"/>
										</executability>
										<create-transient
											container="anchor"
											type="ehome.operational:ParameterGroup"
										/>
										<open-dialog
											bind-input-to="model"
											dialog-view="catalogs/create-structure.view.xml"
										>
											<bind
												channel="anchor"
												to="anchor"
											/>
											<bind
												channel="selection"
												to="selected"
											/>
										</open-dialog>
									</generic-command>
									<generic-command
										clique="new"
										image="css:bi bi-signpost-split"
										input="anchor"
										placement="TOOLBAR"
									>
										<label>
											<en>Switch</en>
											<de>Fallunterscheidung</de>
										</label>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="a -> structureInsertVeto($a, `ehome.operational:Switch`)"/>
										</executability>
										<create-transient
											container="anchor"
											type="ehome.operational:Switch"
										/>
										<open-dialog
											bind-input-to="model"
											dialog-view="catalogs/create-structure.view.xml"
										>
											<bind
												channel="anchor"
												to="anchor"
											/>
											<bind
												channel="selection"
												to="selected"
											/>
										</open-dialog>
									</generic-command>
									<generic-command
										clique="new"
										image="css:bi bi-signpost"
										input="anchor"
										placement="TOOLBAR"
									>
										<label>
											<en>Case</en>
											<de>Fall</de>
										</label>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="a -> structureInsertVeto($a, `ehome.operational:Case`)"/>
										</executability>
										<create-transient
											container="anchor"
											type="ehome.operational:Case"
										/>
										<open-dialog
											bind-input-to="model"
											dialog-view="catalogs/create-structure.view.xml"
										>
											<bind
												channel="anchor"
												to="anchor"
											/>
											<bind
												channel="selection"
												to="selected"
											/>
										</open-dialog>
									</generic-command>
									<generic-command
										clique="new"
										image="css:bi bi-sliders"
										input="anchor"
										placement="TOOLBAR"
									>
										<label>
											<en>Place parameter</en>
											<de>Parameter platzieren</de>
										</label>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="a -> structureInsertVeto($a, `ehome.operational:ParameterView`)"/>
										</executability>
										<create-transient
											container="anchor"
											type="ehome.operational:ParameterView"
										/>
										<open-dialog
											bind-input-to="model"
											dialog-view="catalogs/create-structure.view.xml"
										>
											<bind
												channel="anchor"
												to="anchor"
											/>
											<bind
												channel="selection"
												to="selected"
											/>
										</open-dialog>
									</generic-command>
									<generic-command
										clique="new"
										image="css:bi bi-plug-fill"
										input="anchor"
										placement="TOOLBAR"
									>
										<label>
											<en>Place communication object</en>
											<de>Kommunikationsobjekt platzieren</de>
										</label>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="a -> structureInsertVeto($a, `ehome.operational:Interface`)"/>
										</executability>
										<create-transient
											container="anchor"
											type="ehome.operational:Interface"
										/>
										<open-dialog
											bind-input-to="model"
											dialog-view="catalogs/create-structure.view.xml"
										>
											<bind
												channel="anchor"
												to="anchor"
											/>
											<bind
												channel="selection"
												to="selected"
											/>
										</open-dialog>
									</generic-command>
									<generic-command
										image="css:bi bi-arrow-up"
										input="selectedNode"
										observed-types="ehome.operational:Option,ehome.operational:Case,ehome.operational:Program"
										placement="TOOLBAR"
									>
										<label>
											<en>Move up</en>
											<de>Nach oben</de>
										</label>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="n -> structureMoveVeto($n, -1)"/>
										</executability>
										<with-transaction>
											<execute-script function="n -> structureMove($n, -1)"/>
										</with-transaction>
									</generic-command>
									<generic-command
										image="css:bi bi-arrow-down"
										input="selectedNode"
										observed-types="ehome.operational:Option,ehome.operational:Case,ehome.operational:Program"
										placement="TOOLBAR"
									>
										<label>
											<en>Move down</en>
											<de>Nach unten</de>
										</label>
										<executability>
											<null-input-disabled/>
											<disabled-if expr="n -> structureMoveVeto($n, 1)"/>
										</executability>
										<with-transaction>
											<execute-script function="n -> structureMove($n, 1)"/>
										</with-transaction>
									</generic-command>
									<generic-command
										image="css:bi bi-trash"
										input="selectedNode"
										placement="TOOLBAR"
									>
										<label>
											<en>Delete</en>
											<de>Löschen</de>
										</label>
										<executability>
											<null-input-disabled/>
										</executability>
										<confirm expr="n -> #('Delete {0} with all its contents?'@en, '{0} mit allem Inhalt löschen?'@de).fill($n.label())"/>
										<delete-object/>
										<write-channel name="selected"/>
									</generic-command>
								</commands>
								<tree
									observed-types="ehome.operational:Option,ehome.operational:Case,ehome.operational:Program"
									selection="selected"
								>
									<inputs>
										<input channel="program"/>
									</inputs>
									<root>p -> $p</root>
									<children><![CDATA[p -> node -> switch {
    $node.instanceOf(`ehome.operational:Switch`):
        $node.get(`ehome.operational:Switch#alternatives`);
    $node.instanceOf(`ehome.operational:ConfigFragment`):
        $node.get(`ehome.operational:ConfigFragment#contents`);
    default: [];
}]]></children>
									<parents>p -> node -> $node.container()</parents>
								</tree>
							</panel>
						</pane>
						<pane
							size="50"
							unit="%"
						>
							<panel>
								<title>
									<en>Details</en>
									<de>Details</de>
								</title>
								<switch input="selected">
									<case test="n -> $n.instanceOf(`ehome.operational:Channel`)">
										<form
											input="selected"
											with-inset="true"
										>
											<field attribute="number"/>
											<field attribute="name"/>
											<field attribute="description"/>
											<field attribute="extId"/>
										</form>
									</case>
									<case test="n -> $n.instanceOf(`ehome.operational:ParameterGroup`)">
										<form
											input="selected"
											with-inset="true"
										>
											<field attribute="effectiveTitle"/>
											<field attribute="description"/>
											<field attribute="input"/>
											<field attribute="access"/>
											<field attribute="effectiveAccess"/>
											<field attribute="name"/>
											<field attribute="extId"/>
										</form>
									</case>
									<case test="n -> $n.instanceOf(`ehome.operational:Switch`)">
										<form
											input="selected"
											with-inset="true"
										>
											<field attribute="input"/>
										</form>
									</case>
									<case test="n -> $n.instanceOf(`ehome.operational:Case`)">
										<form
											input="selected"
											with-inset="true"
										>
											<field attribute="pattern"/>
											<field attribute="isDefault"/>
										</form>
									</case>
									<case test="n -> $n.instanceOf(`ehome.operational:ParameterView`)">
										<!--
											A parameter placed here: which parameter definition, and the text, default and
											access it has at this place (empty: those of the parameter). Its value is set per
											device; here only the default is known. The default is entered by the type of the
											parameter: only the field fitting the type's kind is shown. Below, the placed
											parameter with its own default (for comparison) and its type, for information.
										-->
										<form
											input="selected"
											with-inset="true"
										>
											<field attribute="parameter"/>
											<field attribute="description"/>
											<group>
												<label>
													<en>Default at this place</en>
													<de>Vorgabe an dieser Stelle</de>
												</label>
												<field attribute="choice"/>
												<field attribute="number"/>
												<field attribute="decimal"/>
												<field attribute="text"/>
												<field attribute="displayDefault"/>
												<field attribute="defaultSource"/>
											</group>
											<field attribute="access"/>
											<field attribute="effectiveAccess"/>
											<field attribute="extId"/>
										</form>
										<form
											input="placedParameter"
											with-inset="true"
											withEditMode="false"
										>
											<group>
												<label>
													<en>Parameter</en>
													<de>Parameter</de>
												</label>
												<field attribute="type"/>
												<field attribute="displayValue">
													<label>
														<en>Default of the parameter</en>
														<de>Vorgabe des Parameters</de>
													</label>
												</field>
												<field attribute="encodedValue"/>
											</group>
										</form>
										<form
											input="placedType"
											with-inset="true"
											withEditMode="false"
										>
											<group>
												<label>
													<en>Type</en>
													<de>Typ</de>
												</label>
												<field attribute="name"/>
												<field attribute="bits"/>
												<field attribute="kind"/>
												<field attribute="min"/>
												<field attribute="max"/>
												<field attribute="encoding"/>
												<field attribute="decimals"/>
												<field attribute="unit"/>
												<field attribute="pattern"/>
												<field attribute="showsYear"/>
												<field attribute="addressKind"/>
												<field attribute="version"/>
											</group>
										</form>
										<!-- The entries of an enumeration type. -->
										<switch input="placedType">
											<case test="t -> $t.instanceOf(`ehome.operational:EnumerationType`)">
												<table
													observed-types="ehome.operational:EnumerationValue"
													types="ehome.operational:EnumerationValue"
												>
													<inputs>
														<input channel="placedType"/>
													</inputs>
													<columns>
														<column attribute="name"
															width="320"
														/>
														<column attribute="value"
															width="100"
														/>
														<column attribute="index"
															width="100"
														/>
													</columns>
													<rows>t -> $t.get(`ehome.operational:EnumerationType#values`)</rows>
												</table>
											</case>
										</switch>
									</case>
									<case test="n -> $n.instanceOf(`ehome.operational:Interface`)">
										<!-- A communication object placed here: which object definition, and its texts and datapoint types at this place. -->
										<form
											input="selected"
											with-inset="true"
										>
											<field attribute="port"/>
											<field attribute="name"/>
											<field attribute="function"/>
											<field attribute="description"/>
											<field attribute="datapointTypes"/>
											<field attribute="extId"/>
										</form>
									</case>
								</switch>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</tab>
			<tab id="parameters"
				icon="css:bi bi-sliders"
			>
				<label>
					<en>Parameters</en>
					<de>Parameter</de>
				</label>
				<!-- The parameters of the program with their types and defaults; the selected one in a form. -->
				<split-panel
					orientation="horizontal"
					resizable="true"
				>
					<panes>
						<pane
							min-size="240"
							size="55"
							unit="%"
						>
							<panel>
								<title>
									<en>Parameters</en>
									<de>Parameter</de>
								</title>
								<commands>
									<generic-command
										image="css:bi bi-plus-lg"
										input="program"
										placement="TOOLBAR"
									>
										<label>
											<en>New parameter</en>
											<de>Neuer Parameter</de>
										</label>
										<executability>
											<null-input-disabled/>
										</executability>
										<create-transient
											container="program"
											reference="parameters"
											type="ehome.operational:Parameter"
										/>
										<open-dialog
											bind-input-to="model"
											dialog-view="catalogs/create-program-element.view.xml"
										>
											<bind
												channel="container"
												to="program"
											/>
											<bind
												channel="selection"
												to="selectedParameter"
											/>
										</open-dialog>
									</generic-command>
									<generic-command
										image="css:bi bi-trash"
										input="selectedParameter"
										placement="TOOLBAR"
									>
										<label>
											<en>Delete</en>
											<de>Löschen</de>
										</label>
										<executability>
											<null-input-disabled/>
										</executability>
										<if test="p -> programDeleteVeto($p) != null">
											<then>
												<notify
													display="dialog"
													expr="p -> programDeleteVeto($p)"
													kind="error"
													stop="true"
												/>
											</then>
										</if>
										<confirm expr="p -> #('Delete the parameter {0} with its {1} placements in the structure?'@en, 'Den Parameter {0} mit seinen {1} Platzierungen in der Struktur löschen?'@de).fill($p.label(), $p.get(`ehome.operational:Parameter#views`).size())"/>
										<with-transaction>
											<execute-script function="p -> programDelete($p)"/>
										</with-transaction>
										<write-channel name="selectedParameter"/>
									</generic-command>
								</commands>
								<table
									observed-types="ehome.operational:Parameter,ehome.operational:Program"
									selection="selectedParameter"
									types="ehome.operational:Parameter"
								>
									<inputs>
										<input channel="program"/>
									</inputs>
									<columns>
										<column attribute="description"
											width="280"
										/>
										<column attribute="name"
											width="160"
										/>
										<column attribute="type"
											width="200"
										/>
										<column attribute="displayValue"
											width="160"
										>
											<label>
												<en>Default</en>
												<de>Vorgabe</de>
											</label>
										</column>
										<column attribute="access"
											width="120"
										/>
										<computed-column name="placements"
											type="tl.core:Integer"
										>
											<label>
												<en>Placements</en>
												<de>Platzierungen</de>
											</label>
											<value>p -> $p.get(`ehome.operational:Parameter#views`).size()</value>
										</computed-column>
										<column attribute="extId"
											width="240"
										/>
									</columns>
									<rows>p -> $p.get(`ehome.operational:Program#parameters`)</rows>
								</table>
							</panel>
						</pane>
						<pane
							size="45"
							unit="%"
						>
							<panel>
								<title>
									<en>Details</en>
									<de>Details</de>
								</title>
								<form
									input="selectedParameter"
									with-inset="true"
								>
									<field attribute="description"/>
									<field attribute="name"/>
									<field attribute="type"/>
									<field attribute="access"/>
									<group>
										<label>
											<en>Default</en>
											<de>Vorgabe</de>
										</label>
										<field attribute="choice"/>
										<field attribute="number"/>
										<field attribute="decimal"/>
										<field attribute="text"/>
										<field attribute="displayValue"/>
										<field attribute="encodedValue"/>
									</group>
									<field attribute="extId"/>
								</form>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</tab>
			<tab id="objects"
				icon="css:bi bi-plug"
			>
				<label>
					<en>Objects</en>
					<de>Objekte</de>
				</label>
				<!-- The communication objects of the program; the selected one in a form. -->
				<split-panel
					orientation="horizontal"
					resizable="true"
				>
					<panes>
						<pane
							min-size="240"
							size="55"
							unit="%"
						>
							<panel>
								<title>
									<en>Communication objects</en>
									<de>Kommunikationsobjekte</de>
								</title>
								<commands>
									<generic-command
										image="css:bi bi-plus-lg"
										input="program"
										placement="TOOLBAR"
									>
										<label>
											<en>New communication object</en>
											<de>Neues Kommunikationsobjekt</de>
										</label>
										<executability>
											<null-input-disabled/>
										</executability>
										<create-transient
											container="program"
											reference="ports"
											type="ehome.operational:Port"
										/>
										<!-- The next free object number. -->
										<execute-script function="p -> o -> {
