    $t.instanceOf(`ehome.operational:EnumerationType`): $t.get(`ehome.operational:EnumerationType#bits`);
    $t.instanceOf(`ehome.operational:TextType`): $t.get(`ehome.operational:TextType#bits`);
    $t.instanceOf(`ehome.operational:TimeType`): $t.get(`ehome.operational:TimeType#bits`);
    default: null;
}]]></value>
