<?xml version="1.0" encoding="utf-8" ?>

<!--
	Searches the local networks for KNXnet/IP gateways and lists the gateways that answered.

	The search settings are optional: without a network interface, all interfaces are searched;
	without a local address, the system chooses one. The options are computed by the TL-Script
	function knxNetworkInterfaces() (de.haumacher.ehome.discover.KnxNetworkInterfaces).
-->
<view>
	<channels>
		<channel name="gateways"/>
		<channel name="networkInterface"/>
		<channel name="localHost"/>
		<channel name="useNat"/>
		<channel name="noMulticast"/>
	</channels>

	<panel>
		<title>
			<en>KNX gateways</en>
			<de>KNX-Gateways</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-broadcast"
				placement="TOOLBAR"
			>
				<label>
					<en>Search</en>
					<de>Suchen</de>
				</label>
				<execute-script function='networkInterface -> localHost -> useNat -> noMulticast -> x -> {
	"interface": $networkInterface,
	"local-host": $localHost,
	"use-nat": $useNat == true,
	"use-multicast": $noMulticast != true
}'>
					<inputs>
						<input channel="networkInterface"/>
						<input channel="localHost"/>
						<input channel="useNat"/>
						<input channel="noMulticast"/>
					</inputs>
				</execute-script>
				<discover-knx-gateways/>
				<write-channel name="gateways"/>
				<notify expr="rows -> if($rows.isEmpty(), #('No gateway answered.'@en, 'Kein Gateway hat geantwortet.'@de))"
					kind="warning"
				/>
			</generic-command>
		</commands>
		<fields with-inset="true">
			<value-input
				options="knxNetworkInterfaces()"
				value="networkInterface"
			>
				<label>
					<en>Network interface</en>
					<de>Netzwerkschnittstelle</de>
				</label>
			</value-input>
			<value-input
				inputs="networkInterface"
				options="networkInterface -> knxNetworkInterfaces(if($networkInterface == null, '', $networkInterface))"
				value="localHost"
			>
				<label>
					<en>Local address</en>
					<de>Lokale Adresse</de>
				</label>
			</value-input>
			<value-input
				type="tl.core:Boolean"
				value="useNat"
			>
				<label>
					<en>Search through NAT</en>
					<de>Über NAT suchen</de>
				</label>
			</value-input>
			<value-input
				type="tl.core:Boolean"
				value="noMulticast"
			>
				<label>
					<en>Disable multicast</en>
					<de>Multicast deaktivieren</de>
				</label>
			</value-input>
		</fields>
		<table>
			<inputs>
				<input channel="gateways"/>
			</inputs>
			<columns>
				<computed-column name="name"
					type="tl.core:String"
				>
					<label>
						<en>Name</en>
						<de>Name</de>
					</label>
					<value>row -> $row["name"]</value>
				</computed-column>
				<computed-column name="address"
					type="tl.core:String"
				>
					<label>
						<en>Individual address</en>
						<de>Physikalische Adresse</de>
					</label>
					<value>row -> $row["address"]</value>
				</computed-column>
				<computed-column name="endpoint"
					type="tl.core:String"
				>
					<label>
						<en>Control endpoint</en>
						<de>Steuerungs-Endpunkt</de>
					</label>
					<value>row -> $row["endpoint"]</value>
				</computed-column>
				<computed-column name="mac"
					type="tl.core:String"
				>
					<label>
						<en>MAC address</en>
						<de>MAC-Adresse</de>
					</label>
					<value>row -> $row["mac"]</value>
				</computed-column>
				<computed-column name="serial"
					type="tl.core:String"
				>
					<label>
						<en>Serial number</en>
						<de>Seriennummer</de>
					</label>
					<value>row -> $row["serial"]</value>
				</computed-column>
				<computed-column name="medium"
					type="tl.core:String"
				>
					<label>
						<en>Medium</en>
						<de>Medium</de>
					</label>
					<value>row -> $row["medium"]</value>
				</computed-column>
			</columns>
			<rows>gateways -> if($gateways == null, [], $gateways)</rows>
		</table>
	</panel>
</view>
