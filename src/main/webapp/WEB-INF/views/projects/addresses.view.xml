<?xml version="1.0" encoding="utf-8" ?>

<!--
	The group addresses of a project: the ranges and their addresses, and below each address its
	connections (ehome.physical:Connection), one node per communication object connected to it,
	labelled with the device, the object and the direction (connectionLabel), the sending ones first.
	The selected node is shown beside the tree: a range or an address with its connections, the
	datapoint types that do not fit together and the number of senders, or a connection with its
	device and the way to it in the device view.

	An address without a datapoint type in effect (GroupAddressTypes: neither the address nor an
	object names one, and the size of the objects does not decide it) is left out of the runtime
	image. The tree marks it (ehomeUntyped), the switch above the tree narrows the tree to such
	addresses and the ranges holding them, the details say why, and "Set the datapoint type" chooses
	a type for the address (projects/set-datapoint-type.view.xml).

	Objects are connected to the selected address and connections removed with the operations of
	the device view (deviceConnect, deviceDisconnect), so the rules of a connection hold on both
	sides. The connections are computed by Java functions (GroupAddressConnections), hence the tree,
	the table and the channels reading them observe connections and connectors: a connection made in
	the device view appears here, and the other way round, without reloading.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="selected"/>
		<!-- Whether the tree shows only the addresses without a datapoint type and the ranges holding them. -->
		<channel name="untypedOnly"/>
		<!--
			The selected node; nothing once its object was deleted (a connection removed in the device
			view), which a script cannot ask about the type of any more.
		-->
		<derived-channel name="node"
			expr="n -> existingObject($n)"
			inputs="selected"
			observed-types="ehome.physical:Connection,ehome.logical:GroupAddressDefinition"
		/>
		<derived-channel name="selectedDefinition"
			expr="n -> if($n.instanceOf(`ehome.logical:GroupAddressDefinition`), $n, null)"
			inputs="node"
		/>
		<derived-channel name="container"
			expr="p -> n -> if($n.instanceOf(`ehome.logical:GroupRange`), $n, if($n.instanceOf(`ehome.logical:GroupAddress`), $n.container(), $p))"
			inputs="project, node"
		/>
		<!-- The selected address, or the address of the selected connection: where an object is connected to. -->
		<derived-channel name="address"
			expr="n -> if($n.instanceOf(`ehome.logical:GroupAddress`), $n, if($n.instanceOf(`ehome.physical:Connection`), $n.get(`ehome.physical:Connection#target`), null))"
			inputs="node"
		/>
		<!-- The connection selected in the table of the selected address. -->
		<channel name="selectedRow"/>
		<!-- The selected connection: the node selected in the tree, or the row selected in the table of the selected address. -->
		<derived-channel name="connection"
			inputs="node, selectedRow"
			observed-types="ehome.physical:Connection"
		>
			<expr><![CDATA[n -> r -> switch {
    $n.instanceOf(`ehome.physical:Connection`): $n;
    $r != null and $n.instanceOf(`ehome.logical:GroupAddress`) and groupAddressConnections($n).containsElement($r): $r;
    default: null;
}]]></expr>
		</derived-channel>
		<!-- The device of the selected connection. -->
		<derived-channel name="connectionDevice"
			expr="c -> connectionDevice($c)"
			inputs="connection"
		/>
		<derived-channel name="connectionText"
			expr="c -> connectionLabel($c)"
			inputs="connection"
		/>
		<!-- What does not fit together at the selected address; nothing if all fits. -->
		<derived-channel name="problems"
			expr="a -> groupAddressProblems($a)"
			inputs="address"
			observed-types="ehome.physical:Connection,ehome.physical:Connector"
		/>
		<!-- Why the selected address has no datapoint type; nothing for an address that has one. -->
		<derived-channel name="typeHint"
			inputs="address"
			observed-types="ehome.logical:GroupAddress,ehome.physical:Connection,ehome.physical:Connector"
		>
			<expr><![CDATA[a -> if($a == null or groupAddressHasType($a), null,
    #("{0} has no datapoint type: neither the address nor its objects name one, and the size of the objects does not decide it. The runtime image leaves the address out until a type is set (“Set the datapoint type”)."@en,
      "{0} hat keinen Datenpunkttyp: Weder die Adresse noch ihre Objekte nennen einen, und die Größe der Objekte legt ihn nicht fest. Das Laufzeitabbild lässt die Adresse weg, bis ein Typ gesetzt ist („Datenpunkttyp setzen“)."@de)
        .fill($a.get(`ehome.logical:GroupAddress#displayName`)).localize())]]></expr>
		</derived-channel>
		<derived-channel name="senders"
			expr="a -> if($a == null, null, #('Sending objects: {0}'@en, 'Sendende Objekte: {0}'@de).fill(groupAddressSenders($a)).localize())"
			inputs="address"
			observed-types="ehome.physical:Connection,ehome.physical:Connector"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="240"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Group addresses</en>
						<de>Gruppenadressen</de>
					</title>
					<commands>
						<generic-command
							clique="new"
							image="css:bi bi-folder-plus"
							input="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Group range</en>
								<de>Gruppenbereich</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.logical:GroupRange"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="create-node.view.xml"
							>
								<bind
									channel="container"
									to="container"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							clique="new"
							image="css:fa-solid fa-wifi"
							input="container"
							placement="TOOLBAR"
						>
							<label>
								<en>Group address</en>
								<de>Gruppenadresse</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.logical:GroupAddress"/>
							<!-- The next free address of the range is proposed. -->
							<execute-script function="c -> a -> { $a.set(`ehome.logical:GroupAddress#address`, groupAddressNextFree($c)); $a }">
								<inputs>
									<input channel="container"/>
								</inputs>
							</execute-script>
							<open-dialog
								bind-input-to="model"
								dialog-view="create-node.view.xml"
							>
								<bind
									channel="container"
									to="container"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							input="selectedDefinition"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="n -> #('Delete {0}?'@en, '{0} löschen?'@de).fill($n.label())"/>
							<delete-object/>
							<write-channel name="selected"/>
						</generic-command>
						<generic-command
							image="css:bi bi-link-45deg"
							input="address"
							placement="TOOLBAR"
						>
							<label>
								<en>Connect an object</en>
								<de>Objekt verbinden</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="address"
								dialog-view="projects/connect-object.view.xml"
							>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-123"
							input="address"
							placement="TOOLBAR"
						>
							<label>
								<en>Set the datapoint type</en>
								<de>Datenpunkttyp setzen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="address"
								dialog-view="projects/set-datapoint-type.view.xml"
							>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-x-lg"
							input="connection"
							placement="TOOLBAR"
						>
							<label>
								<en>Remove the connection</en>
								<de>Verbindung entfernen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="c -> #('Remove the connection {0}?'@en, 'Verbindung {0} entfernen?'@de).fill(connectionLabel($c))"/>
							<with-transaction>
								<!-- The address of the removed connection is selected afterwards. -->
								<execute-script>
									<function><![CDATA[a -> c -> {
    deviceDisconnect($c);
    $a
}]]></function>
									<inputs>
										<input channel="address"/>
									</inputs>
								</execute-script>
							</with-transaction>
							<write-channel name="selected"/>
						</generic-command>
						<generic-command
							image="css:bi bi-box-arrow-up-right"
							input="connectionDevice"
							placement="TOOLBAR"
						>
							<label>
								<en>Go to the device</en>
								<de>Zum Gerät</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<show-views>
								<show view="projects/project.view.xml"
									label-expr="d -> recursion($d, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement().get(`ehome.project:Project#name`)"
								>
									<bind
										channel="project"
										expr="d -> recursion($d, x -> $x.container()).filter(x -> $x.instanceOf(`ehome.project:Project`)).firstElement()"
									/>
								</show>
								<show view="projects/devices.view.xml">
									<bind channel="selected"/>
								</show>
							</show-views>
						</generic-command>
					</commands>
					<stack>
						<inset>
							<fields>
								<value-input
									type="tl.core:Boolean"
									value="untypedOnly"
								>
									<label>
										<en>Only addresses without datapoint type</en>
										<de>Nur Adressen ohne Datenpunkttyp</de>
									</label>
									<input-control class="com.top_logic.layout.view.form.BooleanControlProvider"
										display="switch"
									/>
								</value-input>
							</fields>
						</inset>
						<tree
							observed-types="ehome.logical:GroupAddressDefinition,ehome.physical:Connection"
							selection="selected"
						>
							<inputs>
								<input channel="project"/>
								<input channel="untypedOnly"/>
							</inputs>
							<root>p -> f -> $p</root>
							<children><![CDATA[p -> f -> node -> switch {
    $node.instanceOf(`ehome.project:Project`) or $node.instanceOf(`ehome.logical:GroupRange`):
        if($f, groupAddressUntypedParts($node), groupAddressParts($node));
    $node.instanceOf(`ehome.logical:GroupAddress`):
        groupAddressConnections($node);
    default: [];
}]]></children>
							<parents>p -> f -> node -> if($node.instanceOf(`ehome.physical:Connection`), $node.get(`ehome.physical:Connection#target`), $node.container())</parents>
							<!-- An address without a datapoint type carries a mark after its label. -->
							<nodeContent class="de.haumacher.ehome.view.ScriptLabelControlProvider"
								css-class="x -> if($x.instanceOf(`ehome.logical:GroupAddress`) and !groupAddressHasType($x), 'ehomeUntyped', null)"
								label="x -> if($x.instanceOf(`ehome.physical:Connection`), connectionLabel($x), null)"
							/>
						</tree>
					</stack>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<!--
					Above, the selected node; below, the connections of the selected address (or of the
					address of the selected connection), with what does not fit together at it. The
					table stays outside of the switch over the selected node: a table in a switch case
					that disappears on a change of the channel its rows read fails (TL #29580).
				-->
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="50"
							unit="%"
						>
							<panel>
								<title>
									<en>Details</en>
									<de>Details</de>
								</title>
								<switch input="node">
									<case test="n -> $n.instanceOf(`ehome.logical:GroupRange`)">
										<form
											input="node"
											with-inset="true"
										>
											<field attribute="name"/>
											<field attribute="rangeStart"/>
											<field attribute="rangeEnd"/>
											<field attribute="unfiltered"/>
											<field attribute="description"/>
											<field attribute="extId"/>
										</form>
									</case>
									<case test="n -> $n.instanceOf(`ehome.logical:GroupAddress`)">
										<stack>
											<visible-if
												expr="h -> $h != null"
												input="typeHint"
											>
												<inset>
													<text
														input="typeHint"
														tone="warning"
													/>
												</inset>
											</visible-if>
											<form
												input="node"
												with-inset="true"
											>
												<field attribute="name"/>
												<field attribute="address"/>
												<field attribute="effectiveDatapointType"/>
												<field attribute="datapointTypes"/>
												<field attribute="central"/>
												<field attribute="unfiltered"/>
												<field attribute="description"/>
												<field attribute="extId"/>
											</form>
										</stack>
									</case>
									<case test="n -> $n.instanceOf(`ehome.physical:Connection`)">
										<!--
											A connection: which object of which device, the direction, and the device; the
											device is configured in the device view ("Go to the device").
										-->
										<stack>
											<inset>
												<text
													input="connectionText"
													variant="title"
												/>
											</inset>
											<form
												input="node"
												with-inset="true"
												withEditMode="false"
											>
												<field attribute="target"/>
												<field attribute="kind"/>
											</form>
											<form
												input="connectionDevice"
												with-inset="true"
												withEditMode="false"
											>
												<group>
													<label>
														<en>Device</en>
														<de>Gerät</de>
													</label>
													<field attribute="name"/>
													<field attribute="type"/>
													<field attribute="location"/>
													<field attribute="description"/>
												</group>
											</form>
										</stack>
									</case>
								</switch>
							</panel>
						</pane>
						<pane
							size="50"
							unit="%"
						>
							<panel>
								<title>
									<en>Connected objects</en>
									<de>Verbundene Objekte</de>
								</title>
								<stack>
									<inset>
										<stack gap="compact">
											<visible-if
												expr="p -> $p != null"
												input="problems"
											>
												<text
													input="problems"
													tone="warning"
												/>
											</visible-if>
											<text
												input="senders"
												tone="secondary"
											/>
										</stack>
									</inset>
									<table
										observed-types="ehome.physical:Connection,ehome.physical:Connector"
										selection="selectedRow"
										types="ehome.physical:Connection"
									>
										<inputs>
											<input channel="address"/>
										</inputs>
										<columns>
											<computed-column name="device"
												type="tl.core:String"
												width="200"
											>
												<label>
													<en>Device</en>
													<de>Gerät</de>
												</label>
												<value>c -> deviceLabel(connectionDevice($c))</value>
											</computed-column>
											<computed-column name="number"
												type="tl.core:Integer"
												width="90"
											>
												<label>
													<en>No.</en>
													<de>Nr.</de>
												</label>
												<value>c -> connectionObject($c).get(`ehome.operational:Interface#port`).get(`ehome.operational:Port#index`)</value>
											</computed-column>
											<computed-column name="object"
												type="tl.core:String"
												width="170"
											>
												<label>
													<en>Object</en>
													<de>Objekt</de>
												</label>
												<value>c -> connectionObject($c).get(`ehome.operational:Interface#displayName`)</value>
											</computed-column>
											<computed-column name="function"
												type="tl.core:String"
												width="130"
											>
												<label>
													<en>Function</en>
													<de>Funktion</de>
												</label>
												<value>c -> connectionFunction($c)</value>
											</computed-column>
											<column attribute="kind"
												width="130"
											>
												<label>
													<en>Direction</en>
													<de>Richtung</de>
												</label>
											</column>
											<computed-column name="datapointType"
												type="ehome.datapoint:DatapointType"
												width="200"
											>
												<label>
													<en>Datapoint type of the object</en>
													<de>Datenpunkttyp des Objekts</de>
												</label>
												<value>c -> connectionDatapointType($c)</value>
											</computed-column>
										</columns>
										<rows>a -> if($a == null, [], groupAddressConnections($a))</rows>
									</table>
								</stack>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</pane>
		</panes>
	</split-panel>
</view>
