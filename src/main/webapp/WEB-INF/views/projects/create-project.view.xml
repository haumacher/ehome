<?xml version="1.0" encoding="utf-8" ?>

<!--
	Create dialog for an empty project. "model" carries the transient project bound by the opening
	command; the created project is written to "selection". The project gets its external ID
	(P-xxxx, as in ETS) when it is created (de.haumacher.ehome.knx.ExtIds).
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="selection"/>
	</channels>
	<window width="500px">
		<title>
			<en>New project</en>
			<de>Neues Projekt</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<field attribute="groupAddressStyle"/>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					input="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Erstellen</de>
					</label>
					<store-form-state/>
					<persist-transient/>
					<write-channel name="selection"/>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
