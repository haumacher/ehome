<?xml version="1.0" encoding="utf-8" ?>

<!--
	The topology of a project: areas, their lines, the devices on a line and the connectors of a
	device that are in use. Devices not placed in a line yet follow the areas. The selected node is
	shown in a form beside the tree, a device with its parameter settings; the selected setting is
	edited by the type of its parameter.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="selected"/>
		<derived-channel name="selectedNode"
			expr="n -> if($n.instanceOf(`ehome.project:Project`), null, $n)"
			inputs="selected"
		/>
		<derived-channel name="selectedArea"
			expr="n -> if($n.instanceOf(`ehome.physical:Area`), $n, null)"
			inputs="selected"
		/>
		<!--
			The parameter setting selected in the settings of a device; the setting shown is the one of the
			selected device only (the table leaves a selection it has no row for in the channel). Its
			parameter definition and the type of that.
		-->
		<channel name="selectedSetting"/>
		<derived-channel name="setting"
			expr="d -> s -> if($s != null and $s.container() == $d, $s, null)"
			inputs="selected, selectedSetting"
		/>
		<derived-channel name="settingParameter"
			expr="s -> $s.get(`ehome.physical:ParameterSetting#parameter`).get(`ehome.operational:ParameterView#parameter`)"
			inputs="setting"
		/>
		<derived-channel name="settingType"
			expr="p -> $p.get(`ehome.operational:Parameter#type`)"
			inputs="settingParameter"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="240"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Devices</en>
						<de>Geräte</de>
					</title>
					<commands>
						<generic-command
							clique="new"
							image="css:bi bi-diagram-3"
							input="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Area</en>
								<de>Bereich</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.physical:Area"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="create-node.view.xml"
							>
								<bind
									channel="container"
									to="project"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-dash-lg"
							input="selectedArea"
							placement="TOOLBAR"
						>
							<label>
								<en>Line</en>
								<de>Linie</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.physical:Line"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="create-node.view.xml"
							>
								<bind
									channel="container"
									to="selectedArea"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							input="selectedNode"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="n -> #('Delete {0}?'@en, '{0} löschen?'@de).fill($n.label())"/>
							<delete-object/>
							<write-channel name="selected"/>
						</generic-command>
					</commands>
					<tree
						observed-types="ehome.physical:Area,ehome.physical:Line,ehome.physical:Device"
						selection="selected"
					>
						<inputs>
							<input channel="project"/>
						</inputs>
						<root>p -> $p</root>
						<children><![CDATA[p -> node -> switch {
    $node.instanceOf(`ehome.project:Project`):
        concat(
            $node.get(`ehome.project:Project#areas`),
            $node.get(`ehome.project:Project#unassignedDevices`));
    $node.instanceOf(`ehome.physical:Area`):
        $node.get(`ehome.physical:Area#lines`);
    $node.instanceOf(`ehome.physical:Line`):
        $node.get(`ehome.physical:Line#devices`);
    $node.instanceOf(`ehome.physical:Device`):
        $node.get(`ehome.physical:Device#connectors`)
            .filter(c -> $c.get(`ehome.physical:Connector#active`) != false);
    default: [];
}]]></children>
						<parents>p -> node -> $node.container()</parents>
					</tree>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<panel>
					<title>
						<en>Details</en>
						<de>Details</de>
					</title>
					<switch input="selected">
						<case test="n -> $n.instanceOf(`ehome.physical:Area`) or $n.instanceOf(`ehome.physical:Line`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="address"/>
								<field attribute="extId"/>
							</form>
						</case>
						<case test="n -> $n.instanceOf(`ehome.physical:Device`)">
							<!--
								The device above, its parameter settings below: the parameter values set in the
								project (all others have their default). The selected setting is edited beside the
								table by the type of its parameter: only the field fitting the type's kind is
								shown. Below it, the placed parameter, the encoding of the value in ETS and the
								type, for information.
							-->
							<split-panel
								orientation="vertical"
								resizable="true"
							>
								<panes>
									<pane
										size="40"
										unit="%"
									>
										<form
											input="selected"
											with-inset="true"
										>
											<field attribute="title"/>
											<field attribute="address"/>
											<field attribute="type"/>
											<field attribute="program"/>
											<field attribute="location"/>
											<field attribute="description"/>
											<field attribute="installationHints"/>
											<field attribute="serialNumber"/>
											<field attribute="loaded"/>
											<field attribute="lastModified"/>
											<field attribute="lastDownload"/>
											<field attribute="downloadPending"/>
											<field attribute="extId"/>
										</form>
									</pane>
									<pane
										size="60"
										unit="%"
									>
										<split-panel
											orientation="horizontal"
											resizable="true"
										>
											<panes>
												<pane
													min-size="240"
													size="55"
													unit="%"
												>
													<panel>
														<title>
															<en>Parameter settings</en>
															<de>Parametereinstellungen</de>
														</title>
														<table
															observed-types="ehome.physical:ParameterSetting"
															selection="selectedSetting"
															types="ehome.physical:ParameterSetting"
														>
															<inputs>
																<input channel="selected"/>
															</inputs>
															<columns>
																<column attribute="name"
																	width="240"
																/>
																<column attribute="displayValue"
																	width="120"
																>
																	<label>
																		<en>Value</en>
																		<de>Wert</de>
																	</label>
																</column>
																<column attribute="displayDefault"
																	width="120"
																/>
															</columns>
															<rows>d -> $d.get(`ehome.physical:Device#settings`)</rows>
														</table>
													</panel>
												</pane>
												<pane
													min-size="240"
													size="45"
													unit="%"
												>
													<panel>
														<title>
															<en>Parameter setting</en>
															<de>Parametereinstellung</de>
														</title>
														<!-- Nothing while no setting of the device is selected. -->
														<visible-if
															expr="s -> $s != null"
															input="setting"
														>
															<form
																input="setting"
																with-inset="true"
															>
																<group>
																	<label>
																		<en>Value</en>
																		<de>Wert</de>
																	</label>
																	<field attribute="choice"/>
																	<field attribute="number"/>
																	<field attribute="decimal"/>
																	<field attribute="text"/>
																</group>
																<field attribute="displayDefault"/>
															</form>
															<form
																input="setting"
																with-inset="true"
																withEditMode="false"
															>
																<field attribute="parameter"/>
																<field attribute="encodedValue"/>
															</form>
															<form
																input="settingType"
																with-inset="true"
																withEditMode="false"
															>
																<group>
																	<label>
																		<en>Type</en>
																		<de>Typ</de>
																	</label>
																	<field attribute="name"/>
																	<field attribute="bits"/>
																	<field attribute="kind"/>
																	<field attribute="min"/>
																	<field attribute="max"/>
																	<field attribute="encoding"/>
																	<field attribute="decimals"/>
																	<field attribute="unit"/>
																	<field attribute="pattern"/>
																	<field attribute="showsYear"/>
																	<field attribute="addressKind"/>
																	<field attribute="version"/>
																</group>
															</form>
															<!-- The entries of an enumeration type. -->
															<switch input="settingType">
																<case test="t -> $t.instanceOf(`ehome.operational:EnumerationType`)">
																	<table
																		observed-types="ehome.operational:EnumerationValue"
																		types="ehome.operational:EnumerationValue"
																	>
																		<inputs>
																			<input channel="settingType"/>
																		</inputs>
																		<columns>
																			<column attribute="name"
																				width="200"
																			/>
																			<column attribute="value"
																				width="100"
																			/>
																			<column attribute="index"
																				width="100"
																			/>
																		</columns>
																		<rows>t -> $t.get(`ehome.operational:EnumerationType#values`)</rows>
																	</table>
																</case>
															</switch>
														</visible-if>
													</panel>
												</pane>
											</panes>
										</split-panel>
									</pane>
								</panes>
							</split-panel>
						</case>
						<case test="n -> $n.instanceOf(`ehome.physical:Connector`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="port"/>
								<field attribute="active"/>
								<field attribute="effectiveDatapointType"/>
								<field attribute="function"/>
								<field attribute="description"/>
								<field attribute="priority"/>
								<field attribute="connections"/>
							</form>
						</case>
					</switch>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
