<?xml version="1.0" encoding="utf-8" ?>

<!--
	The topology of a project: areas, their lines and the devices on a line; devices not placed in a
	line yet follow the areas. A device changed since its last download is marked. The selected node
	is shown beside the tree; a device with its data, its configuration by the structure of its
	program (projects/device-item.view.xml for each entry of a page; a page holding a change since the
	last download is marked), its communication objects with the group addresses they are connected
	to, its changes against the state of the last download or the defaults
	(projects/device-change-group.view.xml per page), and its programming
	(projects/device-programming.view.xml).

	The changes are computed by the Java functions of DeviceChangeFunctions (haumacher/ehome #15):
	the channels and lists reading them name the settings, connectors and connections of devices and
	the devices (a download moves the reference) as observed types.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="selected"/>
		<derived-channel name="selectedNode"
			expr="n -> if($n.instanceOf(`ehome.project:Project`), null, $n)"
			inputs="selected"
		/>
		<derived-channel name="selectedArea"
			expr="n -> if($n.instanceOf(`ehome.physical:Area`), $n, null)"
			inputs="selected"
		/>
		<!-- The selected device. -->
		<derived-channel name="device"
			expr="n -> if($n.instanceOf(`ehome.physical:Device`), $n, null)"
			inputs="selected"
		/>
		<!--
			What the device's values select in the structure of its program (the cases of its switches);
			changes when a value opens or closes a part of the structure, which rebuilds the pages. The
			function is implemented in Java (TL #29799), hence the observed settings.
		-->
		<derived-channel name="configuration"
			expr="d -> if($d == null, null, deviceSelectedCases($d))"
			inputs="device"
			observed-types="ehome.physical:ParameterSetting"
		/>
		<!-- The page selected in the device's configuration; the device itself (the top) without one. -->
		<channel name="page"/>
		<derived-channel name="shownPage"
			expr="d -> p -> if($p == null, $d, $p)"
			inputs="device, page"
		/>
		<!-- The communication object selected (only one of the selected device), and the connection selected of it. -->
		<channel name="selectedInterface"/>
		<derived-channel name="interface"
			expr="d -> i -> if($d != null and $i != null and deviceInterfaces($d).containsElement($i), $i, null)"
			inputs="device, selectedInterface"
			observed-types="ehome.physical:Connector,ehome.physical:Connection,ehome.physical:ParameterSetting"
		/>
		<channel name="selectedConnection"/>
		<derived-channel name="connection"
			expr="d -> i -> c -> if($i != null and $c != null and deviceConnections($d, $i).containsElement($c), $c, null)"
			inputs="device, interface, selectedConnection"
			observed-types="ehome.physical:Connection"
		/>
		<!--
			The pages of the configuration holding a change since the last download; an input of the tree
			of pages, which is built anew with its marks when they change.
		-->
		<derived-channel name="changedPages"
			expr="d -> if($d == null, [], deviceChangedPages($d))"
			inputs="device"
			observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
		/>
		<!--
			What the changes of the device are listed against: the state of the last download (the
			default where one is known) or the defaults of the program. "No value" falls back to the
			default choice (TL #29805). The choice is the first input: the reverse writes it.
		-->
		<channel name="chosenReference"/>
		<derived-channel name="reference"
			expr="r -> d -> if($d == null, null, deviceChangeReference($d, $r))"
			inputs="chosenReference, device"
			observed-types="ehome.physical:Device"
			reverse="r -> $r"
		/>
		<derived-channel name="changeSummary"
			inputs="device, reference"
			observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
		>
			<expr><![CDATA[d -> r -> if($d == null, null, {
    count = deviceChangeCount($d, $r);
    if($r == `ehome.physical:ChangeReference#device`,
        #("Changes since the last download: {0}"@en, "Änderungen seit dem letzten Download: {0}"@de),
        #("Values other than the default: {0}"@en, "Von der Vorgabe abweichende Werte: {0}"@de))
        .fill($count).localize()
})]]></expr>
		</derived-channel>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="240"
				size="40"
				unit="%"
			>
				<panel>
					<title>
						<en>Devices</en>
						<de>Geräte</de>
					</title>
					<commands>
						<generic-command
							clique="new"
							image="css:bi bi-diagram-3"
							input="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Area</en>
								<de>Bereich</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.physical:Area"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="create-node.view.xml"
							>
								<bind
									channel="container"
									to="project"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							clique="new"
							image="css:bi bi-dash-lg"
							input="selectedArea"
							placement="TOOLBAR"
						>
							<label>
								<en>Line</en>
								<de>Linie</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient type="ehome.physical:Line"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="create-node.view.xml"
							>
								<bind
									channel="container"
									to="selectedArea"
								/>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							input="selectedNode"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="n -> #('Delete {0}?'@en, '{0} löschen?'@de).fill($n.label())"/>
							<delete-object/>
							<write-channel name="selected"/>
						</generic-command>
						<generic-command
							image="css:bi bi-arrow-counterclockwise"
							input="project"
							observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
							placement="TOOLBAR"
						>
							<label>
								<en>Discard all changes of all devices since their last download</en>
								<de>Alle Änderungen aller Geräte seit dem letzten Download verwerfen</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="p -> projectDiscardVeto($p)"/>
							</executability>
							<confirm expr="p -> projectDiscardConfirmation($p)"/>
							<with-transaction>
								<execute-script function="p -> projectDiscardChanges($p)"/>
							</with-transaction>
						</generic-command>
					</commands>
					<tree
						observed-types="ehome.physical:Area,ehome.physical:Line,ehome.physical:Device"
						selection="selected"
					>
						<inputs>
							<input channel="project"/>
						</inputs>
						<root>p -> $p</root>
						<children><![CDATA[p -> node -> switch {
    $node.instanceOf(`ehome.project:Project`):
        concat(
            $node.get(`ehome.project:Project#areas`),
            $node.get(`ehome.project:Project#unassignedDevices`));
    $node.instanceOf(`ehome.physical:Area`):
        $node.get(`ehome.physical:Area#lines`);
    $node.instanceOf(`ehome.physical:Line`):
        $node.get(`ehome.physical:Line#devices`);
    default: [];
}]]></children>
						<parents>p -> node -> $node.container()</parents>
						<!-- A device changed since its last download is marked (it changes with every change of its configuration). -->
						<nodeContent class="de.haumacher.ehome.view.ScriptLabelControlProvider"
							css-class="x -> if($x.instanceOf(`ehome.physical:Device`) and deviceChanged($x, $x), 'ehomeChanged', null)"
						/>
					</tree>
				</panel>
			</pane>
			<pane
				size="60"
				unit="%"
			>
				<panel>
					<title>
						<en>Details</en>
						<de>Details</de>
					</title>
					<switch input="selected">
						<case test="n -> $n.instanceOf(`ehome.physical:Area`) or $n.instanceOf(`ehome.physical:Line`)">
							<form
								input="selected"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="address"/>
								<field attribute="extId"/>
							</form>
						</case>
						<case test="n -> $n.instanceOf(`ehome.physical:Device`)">
							<!--
								A device: its data, its configuration by the structure of its program, its
								communication objects with their group addresses, and the values the project
								changed.
							-->
							<tab-bar active-tab="parameters">
								<tabs>
									<tab id="device"
										icon="css:bi bi-info-circle"
									>
										<label>
											<en>Device</en>
											<de>Gerät</de>
										</label>
										<!--
											The location is chosen from the building parts of the project in a dialog
											(projects/choose-location.view.xml), not from the plain reference field, which
											would offer the parts of every project without their path.
										-->
										<form
											input="selected"
											with-inset="true"
										>
											<commands>
												<generic-command
													image="css:fa-solid fa-location-dot"
													input="device"
													placement="TOOLBAR"
												>
													<label>
														<en>Choose the location</en>
														<de>Standort wählen</de>
													</label>
													<executability>
														<null-input-disabled/>
													</executability>
													<open-dialog
														bind-input-to="device"
														dialog-view="projects/choose-location.view.xml"
													>
														<bind
															channel="selection"
															to="selected"
														/>
													</open-dialog>
												</generic-command>
											</commands>
											<field attribute="title"/>
											<field attribute="address"/>
											<field attribute="type"/>
											<field attribute="program"/>
											<field attribute="location"
												readonly="true"
											/>
											<field attribute="description"/>
											<field attribute="installationHints"/>
											<field attribute="serialNumber"/>
											<field attribute="loaded"/>
											<field attribute="lastModified"/>
											<field attribute="lastDownload"/>
											<field attribute="downloadPending"/>
											<field attribute="extId"/>
										</form>
									</tab>
									<tab id="parameters"
										icon="css:bi bi-sliders"
									>
										<label>
											<en>Parameters</en>
											<de>Parameter</de>
										</label>
										<!--
											The configuration as ETS shows it: the pages of the program's structure
											(channels, the channel independent part, parameter blocks) in effect with the
											device's values, and the parameters and communication objects of the selected
											page, each parameter with the input of its type. A change that selects another
											case of a switch changes the pages and the entries at once.
										-->
										<split-panel
											orientation="horizontal"
											resizable="true"
										>
											<panes>
												<pane
													min-size="200"
													size="35"
													unit="%"
												>
													<tree
														observed-types="ehome.physical:ParameterSetting"
														selection="page"
													>
														<inputs>
															<input channel="device"/>
															<input channel="configuration"/>
															<input channel="changedPages"/>
														</inputs>
														<root>d -> c -> m -> $d</root>
														<children>d -> c -> m -> node -> devicePages($d, $node)</children>
														<parents>d -> c -> m -> node -> deviceParentPage($d, $node)</parents>
														<!-- A page holding a change since the last download (on it or below it) is marked. -->
														<nodeContent class="de.haumacher.ehome.view.ScriptLabelControlProvider"
															css-class="d -> x -> if(deviceChanged($d, $x), 'ehomeChanged', null)"
															inputs="device"
														/>
													</tree>
												</pane>
												<pane
													min-size="300"
													size="65"
													unit="%"
												>
													<inset>
														<object-list
															element-channel="item"
															gap="compact"
															inputs="device, shownPage, configuration"
															items="d -> p -> c -> deviceItems($d, $p)"
															observed-types="ehome.physical:ParameterSetting"
														>
															<item>
																<view-ref view="projects/device-item.view.xml">
																	<bind
																		channel="device"
																		to="device"
																	/>
																	<bind
																		channel="item"
																		to="item"
																	/>
																</view-ref>
															</item>
															<empty-text>
																<en>Nothing to set here; the parameters are on the pages below.</en>
																<de>Hier ist nichts einzustellen; die Parameter stehen auf den Seiten darunter.</de>
															</empty-text>
														</object-list>
													</inset>
												</pane>
											</panes>
										</split-panel>
									</tab>
									<tab id="objects"
										icon="css:bi bi-plug-fill"
									>
										<label>
											<en>Communication objects</en>
											<de>Kommunikationsobjekte</de>
										</label>
										<!--
											The communication objects in effect (and those no longer in effect that still
											have connections), and the group addresses the selected one is connected to.
										-->
										<split-panel
											orientation="horizontal"
											resizable="true"
										>
											<panes>
												<pane
													min-size="240"
													size="65"
													unit="%"
												>
													<table
														observed-types="ehome.physical:Connection,ehome.physical:Connector,ehome.physical:ParameterSetting,ehome.physical:Device"
														selection="selectedInterface"
														types="ehome.operational:Interface"
													>
														<inputs>
															<input channel="device"/>
															<input channel="configuration"/>
														</inputs>
														<columns>
															<computed-column name="number"
																type="tl.core:Integer"
																width="50"
															>
																<label>
																	<en>No.</en>
																	<de>Nr.</de>
																</label>
																<value>i -> $i.get(`ehome.operational:Interface#port`).get(`ehome.operational:Port#index`)</value>
															</computed-column>
															<column attribute="displayName"
																width="170"
															/>
															<column attribute="function"
																width="130"
															/>
															<computed-column name="connections"
																multiple="true"
																type="ehome.physical:Connection"
																width="200"
															>
																<inputs>
																	<input channel="device"/>
																</inputs>
																<label>
																	<en>Group addresses</en>
																	<de>Gruppenadressen</de>
																</label>
																<value>d -> i -> deviceConnections($d, $i)</value>
															</computed-column>
															<!-- What the device holds where the connections changed since the last download. -->
															<computed-column name="device"
																type="tl.core:String"
																width="220"
															>
																<inputs>
																	<input channel="device"/>
																</inputs>
																<label>
																	<en>Since the last download</en>
																	<de>Seit dem letzten Download</de>
																</label>
																<value>d -> i -> deviceReferenceHint($d, $i)</value>
															</computed-column>
														</columns>
														<rows>d -> c -> deviceInterfaces($d)</rows>
													</table>
												</pane>
												<pane
													min-size="200"
													size="35"
													unit="%"
												>
													<panel>
														<title>
															<en>Group addresses</en>
															<de>Gruppenadressen</de>
														</title>
														<commands>
															<generic-command
																image="css:bi bi-link-45deg"
																input="interface"
																placement="TOOLBAR"
															>
																<label>
																	<en>Connect a group address</en>
																	<de>Gruppenadresse verbinden</de>
																</label>
																<executability>
																	<null-input-disabled/>
																</executability>
																<open-dialog
																	bind-input-to="interface"
																	dialog-view="projects/connect-group-address.view.xml"
																>
																	<bind
																		channel="device"
																		to="device"
																	/>
																	<bind
																		channel="selection"
																		to="selectedConnection"
																	/>
																</open-dialog>
															</generic-command>
															<generic-command
																image="css:bi bi-x-lg"
																input="connection"
																placement="TOOLBAR"
															>
																<label>
																	<en>Remove the connection</en>
																	<de>Verbindung entfernen</de>
																</label>
																<executability>
																	<null-input-disabled/>
																</executability>
																<with-transaction>
																	<execute-script function="c -> deviceDisconnect($c)"/>
																</with-transaction>
																<write-channel name="selectedConnection"/>
															</generic-command>
														</commands>
														<table
															observed-types="ehome.physical:Connection,ehome.physical:Connector"
															selection="selectedConnection"
															types="ehome.physical:Connection"
														>
															<inputs>
																<input channel="device"/>
																<input channel="interface"/>
															</inputs>
															<columns>
																<column attribute="target"
																	width="220"
																/>
																<column attribute="kind"
																	width="100"
																/>
															</columns>
															<rows>d -> i -> if($i == null, [], deviceConnections($d, $i))</rows>
														</table>
													</panel>
												</pane>
											</panes>
										</split-panel>
									</tab>
									<tab id="settings"
										icon="css:bi bi-pencil-square"
									>
										<label>
											<en>Changed values</en>
											<de>Geänderte Werte</de>
										</label>
										<!--
											The changes of the device against the state of its last download (offered when
											one is known, and the default then) or against the defaults of its program, grouped
											by the page of the structure they are shown on, each entry with its input and the
											ways back to the default and to the device's state. Discarding all changes since
											the last download sets the device back to that state.
										-->
										<panel>
											<title>
												<en>Changed values</en>
												<de>Geänderte Werte</de>
											</title>
											<commands>
												<generic-command
													image="css:bi bi-arrow-counterclockwise"
													input="device"
													observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
													placement="TOOLBAR"
												>
													<label>
														<en>Discard all changes since the last download</en>
														<de>Alle Änderungen seit dem letzten Download verwerfen</de>
													</label>
													<executability>
														<null-input-disabled/>
														<disabled-if expr="d -> deviceDiscardVeto($d)"/>
													</executability>
													<confirm expr="d -> deviceDiscardConfirmation($d)"/>
													<with-transaction>
														<execute-script function="d -> deviceDiscardChanges($d)"/>
													</with-transaction>
												</generic-command>
											</commands>
											<inset>
												<stack gap="default">
													<fields>
														<value-input
															inputs="device"
															label-position="hide-label"
															options="d -> deviceChangeReferences($d)"
															type="ehome.physical:ChangeReference"
															value="reference"
														>
															<label>
																<en>Compared with</en>
																<de>Verglichen mit</de>
															</label>
															<input-control class="com.top_logic.layout.view.form.SelectControlProvider"
																display="radio"
																orientation="horizontal"
															/>
														</value-input>
													</fields>
													<text
														input="changeSummary"
														tone="secondary"
													/>
													<object-list
														element-channel="changeGroup"
														gap="default"
														inputs="device, reference"
														items="d -> r -> if($d == null, [], deviceChangeGroups($d, $r))"
														observed-types="ehome.physical:ParameterSetting,ehome.physical:Connector,ehome.physical:Connection,ehome.physical:Device"
													>
														<item>
															<view-ref view="projects/device-change-group.view.xml">
																<bind
																	channel="device"
																	to="device"
																/>
																<bind
																	channel="group"
																	to="changeGroup"
																/>
															</view-ref>
														</item>
														<empty-text>
															<en>No changes.</en>
															<de>Keine Änderungen.</de>
														</empty-text>
													</object-list>
												</stack>
											</inset>
										</panel>
									</tab>
									<tab id="programming"
										icon="css:bi bi-cpu"
									>
										<label>
											<en>Programming</en>
											<de>Programmierung</de>
										</label>
										<!--
											The download into the device over the project's KNX gateway: the plan, the
											comparison with the device, the download (projects/device-programming.view.xml).
										-->
										<view-ref view="projects/device-programming.view.xml">
											<bind
												channel="device"
												to="device"
											/>
											<bind
												channel="project"
												to="project"
											/>
										</view-ref>
									</tab>
								</tabs>
							</tab-bar>
						</case>
					</switch>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
