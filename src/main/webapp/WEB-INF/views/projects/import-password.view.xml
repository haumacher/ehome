<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the ETS import for a project file whose project is protected by a password (ETS 5/6,
	haumacher/ehome #32): asks for the project password and imports the file with it.

	"request" carries the result of <import-ets-project> for the file uploaded without a password
	(de.haumacher.ehome.etsImport.ImportEtsProjectAction): the file in "file", the reason in
	"message". A wrong password fails the import with the reason, and the dialog stays open for another
	attempt. The imported project is written to "project"; messages of the import are shown in the
	report dialog (import-report.view.xml).
-->
<view>
	<channels>
		<channel name="request"/>
		<channel name="password"/>
		<channel name="project"/>
		<derived-channel name="reason"
			expr='r -> if($r == null, null, $r["message"])'
			inputs="request"
		/>
	</channels>
	<window width="600px">
		<title>
			<en>ETS import: project password</en>
			<de>ETS-Import: Projektpasswort</de>
		</title>
		<inset>
			<stack gap="default">
				<text input="reason"/>
				<fields>
					<value-input
						type="tl.core:String"
						value="password"
					>
						<label>
							<en>Project password</en>
							<de>Projektpasswort</de>
						</label>
						<input-control class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
					</value-input>
				</fields>
			</stack>
		</inset>
		<actions>
			<button appearance="primary">
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:fa-solid fa-upload"
					input="request"
				>
					<label>
						<en>Import</en>
						<de>Importieren</de>
					</label>
					<executability>
						<null-input-disabled/>
					</executability>
					<execute-script function='p -> r -> {"file": $r["file"], "password": $p}'>
						<inputs>
							<input channel="password"/>
						</inputs>
					</execute-script>
					<import-ets-project/>
					<close-dialog/>
					<if test='report -> $report["messages"]'>
						<then>
							<open-dialog
								bind-input-to="report"
								dialog-view="projects/import-report.view.xml"
							/>
						</then>
					</if>
					<execute-script function='report -> $report["project"]'/>
					<write-channel name="project"/>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
