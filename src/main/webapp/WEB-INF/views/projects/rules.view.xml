										>
											<label>
												<en>Id</en>
												<de>Id</de>
											</label>
											<value>row -> toString('@"', $row["id"], '"')</value>
										</computed-column>
										<computed-column name="label"
											type="tl.core:String"
										>
											<label>
												<en>Name</en>
												<de>Name</de>
											</label>
											<value>row -> $row["label"]</value>
										</computed-column>
										<computed-column name="type"
