											type="tl.core:String"
										>
											<label>
												<en>Writable</en>
												<de>Schreibbar</de>
											</label>
											<value>row -> if($row["writable"] == true, '✓', '')</value>
										</computed-column>
									</columns>
									<rows>p -> ruleDatapoints($p)</rows>
								</table>
