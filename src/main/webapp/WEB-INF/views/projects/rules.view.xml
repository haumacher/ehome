<?xml version="1.0" encoding="utf-8" ?>

<!--
	The rules of a project (haumacher/ehome #57, homecontrol spec/rules.md): what the HomeControl
	controller does on its own. A rule has adjustable parameters, timers, optional states (a state
	machine) and reactions; a reaction has triggers, an optional condition, actions and else actions,
	and in a rule with states the states it applies in and the state it leads to. The rules are part
	of the runtime image (Deployment tab), in the order of their "Order".

	Conditions, values, durations and log messages are expressions of the rule language, written as
	text (@"1/2/3" names the datapoint of a group address, $id a parameter, running(t) a timer);
	parameter values are literals (3min, 21.5, 06:30). Each field is checked while it is edited as the
	controller would check it (de.haumacher.ehome.runtime.RuleExport): a text that is not in the
	language is an error, a refusal of the controller (a type error, an unknown timer, a datapoint that
	is not writable) a warning with the controller's reason. "Datapoints" lists the datapoints of the
	project's image that expressions and actions may name.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="rule"/>
		<channel name="parameter"/>
		<channel name="timer"/>
		<channel name="state"/>
		<channel name="reaction"/>
		<channel name="trigger"/>
		<derived-channel name="thenList"
			expr="x -> 'actions'"
			inputs="reaction"
		/>
		<derived-channel name="elseList"
			expr="x -> 'elseActions'"
			inputs="reaction"
		/>
		<derived-channel name="entryList"
			expr="x -> 'entry'"
			inputs="state"
		/>
		<derived-channel name="exitList"
			expr="x -> 'exit'"
			inputs="state"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				size="30"
				unit="%"
			>
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="55"
							unit="%"
						>
							<panel>
								<title>
									<en>Rules</en>
									<de>Regeln</de>
								</title>
								<commands>
									<generic-command
										image="css:bi bi-plus-lg"
										input="project"
										placement="TOOLBAR"
									>
										<label>
											<en>New rule</en>
											<de>Neue Regel</de>
										</label>
										<executability>
											<model-access operation="Write"/>
											<null-input-disabled/>
										</executability>
										<with-transaction>
											<execute-script function="o -> ruleCreate($o, 'rules', `ehome.runtime:Rule`)"/>
										</with-transaction>
										<write-channel name="rule"/>
									</generic-command>
									<generic-command
										image="css:bi bi-trash"
										input="rule"
										placement="TOOLBAR"
									>
										<label>
											<en>Delete</en>
											<de>Löschen</de>
										</label>
										<executability>
											<null-input-disabled/>
										</executability>
										<confirm expr="x -> #('Delete the rule with its reactions?'@en, 'Die Regel mit ihren Reaktionen löschen?'@de)"/>
										<delete-object/>
										<write-channel name="rule"/>
									</generic-command>
								</commands>
								<table
									observed-types="ehome.runtime:Rule"
									selection="rule"
									types="ehome.runtime:Rule"
								>
									<inputs>
										<input channel="project"/>
									</inputs>
									<columns>
										<column attribute="order"/>
										<column attribute="name"/>
										<column attribute="identifier"/>
										<column attribute="enabled"/>
									</columns>
									<rows>p -> if($p == null, [], $p.get(`ehome.project:Project#rules`))</rows>
								</table>
